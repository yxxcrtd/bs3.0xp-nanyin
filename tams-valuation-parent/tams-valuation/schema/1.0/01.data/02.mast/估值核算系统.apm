<c:Views>
<o:View Id="o237">
<a:ObjectID>07642586-2AE2-4C2C-9640-1D17A4DF768E</a:ObjectID>
<a:Name>视图-交易日历</a:Name>
<a:Code>VAL_VW_MST_HOLIDAY</a:Code>
<a:CreationDate>1528342820</a:CreationDate>
<a:Creator>Administrator</a:Creator>
<a:ModificationDate>1534245778</a:ModificationDate>
<a:Modifier>Administrator</a:Modifier>
<a:Comment>交易日历的视图</a:Comment>
<a:View.SQLQuery>SELECT
    c.CDATE,
    a.TRADE_CALENDAR_ID,
    SUM(c.IS_HOLIDAY) AS IS_HOLIDAY
FROM
    MST_TRADE_CALENDAR a
INNER JOIN
    MST_CALENDAR_INFO b
ON
    a.CALENDAR_ID = b.CALENDAR_ID
INNER JOIN
    MST_HOLIDAY c
ON
    c.CALENDAR_ID = b.CALENDAR_ID
GROUP BY
    c.CDATE,
    a.TRADE_CALENDAR_ID</a:View.SQLQuery>
<a:TaggedSQLQuery>select
   c.[{0B2FAD34-B9E2-48D3-9B83-FBB8445EA181}=CDATE],
   a.[{39065A65-6922-46D0-A2D8-A690885E84B2}=TRADE_CALENDAR_ID],
   SUM(c.IS_HOLIDAY) as IS_HOLIDAY
from
   [{77540FA1-7671-4D3C-AF54-3F292D4B1DA1}=MST_TRADE_CALENDAR] a
   INNER JOIN [{4B72680B-D7EE-4B2E-A00F-BDDD83E3B304}=MST_CALENDAR_INFO] b on  a.[{F1830DFF-BABD-40CC-8EE1-EFFD6F21BECE}=CALENDAR_ID] = b.[{548A3363-3649-4B6B-93B0-D456D458DAC3}=CALENDAR_ID]
   INNER JOIN [{C8EE8798-D9B2-4C40-98F1-BA57757ABBDF}=MST_HOLIDAY] c on  c.[{7E6CD54E-222A-4A04-8E56-6B47C85AAC4A}=CALENDAR_ID] = b.[{548A3363-3649-4B6B-93B0-D456D458DAC3}=CALENDAR_ID]
group by
   c.[{0B2FAD34-B9E2-48D3-9B83-FBB8445EA181}=CDATE],
   a.[{39065A65-6922-46D0-A2D8-A690885E84B2}=TRADE_CALENDAR_ID]
</a:TaggedSQLQuery>
<a:ExtendedAttributesText>{BAE632F3-AC04-4059-9893-259ABA89351C},ORA11GR1,174={20D1D9B7-9586-443B-BB24-D76A68FF95A0},ExtObjSuperView,0=
{0609C48C-2656-40C0-95E3-622B811A481B},ExtObjOIDList,0=
{0C3877BA-E269-4008-B79E-0C834DC7C550},ExtObjViewType,0=

</a:ExtendedAttributesText>
