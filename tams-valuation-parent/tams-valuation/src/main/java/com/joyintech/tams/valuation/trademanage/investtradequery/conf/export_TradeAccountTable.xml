<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="trademanage/investtradequery/TradeAccountTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.tams.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="收划款类型">typeFt</Cell>
			<Cell order="5" name="收划款日期">settleDat</Cell>
			<Cell order="6" name="收划款金额">settleAmt</Cell>
			<Cell order="7" name="币种">ccy</Cell>
			<Cell order="8" name="收款账户户名">myAcctName</Cell>
			<Cell order="9" name="收款账户账号">myAcctNo</Cell>
			<Cell order="10" name="付款账户户名">counterAcctName</Cell>
			<Cell order="11" name="付款账户账号">counterAcctNo</Cell>
			<Cell order="12" name="收划款状态">statusFt</Cell>
		</Row>
	</Worksheet>
</Workbook>