<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.tams.valuation.basedata.marketdata.intratequote.dao.ValIntRateQuote001Mapper">
	
	<select id="tableLoad"  parameterType="java.util.Map"
	resultType="com.joyintech.tams.valuation.basedata.marketdata.intratequote.dto.ResultDto">
		SELECT 
		    A.INT_RATE_ID AS intRateId, /**利率代码**/
<!-- 		     一体化问题8：表删除（行情信息（MST_RATE_INFO）） 修改：利率名称从数据字典取 -->
		    <!-- B.RATE_NAME AS rateName, /**利率名称**/-->
		    '' as rateName,
<!-- 		    B.RATE_TYPE AS rateType, /**利率类型**/  -->
		    A.RELAESE_DATE AS relaeseDate, /**发布日**/
		    A.EFF_DATE AS effDate, /**生效日**/
	        A.INT_RATE*100 AS intRate, /**利率值(%)**/
<!-- 		    C.QUO_CCY quoCcy /**币种**/ -->
            '' AS quoCcy
<!-- 		    C.QUO_SRC quoSrc /**数据来源**/ -->
        FROM MST_INT_RATE_INFO A
        <!-- LEFT JOIN MST_RATE_INFO B
        ON A.INT_RATE_ID=B.RATE_ID
        LEFT JOIN MST_EXCHARGE_QUOTE C
        ON B.RATE_ID=C.BASE_CCY
        LEFT JOIN MST_EXCHARGE_QUOTE C ON A.INT_RATE_ID=C.BASE_CCY  -->
        WHERE 1=1
		<if test="params.intRateId!=null and params.intRateId!=''">
		AND A.INT_RATE_ID  LIKE '%'||#{params.intRateId}||'%'
		</if>
		<!-- <if test="params.rateName!=null and params.rateName!=''">
		AND B.RATE_NAME  LIKE '%'||#{params.rateName}||'%'
		</if> -->
<!-- 		<if test="params.rateType!=null and params.rateType!=''"> -->
<!-- 		AND B.RATE_TYPE  LIKE '%'||#{params.rateType}||'%' -->
<!-- 		</if> -->
		<if test="params.relaeseStartDate!=null">
		AND A.RELAESE_DATE <![CDATA[>=]]> #{params.relaeseStartDate}
		</if>
		<if test="params.relaeseEndDate!=null">
		AND A.RELAESE_DATE  <![CDATA[<=]]>#{params.relaeseEndDate}
		</if>
		<if test="params.effStartDate!=null">
		AND A.EFF_DATE <![CDATA[>=]]> #{params.effStartDate}
		</if>
		<if test="params.effEndDate!=null">
		AND A.EFF_DATE <![CDATA[<=]]> #{params.effEndDate}
		</if>
		</select>
  
</mapper>