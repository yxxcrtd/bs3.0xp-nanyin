<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dao.ValValuationStatementQuery001Mapper_mysql">

    <select id="getBusiClass" resultType="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dto.ValValuationStatementQuery001Dto" >
        SELECT DISTINCT TABLE_ID , TABLE_NAME 
          FROM BOK_TABLELIST
         WHERE STATUS = 'E'
         <if test="likeStr != null and !''.equals(likeStr)">
            and (TABLE_ID like concat_ws('','%', #{likeStr} ,'%')  or TABLE_NAME like concat_ws('','%', #{likeStr} ,'%'))
         </if>
         order by TABLE_ID
    </select>

     <select id="queryFilepath" resultType="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dto.ValValuationStatementQuery001Dto" >
         select
              fg.FILE_NAME as fileName,
              fg.FILE_PATH as filePath
             from FILE_GEN fg
           where   1 = 1
             <if test="booksetID !=null and booksetID !='' ">
              AND fg.BOOKSET_ID LIKE concat_ws('','%',#{bookId},'%')
            </if>
            <if test="sdate !=null and sdate !='' ">
              AND fg.GEN_DATE  = STR_TO_DATE(#{sdate,jdbcType=DATE},'%Y-%m-%d')
            </if>
            <if test="fileType !=null and fileType !='' ">
              AND fg.FILE_TYPE = #{fileType}
            </if>

        </select>
</mapper>
