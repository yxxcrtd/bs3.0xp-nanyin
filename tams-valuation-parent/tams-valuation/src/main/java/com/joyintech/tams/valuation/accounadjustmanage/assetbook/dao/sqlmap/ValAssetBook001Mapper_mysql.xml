<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.valuation.accounadjustmanage.assetbook.dao.ValAssetBook001Mapper_mysql">

	<select id="selectBatchGroup" resultType="com.joyintech.framework.select.SelectOptionDto">
		select
			SEQ_NO id,
			GROUP_NAME text
		from SYS_BATCH_PRD_GRP
		where 1=1
		<if test="search != null and !''.equals(search)">
			AND GROUP_NAME like concat_ws('','%', #{search} , '%')
		</if>
	</select>


</mapper>
