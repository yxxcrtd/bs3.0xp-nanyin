<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.tams.valuation.basedata.marketdata.exchangerateinfo.dao.ValExchangeRateInfo001Mapper">

	<select id="tableLoad"
	parameterType="map"
		resultType="com.joyintech.tams.valuation.basedata.marketdata.exchangerateinfo.dto.ValExchangeRateInfo001Dto">
		SELECT			
<!-- 			CURRENCY_PAIR AS currencyPair, -->
<!-- 			FOREIGN_EXCHANGE_TYPE AS foreignExchangeType, -->
			TRADE_DATE AS tradeDate
<!-- 			TERM AS term, -->
<!-- 			EXPIRY_DATE AS expiryDate, -->
<!-- 			OPEN_PRICE AS openPrice, -->
<!-- 			CLOSE_PRICE AS closePrice,	 -->
<!-- 			MAX_PRICE AS maxPrice, -->
<!-- 			MIN_PRICE AS minPrice, -->
<!-- 			DATA_SOURCES AS dataSources	 -->
		FROM
			MST_EXCHARGE_QUOTE		
		WHERE
			1=1
<!-- 		<if test="currencyPair !=null and currencyPair !='' "> -->
<!-- 			AND CURRENCY_PAIR = #{currencyPair} -->
<!-- 		</if>		 -->
<!-- 		<if test="foreignExchangeType!=null and foreignExchangeType!=''"> -->
<!-- 			AND FOREIGN_EXCHANGE_TYPE = #{foreignExchangeType} -->
<!-- 		</if> -->
		<if test="startDate!=null"> 
			AND TRADE_DATE &gt; = #{startDate}
		</if>
		<if test="endDate!=null">
			AND TRADE_DATE &lt; = #{endDate}
		</if>
	</select>
</mapper>