<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.valuation.taxparametermanage.taxscheme.dao.TaxScheme003Mapper_mysql">

    <select id="selectByPrimaryKey" resultType="com.joyintech.tams.valuation.taxparametermanage.taxscheme.dto.TaxScheme003Dto" parameterType="java.lang.String" >
        select 
            seq_no as seqNo, /* 流水号 */
            sch_id as schId, /* 方案代码 */
            asset_classify as assetClassify, /* 资产分类 */
            capi_income_feature as capiIncomeFeature, /* 本金收益特征  */
            income_type as incomeType, /* 收入类型  */
            taxable_sign as taxableSign, /* 应税标志 - 计税方式 */
            fee_type as feeType, /* 免税收入类型(%)  */
            tax_rate*100 as taxRate, /* 应税税率 */
            DATE_FORMAT(eff_date, '%Y-%m-%d') as effDate/* 生效日 */
        from TAX_VAT_SCHEDULE
        where SEQ_NO = #{seqNo,jdbcType=VARCHAR}
    </select>

    <insert id="insertSelective" parameterType="com.joyintech.tams.valuation.taxparametermanage.taxscheme.dto.TaxScheme003Dto" >
        insert into TAX_VAT_SCHEDULE
        <trim prefix="(" suffix=")" suffixOverrides="," >
            SEQ_NO,

            <if test="schId != null" >
                SCH_ID,
            </if>
            <if test="assetClassify != null" >
                ASSET_CLASSIFY,
            </if>
            <if test="capiIncomeFeature != null" >
                CAPI_INCOME_FEATURE,
            </if>
            <if test="incomeType != null" >
                INCOME_TYPE,
            </if>
            <if test="taxableSign != null" >
                TAXABLE_SIGN,
            </if>
            <if test="taxRate != null" >
                TAX_RATE,
            </if>
            <if test="feeType != null" >
                FEE_TYPE,
            </if>
            <if test="effDate != null" >
                EFF_DATE,
            </if>
            <if test="createUser != null" >
                CREATE_USER,
            </if>
            <if test="createDept != null" >
                CREATE_DEPT,
            </if>
            <if test="createTime != null" >
                CREATE_TIME,
            </if>
            <if test="updateUser != null" >
                UPDATE_USER,
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            _NEXTINDEX('TAX_SEQUENCE'),

            <if test="schId != null" >
                #{schId,jdbcType=VARCHAR},
            </if>
            <if test="assetClassify != null" >
                #{assetClassify,jdbcType=VARCHAR},
            </if>
            <if test="capiIncomeFeature != null" >
                #{capiIncomeFeature,jdbcType=VARCHAR},
            </if>
            <if test="incomeType != null" >
                #{incomeType,jdbcType=VARCHAR},
            </if>
            <if test="taxableSign != null" >
                #{taxableSign,jdbcType=VARCHAR},
            </if>
            <if test="taxRate != null" >
                #{taxRate,jdbcType=DECIMAL}/100 ,
            </if>
            <if test="feeType != null" >
                #{feeType,jdbcType=VARCHAR},
            </if>
            <if test="effDate != null" >
                STR_TO_DATE(#{effDate}, '%Y-%m-%d'),
            </if>
            <if test="createUser != null" >
                #{createUser,jdbcType=VARCHAR},
            </if>
            <if test="createDept != null" >
                #{createDept,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateUser != null" >
                #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.joyintech.tams.valuation.taxparametermanage.taxscheme.dto.TaxScheme003Dto" >
        update TAX_VAT_SCHEDULE
        <set >
            <if test="schId != null" >
                SCH_ID = #{schId,jdbcType=VARCHAR},
            </if>
            <if test="assetClassify != null" >
                ASSET_CLASSIFY = #{assetClassify,jdbcType=VARCHAR},
            </if>
            <if test="capiIncomeFeature != null" >
                CAPI_INCOME_FEATURE = #{capiIncomeFeature,jdbcType=VARCHAR},
            </if>
            <if test="incomeType != null" >
                INCOME_TYPE = #{incomeType,jdbcType=VARCHAR},
            </if>
            <if test="taxableSign != null" >
                TAXABLE_SIGN = #{taxableSign,jdbcType=VARCHAR},
            </if>
            <if test="taxRate != null" >
                TAX_RATE = #{taxRate,jdbcType=DECIMAL}/100,
            </if>
            <if test="feeType != null" >
                FEE_TYPE = #{feeType,jdbcType=VARCHAR},
            </if>
            <if test="effDate != null" >
                EFF_DATE = STR_TO_DATE(#{effDate}, '%Y-%m-%d'),
            </if>
            <if test="updateUser != null" >
                UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </set>
        where SEQ_NO = #{seqNo,jdbcType=VARCHAR}
    </update>
    
    
    
    
    
    
    
    
    
    
    
    

   
    
