<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="trademanage/investtradequery/CashtransactionsTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.tams.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="交易类型">feeTypeName</Cell>
			<Cell order="5" name="交易日">tradeDate</Cell>
			<Cell order="6" name="交易金额">tradeAmt</Cell>
			<Cell order="7" name="币种">ccy</Cell>
			<Cell order="8" name="交易状态">tradeStatus</Cell>
			<Cell order="9" name="备注">remark</Cell>
		</Row>
	</Worksheet>
</Workbook>