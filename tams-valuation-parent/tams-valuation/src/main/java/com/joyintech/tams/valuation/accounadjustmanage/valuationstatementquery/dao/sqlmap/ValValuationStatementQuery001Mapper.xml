<mapper
    namespace="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dao.ValValuationStatementQuery001Mapper">
    
    <select id="getBooksetId" resultType="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dto.ValValuationStatementQuery001Dto" >
        SELECT DISTINCT BOOKSET_ID , BOOKSET_NAME 
        FROM BOK_BOOKSET
        order by BOOKSET_ID
    </select>
    
    <select id="getBusiClass" resultType="com.joyintech.tams.valuation.accounadjustmanage.valuationstatementquery.dto.ValValuationStatementQuery001Dto" >
        SELECT DISTINCT TABLE_ID , TABLE_NAME 
          FROM BOK_TABLELIST
         WHERE STATUS = 'E'
         <if test="likeStr != null and !''.equals(likeStr)">
            and (TABLE_ID like '%' || #{likeStr} || '%' or TABLE_NAME like '%' || #{likeStr} || '%')
         </if>
         order by TABLE_ID
    </select>
