<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="trademanage/investtradequery/ValOverduePenalty.xlsx" name="逾期交易查询">
	<Worksheet javaBean="com.joyintech.tams.valuation.trademanage.investtradequery.dto.OverduePenaltyDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="账套代码">prodId</Cell>
			<Cell order="3" name="账套名称">prodAbbr</Cell>
			<Cell order="4" name="资产代码">assetId</Cell>
			<Cell order="5" name="资产名称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="交易场所">tradeMarket</Cell>
			<Cell order="8" name="投资目的">invAim</Cell>
			<Cell order="9" name="发生日">tradeDate</Cell>
			<Cell order="10" name="币种">ccy</Cell>
			<Cell order="11" name="交易本金">prinAmt</Cell>
			<Cell order="12" name="交易利息">intAmt</Cell>
			<Cell order="13" name="交易金额">tradeAmt</Cell>
			<Cell order="14" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>