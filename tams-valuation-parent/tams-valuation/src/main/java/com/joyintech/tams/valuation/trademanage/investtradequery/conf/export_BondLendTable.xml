<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="trademanage/investtradequery/BondLendTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.tams.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="标的债券代码">assetId</Cell>
			<Cell order="5" name="标的债券简称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="借贷方向">finprodType</Cell>
			<Cell order="8" name="借贷期限(天)">termType</Cell>
			<Cell order="9" name="计费基础">basis</Cell>
			<Cell order="10" name="费率">intRate</Cell>
			<Cell order="11" name="币种">ccy</Cell>
			<Cell order="12" name="券面总额/交易本金">shareAmt</Cell>
			<Cell order="13" name="借贷费用">cdAmt</Cell>
			<Cell order="14" name="交易金额">tradeAmt</Cell>
			<Cell order="15" name="交易状态">tradeStatus</Cell>
			<Cell order="16" name="登记托管机构">registOrgName</Cell>
			<Cell order="17" name="结算手续费">feeAmt</Cell>
			<Cell order="18" name="是否随交易支付">isPayWithTradeStr</Cell>
		</Row>
	</Worksheet>
</Workbook>