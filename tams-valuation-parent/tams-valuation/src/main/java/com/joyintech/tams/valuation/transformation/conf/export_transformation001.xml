		<Row>
			<Cell order="1" name="●账套代码">booksetId</Cell>
			<Cell order="2" name="●业务明细代码">busiId</Cell>
			<Cell order="3" name="●业务明细类型">busiDetailType</Cell>
			<Cell order="4" name="●日期">balanceDate</Cell>
			<Cell order="5" name="●投资目的">invAim</Cell>
