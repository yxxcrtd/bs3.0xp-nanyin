    <select id='getTable1' resultType='com.joyintech.tams.valuation.assets.posit.dto.DateTableDto'>
    	select 
    		 to_char(fccr.EFF_DATE, 'yyyy-MM-dd') effDate,/**生效日*/
    		(fccr.YIELD)*100 yield/**利率*/
    	from 
    		FIN_CASH_CALC_RULE fccr
    	where 
    		fccr.FINPROD_ID= #{finprodId}
    </select>
    
