    <select id='getTable2' parameterType="java.util.Map"
    	resultType='com.joyintech.tams.valuation.assets.posit.dto.DateTableDto'>
    	select 
    		to_char(fcp.VDATE, 'yyyy-MM-dd') vdate, /**界面-付息计划表.计息开始日*/
    		to_char(fcp.MDATE, 'yyyy-MM-dd') mdate, /**界面-付息计划表.计息结束日*/
    		to_char(fcp.PAY_DATE, 'yyyy-MM-dd') payDate, /**界面-付息计划表.理论支付日*/
    		fcp.INT_AMT intAmt/**界面-付息计划表.应计利息*/
    	from 
    		FIN_CASH_PLAN fcp
    	where fcp.FINPROD_ID= #{finprodId}
    	and fcp.CASH_ID IN (SELECT CASH_ID FROM FIN_CASH_INFO WHERE CASH_TYPE_1 = #{cashType1})
    	order by vdate asc <!-- modify by dongjun on 20181226 付息计划按照计息开始日排序 -->
    </select>
    
    <select id='getTable3' parameterType="java.util.Map"
    	resultType='com.joyintech.tams.valuation.assets.posit.dto.DateTableDto'>
    	select 
    		to_char(fcp.MDATE, 'yyyy-MM-dd') repayDate, /**界面-还本计划表.还本日*/
    		to_char(fcp.PAY_DATE, 'yyyy-MM-dd') payDate, /**界面-还本计划表.支付*/
    		fcp.PRIN_AMT prinAmt, /**界面-付息计划表.理论支付日*/
    		fcp.INT_AMT intAmt/**界面-付息计划表.应计利息*/
    	from 
    		FIN_CASH_PLAN fcp
    	where fcp.FINPROD_ID= #{finprodId}
    	and fcp.CASH_ID IN (SELECT CASH_ID FROM FIN_CASH_INFO WHERE CASH_TYPE_1 != #{cashType1})
    	order by repayDate asc <!-- modify by dongjun on 20181226 还本计划按照计息开始日排序 -->
    </select>
    <!-- modify by dongjun on 20181203 end -->
    
