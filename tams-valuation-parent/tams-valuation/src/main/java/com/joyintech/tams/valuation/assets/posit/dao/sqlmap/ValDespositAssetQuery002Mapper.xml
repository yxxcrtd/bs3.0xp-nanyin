    <update id="updateFinCashPayRule" parameterType="com.joyintech.tams.common.base.entity.FinCashPayRule" >
        update FIN_CASH_PAY_RULE
        <set >
            <if test="payCycle != null" >
                PAY_CYCLE = #{payCycle,jdbcType=VARCHAR},
            </if>
            <if test="dayType != null" >
                DAY_TYPE = #{dayType,jdbcType=VARCHAR},
            </if>
            <if test="dayValue != null" >
                DAY_VALUE = #{dayValue,jdbcType=VARCHAR},
            </if>
            <!-- <if test="tdayRule != null" >
                TDAY_RULE = #{tdayRule,jdbcType=VARCHAR},
            </if> -->
            <if test="endTdayRule != null" >
                END_TDAY_RULE = #{endTdayRule,jdbcType=VARCHAR},
            </if>
            <if test="payTdayRule != null" >
                PAY_TDAY_RULE = #{payTdayRule,jdbcType=VARCHAR},
            </if>
            <if test="calcRule != null" >
                CALC_RULE = #{calcRule,jdbcType=VARCHAR},
            </if>
            <if test="firstPayDate != null" >
                FIRST_PAY_DATE = #{firstPayDate,jdbcType=DATE},
            </if>
            <if test="cashUnitType != null" >
                CASH_UNIT_TYPE = #{cashUnitType,jdbcType=VARCHAR},
            </if>
            <if test="finprodId != null" >
                FINPROD_ID = #{finprodId,jdbcType=VARCHAR},
            </if>
            <if test="finprodType != null" >
                FINPROD_TYPE = #{finprodType,jdbcType=VARCHAR},
            </if>
            <if test="payType != null" >
                PAY_TYPE = #{payType,jdbcType=VARCHAR},
            </if>
            <if test="branch != null" >
                BRANCH = #{branch,jdbcType=DECIMAL},
            </if>
            <if test="updateUser != null" >
                UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </set>
        where FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
          and FINPROD_TYPE = #{finprodType,jdbcType=VARCHAR}
    </update>
    
