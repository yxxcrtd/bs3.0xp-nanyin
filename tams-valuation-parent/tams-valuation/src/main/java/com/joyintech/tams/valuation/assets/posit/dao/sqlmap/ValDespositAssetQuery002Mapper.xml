    <select id="selectByfinprodId" resultType="com.joyintech.tams.valuation.assets.posit.dto.ValDespositAssetQuery002Dto">
            <!-- modify by dongjun on 20181201 start -->
             select             
                  fp.FINPROD_ID,            /** 资产代码 */
                  fp.FINPROD_NAME,        			  /** 资产名称 */
                  fp.FINPROD_TYPE,                     /** 存款类型 */
                  fp.VDATE,     /** 起息日 */
                  fp.MDATE,     /** 到期日 */
                  fp.CAPI_INCOME_FEATURE,  /** 本金收益特征*/
                  fp.CCY,                         /** 币种 */
                  fp.ISSUE_AMT,                 /** 存款本金 */ 
                  fp.CALENDAR_ID,                             /** 交易日历 */    
                  fp.BLN_AREA,                       		 /** 境内外 */ 
                  fp.ISSUER,					/**发行人*/
                  fp.TRADE_MARKET,							/** 交易场所*/
                  (fp.mdate - fp.vdate)  term,           /** 期限 */  
                  fpt.TYPE_2,    							/**核算分类*/
                  fpt.TYPE_1,                		 	 /** 资产类型 */     
                  (fccr.YIELD)*100 basicRate,
                  fccr.REMARK remark,
                  fccr.BASIS basis,                          /** 计息基础 */  
                  <!-- fcpr.TDAY_RULE,                 /** 付息营业日准则 */   -->
                  fcpr.END_TDAY_RULE endTdayRule,    /*付息截止日营业日准则*/
             	  fcpr.PAY_TDAY_RULE payTdayRule,    /*付息支付日营业日准则*/
                  fcpr.PAY_CYCLE,                   /** 付息频率 */  
                  fcpr.CALC_RULE,                   /** 推算方式 */
                  fcpr.FIRST_PAY_DATE,           /** 首次付息日 */            
                  fccr.CALC_TYPE                 /**利率类型*/
             from FIN_PRODUCT fp 
             LEFT JOIN          
             (
             SELECT * FROM
             	(
	             SELECT 
	             	FINPROD_ID, YIELD,REMARK,BASIS,CALC_TYPE,     	
	             	ROW_NUMBER() OVER(PARTITION BY FINPROD_ID ORDER BY EFF_DATE ASC) rowN
	             FROM FIN_CASH_CALC_RULE 
				)
			WHERE rowN =1 
             ) fccr 
             ON fp.FINPROD_ID = fccr.FINPROD_ID
			LEFT JOIN 
			(
			SELECT * FROM FIN_CASH_PAY_RULE
			WHERE CASH_ID IN (SELECT CASH_ID FROM FIN_CASH_INFO WHERE CASH_TYPE_1 = #{cashType1})
			) fcpr
			ON fp.FINPROD_ID = fcpr.FINPROD_ID
             left join FIN_PRODUCT_TYPE fpt on fp.finprod_id = fpt.finprod_id 
            where 1 = 1
        <if test="finprodId !=null and finprodId != '' ">
          and fp.finprod_id = #{finprodId}  
        </if>   
        <!-- modify by dongjun on 20181201 end -->
    </select>
    
