			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>joyintech-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jixu</groupId>
            <artifactId>jixu</artifactId>
            <version>0.0.1</version>
        </dependency>
    </dependencies>

