	<!-- 接口定时任务执行类 -->
	<bean id="interfScheduleJob"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<!-- 定时执行类 -->
			<ref bean="interfRecvTask" />
		</property>
		<property name="targetMethod">
			<!-- 定时执行类的方法 -->
			<value>execute</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>
<!-- 	<bean id="interfScheduleJob1"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			定时执行类
			<ref bean="interfTestTask" />
		</property>
		<property name="targetMethod">
			定时执行类的方法
			<value>execute</value>
		</property>
		<property name="concurrent" value="false" />
		是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程
	</bean> -->
	<bean id="updateSysdateJob"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<!-- 定时执行类 -->
			<ref bean="updateSysdateTask" />
		</property>
		<property name="targetMethod">
			<!-- 定时执行类的方法 -->
			<value>execute</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>
	
		<!-- add by hudongyang 深证通接口轮训  -->
	<bean id="sztInterfTaskTrigger"
		class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="sztInterfJob" />
		</property>
		<property name="cronExpression">
			<!-- 系统时间在24点执行一次 -->
			<value>00 0/6 * * * ?</value>
		</property>
	</bean>
	
	<!-- add by hudongyang 深圳通接口轮训  -->
	<bean id="sztInterfJob"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<!-- 定时执行类 -->
			<ref bean="sztInterfRecTask" />
		</property>
		<property name="targetMethod">
			<!-- 定时执行类的方法 -->
			<value>sztInterfRec</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>
</beans>  