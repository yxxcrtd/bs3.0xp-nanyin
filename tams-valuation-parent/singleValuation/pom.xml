<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>2.1.9</version>
	</parent>
	<version>1.0.0</version>
	<artifactId>singleValuation</artifactId>
<!-- 	<packaging>war</packaging> -->
	<packaging>war</packaging>
	<name>singleValuation</name>
	<description>估值核算管理系统</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
        <hibernate.version>5.3.6.Final</hibernate.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-data</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-log</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-security</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-workflow</artifactId>
		</dependency>
		<!-- 估值画面端 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-valuation</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- 行情基础数据 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-basicdata</artifactId>
			<version>1.0.0</version>
			<exclusions>
				<exclusion>
					<artifactId>framework-dtx</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-invest-common</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>component-business</artifactId>
			<version>0.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>component-base</artifactId>
			<version>0.0.1</version>
			<exclusions>
				<exclusion>
					<artifactId>framework-dtx</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>
	<build>
        <finalName>valuation</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.springframework.boot.loader.WarLauncher</mainClass>
                    <addResources>true</addResources>
                    <classifier>exec</classifier>
                    <fork>true</fork>
                </configuration>
            </plugin>
        </plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.xml</include>
					<include>**/*.txt</include>
					<include>**/*.png</include>
					<include>**/*.properties</include>
					<include>**/*.ini</include>
					<include>**/*.yml</include>
					<include>**/*.js</include>
					<include>**/*.html</include>
					<include>**/*.xls</include>
				</includes>
				<filtering>false</filtering>
			</resource>
		</resources>
    </build>
