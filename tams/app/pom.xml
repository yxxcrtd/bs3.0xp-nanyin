<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.3-BOOTVIS</version>
	</parent>
	<artifactId>tams</artifactId>
	<version>0.1.9</version>
<!-- 	<packaging>war</packaging> -->
	<packaging>jar</packaging>
	<name>tams</name>
	<description>理财资管系统画面整合启动</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
        <hibernate.version>5.3.6.Final</hibernate.version>
	</properties>

	<dependencies>
		<!-- 中债一体化工程 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>svreport-app</artifactId>
			<version>2.1.2</version>
		</dependency>
        <!-- 信批一体化工程 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>disclosure-app</artifactId>
            <version>2.1.2</version>
        </dependency>
        <!-- 投管一体化工程 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>invest-app</artifactId>
            <version>2.1.2</version>
        </dependency>
        <!-- 估值一体化工程 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>valuation-app</artifactId>
            <version>2.1.2</version>
        </dependency>
        <!-- 移动APP -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>mobileApproval</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- 几许工程 -->
		<dependency>
			<groupId>com.jixu</groupId>
			<artifactId>jixu</artifactId>
			<version>0.0.1</version>
		</dependency>

	</dependencies>
	<build>
		<finalName>tams</finalName>
		<plugins>
		<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>
			
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.joyintech.tams.TamsApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.xml</include>
					<include>**/*.txt</include>
					<include>**/*.png</include>
					<include>**/*.properties</include>
					<include>**/*.ini</include>
					<include>**/*.yml</include>
					<include>**/*.js</include>
					<include>**/*.html</include>
					<include>**/*.xls</include>
				</includes>
				<filtering>false</filtering>
			</resource>
		</resources>
	</build>

</project>
