<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist17.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
          <Cell order="1" name="数据日期">repStatusDate</Cell>                 <!--数据日期-->
          <Cell order="2" name="数据日期">finprodMarketId</Cell>               <!--行内资产/负债编码-->
          <Cell order="3" name="数据日期">repIssuePartyId</Cell>               <!--发行机构代码-->
          <Cell order="4" name="数据日期">repAssetTypeStr</Cell>               <!--资产/负债类别-->
          <Cell order="5" name="数据日期">ccyStr</Cell>                        <!--币种-->     
          <Cell order="6" name="数据日期">repTradeMarketStr</Cell>             <!--交易流通场所--> 
          <Cell order="7" name="数据日期">repFinprodName</Cell>                <!--委外投资协议名称-->
          <Cell order="8" name="数据日期">secId</Cell>                         <!--委外投资协议编号-->
          <Cell order="9" name="数据日期">repTrustee</Cell>                    <!--受托人-->
          <Cell order="10" name="数据日期">repActualManager</Cell>             <!--实际管理人-->
          <Cell order="11" name="数据日期">repCustodian</Cell>                 <!--托管人-->
          <Cell order="12" name="数据日期">repEntrustInvestMoney</Cell>        <!--委托投资金额-->
          <Cell order="13" name="数据日期">repCapiInvestStr</Cell>             <!--资金实际投向-->
          <Cell order="14" name="数据日期">repApplicationMode</Cell>           <!--资金运用方式-->
          <Cell order="15" name="数据日期">repCapUseInduStr</Cell>             <!--资金运用行业-->
          <Cell order="16" name="数据日期">repInvestStartdate</Cell>           <!--投资运作起始日期-->
          <Cell order="17" name="数据日期">repInvestEnddate</Cell>             <!--投资运作终止日期-->
          <Cell order="18" name="数据日期">repTrustInvestAttributeStr</Cell>   <!--委外投资属性-->
          <Cell order="19" name="数据日期">repRateFlagStr</Cell>               <!--是否有预期收益率-->
          <Cell order="20" name="数据日期">repMaxSxpectedYield</Cell>          <!--预期最高收益率-->
          <Cell order="21" name="数据日期">repMinExpectedYield</Cell>          <!--预期最低收益率-->
          <Cell order="22" name="数据日期">repManagementRate</Cell>            <!--管理费率%-->
          <Cell order="23" name="数据日期">repTrustRate</Cell>                 <!--托管费率%-->
          <Cell order="24" name="数据日期">repTradeSumRate</Cell>              <!--交易相关合计费率%-->
          <Cell order="25" name="数据日期">repIntermediarySumRate</Cell>       <!--中介服务机构合计费率%-->
          <Cell order="26" name="数据日期">repOtherSumRate</Cell>              <!--其他合计费率%-->
  		</Row>
    </Worksheet>
</Workbook>