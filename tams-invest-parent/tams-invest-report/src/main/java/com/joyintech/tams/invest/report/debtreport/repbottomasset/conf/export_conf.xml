<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepBottomAsset.xlsx" name="资管计划底层持仓登记">
    <Worksheet javaBean="com.joyintech.tams.common.base.entity.RepBottomAsset">
        <Row>
            <Cell order="1" name="数据日期">repStatusDate</Cell>
            <Cell order="2" name="发行机构代码">repIssuePartyId</Cell>
            <Cell order="3" name="对应资管及委外资产行内资产/负债编码">repAssetCode</Cell>
            <Cell order="4" name="资管及委外资产当前总折算人民币金额（元）">repSumMoney</Cell>
            <Cell order="5" name="资管及委外资产当前总数量">repSumAmount</Cell>
            <Cell order="6" name="资管及委外资产未投资头寸（元）">repUninvestCash</Cell>
            <Cell order="7" name="底层资产行内资产/负债编码">repBottomCode2</Cell>
            <Cell order="8" name="底层资产持仓数量">repBottomAssetAmount</Cell>
            <Cell order="9" name="底层资产折算人民币市值（元）">repBottomAssetSmv</Cell>
            <Cell order="10" name="持仓日期">repPositionDate</Cell>
  		</Row>
    </Worksheet>
</Workbook>