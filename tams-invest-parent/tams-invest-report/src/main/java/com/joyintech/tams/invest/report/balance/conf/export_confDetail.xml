<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepFinProductAssetBalance2.xlsx" name="资产余额表">
    <Worksheet javaBean="com.joyintech.tams.invest.report.balance.dto.RepFinProductAssetBalanceDto">
        <Row>
            <Cell order="1" name="组合名称">portfolioName</Cell>
            <Cell order="2" name="资产类型">finprodType2Name</Cell>
            <Cell order="3" name="资产一级分类">type4Name</Cell>
            <Cell order="4" name="资产二级分类">type5Name</Cell>
            <Cell order="5" name="资产代码">finprodMarketId</Cell>
            <Cell order="6" name="资产名称">finprodAbbr</Cell>
            <Cell order="7" name="初始本金">firstAmount</Cell>
            <Cell order="8" name="当前余额（份额）">amount</Cell>
            <Cell order="9" name="上一次付息截止日">tradeDate</Cell>
            <Cell order="10" name="起息日">vdate</Cell>
            <Cell order="11" name="到期日">mdate</Cell>
            <Cell order="12" name="计息基础">basisName</Cell>
            <Cell order="13" name="收益率(%)">rangeYield</Cell>
            <Cell order="14" name="到期收益率(%)">mYield</Cell>
            <Cell order="15" name="摊销价（成本价）">costPrice</Cell>
            <Cell order="16" name="市价">closePrice</Cell>
            <Cell order="17" name="发行人（融资人）">issuer</Cell>
            <Cell order="18" name="币种">ccyName</Cell>
            <Cell order="19" name="所属团队">deptCodeName</Cell>
        </Row>
    </Worksheet>
</Workbook>