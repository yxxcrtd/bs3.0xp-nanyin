<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepFinProductBalance.xlsx" name="产品余额表">
    <Worksheet javaBean="com.joyintech.tams.invest.report.balance.dto.RepFinProductBalanceDto">
        <Row>
            <Cell order="1" name="产品代码">finprodMarketId</Cell>
            <Cell order="2" name="产品简称">finprodAbbr</Cell>
            <Cell order="3" name="产品名称">finprodName</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="处理模式">dealMode</Cell>
            <Cell order="7" name="销售部门">saleDepartment</Cell>
            <Cell order="8" name="产品款型">productType</Cell>
            <Cell order="9" name="认购币种">ccy</Cell>
            <Cell order="10" name="认购金额 ">tradeAmt</Cell>
            <Cell order="11" name="剩余金额">tdyPrinAmt</Cell>
            <Cell order="12" name="起息日">vdateStr</Cell>
            <Cell order="13" name="到期日">mdateStr</Cell>
            <Cell order="14" name="预期收益率(%)/净值">valuation</Cell>
            <Cell order="14" name="托管费率（%）">clientYield</Cell>
            <Cell order="15" name="销售费率（%）">saleYield</Cell>
            <Cell order="16" name="管理费率（%）">managerYield</Cell>
            <Cell order="17" name="其他费率(%)">otherYield</Cell>
            <Cell order="18" name="发行方式">issueTypeName</Cell>
        </Row>
    </Worksheet>
</Workbook>