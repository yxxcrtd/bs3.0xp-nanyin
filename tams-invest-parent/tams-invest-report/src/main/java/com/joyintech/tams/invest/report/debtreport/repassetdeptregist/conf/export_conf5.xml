<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist5.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
           <Cell order="1" name="数据日期">repStatusDate</Cell>     <!--数据日期-->
           <Cell order="2" name="数据日期">finprodMarketId</Cell>   <!--行内资产/负债编码-->
           <Cell order="3" name="数据日期">repIssuePartyId</Cell>   <!--发行机构代码-->
           <Cell order="4" name="数据日期">repAssetTypeStr</Cell>   <!--资产/负债类别-->
           <Cell order="5" name="数据日期">ccyStr</Cell>            <!--币种-->    
           <Cell order="6" name="数据日期">repTradeMarketStr</Cell> <!--交易流通场所--> 
           <Cell order="7" name="数据日期">repIsRightStr</Cell>     <!--是否为收/受益权-->
           <Cell order="8" name="数据日期">repIsResaleStr</Cell>    <!--是否属于买入返售-->
           <Cell order="9" name="数据日期">repAstBillType</Cell>    <!--类型-->
           <Cell order="10" name="数据日期">repNum</Cell>           <!--数量-->
           <Cell order="11" name="数据日期">repAmtSum</Cell>        <!--合计金额-->
           <Cell order="12" name="数据日期">repRemainTerm</Cell>    <!--加权剩余期限（天）-->
           <Cell order="13" name="数据日期">repMaxRemainTerm</Cell> <!--最长剩余期限（天）-->
           <Cell order="14" name="数据日期">repMinRemainTerm</Cell> <!--最短剩余期限（天）-->
           <Cell order="15" name="数据日期">repVdate</Cell>         <!--起息日-->
           <Cell order="16" name="数据日期">repMdate</Cell>         <!--到期日-->
           <Cell order="17" name="数据日期">repIndustry</Cell>      <!--行业-->
           <Cell order="18" name="数据日期">repDiscRate</Cell>      <!--贴现利率（%）-->
  		</Row>
    </Worksheet>
</Workbook>