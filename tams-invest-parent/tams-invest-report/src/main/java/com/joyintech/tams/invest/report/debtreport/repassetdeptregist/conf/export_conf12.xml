<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist12.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
           <Cell order="1" name="数据日期">repStatusDate</Cell>      <!--数据日期-->
           <Cell order="2" name="数据日期">finprodMarketId</Cell>    <!--行内资产/负债编码-->
           <Cell order="3" name="数据日期">repIssuePartyId</Cell>    <!--发行机构代码-->
           <Cell order="4" name="数据日期">repAssetTypeStr</Cell>    <!--资产/负债类别-->
           <Cell order="5" name="数据日期">ccyStr</Cell>             <!--币种-->     
           <Cell order="6" name="数据日期">repTradeMarketStr</Cell>  <!--交易流通场所--> 
           <Cell order="7" name="数据日期">repFinprodName</Cell>     <!--资管计划名称-->
           <Cell order="8" name="数据日期">repPartyCode</Cell>       <!--资管计划发起人机构编码-->
           <Cell order="9" name="数据日期">repRegistCode</Cell>      <!--资管计划登记编码-->
           <Cell order="10" name="数据日期">repManagerId</Cell>      <!--管理人-->
           <Cell order="11" name="数据日期">repTrusteeId</Cell>      <!--托管人-->
           <Cell order="12" name="数据日期">repAmt</Cell>            <!--金额-->
           <Cell order="13" name="数据日期">repCapiInvestStr</Cell>  <!--资金实际投向-->
           <Cell order="14" name="数据日期">repCapUseWay</Cell>      <!--资金运用方式-->
           <Cell order="15" name="数据日期">repCapUseInduStr</Cell>  <!--资金运用行业-->
           <Cell order="16" name="数据日期">repSetDate</Cell>        <!--资管计划成立日期-->
           <Cell order="17" name="数据日期">repEndDate</Cell>        <!--资管计划终止日期-->
           <Cell order="18" name="数据日期">repPlanPropStr</Cell>    <!--资管计划属性-->
           <Cell order="19" name="数据日期">repYieldFlagStr</Cell>   <!--是否有预期收益率-->
           <Cell order="20" name="数据日期">repMaxRate</Cell>        <!--预期最高收益率%-->
           <Cell order="21" name="数据日期">repMinRate</Cell>        <!--预期最低收益率%-->
           <Cell order="22" name="数据日期">repBuyStructStr</Cell>   <!--购买结构-->
           <Cell order="23" name="数据日期">repManageTypeStr</Cell>  <!--管理方式-->
           <Cell order="24" name="数据日期">repIsCtrlBottomStr</Cell><!--是否掌控计划底层资产详情-->
           <Cell order="25" name="数据日期">repMgrFeeRate</Cell>     <!--管理费率%-->
           <Cell order="26" name="数据日期">repTruFeeRate</Cell>     <!--托管费率%-->
           <Cell order="27" name="数据日期">repTradeFeeRate</Cell>   <!--交易相关合计费率%-->
           <Cell order="28" name="数据日期">repAgencyFeeRate</Cell>  <!--中介服务机构合计费率%-->
           <Cell order="29" name="数据日期">repOtherFeeRate</Cell>   <!--其他合计费率%-->
  		</Row>
    </Worksheet>
</Workbook>