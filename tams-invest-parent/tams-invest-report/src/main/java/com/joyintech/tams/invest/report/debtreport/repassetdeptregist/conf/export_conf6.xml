<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist6.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
           <Cell order="1" name="数据日期">repStatusDate</Cell>     <!--数据日期-->
           <Cell order="2" name="数据日期">finprodMarketId</Cell>   <!--行内资产/负债编码-->
           <Cell order="3" name="数据日期">repIssuePartyId</Cell>   <!--发行机构代码-->
           <Cell order="4" name="数据日期">repAssetTypeStr</Cell>   <!--资产/负债类别-->
           <Cell order="5" name="数据日期">ccyStr</Cell>            <!--币种-->     
           <Cell order="6" name="数据日期">repTradeMarketStr</Cell> <!--交易流通场所--> 
           <Cell order="7" name="数据日期">repSharesId</Cell>       <!--股票代码-->
           <Cell order="8" name="数据日期">repFinprodName</Cell>    <!--股票/企业名称-->
           <Cell order="9" name="数据日期">repSharesTypeStr</Cell>  <!--股票类型-->
           <Cell order="10" name="数据日期">repIndustry</Cell>      <!--行业-->
           <Cell order="11" name="数据日期">repInvestStageStr</Cell><!--投资阶段-->
           <Cell order="12" name="数据日期">repPartyType1Str</Cell> <!--企业类型（按规模划分）-->
           <Cell order="13" name="数据日期">repPartyType3Str</Cell> <!--企业类型（按技术领域划分）-->
           <Cell order="14" name="数据日期">repPartyType2Str</Cell> <!--企业类型（按经济类型划分）-->
           <Cell order="15" name="数据日期">repIsPledgeStr</Cell>   <!--是否为质押融资-->
  		</Row>
    </Worksheet>
</Workbook>