           <Cell order="21" name="数据日期">repFinancierType3Str</Cell>       <!--融资人类型（按技术领域划分）-->
           <Cell order="22" name="数据日期">repFinancierType2Str</Cell>       <!--融资人类型（按经济类型划分）-->
