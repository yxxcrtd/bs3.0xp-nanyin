<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist11.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
           <Cell order="1" name="数据日期">repStatusDate</Cell>       <!--数据日期-->
           <Cell order="2" name="数据日期">finprodMarketId</Cell>     <!--行内资产/负债编码-->
           <Cell order="3" name="数据日期">repIssuePartyId</Cell>     <!--发行机构代码-->
           <Cell order="4" name="数据日期">repAssetTypeStr</Cell>     <!--资产/负债类别-->
           <Cell order="5" name="数据日期">ccyStr</Cell>              <!--币种-->     
           <Cell order="6" name="数据日期">repTradeMarketStr</Cell>   <!--交易流通场所--> 
           <Cell order="7" name="数据日期">repCountryArea</Cell>      <!--所属国家或地区-->
           <Cell order="8" name="数据日期">repFinprodName</Cell>      <!--合约名称-->
           <Cell order="9" name="数据日期">repVdate</Cell>            <!--起息日-->
           <Cell order="10" name="数据日期">repMdate</Cell>           <!--到期日-->
           <Cell order="11" name="数据日期">repPaperRate</Cell>       <!--票面利率%-->
           <Cell order="12" name="数据日期">repIntpayCycle</Cell>     <!--付息频率（个月/次）-->
           <Cell order="13" name="数据日期">repIncomeRatio</Cell>     <!--固定收益部分所占比例(%)-->
           <Cell order="14" name="数据日期">repDerInstrRatio</Cell>   <!--衍生金融工具所占比例(%)-->
           <Cell order="15" name="数据日期">repDerInstrInvType</Cell> <!--衍生金融工具具体投资方式-->
           <Cell order="16" name="数据日期">repDerInstrTarget</Cell>  <!--衍生金融工具挂钩的标的资产-->
           <Cell order="17" name="数据日期">repAcctMode</Cell>        <!--利息结算方式-->
           <Cell order="18" name="数据日期">repSpecialCmt</Cell>      <!--含权情况说明-->
           <Cell order="19" name="数据日期">repMaxYield</Cell>        <!--结构性票据最高收益率%-->
           <Cell order="20" name="数据日期">repMinYield</Cell>        <!--结构性票据最低收益率%-->
           <Cell order="21" name="数据日期">repBasicPrice</Cell>      <!--挂钩标的资产基准价格-->
           <Cell order="22" name="数据日期">repRegDatePrice</Cell>    <!--挂钩标的资产登记日价格-->
           <Cell order="23" name="数据日期">repTradeFee</Cell>        <!--交易费-->
  		</Row>
    </Worksheet>
</Workbook>