<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="RepAssetDeptRegist8.xlsx" name="资产要素登记">
    <Worksheet javaBean="com.joyintech.tams.invest.report.debtreport.repassetdeptregist.dto.RepAssetDeptRegistDto">
        <Row>
           <Cell order="1" name="数据日期">repStatusDate</Cell>     <!--数据日期-->
           <Cell order="2" name="数据日期">finprodMarketId</Cell>   <!--行内资产/负债编码-->
           <Cell order="3" name="数据日期">repIssuePartyId</Cell>   <!--发行机构代码-->
           <Cell order="4" name="数据日期">repAssetTypeStr</Cell>   <!--资产/负债类别-->
           <Cell order="5" name="数据日期">ccyStr</Cell>            <!--币种-->     
           <Cell order="6" name="数据日期">repTradeMarketStr</Cell> <!--交易流通场所--> 
           <Cell order="7" name="数据日期">repCountryArea</Cell>    <!--所属国家或地区-->
           <Cell order="8" name="数据日期">repFinprodName</Cell>    <!--债券名称-->
           <Cell order="9" name="数据日期">finprodMarketId</Cell>   <!--债券代码-->
           <Cell order="10" name="数据日期">repIssueParty</Cell>    <!--发行机构-->
           <Cell order="11" name="数据日期">repIndustry</Cell>      <!--发行机构所属行业-->
           <Cell order="12" name="数据日期">repVdate</Cell>         <!--起息日-->
           <Cell order="13" name="数据日期">repMdate</Cell>         <!--到期日-->
           <Cell order="14" name="数据日期">repTerm</Cell>          <!--期限（月）-->
           <Cell order="15" name="数据日期">repPartyGrade</Cell>    <!--发行机构主体信用评级-->
           <Cell order="16" name="数据日期">repSecGrade</Cell>      <!--债券信用评级-->
           <Cell order="17" name="数据日期">repPaperRate</Cell>     <!--票面利率%-->
           <Cell order="18" name="数据日期">repIntpayCycle</Cell>   <!--付息频率（个月/次）-->
           <Cell order="19" name="数据日期">repGuaranteeCmt</Cell>  <!--担保情况说明-->
           <Cell order="20" name="数据日期">repSpecialCmt</Cell>    <!--是否含权等特殊条款情况说明-->
  		</Row>
    </Worksheet>
</Workbook>