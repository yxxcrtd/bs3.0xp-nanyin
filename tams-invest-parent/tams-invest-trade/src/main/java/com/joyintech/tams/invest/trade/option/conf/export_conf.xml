<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdOptionTrade001.xlsx" name="期权交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.option.dto.TrdOptionTrade001Dto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="交易编号">totleTradeId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="交易方向">psText</Cell>
            <Cell order="5" name="合约类型">contractTypeText</Cell>
            <Cell order="6" name="合约标的">targetId</Cell>
            <Cell order="7" name="数量">amount</Cell>
            <Cell order="8" name="行权方式">exerciseTypeText</Cell>
            <Cell order="9" name="期限">term</Cell>
            <Cell order="10" name="交易日">tradeDateText</Cell>
            <Cell order="12" name="起息日">vdateText</Cell>
            <Cell order="13" name="到期日">mdateText</Cell>
            <Cell order="14" name="备注">remark</Cell>
