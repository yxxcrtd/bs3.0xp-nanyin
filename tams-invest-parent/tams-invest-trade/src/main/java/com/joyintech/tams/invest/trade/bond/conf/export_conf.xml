<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdBondInvestTrade001.xlsx" name="债券投资交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.bond.dto.TrdBondInvestTradeDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="业务编号">totleTradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="资产代码">finprodId</Cell>
            <Cell order="7" name="资产名称">finprodName</Cell>
            <Cell order="8" name="交易方向">psText</Cell>
            <Cell order="9" name="交易场所">tradeMarketText</Cell>
            <Cell order="10" name="交易市场">tradeMarketModeText</Cell>
            <Cell order="11" name="交易平台">tradePlatText</Cell>
            <Cell order="12" name="券面总额">tradeAmt</Cell>
            <Cell order="13" name="本方券券面总额">ownTradeAmt</Cell>
            <Cell order="14" name="融入券券面总额">integrateTradeAmt</Cell>
            <Cell order="15" name="币种">ccyText</Cell>
            <Cell order="16" name="偏离度">deviation</Cell>
            <Cell order="17" name="净价">unitCprice</Cell>
            <Cell order="18" name="交易日期">tradeDateText</Cell>
            <Cell order="19" name="交割日期">settleDateText</Cell>
            <Cell order="20" name="成交编号">fTradeId</Cell>
            <Cell order="21" name="处理状态">orderRetStatusStr</Cell>
            <Cell order="22" name="资产推荐方">assetRecommandOrg</Cell>
            <Cell order="23" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>