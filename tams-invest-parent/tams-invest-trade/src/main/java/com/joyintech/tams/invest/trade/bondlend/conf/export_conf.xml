<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdBondLendTrade001.xlsx" name="债券借贷投资交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.bondlend.dto.TrdBondLendInvestTradeDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="标的债券代码">finprodId</Cell>
            <Cell order="7" name="标的债券名称">finprodName</Cell>
            <Cell order="8" name="交易方向">psText</Cell>
            <Cell order="9" name="交易场所">tradeMarketText</Cell>
            <Cell order="10" name="券面总额">tradeAmt</Cell>
            <Cell order="14" name="交易日期">tradeDate</Cell>
            <Cell order="15" name="首次结算日">vdate</Cell>
            <Cell order="15" name="到期结算日">mdate</Cell>
            <Cell order="15" name="期限品种">termType</Cell>
            <Cell order="16" name="实际占券天数">actAmtDays</Cell>
            <Cell order="16" name="币种">ccyText</Cell>
            <Cell order="16" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>