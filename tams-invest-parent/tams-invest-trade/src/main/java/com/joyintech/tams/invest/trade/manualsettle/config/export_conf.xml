<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="ManualSettle001.xlsx" name="手工交收">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.manualsettle.dto.ManualSettleDto">
        <Row>
            <Cell order="1" name="交收状态">settleStatusStr</Cell>
            <Cell order="2" name="指令序号">orderId</Cell>
            <Cell order="3" name="原业务编号">tradeId</Cell>
            <Cell order="4" name="交易日期">tradeDate</Cell>
            <Cell order="5" name="交收日期">settleDate</Cell>
            <Cell order="6" name="组合代码">portfolioId</Cell>
            <Cell order="7" name="组合名称">portfolioName</Cell>
            <Cell order="8" name="资金账户">acctNo</Cell>
            <Cell order="9" name="证券账户">secAcctId</Cell>
            <Cell order="10" name="交易市场">tradeMarketStr</Cell>
            <Cell order="11" name="交易平台">tradePlatStr</Cell>
            <Cell order="12" name="资产代码">finprodMarketId</Cell>
            <Cell order="13" name="资产名称">finprodName</Cell>
            <Cell order="14" name="交割数量">settleNum</Cell>
            <Cell order="15" name="交割金额">settleAmt</Cell>
            <Cell order="16" name="业务类别">busiTypeStr</Cell>
            <Cell order="17" name="交易对手">counterId</Cell>
        </Row>
    </Worksheet>
</Workbook>