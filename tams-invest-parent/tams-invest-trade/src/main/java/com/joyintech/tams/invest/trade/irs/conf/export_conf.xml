<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdIRSTrade.xlsx" name="利率互换交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.irs.dto.TrdIRSTradeDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusStr</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="交易日期">tradeDateStr</Cell>
            <Cell order="7" name="互换方式">irsTypeStr</Cell>
            <Cell order="8" name="起息日">vdateStr</Cell>
            <Cell order="9" name="到期日">mdateStr</Cell>
            <Cell order="10" name="期限(天)">term</Cell>
            <Cell order="11" name="名义本金币种">ccyStr</Cell>
            <Cell order="12" name="名义本金(万元)">prin</Cell>
            <Cell order="13" name="固定利率(%)">yield</Cell>
            <Cell order="14" name="固定利率付息频率">fixPayCycleStr</Cell>
            <Cell order="15" name="固定利率首期起息日">firstPayDateRStr</Cell>
            <Cell order="16" name="挂钩利率">intTypeStr</Cell>
            <Cell order="17" name="利差(BP)">spreadRate</Cell>
            <Cell order="18" name="浮动利率付息频率">floatPayCycleStr</Cell>
            <Cell order="19" name="浮动利率首期起息日">firstPayDateFStr</Cell>
            <Cell order="20" name="交易对手">counterId</Cell>
            <Cell order="21" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>