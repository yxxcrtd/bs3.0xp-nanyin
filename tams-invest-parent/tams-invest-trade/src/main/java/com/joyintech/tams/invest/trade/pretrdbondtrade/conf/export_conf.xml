<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="PreTrdBondInvestTrade001.xlsx" name="债券交易预录入">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.pretrdbondtrade.dto.PreTrdBondInvestTrade001Dto">
        <Row>
            <Cell order="1"  name="有效状态">validStatusText</Cell>
            <Cell order="2"  name="交易日期">tradeDateText</Cell>
            <Cell order="3"  name="对手方">counterId</Cell>
            <Cell order="4"  name="对手方交易员 ">counterTrader</Cell>
            <Cell order="5"  name="交易方向">ps</Cell>
            <Cell order="6"  name="资产代码">finprodId</Cell>
            <Cell order="7"  name="债券名称">finprodName</Cell>
            <Cell order="8"  name="净价(元)">unitCprice</Cell>
            <Cell order="9"  name="到期收益率(%)">yield</Cell>
            <Cell order="10" name="行权收益率(%)">exerYield</Cell>
            <Cell order="11" name="全面总额(万元)">shareAmt</Cell>
            <Cell order="12" name="清算速度">settleSpeedText</Cell>
            <Cell order="13" name="结算方式">deliveryType</Cell>
            <Cell order="14" name="清算类型">clearType</Cell>
            <Cell order="15" name="有效时间">effTimeText</Cell>
            <Cell order="16" name="补充条款">remark</Cell>
            <Cell order="17" name="资金开户行名称">acctBankDep</Cell>
            <Cell order="18" name="资金账户户名">acctName</Cell>
            <Cell order="19" name="资金账号">acctNo</Cell>
            <Cell order="20" name="支付系统行号">acctBankDepoPayno</Cell>
            <Cell order="21" name="托管账户户名">secAcctName</Cell>
            <Cell order="22" name="托管机构名称">registOrg</Cell>
            <Cell order="23" name="托管账号">secAcctId</Cell>
            <Cell order="24" name="应计利息">unitInt</Cell>
            <Cell order="25" name="结算币种">ccy</Cell>
        </Row>
    </Worksheet>
</Workbook>