<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdConBond001.xlsx" name="可转债投资交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.conbond.dto.TrdConBondDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusStr</Cell>
            <Cell order="2" name="业务编号">busiCode</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合名称">portfolioName</Cell>
            <Cell order="5" name="资产代码">finprodId</Cell>
            <Cell order="6" name="资产名称">finprodName</Cell>
            <Cell order="7" name="交易方向">psStr</Cell>
            <Cell order="8" name="申购券面总额">prinAmt</Cell>
            <Cell order="9" name="中签券面总额">winlotteryAmt</Cell>
            <Cell order="10" name="申购日期">purchDate</Cell>
            <Cell order="11" name="确认日期">tradeDate</Cell>
            <Cell order="12" name="缴款日期">settleDate</Cell>
            <Cell order="13" name="申购方式">purchModleStr</Cell>
            <Cell order="14" name="申购类型">purchTypeStr</Cell>
            <Cell order="15" name="交易场所">tradeMarketStr</Cell>
            <Cell order="16" name="币种">ccyStr</Cell>
            <Cell order="17" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>