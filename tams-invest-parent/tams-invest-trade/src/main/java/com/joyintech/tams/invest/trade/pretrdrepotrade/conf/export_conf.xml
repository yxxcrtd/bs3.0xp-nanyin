<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="PreTrdRepoTrade001.xlsx" name="质押式回购交易预录入">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.pretrdrepotrade.dto.PreTrdRepoTrade001Dto">
        <Row>
            <Cell order="1"  name="有效状态">validStatusText</Cell>
            <Cell order="2"  name="交易日期">tradeDateText</Cell>
            <Cell order="3"  name="对手方">counterId</Cell>
            <Cell order="4"  name="对手方交易员 ">counterTrader</Cell>
            <Cell order="5"  name="交易方向">psText</Cell>
            <Cell order="6"  name="交易金额(元)">tradeAmt</Cell>
            <Cell order="7"  name="回购利率(%)">rate</Cell>
            <Cell order="8"  name="回购期限(天)">repoTerm</Cell>
            <Cell order="9"  name="清算速度">settleSpeedStr</Cell>
            <Cell order="10" name="首次结算方式 ">deliveryTypeText</Cell>
            <Cell order="11" name="到期结算方式">mDeliveryTypeText</Cell>
            <Cell order="12" name="清算类型">clearTypeText</Cell>
            <Cell order="13" name="有效时间">effTimeText</Cell>
            <Cell order="14" name="补充条款">remark</Cell>
            <Cell order="15" name="资金开户行">acctBankDep</Cell>
            <Cell order="16" name="账户">acctNo</Cell>
            <Cell order="17" name="账户名">acctName</Cell>
            <Cell order="18" name="资金开户行支付系统行号">acctBankDepoPayno</Cell>
            <Cell order="19" name="托管机构名称">registOrgStr</Cell>
            <Cell order="20" name="托管账号">secAcctId</Cell>
            <Cell order="21" name="托管账户户名">secAcctName</Cell>
            <Cell order="22" name="债券币种">bondCcy</Cell>
            <Cell order="23" name="结算币种">settleCcy</Cell>
            <Cell order="24" name="组合名称">portfolioName</Cell>
            <Cell order="25" name="债券代码">finprodMarketId</Cell>
            <Cell order="26" name="债券名称">finprodAbbr</Cell>
            <Cell order="27" name="券面总额(万元)">pledgeAmt</Cell>
            <Cell order="28" name="折算比例(%)">pledgeRatio</Cell>
        </Row>
    </Worksheet>
</Workbook>