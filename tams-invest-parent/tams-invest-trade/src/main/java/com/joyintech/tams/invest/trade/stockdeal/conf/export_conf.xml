<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdStock001.xlsx" name="股票交易">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.stockdeal.dto.TrdStockDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="资产代码">finprodId</Cell>
            <Cell order="7" name="资产名称">finprodAbbr</Cell>
            <Cell order="8" name="交易方向">psStr</Cell>
            <Cell order="9" name="交易场所">tradeMarketStr</Cell>
            <Cell order="10" name="交易方式">dealModeStr</Cell>
            <Cell order="11" name="上市板">boardStr</Cell>
            <Cell order="12" name="交易日期">tradeDateStr</Cell>
            <Cell order="13" name="交易价格">unitCprice</Cell>
            <Cell order="15" name="交易数量">shareAmt</Cell>
            <Cell order="15" name="交易金额">tradeAmt</Cell>
            <Cell order="16" name="币种">ccyStr</Cell>
            <Cell order="17" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>