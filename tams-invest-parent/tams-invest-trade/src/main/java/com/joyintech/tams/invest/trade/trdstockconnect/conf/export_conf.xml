<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdStockConnect001.xlsx" name="港股通交易">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.trdstockconnect.dto.TrdStockConnectDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="指令编号">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="资产代码">finprodId</Cell>
            <Cell order="7" name="资产名称">finprodAbbr</Cell>
            <Cell order="8" name="交易方向">psStr</Cell>
            <Cell order="9" name="港股通市场">hkMarketStr</Cell>
            <Cell order="10" name="交易日期">tradeDateStr</Cell>
            <Cell order="11" name="交易价格（港元）">unitCprice</Cell>
            <Cell order="12" name="交易数量（股）">shareAmt</Cell>
            <Cell order="13" name="成交金额（港元）">dealAmt</Cell>
            <Cell order="14" name="交易金额（元）">tradeAmt</Cell>
            <Cell order="15" name="佣金（元）">commission</Cell>
            <Cell order="16" name="印花税（港元）">stampDuty</Cell>
            <Cell order="17" name="交易征费（港元）">transactionLevy</Cell>
            <Cell order="18" name="交易费（港元）">transactionFee</Cell>
            <Cell order="19" name="交易系统使用费（港元）">transactionSystemFee</Cell>
            <Cell order="20" name="股份交收费（港元）">sharePaymentFee</Cell>
            <Cell order="21" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>