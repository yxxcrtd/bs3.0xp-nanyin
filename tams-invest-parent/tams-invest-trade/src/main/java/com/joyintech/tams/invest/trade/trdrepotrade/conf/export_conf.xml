<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdRepoTrade001.xlsx" name="回购投资交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.trdrepotrade.dto.TrdRepoTrade001Dto">
        <Row>
            <Cell order="1" name="有效状态">validStatusText</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="交易场所">tradeMarket</Cell>
            <Cell order="7" name="质押券">bondName</Cell>
            <Cell order="8" name="回购类型">repoTypeText</Cell>
            <Cell order="9" name="期限品种">termTypeReback</Cell>
            <Cell order="10" name="交易方向">psText</Cell>
            <Cell order="11" name="交易日期">tradeDateText</Cell>
            <Cell order="12" name="交易金额">prinAmt</Cell>
            <Cell order="13" name="币种">ccyText</Cell>
            <Cell order="14" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>