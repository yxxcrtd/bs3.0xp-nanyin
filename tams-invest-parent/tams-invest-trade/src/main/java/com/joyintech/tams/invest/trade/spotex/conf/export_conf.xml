<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdSpotexInvestTrade001.xlsx" name="外汇即期交易">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.spotex.dto.TrdSpotexInvestTradeDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusName</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="交易类型">excDealTypeName</Cell>
            <Cell order="7" name="货币对">curPairName</Cell>
            <Cell order="8" name="交易方向">psName</Cell>
            <Cell order="9" name="交易日期">tradeDateText</Cell>
            <Cell order="10" name="清算速度">settleSpeedName</Cell>
            <Cell order="11" name="交割日">settleDateText</Cell>
            <Cell order="12" name="即期汇率">unitCprice</Cell>
            <Cell order="13" name="交易货币">dealCurName</Cell>
            <Cell order="14" name="交易货币金额">prinAmt</Cell>
            <Cell order="15" name="对应货币">ccyName</Cell>
            <Cell order="16" name="对应货币金额">tradeAmt</Cell>
            <Cell order="17" name="折美元金额">usdAmt</Cell>
            <Cell order="18" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>