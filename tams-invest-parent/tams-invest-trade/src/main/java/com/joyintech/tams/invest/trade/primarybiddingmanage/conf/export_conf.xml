<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="PrimaryBiddingManage.xlsx" name="债券一级投标">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.primarybiddingmanage.dto.PrimaryBiddingManageDto">
        <Row>
            <Cell order="1" name="投标编号">bidId</Cell>
            <Cell order="2" name="有效状态">validStatusText</Cell>
            <Cell order="3" name="确认状态">tenderconfirmstatusText</Cell>
            <Cell order="4" name="截标状态">bidCloseStatusText</Cell>
            <Cell order="5" name="资产代码">finprodId</Cell>
            <Cell order="6" name="资产简称">finprodAbbr</Cell>
            <Cell order="7" name="投标日">biddate</Cell>
            <Cell order="8" name="汇总投标券面总额">allBidPrinAmt</Cell>
            <Cell order="9" name="投标标位">bidpriceStr</Cell>
            <Cell order="10" name="交易对手">counterIdText</Cell>
        </Row>
    </Worksheet>
</Workbook>