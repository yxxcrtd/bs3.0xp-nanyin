<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="TrdForwexInvestTrade.xlsx" name="外汇远期投资交易信息一览">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.forwex.dto.TrdForwexInvestTradeDto">
        <Row>
            <Cell order="1" name="有效状态">validStatusStr</Cell>
            <Cell order="2" name="业务编号">tradeId</Cell>
            <Cell order="3" name="委托代码">entrustId</Cell>
            <Cell order="4" name="组合代码">portfolioId</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="交易类型">excDealTypeStr</Cell>
            <Cell order="7" name="货币对">curPair</Cell>
            <Cell order="8" name="交易方向">psStr</Cell>
            <Cell order="9" name="清算模式">deliveryTypeStr</Cell>
            <Cell order="10" name="交易日期">tradeDateStr</Cell>
            <Cell order="11" name="期限">termTypeStr</Cell>
            <Cell order="12" name="交割日">settleDateStr</Cell>
            <Cell order="13" name="即期汇率">unitCprice</Cell>
            <Cell order="14" name="远期点">unitInt</Cell>
            <Cell order="15" name="远期全价">unitFprice</Cell>
            <Cell order="16" name="定价日">pricedDateStr</Cell>
            <Cell order="17" name="定价日即期汇率">pricedDateRate</Cell>
            <Cell order="18" name="差额收付方向">difPsStr</Cell>
            <Cell order="19" name="差额收付金额">difPayAmt</Cell>
            <Cell order="20" name="交易货币">ccyStr</Cell>
            <Cell order="21" name="交易货币金额">prinAmt</Cell>
            <Cell order="22" name="对应货币">corCcyStr</Cell>
            <Cell order="23" name="对应货币金额">fpriceAmt</Cell>
            <Cell order="24" name="折美元金额">usdAmt</Cell>
            <Cell order="25" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>