<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="CSTPSelect001.xlsx" name="CSTP下行交易查询">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.cstp.dto.CstpSelectDto">
        <Row>
        	<Cell order="1" name="匹配状态">matchStatusStr</Cell>
            <Cell order="2" name="成交编号">execid</Cell>
            <Cell order="3" name="资产类型">businesstypeStr</Cell>
            <Cell order="4" name="资产代码">securityid</Cell>
            <Cell order="5" name="资产名称">symbol</Cell>
            <Cell order="6" name="交易方向">psStr</Cell>
            <Cell order="7" name="交易场所">marketStr</Cell>
            <Cell order="8" name="券面总额合计">lastqty</Cell>
            <Cell order="9" name="回购利率%/净价">price</Cell>
            <Cell order="10" name="全价">dirtyprice</Cell>
            <Cell order="11" name="到期收益率%">underlyingyield2</Cell>
            <Cell order="12" name="行权收益率%">strikeyield</Cell>
            <Cell order="13" name="成交日期">tradeDateStr</Cell>
            <Cell order="14" name="清算速度">settleSpeedStr</Cell>
            <Cell order="15" name="应计利息">accruedinterestamt</Cell>
            <Cell order="16" name="应计利息总额">accruedinteresttotalamt</Cell>
            <Cell order="17" name="交易金额">tradecashamt</Cell>
            <Cell order="18" name="到期结算金额">settlcurramt2</Cell>
            <Cell order="19" name="回购期限">tradelimitdays</Cell>
            <Cell order="20" name="实际占款天数">cashholdingdays</Cell>
            <Cell order="21" name="已匹配额度">lastqtyready</Cell>
            <Cell order="22" name="证券账户">ourdepositaccountname</Cell>
            <Cell order="23" name="交易员">ourTradeName</Cell>
            <Cell order="24" name="匹配度">dealPercent</Cell>
        </Row>
    </Worksheet>
</Workbook>