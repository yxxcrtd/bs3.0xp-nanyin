<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrFund002.xlsx" name="基金委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrfund.dto.EtrFundDto">
        <Row>
            <Cell order="1" name="状态">entrustStatusStr</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="资产二级类型">assetType1Name</Cell>
            <Cell order="5" name="资产三级类型">assetType10Name</Cell>
          <!--   <Cell order="6" name="资产四级类型">assetType11Name</Cell> -->
            <Cell order="6" name="市场代码">finprodMarketId</Cell>
            <Cell order="7" name="资产名称">finprodName</Cell>
            <Cell order="8" name="交易方向">psStr</Cell>
            <Cell order="9" name="币种">ccyStr</Cell>
            <Cell order="10" name="委托开始日">vdateStr</Cell>
            <Cell order="11" name="委托结束日">mdateStr</Cell>
            <Cell order="12" name="委托金额/委托份额">entrustAmtOrNumStr</Cell>
            <!-- <Cell order="12" name="委托金额">entrustNumStr</Cell> -->
            <!--<Cell order="13" name="委托份额">entrustNumStr</Cell>-->
            <Cell order="14" name="已完成额度">finishAmt</Cell>
            <Cell order="15" name="交易完成度">transactioncom</Cell>
        </Row>
    </Worksheet>
</Workbook>