<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrWtFxswap.xlsx" name="外汇掉期委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrwtfxswap.dto.EtrWtFxswapDto">
        <Row>
            <Cell order="1" name="有效状态">busEntrustStatus</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="交易类型">busTradeType</Cell>
            <Cell order="5" name="货币对">busCcyPair</Cell>
            <Cell order="6" name="交易方向">busTradePs</Cell>
            <Cell order="7" name="委托开始日">vdateStr</Cell>
            <Cell order="8" name="委托截止日">mdateStr</Cell>
            <Cell order="9" name="期限类型">busTermType</Cell>
            <Cell order="10" name="近端交割日">proximalDeliveryDate</Cell>
            <Cell order="11" name="远端交割日">remoteDeliveryDate</Cell>
            <Cell order="12" name="掉期点">swapsPoint</Cell>
            <Cell order="13" name="交易货币">busTradeCcy</Cell>
            <Cell order="14" name="交易货币金额">tradeAmt</Cell>
            <Cell order="15" name="对应货币">busContraCcy</Cell>
            <Cell order="16" name="已完成金额">completeAmt</Cell>
            <Cell order="17" name="交易完成度(%)">tradePercent</Cell>
            <Cell order="18" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>