<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrTransactionDetail001.xlsx" name="指令查询">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrtransactiondetail.dto.EtrTransactionDetailDto">
        <Row>
            <Cell order="1" name="指令代码">entrustId</Cell>
            <Cell order="2" name="成交编号">fTradeId</Cell>
            <Cell order="3" name="组合代码">portfolioId</Cell>
            <Cell order="4" name="组合名称">portfolioName</Cell>
            <Cell order="5" name="交易日期">tradeDate</Cell>
            <Cell order="6" name="资产类型">assetTypeStr</Cell>
            <Cell order="7" name="资产代码">finprodMarketId</Cell>
            <Cell order="8" name="资产名称">finprodName</Cell>
            <Cell order="9" name="资产简称">finprodAbbr</Cell>
            <Cell order="10" name="期限品种">termVriety</Cell>
            <Cell order="11" name="交易方向">psStr</Cell>
            <Cell order="12" name="券面总额">bondTotalFace</Cell>
            <Cell order="13" name="净价">unitCprice</Cell>
            <Cell order="14" name="全价">unitFprice</Cell>
            <Cell order="15" name="全价总额">fpriceAmt</Cell>
            <Cell order="16" name="交易金额">tradeAmt</Cell>
            <Cell order="17" name="交易份额">shareAmt</Cell>
            <Cell order="18" name="交易数量">tradeNum</Cell>
            <Cell order="19" name="交易价格">tradePrice</Cell>
            <Cell order="20" name="回购利率（%）">backRate</Cell>
            <Cell order="21" name="质押券代码">repSecId</Cell>
            <Cell order="22" name="质押券名称">repSecName</Cell>
            <Cell order="23" name="质押券数量">repSecNum</Cell>
            <Cell order="24" name="回购期限">term</Cell>
            <Cell order="25" name="首次结算日">vPayDate</Cell>
            <Cell order="26" name="到期结算日">mPayDate</Cell>
            <Cell order="27" name="原质押券代码">origRepSecId</Cell>
        </Row>
    </Worksheet>
</Workbook>