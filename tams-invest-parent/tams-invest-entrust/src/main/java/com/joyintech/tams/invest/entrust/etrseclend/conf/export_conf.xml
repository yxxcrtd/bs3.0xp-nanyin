<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrSecLend.xlsx" name="债券投资委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrseclend.dto.EtrSecLendDto">
        <Row>
            <Cell order="1" name="有效状态">busEntrustStatus</Cell>
            <Cell order="2" name="投资经理">invManagerId</Cell>
            <Cell order="3" name="组合代码">portfolioId</Cell>
            <Cell order="4" name="组合名称">portfolioName</Cell>
            <Cell order="5" name="标的债券代码">targetFinprodId</Cell>
            <Cell order="6" name="借贷方向">busBusiPs</Cell>
            <Cell order="7" name="交易场所">busTradeMarket</Cell>
            <Cell order="8" name="券面总额(万元)">totalAmt</Cell>
            <Cell order="9" name="币种">busCcy</Cell>
            <Cell order="10" name="委托开始日">vdate</Cell>
            <Cell order="11" name="委托结束日">mdate</Cell>
            <Cell order="12" name="已完成额度">finishAmt</Cell>
            <Cell order="13" name="交易完成度">transactioncom</Cell>
            <Cell order="14" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>