<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrOption.xlsx" name="期权投资委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etroption.dto.EtrOptionDto">
        <Row>
           <Cell order="1" name="有效状态">entrustStatusStr</Cell>
            <Cell order="2" name="投资经理">invManagerId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="交易方向">psStr</Cell>
            <Cell order="6" name="合约标的">assetType10Str</Cell>
            <Cell order="7" name="合约类型">assetType11Str</Cell>
            <Cell order="8" name="数量">entrustNum</Cell>
            <Cell order="9" name="期限">termDaysStr</Cell>
            <Cell order="10" name="委托开始日">vdateStr</Cell>
            <Cell order="11" name="委托终止日">mdateStr</Cell>
            <Cell order="12" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>