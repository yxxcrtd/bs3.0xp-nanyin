<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrWtSpotex001.xlsx" name="外汇即期委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrwtspotex.dto.EtrWtSpotexDto">
        <Row>
            <Cell order="1" name="有效状态">entrustStatusStr</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="交易类型">excDealTypeStr</Cell>
            <Cell order="5" name="货币对">curPairName</Cell>
            <Cell order="6" name="交易方向">psStr</Cell>
            <Cell order="7" name="委托开始日">vdateStr</Cell>
            <Cell order="8" name="委托截止日">mdateStr</Cell>
            <Cell order="9" name="清算速度">settleSpreedStr</Cell>
            <Cell order="10" name="即期汇率">price</Cell>
            <Cell order="11" name="交易货币">ccyName</Cell>
            <Cell order="12" name="交易货币金额">entrustAmt</Cell>
            <Cell order="11" name="对应货币">corCcyName</Cell>
            <Cell order="12" name="预计对应货币金额">expCorAmt</Cell>
            <Cell order="13" name="已完成额度">finishAmt</Cell>
            <Cell order="14" name="交易完成度（%）">tradeFinishAmt</Cell>
            <Cell order="15" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>