<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrStock.xlsx" name="股票委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrstock.dto.EtrStockDto">
        <Row>
            <Cell order="1" name="委托状态">busEntrustStatus</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="资产代码">finprodMarketId</Cell>
            <Cell order="5" name="资产名称">finprodName</Cell>
            <Cell order="6" name="交易方向">busPs</Cell>
            <Cell order="7" name="交易场所">busTradeMarket</Cell>
            <Cell order="8" name="交易方式">busDealMode</Cell>
            <Cell order="9" name="上市板">busBoard</Cell>
            <Cell order="10" name="币种">busCcy</Cell>
            <Cell order="11" name="委托开始日">vdate</Cell>
            <Cell order="12" name="委托结束日">mdate</Cell>
            <Cell order="13" name="委托数量">busEntrustNum</Cell>
            <Cell order="14" name="委托价格">price</Cell>
            <Cell order="15" name="已完成额度">finishAmt</Cell>
            <Cell order="16" name="交易完成度">transactioncom</Cell>
        </Row>
    </Worksheet>
</Workbook>