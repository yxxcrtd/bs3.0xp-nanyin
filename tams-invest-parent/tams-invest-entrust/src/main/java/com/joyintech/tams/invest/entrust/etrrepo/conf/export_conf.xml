<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrRepo.xlsx" name="买断式回购投资委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrrepo.dto.EtrRepoDto">
        <Row>
            <Cell order="1" name="委托状态">busEntrustStatus</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="回购类型">busAssetType1</Cell>
            <Cell order="5" name="期限品种">busTermType</Cell>
            <Cell order="6" name="交易方向">busPs</Cell>
            <Cell order="7" name="回购利率(%)">price</Cell>
            <Cell order="8" name="币种">busCcy</Cell>
            <Cell order="9" name="委托开始日">vdateText</Cell>
            <Cell order="10" name="委托结束日">mdateText</Cell>
            <Cell order="11" name="委托金额">entrustAmt</Cell>
            <Cell order="12" name="已完成额度">finishAmt</Cell>
            <Cell order="13" name="交易完成度">transactioncom</Cell>
            <!-- add by zhangpuyu 2019/11/15 start-->
            <Cell order="14" name="价格模式">priceModelStr</Cell>
            <!-- add by zhangpuyu 2019/11/15 end-->
        </Row>
    </Worksheet>
</Workbook>