        <Row>
            <Cell order="1" name="有效状态">entrustStatusStr</Cell>
            <Cell order="2" name="投资经理">invManagerId</Cell>
            <Cell order="3" name="组合代码">portfolioId</Cell>
            <Cell order="4" name="组合名称">portfolioName</Cell>
            <Cell order="5" name="到期日">dueDate</Cell>
            <Cell order="6" name="期限">termTypeStr</Cell>
            <Cell order="7" name="名义本金币种">ccyStr</Cell>
