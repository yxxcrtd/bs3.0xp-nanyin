            <Cell order="11" name="固定利率%">matureYield</Cell>
            <Cell order="12" name="委托开始日">vdateStr</Cell>
            <Cell order="13" name="委托截止日">mdateStr</Cell>
            <Cell order="14" name="已完成额度">finishAmt</Cell>
