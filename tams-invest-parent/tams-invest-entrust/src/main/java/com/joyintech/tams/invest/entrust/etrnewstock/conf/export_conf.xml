<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrNewStock.xlsx" name="新股申购">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrnewstock.dto.EtrNewStockDto">
        <Row>
            <Cell order="1" name="有效状态">busEntrustStatus</Cell>
            <Cell order="2" name="投资经理">invManagerId</Cell>
            <Cell order="3" name="组合代码">portfolioId</Cell>
            <Cell order="4" name="组合名称">portfolioName</Cell>
            <Cell order="5" name="资产代码">finprodMarketId</Cell>
            <Cell order="6" name="资产名称">finprodAbbr</Cell>
            <Cell order="7" name="指令日期">entrustDate</Cell>
            <Cell order="8" name="申购方式">purchModle</Cell>
            <Cell order="9" name="申购数量">entrustNum</Cell>
            <Cell order="10" name="申购价格">price</Cell>
            <Cell order="11" name="申购金额">entrustAmt</Cell>
            <Cell order="12" name="币种">busCcy</Cell>
            <Cell order="13" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>