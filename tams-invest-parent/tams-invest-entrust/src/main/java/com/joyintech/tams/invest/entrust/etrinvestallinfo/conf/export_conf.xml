<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrInvestAllInfo.xlsx" name="委托查询">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrinvestallinfo.dto.EtrInvestAllInfoDto">
        <Row>
            <Cell order="1" name="委托状态">entrustStatusStr</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="资产类型">assetTypeStr</Cell>
            <Cell order="5" name="资产代码">finprodMarketId</Cell>
            <Cell order="6" name="资产名称">finprodName</Cell>
            <Cell order="7" name="交易方向">psStr</Cell>
            <Cell order="8" name="交易场所">tradeMarketStr</Cell>
            <Cell order="9" name="清算速度">tradePlatStr</Cell>
            <Cell order="10" name="券面总额/委托金额">entrustAmtStr</Cell>
            <Cell order="11" name="币种">ccyStr</Cell>
            <Cell order="12" name="委托开始日">vdate</Cell>
            <Cell order="13" name="委托结束日">mdate</Cell>
            <Cell order="14" name="投资经理">invManagerId</Cell>
            <Cell order="15" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>