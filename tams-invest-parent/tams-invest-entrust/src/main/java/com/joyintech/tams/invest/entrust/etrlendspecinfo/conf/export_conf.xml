<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrLendSpecInfo.xlsx" name="拆借投资委托">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrlendspecinfo.dto.EtrLendSpecInfoDto">
        <Row>
            <Cell order="1" name="委托状态">entrustStatusStr</Cell>
            <Cell order="2" name="组合代码">portfolioId</Cell>
            <Cell order="3" name="组合名称">portfolioName</Cell>
            <Cell order="4" name="拆借类型">type6Str</Cell>
            <!--新增投资经理 yzg 20190904 start  -->
            <Cell order="5" name="投资经理">invManagerId</Cell>
            <!--新增投资经理 yzg 20190904 end  -->
            <Cell order="6" name="交易方向">psStr</Cell>
            <Cell order="7" name="期限">termDaysStr</Cell>
            <Cell order="8" name="利率">price</Cell>
            <Cell order="9" name="币种">ccyStr</Cell>
            <Cell order="10" name="委托开始日">vdateStr</Cell>
            <Cell order="11" name="委托结束日">mdateStr</Cell>
            <Cell order="12" name="委托金额">entrustAmt</Cell>
            <Cell order="13" name="已完成额度">finishAmt</Cell>
            <Cell order="14" name="交易完成度">transactioncom</Cell>
            <Cell order="15" name="备注">remark</Cell>
        </Row>
    </Worksheet>
</Workbook>