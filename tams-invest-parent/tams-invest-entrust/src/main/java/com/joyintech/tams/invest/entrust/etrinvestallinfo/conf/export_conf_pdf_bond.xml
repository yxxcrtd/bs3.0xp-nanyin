<?xml version="1.0" encoding="UTF-8"?>
<WorkPage size="6" name="债券交易审批表">
    <Table type="2" span="6" fontSize="8" padding="5" vertical="5" horizontal="1">
        <Row padding="5" vertical="5" horizontal="1">
            <Cell order="1" colspan="6" name="审批事项">审批事项</Cell>
        </Row>
        <Row fontSize="8" padding="5" vertical="5" horizontal="1">
            <Cell order="1" name="交易日期">entrustDateStr</Cell>
            <Cell order="2" name="债券代码">finprodMarketId</Cell>
            <Cell order="3" name="债券简称">finprodAbbr</Cell>
            <Cell order="4" name="卖出方">saler</Cell>
            <Cell order="5" name="买入方">buyer</Cell>
            <Cell order="6" name="交易面额(万元)">entrustNum</Cell>
            <Cell order="7" name="交易净价(元)">price</Cell>
            <Cell order="8" name="估值净价(元)">valuePrice</Cell>
            <Cell order="9" name="价格偏离度">deviation</Cell>
            <Cell order="10" name="备注">remark</Cell>
            <Cell order="11" borderSide="15,15" horizontal="1,2"  type="2" name="业务经办意见">jbyj,jbrq</Cell>
            <Cell order="12" borderSide="15,15" horizontal="1,2"  type="2" name="业务复核意见">fhyj,fhrq</Cell>
            <Cell order="13" borderSide="15,15" horizontal="1,2"  type="2" name="风控意见">fkyj,fkrq</Cell>
            <Cell order="14" borderSide="15,15" horizontal="1,2"  type="2" name="分管负责人意见">fgyj,fgrq</Cell>
            <Cell order="15" borderSide="15,15" horizontal="1,2"  type="2" name="资产管理部负责人意见">zgyj,zgrq</Cell>
        </Row>
    </Table>
</WorkPage>

