<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="EtrExchangeTrade003.xlsx" name="场内交易指令管理">
    <Worksheet javaBean="com.joyintech.tams.invest.entrust.etrexchangetrade.dto.EtrExchangeTrade003Dto">
        <Row>
            <Cell order="1" name="指令编号">entrustId</Cell>
            <Cell order="2" name="指令状态">entrustStatusString</Cell>
            <Cell order="3" name="执行进度">implementPercentAge</Cell>
            <Cell order="4" name="成交进度">dealPercentAge</Cell>
            <Cell order="5" name="组合名称">portfolioName</Cell>
            <Cell order="6" name="资金账号名称">dealCurAcctName</Cell>
            <Cell order="7" name="证券账户代码">secAcctId</Cell>
            <Cell order="8" name="证券账户名称">secAcctName</Cell>
            <Cell order="9" name="资产名称">finprodAbbr</Cell>
            <Cell order="10" name="资产类型">assetTypeString</Cell>
            <Cell order="11" name="市场">tradeMarketString</Cell>
            <Cell order="12" name="交易平台">tradePlatString</Cell>
            <Cell order="13" name="委托方向">psStr</Cell>
            <Cell order="14" name="价格模式">priceModelString</Cell>
            <Cell order="15" name="指令价格">price</Cell>
            <Cell order="16" name="指令金额">entrustAmt</Cell>
            <Cell order="17" name="开始日期">vdate</Cell>
            <Cell order="18" name="结束日期">mdate</Cell>
        </Row>
    </Worksheet>
</Workbook>