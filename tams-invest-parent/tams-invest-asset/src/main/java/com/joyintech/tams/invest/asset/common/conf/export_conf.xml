<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="FinStageManagement.xlsx" name="期次管理信息">
    <Worksheet javaBean="com.joyintech.tams.invest.asset.common.dto.FinStageManagementDto">
        <Row>
            <Cell order="1" name="资产代码">finprodMarketId</Cell>
            <Cell order="2" name="资产名称">finprodName</Cell>
            <Cell order="3" name="期次">period</Cell>
            <Cell order="4" name="起息日">vdateStr</Cell>
            <Cell order="5" name="到期日">mdateStr</Cell>
            <Cell order="6" name="融资金额">issueAmt</Cell>
            <Cell order="7" name="借款利率（%）">loadRate</Cell>
            <Cell order="8" name="净投资收益率（%）">investRate</Cell>
            <Cell order="9" name="买断利率（%）">buyoutRate</Cell>
            <Cell order="10" name="资产推荐费率（%）">referRate</Cell>
        </Row>
    </Worksheet>
</Workbook>