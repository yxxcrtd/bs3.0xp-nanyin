<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="FinStockSubjectC.xlsx" name="股票标的信息">
    <Worksheet javaBean="com.joyintech.tams.invest.asset.stock.dto.FinStockInfoDto">
        <Row>
            <Cell order="1" name="资产代码">finprodMarketId</Cell>
            <Cell order="2" name="资产名称">finprodAbbr</Cell>
            <Cell order="3" name="交易场所">tradeMarketAbbr</Cell>
            <Cell order="4" name="上市板">boardName</Cell>
            <Cell order="5" name="公司名称">customerName</Cell>
            <Cell order="6" name="上市时间">vdate</Cell>
            <Cell order="7" name="总股本">sShares</Cell>
            <Cell order="8" name="流通股本">cShares</Cell>
            <Cell order="9" name="是否沪港通或深港通">shOrZhName</Cell>
            <Cell order="10" name="是否融资融券标的">isMarginFinprodName</Cell>
            <Cell order="11" name="币种">ccyAbbr</Cell>
        </Row>
    </Worksheet>
</Workbook>