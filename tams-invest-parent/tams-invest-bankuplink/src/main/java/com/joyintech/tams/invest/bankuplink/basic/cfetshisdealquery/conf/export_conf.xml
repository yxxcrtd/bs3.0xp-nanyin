<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="CfetsHisDealQuery001.xlsx" name="质押式回购历史报价查询">
    <Worksheet javaBean="com.joyintech.tams.invest.bankuplink.repo.dto.RepoQuoteInfoDto">
        <Row>
            <Cell order="1" name="交易日期">quoteDate</Cell>
            <Cell order="2" name="本方角色">quoteRoleTypeStr</Cell>
            <Cell order="3" name="本方方向">repoPsStr</Cell>
            <Cell order="4" name="报价类型">quoteTypeStr</Cell>
            <Cell order="5" name="交易状态">tradeStatusStr</Cell>
            <Cell order="6" name="发送状态">sendStatusStr</Cell>
            <Cell order="7" name="本方">ouPartyName</Cell>
            <Cell order="8" name="交易对手">cpPartyName</Cell>
            <Cell order="9" name="对手方交易员">cpTraderName</Cell>
            <Cell order="10" name="回购利率(%)">rate</Cell>
            <Cell order="11" name="交易金额(元)">shareAmt</Cell>
            <Cell order="12" name="首次结算日">vSettleDateStr</Cell>
            <Cell order="13" name="到期结算日">mSettleDateStr</Cell>
            <Cell order="14" name="期限(天)">term</Cell>
            <Cell order="15" name="清算速度">settleSpeedStr</Cell>
            <Cell order="16" name="报价编号">cfetsQuoteId</Cell>
            <Cell order="17" name="成交编号">execid</Cell>
            <Cell order="18" name="组合代码">portfolioId</Cell>
            <Cell order="19" name="指令代码">entrustId</Cell>
        </Row>
    </Worksheet>
</Workbook>