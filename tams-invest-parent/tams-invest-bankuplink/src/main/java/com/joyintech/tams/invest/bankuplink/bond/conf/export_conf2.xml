            <Cell order="11" name="回购利息">accruedinteresttotalamt</Cell>
            <Cell order="12" name="交易金额">tradecashamt</Cell>
            <Cell order="13" name="到期结算金额">settlcurramt2</Cell>
            <Cell order="14" name="回购期限">tradelimitdays</Cell>
            <Cell order="15" name="实际占款天数">cashholdingdays</Cell>
