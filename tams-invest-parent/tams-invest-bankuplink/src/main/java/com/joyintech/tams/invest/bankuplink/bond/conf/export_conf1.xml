<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="CSTPSelectBond001.xlsx" name="CSTP下行交易查询">
    <Worksheet javaBean="com.joyintech.tams.invest.trade.cstp.dto.CstpSelectDto">
        <Row>
            <Cell order="1" name="组合代码">portfolioId</Cell>
            <Cell order="2" name="成交编号">execid</Cell>
            <Cell order="3" name="证券账户">acctNo</Cell>
            <Cell order="4" name="资产类型">businesstypeStr</Cell>
            <Cell order="5" name="资产代码">securityid</Cell>
            <Cell order="6" name="资产简称">symbol</Cell>
