<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="MstFuturesPriceInfo001.xlsx" name="期货行情信息">
    <Worksheet javaBean="com.joyintech.tams.invest.basicdata.mstfuturespriceinfo.dto.MstFuturesPriceInfoDto">
        <Row>
            <Cell order="1" name="合约代码">futuresId</Cell>
            <Cell order="2" name="行情日期">tradeDateStr</Cell>
            <Cell order="3" name="Wind代码">windCode</Cell>
            <Cell order="4" name="前结算价">preSettlePriceStr</Cell>
            <Cell order="5" name="开盘价">openPriceStr</Cell>
            <Cell order="6" name="收盘价">closePriceStr</Cell>
            <Cell order="7" name="最高价">highPriceStr</Cell>
            <Cell order="8" name="最低价">lowPriceStr</Cell>
            <Cell order="9" name="结算价">settlePriceStr</Cell>
