<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="MstBondFirstMarketCalendar001.xlsx" name="一级市场新债日历">
    <Worksheet javaBean="com.joyintech.tams.invest.basicdata.mstbondfirstmarketcalendar.dto.MstBondFirstMarketCalendar001Dto">
        <Row>
            <Cell order="1" name="债券代码">secId</Cell>
            <Cell order="2" name="债券简称">secAbbr</Cell>
            <Cell order="3" name="期限（年）">termYears</Cell>
            <Cell order="4" name="发行额度（亿）">issueAmt</Cell>
            <Cell order="5" name="债项评级">secGradeResult</Cell>
            <Cell order="6" name="主体评级">issuerGradeResult</Cell>
            <Cell order="7" name="投标区间（最小）">bidPriceMin</Cell>
            <Cell order="8" name="投标区间（最大）">bidPriceMax</Cell>
            <Cell order="9" name="发行利率">issueRate</Cell>
            <Cell order="10" name="发行人">issuerName</Cell>
            <Cell order="11" name="担保人">sponsorName</Cell>
            <Cell order="12" name="特殊条款">othClause</Cell>
            <Cell order="13" name="投标日">bidDateStr</Cell>
            <Cell order="14" name="缴款日">payDateStr</Cell>
            <Cell order="15" name="上市日">onmarketDateStr</Cell>
            <Cell order="16" name="主承销商">mainSalerName</Cell>
            <Cell order="17" name="交易场所">tradeMarketName</Cell>
            <Cell order="18" name="登记托管机构">registOrgName</Cell>
  		</Row>
    </Worksheet>
</Workbook>