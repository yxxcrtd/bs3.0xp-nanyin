        <Row>
            <Cell order="1" name="业务编号">orderid</Cell>
            <Cell order="2" name="组合代码">portid</Cell>
            <Cell order="3" name="组合名称">portname</Cell>
            <Cell order="4" name="是否发送">send</Cell>
            <Cell order="5" name="支付日">sdate</Cell>
            <Cell order="6" name="划款金额">amt</Cell>
            <Cell order="7" name="币种">ccy</Cell>
            <Cell order="8" name="付款账号">payno</Cell>
            <Cell order="9" name="付款账号名称">payname</Cell>
            <Cell order="10" name="收款账号">gatno</Cell>
            <Cell order="11" name="收款账号名称">gatname</Cell>
            <Cell order="12" name="收款账号网点/支付系统号">gatpayno</Cell>
            <Cell order="13" name="发送状态">status</Cell>
            <Cell order="14" name="用途">purpose</Cell>
