<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="CeMonitorOrg.xlsx" name="机构授信额度监测表">
    <Worksheet javaBean="com.joyintech.tams.invest.risk.creditmanagement.cemonitor.dto.CreditLinesDealDto">
        <Row>
            <Cell order="1" name="批复号">pflsh</Cell>
            <Cell order="2" name="机构名称">customerName</Cell>
            <Cell order="3" name="授信品种">creditQuoteTypeValue</Cell>
            <Cell order="4" name="批复金额(亿元)">creditAmt</Cell>
            <Cell order="5" name="已使用金额(直接)">usedAmt</Cell>
            <Cell order="6" name="已使用金额(委托)">usedEnstustAmt</Cell>
            <Cell order="7" name="已使用金额(合计)">usedAmtTotal</Cell>
            <Cell order="8" name="剩余金额(亿元)">remainAmt</Cell>
            <Cell order="9" name="批复生效日">vdate</Cell>
            <Cell order="10" name="批复到期日">mdate</Cell>
        </Row>
    </Worksheet>
</Workbook>
