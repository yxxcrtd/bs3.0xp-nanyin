  <sql id="PBC_PRD_BASEINFO_SUB">
  (select a.* from (SELECT PBC_PROD_ID,PROD_ID,OPERATE_MODE,IVSTORIENTATION,VDATE,status,RAISE_ENDDATE,ORG_CODE,
	row_number() OVER (partition BY PBC_PROD_ID ORDER BY NVL(UPDATE_TIME,CREATE_TIME)
	DESC) AS myrank
	FROM pbc_prd_baseinfo_sub) a
	WHERE a.myrank=1)
  </sql>
<!-- 查询产品交易头寸 -->
<select id="getPrdDealPositionList"
	parameterType="com.joyintech.tams.svreport.pbc.classic.prdinfoendsub.dto.PbcPrdBaseinfoEndSub"
	resultType="com.joyintech.tams.svreport.position.dto.ChbPrdPosition">
	select CDATE,PROD_ID,CCY,sum(nvl(TOTAL_INTAMT,0)) TOTAL_INTAMT,sum(nvl(CUSTAMT,0)) CUSTAMT,sum(nvl(CUSTQTY,0)) CUSTQTY,sum(nvl(RAISEAMT,0)) RAISEAMT
	from CHB_PRD_POSITION
	where
	<foreach collection="list" item="item" open="(PROD_ID,to_char(CDATE,'yyyy-mm-dd')) in ("
		separator="union all" close=")">
		select
		#{item.prodId,jdbcType=VARCHAR},
		to_char(#{item.mdate},'yyyy-mm-dd')
		from sysibm.SYSDUMMY1
	</foreach>
	group by CDATE,PROD_ID,CCY
</select>

