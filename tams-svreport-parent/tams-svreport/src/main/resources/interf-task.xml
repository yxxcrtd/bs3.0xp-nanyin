<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:batch="http://www.springframework.org/schema/batch" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context" xmlns:tx="http://www.springframework.org/schema/tx"
	xsi:schemaLocation="http://www.springframework.org/schema/beans	
	http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
	http://www.springframework.org/schema/batch 
	http://www.springframework.org/schema/batch/spring-batch-3.0.xsd
	http://www.springframework.org/schema/context 
	http://www.springframework.org/schema/context/spring-context-3.1.xsd
	http://www.springframework.org/schema/tx 
	http://www.springframework.org/schema/tx/spring-tx-4.3.xsd">

	<!-- 总管理类 如果将lazy-init='false'那么容器启动就会执行调度程序 -->
	<bean id="intefTask" lazy-init="false" autowire="no"
		class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="startupDelay" value="60" />
		<property name="triggers">
			<list>
			<ref bean="interfTaskTrigger1" />
				<!--  <ref bean="interfTaskTrigger1" /> 
				 <ref bean="interfTaskTrigger2" />  -->
				<!-- <ref bean="interfTaskTrigger3" /> 
				 <ref bean="interfTaskTrigger4" /> -->
			</list>
		</property>
		<property name="quartzProperties">
			<props>
				<!-- quartz 取消检查更新 -->
				<prop key="org.quartz.scheduler.skipUpdateCheck">true</prop>
			</props>
		</property>
	</bean>
	<!-- 触发器工厂，将所有的定时任务都注入工厂 -->
	<bean id="interfTaskTrigger1"
		class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="interfScheduleJob1" />
		</property>
		<property name="cronExpression">
			<!-- 每4分钟执行一次 -->
			<value>0 0/2 * * * ?</value>
		</property>
	</bean>
	<!-- 触发器工厂，处理中债反馈结果 -->
	<bean id="interfTaskTrigger2"
		class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="interfScheduleJob2" />
		</property>
		<property name="cronExpression">
			<!-- 每5分钟执行一次 -->
			<value>0 0/5 * * * ?</value>
		</property>
	</bean>
	<bean id="interfTaskTrigger3" 
		class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="interfScheduleJob3" />
		</property>
		<property name="cronExpression">
			<value>0 20 14 * * ?</value>
		</property>
	</bean>
	<bean id="interfTaskTrigger4" 
		class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="interfScheduleJob4" />
		</property>
		<property name="cronExpression">
			<value>0 0/5 * * * ?</value>
		</property>
	</bean>
	<!-- 接口定时任务执行类 -->
	<bean id="interfScheduleJob1"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<!-- 定时执行类 -->
			<ref bean="svr3CnBondUpInterfTaskService" />
		</property>
		<property name="targetMethod">
			<!-- 定时执行类的方法 -->
			<value>execute</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>
	<!-- 接口定时任务， 处理中债直连返回信息 -->
	<bean id="interfScheduleJob2"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<!-- 定时执行类 -->
			<ref bean="InterfTaskService" />
		</property>
		<property name="targetMethod">
			<!-- 定时执行类的方法 -->
			<value>execute</value>
		</property>
        <property name="concurrent" value="false" />
        <!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>

	<bean name="interfScheduleJob3"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<ref bean="InterfCheckInnerService" />
		</property>
		<property name="targetMethod">
			<value>run</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>

	<bean name="interfScheduleJob4"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject">
			<ref bean="InterfCheckNumService" />
		</property>
		<property name="targetMethod">
			<value>run</value>
		</property>
		<property name="concurrent" value="false" />
		<!-- 是否允许任务并发执行。当值为false时，表示必须等到前一个线程处理完毕后才再启一个新的线程 -->
	</bean>
</beans>  