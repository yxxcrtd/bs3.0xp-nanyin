    <insert id="insert">
        insert into MST_BOND_CREDIT_RATING
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="oCode !=null and oCode !=''">
                O_CODE,
            </if>
            <if test="gradeOrgId !=null and gradeOrgId !=''">
                GRADE_ORG_ID,
            </if>
            <if test="gradeDate !=null and gradeDate!=''">
                GRADE_DATE,
            </if>
            <if test="shortLongTerm !=null and shortLongTerm !=''">
                SHORT_LONG_TERM,
            </if>
            <if test="gradeResult !=null and gradeResult !=''">
                GRADE_RESULT,
            </if>
            <if test="dataSource !=null and dataSource !=''">
                DATA_SOURCE,
            </if>
            <if test="source !=null and source !=''">
                SOURCE,
            </if>
            <if test="status !=null and status !=''">
                STATUS,
            </if>
            <if test="oName !=null and oName !=''">
                O_NAME,
            </if>
            <if test="oObject !=null and oObject !=''">
                O_OBJECT,
            </if>
            <if test="createUser !=null and createUser !=''">
                CREATE_USER,
            </if>
            <if test="createDept !=null and createDept !=''">
                CREATE_DEPT,
            </if>
            <if test="createTime !=null">
                CREATE_TIME,
            </if>
            <if test="updateUser !=null and updateUser !=''">
                UPDATE_USER,
            </if>
            <if test="updateTime !=null">
                UPDATE_TIME
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="oCode !=null and oCode !=''">
                #{oCode},
            </if>
            <if test="gradeOrgId !=null and gradeOrgId !=''">
                #{gradeOrgId},
            </if>
            <if test="gradeDate !=null and gradeDate!=''">
                to_date(#{gradeDate},'yyyy-MM-dd'),
            </if>
            <if test="shortLongTerm !=null and shortLongTerm !=''">
                #{shortLongTerm},
            </if>
            <if test="gradeResult !=null and gradeResult !=''">
                #{gradeResult},
            </if>
            <if test="dataSource !=null and dataSource !=''">
                #{dataSource},
            </if>
            <if test="source !=null and source !=''">
                #{source},
            </if>
            <if test="status !=null and status !=''">
                #{status},
            </if>
            <if test="oName !=null and oName !=''">
                #{oName},
            </if>
            <if test="oObject !=null and oObject !=''">
                #{oObject},
