    <insert id="batchInsert" parameterType="java.util.List">
        insert into MST_BOND_CREDIT_RATING (
                O_CODE,
                GRADE_ORG_ID,
                GRADE_DATE,
                SHORT_LONG_TERM,
                GRADE_RESULT,
                DATA_SOURCE,
                SOURCE,
                STATUS,
                O_NAME,
                O_OBJECT,
                CREATE_USER,
                CREATE_DEPT,
                CREATE_TIME,
                UPDATE_USER,
                UPDATE_TIME )
        <foreach collection="list" separator="union all" item="item">
            (select
                #{item.oCode},
                #{item.gradeOrgId},
                to_date(#{gradeDate},'yyyy-MM-dd'),
                #{item.shortLongTerm},
                #{item.gradeResult},
                #{item.dataSource},
                #{item.source},
                #{item.status},
                #{item.oName},
                #{item.oObject},
                #{item.createUser},
                #{item.createDept},
                #{item.createTime},
                #{item.updateUser},
                #{item.updateTime}
            from dual)
        </foreach>
    </insert>
    <update id="update">
        update MST_BOND_CREDIT_RATING
        <trim prefix="set" suffixOverrides=",">
            <if test="gradeOrgId !=null and gradeOrgId !=''">
                GRADE_ORG_ID = #{gradeOrgId},
            </if>
            <if test="shortLongTerm !=null and shortLongTerm !=''">
                SHORT_LONG_TERM = #{shortLongTerm},
            </if>
            <if test="gradeResult !=null and gradeResult !=''">
                GRADE_RESULT = #{gradeResult},
            </if>
            <if test="status !=null and status !=''">
                STATUS = #{status},
            </if>
            <if test="updateUser !=null and updateUser !=''">
                UPDATE_USER = #{updateUser},
            </if>
            <if test="updateTime !=null">
                UPDATE_TIME = #{updateTime}
            </if>
        </trim>
        where O_CODE = #{oCode} AND O_OBJECT = #{oObject}
    </update>
    <select id="selcetByKey" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/> from MST_BOND_CREDIT_RATING where O_CODE = #{oCode} and O_OBJECT= #{oObject}
    </select>
    <select id="selectAll" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/> from MST_BOND_CREDIT_RATING
        <where>
            <if test="oObject!=null and oObject!=''">
                O_OBJECT = #{oObject}
            </if>
            <if test="oName!=null and oName!=''">
                and O_NAME = #{oName}
            </if>
            <if test="shortLongTerm!=null and shortLongTerm!=''">
                and SHORT_LONG_TERM = #{shortLongTerm}
            </if>
            <if test="status!=null and status!=''">
                and STATUS = #{status}
            </if>
            <if test="gradeDateStart!=null and gradeDateStart!=''">
                and GRADE_DATE &gt;= to_date(#{gradeDateStart},'yyyy-mm-dd')
            </if>
            <if test="gradeDateEnd!=null and gradeDateEnd !=''">
                and GRADE_DATE &lt;= to_date(#{gradeDateEnd},'yyyy-mm-dd')
            </if>
        </where>
    </select>
    <select id="getFinProdAbbr" resultType="com.joyintech.framework.select.SuggestDto">
        SELECT
            distinct
            ASSET_CODE AS code,
            ASSET_NAME AS shortName
        FROM CHB_ASSET_INFO
        WHERE ASSET_TYPE2 IN
              (SELECT ITEM_CODE FROM SYS_DATADICT_LIST_LINK WHERE LINKED_DICT_CODE ='SVR_ASSET_TYPE_FIRST_LEVEL' AND LINKED_ITEM_CODE ='004')
        <if test="param !=null and  param !='' ">
            AND (ASSET_CODE like '%' || #{param} || '%'
            OR ASSET_NAME like '%' || #{param} || '%')
        </if>

    </select>
</mapper>
