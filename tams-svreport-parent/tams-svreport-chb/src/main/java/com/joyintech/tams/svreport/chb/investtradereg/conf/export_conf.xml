		<Row>
			<Cell order="1" name="产品登记编码">prodRegCode</Cell><!-- 产品登记编码 -->
			<Cell order="2" name="发行机构代码">registBankCode</Cell><!-- 发行机构代码 -->
			<Cell order="3" name="行内资产/负债编码">assetCode</Cell><!-- 行内资产/负债编码-->
			<Cell order="4" name="行内交易编码">tradeCode</Cell><!-- 行内交易编码 -->
			<Cell order="5" name="资金流动类型">curAssetTypeName</Cell><!-- 资金流动类型 -->
			<Cell order="6" name="资金流动类型说明">curAssetdetType</Cell><!-- 资金流动类型说明 -->
