			<Cell order="17" name="成交编号/合同号">contractCode</Cell><!-- 成交编号/合同号 -->
			<Cell order="18" name="交易日">dealdateString</Cell><!-- 交易日 -->
			<Cell order="19" name="备注">remark</Cell><!-- 备注 -->
