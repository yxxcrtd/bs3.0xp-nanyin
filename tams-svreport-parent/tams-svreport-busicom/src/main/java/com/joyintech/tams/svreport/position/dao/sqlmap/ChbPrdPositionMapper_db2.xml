<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.svreport.position.dao.ChbPrdPositionMapper_db2" >
  <resultMap id="BaseResultMap" type="com.joyintech.tams.svreport.position.dto.ChbPrdPosition" >
    <result column="CDATE" property="cdate" jdbcType="DATE" />
    <result column="PROD_ID" property="prodId" jdbcType="VARCHAR" />
    <result column="INDENTIFY_MARK" property="indentifyMark" jdbcType="VARCHAR" />
    <result column="CCY" property="ccy" jdbcType="VARCHAR" />
    <result column="ISSUE_PARTY_ID" property="issuePartyId" jdbcType="VARCHAR" />
    <result column="TDADD_QTY" property="tdaddQty" jdbcType="DECIMAL" />
    <result column="TDADD_AMT" property="tdaddAmt" jdbcType="DECIMAL" />
    <result column="TDADD_COST" property="tdaddCost" jdbcType="DECIMAL" />
    <result column="BALANCE_QTY" property="balanceQty" jdbcType="DECIMAL" />
    <result column="BALANCE_AMT" property="balanceAmt" jdbcType="DECIMAL" />
    <result column="TDADD_INTAMT" property="tdaddIntamt" jdbcType="DECIMAL" />
    <result column="TOTAL_INTAMT" property="totalIntamt" jdbcType="DECIMAL" />
    <result column="ORG_CODE" property="orgCode" jdbcType="VARCHAR" />
    <result column="DEPT_CODE" property="deptCode" jdbcType="VARCHAR" />
    <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
    <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
    <result column="BUY_PLACE" property="buyplace" jdbcType="VARCHAR" />
    <result column="CONSIGN_AMT" property="consignamt" jdbcType="DECIMAL" />
    <result column="CUST_COUNTS" property="custCounts" jdbcType="DECIMAL" />
    <result column="CUSTOMER_TYPE2" property="customerType2" jdbcType="VARCHAR" />
    <result column="CUSTAMT" property="custamt" jdbcType="DECIMAL" />
    <result column="CUSTQTY" property="custqty" jdbcType="DECIMAL" />
    <result column="RAISEAMT" property="raiseamt" jdbcType="DECIMAL" />
    <result column="REMARK" property="remark" jdbcType="VARCHAR" />
  </resultMap>
  
  <select id="selectByDate" 
          resultSetType="FORWARD_ONLY" fetchSize="1000"
          resultMap="BaseResultMap" parameterType="map">
		SELECT
		    POS.CDATE+1 day CDATE,
			POS.PROD_ID,
			POS.INDENTIFY_MARK,
			POS.CCY,
			POS.ISSUE_PARTY_ID,
			POS.BALANCE_QTY,
			POS.BALANCE_AMT,
			POS.TOTAL_INTAMT,
			ORG_CODE,
			DEPT_CODE,
			BUY_PLACE,
			CONSIGN_AMT,
			CUST_COUNTS,
			CUSTOMER_TYPE2,
			CUSTAMT,
			CUSTQTY,
			RAISEAMT
		FROM CHB_PRD_POSITION POS
		WHERE 1 = 1
		AND POS.CDATE = #{cdate,jdbcType = DATE}
		<if test="prodIdList!=null and prodIdList.size()!=0">
      	 	AND POS.PROD_ID in 
	        <foreach item="accountid" collection="prodIdList" open="(" separator="," close=")"> 
	          #{accountid}
	       	</foreach>
        </if>
		/*未到期且后续没有待支付的付息交易*/
		AND NOT EXISTS (
                     SELECT 1 FROM CHB_PRD_DEAL DL 
                     WHERE NVL(FPROD_ID,PROD_ID) = POS.PROD_ID 
                     AND DL.SETTDATE_DATE = POS.CDATE
                     AND DL.TRADE_TYPE = '16'
                     AND DL.STATUS != 'D'
                     AND NOT EXISTS (SELECT 1 FROM CHB_PRD_DEAL T1 
                                     WHERE T1.PROD_ID = DL.PROD_ID
                                     AND T1.TRADE_TYPE = '04'
                                     AND T1.STATUS != 'D'
                                     AND T1.INTEREST_DATE > DL.SETTDATE_DATE)
                   )
  </select>
</mapper>