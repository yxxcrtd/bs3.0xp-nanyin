<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.svreport.chbreport.common.dao.ChbreportCommonMapper">
    <select id="selectAllPrdBaseInfo" resultType="com.joyintech.framework.select.SelectOptionDto">
        select DISTINCT
        PROD_ID id,
        PROD_NAME text
        from CHB_PRD_BASEINFO
        where
        STATUS='E'
        <if test="search != null and search !=''">
            AND (PROD_ID LIKE concat(concat('%', #{search}),'%')
            OR PROD_NAME LIKE concat(concat('%', #{search}),'%'))
        </if>
    </select>
</mapper>