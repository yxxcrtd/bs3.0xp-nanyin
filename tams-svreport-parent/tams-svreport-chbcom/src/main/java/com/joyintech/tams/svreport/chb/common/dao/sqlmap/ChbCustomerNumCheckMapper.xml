<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.svreport.chb.common.dao.ChbCustomerNumCheckMapper" >

    <select id="getraiseCustNum"  resultType="com.joyintech.tams.common.base.entity.ChbPrdCustNumIfo">
        select
        PROD_ID  prdCode,
        SINGLE_TOTAL+LEGAL_TOTAL+UNLEGAL_TOTAL  CustHeldNum
        from  CHB_PRD_RAISETOT_SUB
        where
        status_date=#{checkDate,jdbcType=DATE}
        and status !='D'
        <if test="prodId != null and prodId != ''">
            and PROD_ID = #{prodId}
        </if>
    </select>

    <select id="getraiseCustNumThree" resultType="com.joyintech.tams.common.base.entity.ChbPrdCustNumIfo">
        SELECT
            a.ACCOUNT prdCode,
            count(INDENTIFY_MARK) CustHeldNum
            from
            (
                select
                    ACCOUNT ,
                    INDENTIFY_MARK,
                    STATUS,
                    ROW_NUMBER() over( partition BY ACCOUNT, INDENTIFY_MARK ORDER BY UPDATE_TIME DESC) AS rowno
                from
                    CHB_EQUDET
                <where>
                    <if test="prodIdList != null and prodIdList.size() > 0">
                        AND ACCOUNT IN
                        <trim suffixOverrides=" OR ACCOUNT IN ()">
                            <foreach collection='prodIdList' open='(' close=')' index='index'
                                     item='item'>
                                <if test="index != 0">
                                    <choose>
                                        <when test="index % 1000 == 999">) OR ACCOUNT IN (</when>
                                        <otherwise>,</otherwise>
                                    </choose>
                                </if>
                                #{item}
                            </foreach>
                        </trim>
                    </if>
                    AND EQUITY_CONF_DATE=#{checkDate,jdbcType=DATE}
                    AND BUSI_TYPE='01'
                </where>
            ) a
        WHERE
            rowno = 1 AND STATUS != 'D'
        group by a.ACCOUNT
    </select>
</mapper>