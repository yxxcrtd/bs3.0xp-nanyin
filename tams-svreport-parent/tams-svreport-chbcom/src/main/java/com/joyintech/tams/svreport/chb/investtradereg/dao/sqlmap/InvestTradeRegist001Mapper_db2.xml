	<delete id="deleteLastSubmitHis" parameterType="java.util.Map">
       delete  from CHB_INVEST_TRADE_SUB_HIS
      where 1 =1 
      and HIS_NO in (
      select a.HIS_NO from (
  select HIS_NO,row_number() over(partition by ASSET_CODE order by nvl(UPDATE_TIME,CREATE_TIME) desc) myrank
  from CHB_INVEST_TRADE_SUB_HIS
  where 1=1
   <if test="registList !=null and registList.size()>0">
         <foreach collection="registList" item="regist" open=" AND (TRADE_CODE) IN (" separator="union all"  close=")">
           select #{regist.tradeCode,jdbcType=VARCHAR}from sysibm.SYSDUMMY1
         </foreach>
      </if>
  )a
  where a.myrank=1
  )
