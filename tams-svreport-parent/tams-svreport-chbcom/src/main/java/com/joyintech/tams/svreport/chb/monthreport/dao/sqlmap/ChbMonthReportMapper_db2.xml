	<select id="selectMonthReportBySendDate" parameterType="java.util.Map"
		resultMap="BaseResultMapWithDetail">
		select *
		from (
		select rownumber() over() as rownum,
		<include refid="Base_Column_List" />
		from CHB_MONTH_REPORT monthreport
	    <where>
	       <if test="sendDate != null">
	       and to_char(monthreport.SUBMIT_TIME,'yyyy-MM-dd') &lt;= to_char(#{sendDate,jdbcType=DATE},'yyyy-MM-dd')
	       </if>
	    </where>
	    order by monthreport.startdate desc
	    ) 
	    where rownum = 1<!-- 查询月报最新数据 -->

	</select>

