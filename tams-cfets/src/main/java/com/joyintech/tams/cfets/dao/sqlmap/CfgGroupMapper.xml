<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.dsp.datarouter.dao.CfgGroupMapper">
    
    <resultMap type="com.joyintech.dsp.datarouter.pojo.CfgGroup" id="CfgGroupResult">
        <result property="gpcode"    column="GPCODE"    />
        <result property="gpname"    column="GPNAME"    />
        <result property="gptype1"    column="GPTYPE1"    />
        <result property="gptype2"    column="GPTYPE2"    />
        <result property="gpdesc"    column="GPDESC"    />
        <result property="gpimage"    column="GPIMAGE"    />
        <result property="status"    column="STATUS"    />
        <result property="mdtime"    column="MDTIME"    />
        <result property="mduser"    column="MDUSER"    />
        <result property="remark1"    column="REMARK1"    />
        <result property="remark2"    column="REMARK2"    />
        <result property="remark3"    column="REMARK3"    />
    </resultMap>

    <sql id="selectCfgGroupVo">
        select GPCODE, GPNAME,GPTYPE1,GPTYPE2, GPDESC, GPIMAGE, STATUS, MDTIME, MDUSER, REMARK1, REMARK2, REMARK3, SEQNO from DSP_R_CFG_GROUP
    </sql>

    <select id="list" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup" resultMap="CfgGroupResult" useCache="false">
        <include refid="selectCfgGroupVo"/>
        <where>  
            <if test="gpname != null  and gpname != ''"> and GPNAME like concat('%', #{gpname}, '%')</if>
            <if test="gptype1 != null  and gptype1 != ''"> and GPTYPE1 = #{gptype1}</if>
            <if test="gptype2 != null  and gptype2 != ''"> and GPTYPE2 = #{gptype2}</if>
            <if test="gpdesc != null  and gpdesc != ''"> and GPDESC = #{gpdesc}</if>
            <if test="gpimage != null  and gpimage != ''"> and GPIMAGE = #{gpimage}</if>
            <if test="status != null "> and STATUS = #{status}</if>
            <if test="mdtime != null  and mdtime != ''"> and MDTIME = #{mdtime}</if>
            <if test="mduser != null  and mduser != ''"> and MDUSER = #{mduser}</if>
            <if test="remark1 != null "> and REMARK1 = #{remark1}</if>
            <if test="remark2 != null  and remark2 != ''"> and REMARK2 = #{remark2}</if>
            <if test="remark3 != null  and remark3 != ''"> and REMARK3 = #{remark3}</if>
        </where>
        order by SEQNO
    </select>
    
    <select id="getCfgGroupByGpcode" parameterType="String" resultMap="CfgGroupResult" useCache="false">
        <include refid="selectCfgGroupVo"/>
        where GPCODE = #{gpcode}
    </select>
        
    <insert id="insertCfgGroup" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup">
        insert into DSP_R_CFG_GROUP
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gpcode != null">GPCODE,</if>
            <if test="gpname != null">GPNAME,</if>
            <if test="gptype1 != null">GPTYPE1,</if>
            <if test="gptype2 != null">GPTYPE2,</if>
            <if test="gpdesc != null">GPDESC,</if>
            <if test="gpimage != null">GPIMAGE,</if>
            <if test="status != null">STATUS,</if>
            <if test="mdtime != null">MDTIME,</if>
            <if test="mduser != null">MDUSER,</if>
            <if test="remark1 != null">REMARK1,</if>
            <if test="remark2 != null">REMARK2,</if>
            <if test="remark3 != null">REMARK3,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gpcode != null">#{gpcode},</if>
            <if test="gpname != null">#{gpname},</if>
            <if test="gptype1 != null">#{gptype1},</if>
            <if test="gptype2 != null">#{gptype2},</if>
            <if test="gpdesc != null">#{gpdesc},</if>
            <if test="gpimage != null">#{gpimage},</if>
            <if test="status != null">#{status},</if>
            <if test="mdtime != null">#{mdtime},</if>
            <if test="mduser != null">#{mduser},</if>
            <if test="remark1 != null">#{remark1},</if>
            <if test="remark2 != null">#{remark2},</if>
            <if test="remark3 != null">#{remark3},</if>
         </trim>
    </insert>

    <update id="updateCfgGroup" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup">
        update DSP_R_CFG_GROUP
        <trim prefix="SET" suffixOverrides=",">
            <if test="gpname != null">GPNAME = #{gpname},</if>
            <if test="gpdesc != null">GPDESC = #{gpdesc},</if>
            <if test="gpimage != null">GPIMAGE = #{gpimage},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="mdtime != null">MDTIME = #{mdtime},</if>
            <if test="mduser != null">MDUSER = #{mduser},</if>
            <if test="remark1 != null">REMARK1 = #{remark1},</if>
            <if test="remark2 != null">REMARK2 = #{remark2},</if>
            <if test="remark3 != null">REMARK3 = #{remark3},</if>
        </trim>
        where GPCODE = #{gpcode}
    </update>

    <delete id="deleteCfgGroupById" parameterType="String">
        delete from DSP_R_CFG_GROUP where GPCODE = #{gpcode}
    </delete>

    <delete id="deleteCfgGroupByIds" parameterType="String">
        delete from DSP_R_CFG_GROUP where GPCODE in 
        <foreach item="gpcode" collection="array" open="(" separator="," close=")">
            #{gpcode}
        </foreach>
    </delete>

    <update id="updateGroupSortByUp" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup">
        update DSP_R_CFG_GROUP t set t.SEQNO=t.SEQNO-2 where t.SEQNO &lt; #{seqno}
    </update>

    <update id="updateGroupSortByDown" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup">
        update DSP_R_CFG_GROUP t set t.SEQNO=t.SEQNO+2 where t.SEQNO &gt; #{seqno}
    </update>

    <update id="updateGroupSort" parameterType="com.joyintech.dsp.datarouter.pojo.CfgGroup">
		update DSP_R_CFG_GROUP t set t.SEQNO=#{seqno} where t.GPCODE=#{gpcode}
    </update>
    
</mapper>