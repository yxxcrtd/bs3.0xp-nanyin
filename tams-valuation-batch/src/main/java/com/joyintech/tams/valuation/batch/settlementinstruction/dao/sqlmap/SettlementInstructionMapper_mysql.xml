<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.valuation.batch.settlementinstruction.dao.SettlementInstructionMapper_mysql">
	<select id="selectStlPayOrders" resultType="com.joyintech.tams.common.base.entity.StlPayOrders">
		SELECT 
		  S.MY_ACCT_NO,
		  S.CCY,
		  S.COUNTER_ACCT_NO,
		  S.PS
		FROM STL_PAY_ORDERS S 
		WHERE S.TRADE_ID= #{tradeId}
		AND 2 > LIMIT 
	</select>
</mapper>
