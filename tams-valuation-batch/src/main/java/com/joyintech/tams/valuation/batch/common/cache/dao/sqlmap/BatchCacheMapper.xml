<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.batch.common.cache.dao.BatchCacheMapper">
    <select id="findAllDetailSubject" resultType="com.joyintech.tams.valuation.batch.common.cache.service.entity.ValBokSubjectDetailMem">
        SELECT BOOKSET_ID,BASE_SUBJECT_NATURE,BOK_DETAIL_ID FROM BOK_SUBJECT_DETAIL
    </select>
    <select id="findAllBussDetsubKey" resultType="com.joyintech.tams.valuation.batch.common.cache.service.entity.ValBokBussDetsubMem">
        SELECT BOOKSET_ID,DETAIL_SUBJECT_NO FROM BOK_BUSS_DETSUB
    </select>
    <select id="selectAllSysParam" resultType="com.joyintech.tams.valuation.batch.common.cache.service.entity.SysParaDto">
		SELECT
		 SYSTEM_CODE,
		 PARA_CODE,
		 PARAM_VALUE
		FROM SYS_PARA
    </select>
</mapper>