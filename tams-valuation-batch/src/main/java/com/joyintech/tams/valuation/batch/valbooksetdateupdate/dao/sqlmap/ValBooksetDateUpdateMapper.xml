<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
    namespace="com.joyintech.tams.valuation.batch.valbooksetdateupdate.dao.ValBooksetDateUpdateMapper">
    
    <update id="updateBooksetDate">
        UPDATE
            BOK_BOOKSET_date
        SET
            bookset_date = bookset_date + 1
        WHERE 
            1 = 1
            <if test="booksetIds !=null and booksetIds.size >0 ">
            AND (bookset_id IN
                <foreach collection="booksetIds" item="item" index="index" open="( " close=" )" separator=",">
                    <if test="(index % 998) == 0">
	                    null) OR bookset_id in (
                    </if>
                    #{item}
                </foreach>
                )
            </if>
    </update>
    
    
    <update id="updateBokDealAccounting">
        UPDATE
            BOK_DEAL_ACCOUNTING
        SET
            IS_ACCOUNTED = 'Y'
        WHERE 
            1 = 1
            AND BOOK_DATE =#{bookDate}
            <if test="booksetIds !=null and booksetIds.size >0 ">
            AND (bookset_id IN
                <foreach collection="booksetIds" item="item" index="index" open="( " close=" )" separator=",">
                    <if test="(index % 998) == 0">
	                    null) OR bookset_id in (
                    </if>
                    #{item}
                </foreach>
                )
            </if>
    </update>
</mapper>