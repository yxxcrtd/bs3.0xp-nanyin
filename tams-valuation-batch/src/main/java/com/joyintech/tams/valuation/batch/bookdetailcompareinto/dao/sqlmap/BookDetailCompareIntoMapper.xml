	<select id="getUpdateSeqNo"  parameterType="java.util.Map"  resultType="String" >
		select
		    T.SEQNO
		from BOK_BOOKDETAIL_ALL T
		where 1=1
		AND T.HAPPEN_DATE >= #{HAPPEN_DATE}
		AND #{BOOK_DATE}  >=  T.HAPPEN_DATE
		AND #{BOOK_DATE}  >=  T.BOOK_DATE

		AND exists (
		          select 'X'
		          from BOK_BATCH_TASK_TODO P
		          where 1=1
		          AND   P.SEQ_NO = #{seqNo}
		          AND   P.BOOKSET_DATE = #{BOOKSET_DATE}
		          AND		P.BOOK_DATE	= #{BOOK_DATE}

		          AND EXISTS (
		              SELECT 'Y'
		              FROM  BOK_MATCH_RLAT B
		              WHERE
		              B.MATCH_TYPE = #{matchType}
		              AND B.SOURCE=P.TASK_ID
		          )

		          and T.BOOKSET_ID = P.BOOKSET_ID
		          and P.TASK_ID = T.TABLE_ID
		          and T.BOK_DETAIL_ID = NVL(P.BOK_DETAIL_ID, T.BOK_DETAIL_ID)
		)
	</select>


