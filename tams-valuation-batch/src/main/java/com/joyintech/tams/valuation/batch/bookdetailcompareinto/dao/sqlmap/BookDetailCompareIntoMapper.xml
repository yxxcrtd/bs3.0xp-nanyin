<!-- 账务明细比较获取明细数据 - 仅当前表有的数据  -->
	<select id="queryValBokBookdetailCurrentDetail"  resultType="com.joyintech.tams.valuation.batch.bookdetailcompareinto.dto.ValBokBookdetailCurrentExt" >
		SELECT 																		
		T.*
		FROM 																		
    		BOK_BOOKDETAIL_CURRENT T
    		,BOK_BATCH_TASK_TODO P 
		where																		
			T.BOOKSET_ID = P.BOOKSET_ID
			AND T.BOOKSET_DATE = P.BOOKSET_DATE
			AND T.BOOK_DATE = P.BOOK_DATE
            AND P.SEQ_NO = #{seqNo}
            AND P.BOOKSET_DATE = #{BOOKSET_DATE}
            AND P.BOOK_DATE = #{BOOK_DATE}
            AND P.TASK_ID = #{taskId}
            AND P.IS_SUB_BOOKSET = #{IS_SUB_BOOKSET}
		order by T.BOOK_ORDER
	</select>
	
	<!-- 账务明细比较获取明细数据 - 仅当前表有的数据  -->
	<select id="queryValBokBookdetailAllDetail"  resultType="com.joyintech.tams.valuation.batch.bookdetailcompareinto.dto.ValBokBookdetailAllExt" >
		SELECT
		A.*
		FROM
		BOK_BOOKDETAIL_ALL A
		INNER JOIN
		BOK_BATCH_TASK_TODO P
		ON
		P.SEQ_NO = #{seqNo}
		AND P.BOOKSET_DATE = #{BOOKSET_DATE}
		AND P.BOOK_DATE = #{BOOK_DATE}
		AND P.TASK_ID = #{taskId}
		AND A.BOOKSET_ID = P.BOOKSET_ID
		AND A.BOOKSET_DATE = P.BOOKSET_DATE
		AND A.BOOK_DATE = P.BOOK_DATE
		WHERE EXISTS(
		SELECT
		T.BOOK_ID
		FROM BOK_BOOKDETAIL_CURRENT T
		WHERE
		A.BOOKSET_ID = T.BOOKSET_ID
		AND A.BOOK_ID = T.BOOK_ID
		)
		ORDER BY
		A.BOOK_ORDER
