	     <update id="updateSeqno"  parameterType="java.util.List">
			  <foreach collection="list" item="item" index="index" open="BEGIN" close=";END;" separator=";">   
			    update																						
					BOK_BOOKDETAIL_ALL A																						
				set	
					A.R_SEQNO = #{item.rSeqno, jdbcType=VARCHAR}
				WHERE 
					A.SEQNO = #{item.seqno, jdbcType=VARCHAR}
			</foreach>
        </update>
        
        <select id="selectSeqnoToUpdate" resultType="com.joyintech.tams.valuation.batch.common.base.entity.extcommon.ValBokBookdetailBatch" >
			    select 	
			    	A.SEQNO, 
			    	B.SEQNO AS rSeqno
			    from  
			    	BOK_BOOKDETAIL_ALL A, BOK_BOOKDETAIL_ALL B, BOK_BATCH_TASK_TODO P																					
				WHERE
					A.OFFSET_FLAG = '01'																				
		            AND		A.HAPPEN_DATE >= #{HAPPEN_DATE}																					
					AND		#{BOOK_DATE}	>=		A.HAPPEN_DATE																															
					AND	    #{BOOK_DATE}	>=		A.BOOK_DATE 		
		            AND		A.BOOKSET_ID = P.BOOKSET_ID
                    AND     P.SEQ_NO = #{seqNo}
                    AND     P.BOOK_DATE = #{BOOK_DATE}
                    AND     P.BOOKSET_DATE = #{BOOKSET_DATE}
                    AND     P.TASK_ID = #{taskId}
                    AND     A.SEQNO = B.R_SEQNO   
			        AND     B.OFFSET_FLAG = '02'
			        AND P.IS_SUB_BOOKSET = #{IS_SUB_BOOKSET}
        </select>
