	<!-- 查询上一工作日 -->
	<select id="getCDate" parameterType="java.util.Map" resultType="java.util.Date">
<!-- 	CREATE OR REPLACE VIEW VAL_VW_MST_HOLIDAY(CDATE,TRADE_CALENDAR_ID,IS_HOLIDAY) AS
    (
        SELECT c.CDATE,a.TRADE_CALENDAR_ID,SUM(c.IS_HOLIDAY) AS IS_HOLIDAY
        FROM MST_TRADE_CALENDAR a
        INNER JOIN MST_CALENDAR_INFO b ON a.CALENDAR_ID = b.CALENDAR_ID
        INNER JOIN MST_HOLIDAY c ON c.CALENDAR_ID = b.CALENDAR_ID
        GROUP BY a.TRADE_CALENDAR_ID
    ) -->
	SELECT MAX(CDATE)
	FROM VAL_VW_MST_HOLIDAY
	WHERE CDATE<![CDATA[<]]>#{cdate}
	AND IS_HOLIDAY = #{isHoliday}
	AND TRADE_CALENDAR_ID = #{calendarId}
	</select>
	
	<!-- 是否节假日 -->
	<select id="getIsHoliday" parameterType="java.util.Map" resultType="String">
		SELECT
		IS_HOLIDAY
		FROM
		VAL_VW_MST_HOLIDAY
		WHERE CDATE = #{cdate}
		AND TRADE_CALENDAR_ID = #{calendarId}
	</select>
	
	<!-- 查询上一开放日 -->
	<select id="getLastOpenDate" parameterType="java.util.Map" resultType="java.util.Date">
	SELECT MAX(OPEN_DATE_END) AS lastOpenDate
<!-- 	一体化问题12：表名变更（开放计划表(FIN_VAL_OPEN_PLAN) -> 开放计划(FIN_OPEN_PLAN) -->
	FROM FIN_OPEN_PLAN
	WHERE FINPROD_ID = #{finprodId}
	AND OPEN_DATE_END<![CDATA[<]]>#{cdate}
	</select>
	
	<!-- 摊销重算配置查询 -->
	<select id="getBokAmoConfig" parameterType="java.util.Map" resultType="com.joyintech.tams.common.base.entity.BokAmoConfig">
select		
	BOOKSET_ID,
	BUSI_ID,
	CDATE,	
	RECAL_TYPE,
  	DAILYDSC_YIELD
from		
	BOK_AMO_CONFIG	
where		
		BUSI_ID = #{busiId}
	AND	CDATE = #{cdate}
	AND	(BOOKSET_ID = #{booksetId}  OR BOOKSET_ID = 'ALL')
ORDER BY (DECODE(BOOKSET_ID ,'ALL',2,1))		
	</select>
		
		
	<select id="tradeDealAccountCount" parameterType="java.util.Map" resultType="Integer">
		SELECT 
			COUNT(1) 
		FROM TRD_PRODUCT_DEAL D
		WHERE D.TRADE_DATE = #{TRADE_DATE}
		<if test="pslist != null and pslist.size > 0">
			AND D.PS IN
			<foreach collection="pslist" item="ps" open="( " close=" )" separator=",">
                #{ps}
            </foreach>
		</if>

		<if test="tradeStatus != null and tradeStatus!='' ">
			and D.TRADE_STATUS=#{tradeStatus}
		</if>
		AND EXISTS (
			SELECT * FROM BOK_DEAL_ACCOUNTING C WHERE D.TRADE_ID = C.BUSI_NO
			AND C.BOOKSET_ID = #{BOOKSET_ID}
		)
		
		
	</select>
</mapper>