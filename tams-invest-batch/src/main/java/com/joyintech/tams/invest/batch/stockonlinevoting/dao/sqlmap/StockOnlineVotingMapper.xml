<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.invest.batch.stockonlinevoting.dao.StockOnlineVotingMapper">

	<delete id="deleteBatchStMeetingProposalInfo">
		delete from ST_MEETING_PROPOSAL_INFO
		<where>
			<if test="meetingseq != null and meetingseq != ''">
				AND MEETINGSEQ = #{meetingseq}
			</if>
		</where>
	</delete>

	<delete id="deleteBatchStMeetingProposalVoteinfo">
		delete from ST_MEETING_PROPOSAL_VOTEINFO
		<where>
			<if test="meetingseq != null and meetingseq != ''">
				AND MEETINGSEQ = #{meetingseq}
			</if>
		</where>
	</delete>
</mapper>