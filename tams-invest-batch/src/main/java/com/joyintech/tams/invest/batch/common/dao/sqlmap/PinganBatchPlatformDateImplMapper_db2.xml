<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.batch.common.dao.PinganBatchPlatformDateImplMapper_db2">
    <select id="getDbDate" resultType="java.util.Date">
        select current date from sysibm.SYSDUMMY1
    </select>
    <update id="updateSysDate" parameterType="java.util.Date">
        update SYS_DATE set CUR_DATE=#{newDate, jdbcType=DATE}
    </update>
</mapper>