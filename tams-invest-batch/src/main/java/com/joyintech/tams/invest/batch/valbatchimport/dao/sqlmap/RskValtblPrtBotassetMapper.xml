<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.batch.valbatchimport.dao.RskValtblPrtBotassetMapper">
	 <select id="selectBotAssetMap" resultType="com.joyintech.tams.invest.batch.valbatchimport.dto.RskValtblPrtBotassetMapDto">
		 SELECT
			PTL_ID,
			SUB_CODE,
			FINPROD_ID
			FROM
		 RSK_VALTBL_PRT_BOTASSET_MAP
		  <where>
			  <if test="ptlId !=null and ptlId !=''">
			   AND	PTL_ID = #{ptlId,jdbcType=VARCHAR}
			  </if>
		  </where>
	 </select>
</mapper>