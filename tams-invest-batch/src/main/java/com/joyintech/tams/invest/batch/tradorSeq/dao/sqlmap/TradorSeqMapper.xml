<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.invest.batch.tradorSeq.dao.TradorSeqForwardMapper">
    <delete id="deleteTradorSeq">
        delete from TRADOR_SEQ
    </delete>

    <select id="selectTradorSeqByRole" resultType="com.joyintech.tams.invest.batch.tradorSeq.dto.TradorSeqForwardDto">
            select DISTINCT sys_user_role.user_id userId
           from sys_user_role
          inner join sys_role on sys_user_role.role_id = sys_role.role_id
          where sys_role.role_pos = '06'
    </select>

</mapper>