    <callBackMethods>
        <method id="-1" className="com.hundsun.mcapi.MCT2sdkCallback" />
        <method id="5" className="com.joyintech.tams.exchange.terminal.trade.ufx.UfxTradeCallBack"/>
        <method id="6" className="com.joyintech.tams.exchange.terminal.test.UfxRebackTest"/>
        <method id="0"
                className="com.joyintech.tams.exchange.terminal.trade.ufx.UfxMdCallBack"/> <!--Message center server callback must set mehtod id equals 0 -->
