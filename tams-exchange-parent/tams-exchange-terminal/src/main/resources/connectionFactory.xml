<?xml version="1.0" encoding="UTF-8"?>
<SocketClient>
	<!-- otc同步长连 -->
	<connectionFactory name="otcSyncLongConnection"
		connectType="long" concurrentType="sync" connectTimeOut="1000"
		connLifeCycleListener="com.tools.client.trade.MidCheckInAspect">
		<servers>
			<!-- <unit serverAddress="10.25.152.104" serverPort="19200" ></unit> -->
			<!--<unit serverAddress="10.25.153.142" serverPort="19200" ></unit> -->
			<!-- <unit serverAddress="10.25.153.142" serverPort="19200"></unit> -->
			<!-- <unit serverAddress="10.25.167.188" serverPort="9200"></unit>
			<unit serverAddress="10.25.167.189" serverPort="9200"></unit> -->
			<unit serverAddress="47.108.58.49" serverPort="19200" ></unit>
			<!-- <unit serverAddress="10.25.163.162" serverPort="19200" ></unit> -->
		</servers>
		<!-- decodeHandler="com.tools.socket.client.handler.impl.CallMidLongConnectTypeDecodeHandler" -->
		<handler useDecodeHandler="true"

			decodeHandler="com.tools.socket.client.handler.impl.CallMidLongConnectTypeDecodeHandler"
			useCompressHandler="false" compressHandler="com.cn.jiaqi.compressHandler"
			decompressHandler="com.cn.jiaqi.deCompressHandler"
			useEncryptionHandler="false" encryptionHandler="com.cn.jiaqi.encryptionHandler"
			deEncryptionHandler="com.cn.jiaqi.deEncryptionHandler">
		</handler>
		<connectionPool coreSize="20" maxSize="100"
			reConnectRate="1000" heartIdleTime="5" maxSendCount="15"
			heartMessageHandler="com.tools.client.trade.MidHeartMessageHandler"
			minSendCount="10" useHeartMessageHandler="true">
		</connectionPool>
	</connectionFactory>

