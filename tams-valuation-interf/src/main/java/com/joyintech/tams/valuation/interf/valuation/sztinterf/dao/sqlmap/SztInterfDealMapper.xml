	<!-- 更新科目余额表和估值表对账成功失败情况，科目信息表不存在更新 -->
	<update id="updateInterfLog" parameterType="com.joyintech.tams.valuation.interf.valuation.sztinterf.dto.SztIntfLogModel" >
        UPDATE SZT_INTERF_VALUATION
        <set >
			<if test="returnTime != null" >
                RETURN_TIME,
            </if>
			<if test="returnTxt != null" >
                RETURN_TXT,
            </if>
			<if test="checkStatus != null" >
                CHECK_STATUS,
            </if>
			<if test="updateUser != null" >
                UPDATE_USER,
            </if>
			<if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </set>
        WHERE FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
          AND SERIALNO = #{refNo,jdbcType=VARCHAR}
          AND INTER_TYPE = #{interType,jdbcType=CHAR}
          AND CDATE = #{cdate,jdbcType=VARCHAR}
    </update>
    
    <!-- 每次发送时删除对应的产品信息条件是产品代码、接口类型(科目信息、科目余额表、估值表)、估值日期(科目余额表、估值表、科目信息表不存在估值日期) -->
    <delete id="deleteInterfLog" parameterType="java.util.Map" >
        DELETE FROM SZT_INTERF_VALUATION
        where FINPROD_ID = #{prodId,jdbcType=VARCHAR}
        <if test="interType != null" > AND INTER_TYPE = #{interType,jdbcType=CHAR}</if> 
        <if test="interType != '2' " > AND CDATE = #{cdate,jdbcType=VARCHAR}</if> 
    </delete>
    
