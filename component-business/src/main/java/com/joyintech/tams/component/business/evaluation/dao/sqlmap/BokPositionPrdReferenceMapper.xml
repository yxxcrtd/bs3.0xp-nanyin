<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.component.business.evaluation.dao.BokPositionPrdReferenceMapper">

	<select id="getBokPositionPrdList" resultType="com.joyintech.tams.component.business.evaluation.dto.BokPositionPrd">
		select * from BOK_POSITION_PRD
		<where>
            <if test="startDate!=null and startDate != ''">
                AND CDATE >= to_date(#{startDate},'yyyy-MM-dd')
            </if>
            <if test="endDate!=null and endDate != ''">
                AND to_date(#{endDate},'yyyy-MM-dd') >= CDATE
            </if>
            <if test="finProdId!=null and finProdId!=''"> <!-- 金融产品代码 -->
                AND FINPROD_ID = #{finProdId}
            </if>
            <if test="branch!=null and branch!=''"> <!-- 分支序号 -->
                AND BRANCH = #{branch}
            </if>
        </where>
	</select>
    
    <select id="getBokPositionPrdOfDay" resultType="com.joyintech.tams.component.business.evaluation.dto.BokPositionPrd">
        select * from BOK_POSITION_PRD
        where CDATE = #{cdate,jdbcType=DATE}
        AND FINPROD_ID = #{finProdId}
        <if test="branch!=null and branch!=''"> <!-- 分支序号 -->
            AND BRANCH = #{branch}
        </if>
    </select>
	
</mapper>