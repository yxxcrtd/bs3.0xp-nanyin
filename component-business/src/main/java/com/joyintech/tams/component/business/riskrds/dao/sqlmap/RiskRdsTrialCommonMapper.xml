<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.component.business.riskrds.dao.RiskRdsTrialCommonMapper" >
    <select id="selectConvertible" resultMap="com.joyintech.tams.common.base.dao.FinProductConvertibleMapper.BaseResultMap"
         parameterType="java.util.List" >
        select 
        <include refid="com.joyintech.tams.common.base.dao.FinProductConvertibleMapper.Base_Column_List" />
        from FIN_PRODUCT_CONVERTIBLE
        <if test = "list != null and !list.isEmpty()">
        where FINPROD_ID IN 
        <foreach collection="list" open="(" separator="," close=")"></foreach>
            #{item}
        </if>
    </select>
</mapper>