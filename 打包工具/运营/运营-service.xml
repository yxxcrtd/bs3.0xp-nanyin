<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.4</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-service-container</artifactId>
	<version>2.1.1</version>
	<description>此功能的目的是集成各个微服务,将各个微服务的启动类、配置文件集中化，让各个微服务只写业务代码</description>

	<dependencies>
		<dependency>
			<groupId>com.oracle</groupId>
			<artifactId>ojdbc6</artifactId>
			<version>11.2.0.1.0</version>
		</dependency>
		
		<!-- 中债一期 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-chb</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 中债三期 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-chb3</artifactId>
			<version>3.1.0</version>
		</dependency>
		
		<!-- 信批服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-disclosure</artifactId>
			<version>2.1.1</version>
		</dependency>

		<!-- 人行报表服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-pbc</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 中债共通服务 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-svrcom</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 估值核算 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>service-valuation</artifactId>
			<version>2.1.1</version>
		</dependency>
		
		<!-- 引入Actuator监控依赖 <dependency> <groupId>org.springframework.boot</groupId> 
			<artifactId>spring-boot-starter-actuator</artifactId> </dependency> -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>

			<!-- 打包源代码插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<configuration>
					<attach>true</attach>
				</configuration>
				<executions>
					<execution>
						<phase>compile</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
			</resource>
			<resource>
				<directory>${project.basedir}/src/main/resources</directory>
				<targetPath>${project.build.outputDirectory}</targetPath>
			</resource>
		</resources>
	</build>
</project>