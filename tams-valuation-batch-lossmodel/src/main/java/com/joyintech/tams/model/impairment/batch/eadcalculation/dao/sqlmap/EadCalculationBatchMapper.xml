	<!--查询存续期交易列表-->
	<select id="selectDurationTradeByAssetId" resultType="com.joyintech.tams.common.base.entity.ModEclResultProcess" >
		select A.PLAN_END_DATE PLAN_END_DATE,
       		   A.PS PS,
       		   A.IS_CLEAN IS_CLEAN,
       		   A.TRADE_AMT TRADE_AMT
		from MOD_ECL_RESULT_PROCESS A
		where A.ASSET_ID = #{assetId,jdbcType=VARCHAR}
		AND A.PS IN(#{PS_T22},#{PS_T23})
	</select>

