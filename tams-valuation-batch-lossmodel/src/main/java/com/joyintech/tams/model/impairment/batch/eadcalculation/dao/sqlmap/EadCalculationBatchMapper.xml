	<!-- 删除跑批日减值过程表  -->
    <delete id="deleteModelResultByDateAndEad" >
         delete from MOD_ECL_RESULT_PROCESS
        where DEC_DATE = #{decDate,jdbcType=DATE}
        	AND PROCESS = #{process}
		<if test="finprodIdList != null and finprodIdList.size > 0">
			AND (ASSET_ID IN
			<foreach collection="finprodIdList" item="item" index="index" open="( " close=" )" separator=",">
				<if test="(index % 998) == 0">
					null) OR ASSET_ID in (
				</if>
				#{item}
			</foreach>
			)
		</if>
    </delete>

	<!--查询买入交易列表 -->
	<select id="selectTradeInByDate" resultMap="BaseResultMap" >
		select
		<include refid="com.joyintech.tams.model.impairment.batch.eadcalculation.dao.EadCalculationBatchMapper.Base_Column_List" />
		from MOD_ECL_RESULT_PROCESS
		where DEC_DATE = #{decDate,jdbcType=DATE}
		AND PS = #{PS_T01}
		AND PROCESS = #{MODEL_DEC_PROCESS_02}
		<if test="finprodIdList != null and finprodIdList.size > 0">
			AND (ASSET_ID IN
			<foreach collection="finprodIdList" item="item" index="index" open="( " close=" )" separator=",">
				<if test="(index % 998) == 0">
					null) OR ASSET_ID in (
				</if>
				#{item}
			</foreach>
			)
		</if>
	</select>

	<!--查询卖出交易列表 -->
	<select id="selectTradeOutByDate" resultMap="BaseResultMap" >
		select
		<include refid="com.joyintech.tams.model.impairment.batch.eadcalculation.dao.EadCalculationBatchMapper.Base_Column_List" />
		from MOD_ECL_RESULT_PROCESS
		where DEC_DATE = #{decDate,jdbcType=DATE}
		AND PS IN(#{PS_T02},#{PS_T03},#{PS_T07},#{PS_T08},#{PS_T39})
		AND PROCESS = #{MODEL_DEC_PROCESS_01}
		<if test="finprodIdList != null and finprodIdList.size > 0">
			AND (ASSET_ID IN
			<foreach collection="finprodIdList" item="item" index="index" open="( " close=" )" separator=",">
