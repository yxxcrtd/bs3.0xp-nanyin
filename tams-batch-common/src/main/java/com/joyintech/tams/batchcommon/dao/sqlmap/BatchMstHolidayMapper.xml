<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.batchcommon.dao.BatchMstHolidayMapper">
    <!-- 是否节假日 -->
    <select id="getIsHoliday" parameterType="java.util.Map" resultType="String">
        SELECT
        IS_HOLIDAY
        FROM
        VAL_VW_MST_HOLIDAY
        WHERE CDATE = #{cdate}
        AND TRADE_CALENDAR_ID = #{calendarId}
    </select>


</mapper>