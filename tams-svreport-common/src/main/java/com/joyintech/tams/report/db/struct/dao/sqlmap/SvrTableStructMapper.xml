<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.report.db.struct.dao.SvrTableStructMapper">
    <select id="selectTableStruct" parameterType="java.util.Map"
        resultType="com.joyintech.tams.report.db.struct.dto.TableColumn" useCache="false" flushCache="true">
        <if test="databaseType == 'DB2'"> 
          
        </if>
        <if test="databaseType == 'Oracle'"> 
          SELECT
			TABLE_NAME as tableName,
			COLUMN_NAME as columnName,
			DATA_TYPE as dataType,
			DATA_LENGTH as dataLength,
			NULLABLE as nullable,
		    COLUMN_ID as columnId
		FROM
			USER_TAB_COLUMNS
		WHERE
			TABLE_NAME = '${table}'
		ORDER BY
			COLUMN_ID
        </if>
    </select>
</mapper>