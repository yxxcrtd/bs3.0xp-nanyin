<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.tams.report.common.dao.BaseInformationMapper_db2">
	<resultMap id="BaseResultMap"
		type="com.joyintech.tams.common.base.entity.BaseInformationDto">
		<id column="BASEINFORMATIONID" property="baseInformationId"
			jdbcType="VARCHAR" />
		<result column="BASETABLEID" property="baseTableId"
			jdbcType="VARCHAR" />
		<result column="BASETABLENAME" property="baseTableName"
			jdbcType="VARCHAR" />
		<result column="BASECOLUMNID" property="baseColumnId"
			jdbcType="VARCHAR" />
		<result column="BASECOLUMNNAME" property="baseColumnName"
			jdbcType="VARCHAR" />
		<result column="BASECOLUMNTYPE" property="baseColumnType"
			jdbcType="CHAR" />
		<result column="DATAOBJECT" property="dataObject"
			jdbcType="VARCHAR" />
		<result column="BUSINESSPKFLAG" property="businesspkFlag"
			jdbcType="CHAR" />
		<result column="DICTCODE" property="dictCode"
			jdbcType="VARCHAR" />
	</resultMap>
		
	<select id="queryBaseInfoPageByParams" resultType="Map" statementType="STATEMENT">
select * from (SELECT t.*,row_number() over() ROW_ID FROM ${tableId} t WHERE 
		<if test="list==null or list.size()==0">
			1=1
		</if>
		<foreach item="item" index="index" collection="list" open=" " separator="and" close=" ">
			<choose>
				<when test="item.baseColumnType == 'T'.toString()">
					${item.baseColumnId} LIKE '%${item.columnText}%'
				</when>
				<when test="item.baseColumnType == 'D'.toString()">
				TO_CHAR(${item.baseColumnId},'yyyy-mm-dd') <![CDATA[ >= ]]> '${item.startDate}'
				AND TO_CHAR(${item.baseColumnId},'yyyy-mm-dd') <![CDATA[ <= ]]> '${item.endDate}'
				</when>
				<when test="item.baseColumnType == 'S'.toString()">
					1=1 and ${item.baseColumnId} in
					<foreach collection="item.columnSeq" item="items" open="(" separator="," close=")">
    					'${items}'
    				</foreach>
				</when>
			</choose>
		</foreach>
		) 
		where
		ROW_ID &lt; ${endIndex} and ROW_ID &gt; ${beginIndex}
	</select>
	
	<select id="queryDateColumnList" resultType="java.lang.String" parameterType="java.lang.String">
		<if test="tableId != null">
		<!-- SELECT COLUMN_NAME FROM user_tab_columns WHERE TABLE_NAME = #{tableId,jdbcType=VARCHAR}
		AND DATA_TYPE ='DATE' -->
		SELECT COLNAME FROM SYSCAT.COLUMNS WHERE TABNAME = #{tableId,jdbcType=VARCHAR} AND TYPENAME ='DATE'
		</if>
	</select>
	
	<select id="queryTimeColumnList" resultType="java.lang.String" parameterType="java.lang.String">
		<if test="tableId != null">
		<!-- SELECT COLUMN_NAME FROM user_tab_columns WHERE TABLE_NAME = #{tableId,jdbcType=VARCHAR}
		AND DATA_TYPE LIKE '%TIMESTAMP%' -->
		SELECT COLNAME FROM SYSCAT.COLUMNS WHERE TABNAME = #{tableId,jdbcType=VARCHAR} AND TYPENAME LIKE '%TIMESTAMP%'
		</if>
	</select>
	
	<select id="queryAllColumns" resultType="java.lang.String" parameterType="java.lang.String">
		<if test="tableId != null">
		<!-- SELECT T.COLUMN_NAME FROM USER_COL_COMMENTS T 
		WHERE T.TABLE_NAME = #{tableId,jdbcType=VARCHAR} -->
		SELECT COLNAME FROM SYSCAT.COLUMNS WHERE TABNAME=#{tableId,jdbcType=VARCHAR}
		</if>
	</select>
	
	<insert id="insertBatch" parameterType="com.joyintech.tams.common.base.entity.BaseInformationDto">
  		INSERT ALL 
  		<foreach collection="insertList" item="item" index="index" separator="" >
  		INTO CHB_INFOMGR_CONFIG
  		(
  			BASEINFORMATIONID,        
			BASETABLEID,         
			BASECOLUMNID,         
			BASECOLUMNNAME,       
			BASECOLUMNTYPE,         
			BUSINESSPKFLAG,         
			DICTCODE
		) VALUES
  				( 
  					#{item.baseInformationId, jdbcType=VARCHAR},
  					#{item.baseTableId, jdbcType=VARCHAR},
  					#{item.baseColumnId, jdbcType=VARCHAR},
  					#{item.baseColumnName, jdbcType=VARCHAR},
  					#{item.baseColumnType, jdbcType=VARCHAR},
  					#{item.businesspkFlag, jdbcType=VARCHAR},
  					#{item.dictCode, jdbcType=VARCHAR}
  				)
  		</foreach>
  		SELECT 1 FROM sysibm.sysdummy1
	</insert>
</mapper>