<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.report.common.dao.ViewCompareDetailMapper">
    <select id="selectDetail" resultType="java.util.Map">
        select
        *
        from ${tableName}
        <where>
            <if test="condition != null">
                <foreach collection="condition" open="" close="" separator=" AND " item="item">
                    ${item.field} = ${item.value}
                </foreach>
            </if>
        </where>
        ${order}
    </select>
    <select id="selectBankCodeByOrgCode" resultType ="java.lang.String" parameterType="java.lang.String">
        SELECT T.REGIST_BANK_CODE FROM CHB_ORG_REGIST_BANK_CODE T WHERE T.ORG_CODE = #{orgCode, jdbcType=VARCHAR}
    </select>
</mapper>