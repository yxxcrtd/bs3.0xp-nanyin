	<delete id="deleteRepProdDeclare">
		delete from REP_PROD_DECLARE
		where REP_FINPROD_ID in
		<foreach collection="repFinprodIdList" item="item" index="index" open="(" close=")" separator=",">
        #{item}
        </foreach>
	</delete>
	
	<delete id="deleteRepProdIssue">
		delete from REP_PROD_ISSUE
		where REP_FINPROD_ID in
		<foreach collection="repFinprodIdList" item="item" index="index" open="(" close=")" separator=",">
        #{item}
        </foreach>
	</delete>
	
	<update id="updateFinProduct" parameterType="com.joyintech.tams.common.base.entity.FinProduct" >
		update FIN_PRODUCT set ENTRUST_TYPE = #{entrustType,jdbcType=VARCHAR}
		where FINPROD_ID = #{finprodId}
	</update>
