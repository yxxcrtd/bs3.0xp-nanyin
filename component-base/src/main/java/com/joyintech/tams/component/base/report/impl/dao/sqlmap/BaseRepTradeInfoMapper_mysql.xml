<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.component.base.report.impl.dao.BaseRepTradeInfoMapper_mysql" >
	<delete id="delete" >
		DELETE FROM REP_TRADE 
		<where>
			REP_BANK_TRADE_CODE in 
			<foreach collection="bankTradeCodeList" item="item" index="index" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</where>
	</delete>

	<delete id="deleteRepAssetDeri" >
		DELETE FROM REP_ASSET_DERI
		<where>
			REP_FINPROD_ID in
			<foreach collection="list" item="item" index="index" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</where>
	</delete>

	<select id="selectTradeComponent" resultType="java.lang.String">
		SELECT COUNTER_NAME FROM MST_COUNTER_PARTY WHERE COUNTER_ID = #{counterId}
	</select>
</mapper>