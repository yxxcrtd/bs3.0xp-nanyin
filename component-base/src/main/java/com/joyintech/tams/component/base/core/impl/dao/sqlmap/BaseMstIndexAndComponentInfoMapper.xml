<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.tams.component.base.core.impl.dao.BaseMstIndexAndComponentInfoMapper">
	<resultMap id="MstIndexInfoMap"
		type="com.joyintech.tams.common.base.entity.MstIndexInfo">
		<id column="INDEX_ID" property="indexId" jdbcType="VARCHAR" />
		<result column="INDEX_TYPE" property="indexType" jdbcType="VARCHAR" />
		<result column="INDEX_NAME" property="indexName" jdbcType="VARCHAR" />
		<result column="REMARK" property="remark" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap id="MstIndexComponentMap"
		type="com.joyintech.tams.common.base.entity.MstIndexComponent">
		<id column="INDEX_ID" property="indexId" jdbcType="VARCHAR" />
		<id column="VALUE_SOURCE" property="valueSource" jdbcType="VARCHAR" />
		<id column="COMPONENT_ID" property="componentId" jdbcType="VARCHAR" />
		<id column="COMPONENT_TYPE" property="componentType" jdbcType="VARCHAR" />
		<result column="WEIGHT" property="weight" jdbcType="DECIMAL" />
		<result column="REMARK" property="remark" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap
		type="com.joyintech.tams.component.base.core.dto.BaseMstIndexAndComponentInfoDto"
		id="BaseMstIndexAndComponentInfoDtoMap">
		<association property="mstIndexInfo"
			javaType="com.joyintech.tams.common.base.entity.MstIndexInfo">
			<id column="INDEX_ID" property="indexId" jdbcType="VARCHAR" />
			<result column="INDEX_TYPE" property="indexType" jdbcType="VARCHAR" />
			<result column="INDEX_NAME" property="indexName" jdbcType="VARCHAR" />
			<result column="REMARK" property="remark" jdbcType="VARCHAR" />
			<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
			<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
			<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
			<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
			<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		</association>
		<collection property="mstIndexComponents"
			ofType="com.joyintech.tams.common.base.entity.MstIndexComponent">
			<id column="INDEX_ID" property="indexId" jdbcType="VARCHAR" />
			<id column="VALUE_SOURCE" property="valueSource" jdbcType="VARCHAR" />
			<id column="COMPONENT_ID" property="componentId" jdbcType="VARCHAR" />
			<id column="COMPONENT_TYPE" property="componentType" jdbcType="VARCHAR" />
			<result column="WEIGHT" property="weight" jdbcType="DECIMAL" />
			<result column="REMARK" property="remark" jdbcType="VARCHAR" />
			<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
			<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
			<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
			<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
			<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		</collection>
	</resultMap>
	<select id="queryIndexInfo" resultMap="MstIndexInfoMap">
		select
		INDEX_ID , INDEX_TYPE , INDEX_NAME , REMARK
		, CREATE_USER
		,CREATE_DEPT , CREATE_TIME ,
		UPDATE_USER ,UPDATE_TIME
		from
		MST_INDEX_INFO
		<where>
			<if test="indexId !=null">
				and INDEX_ID = #{indexId,jdbcType=VARCHAR}
			</if>
			<if test="indexType !=null">
				and INDEX_TYPE = #{indexType,jdbcType=VARCHAR}
			</if>
		</where>
	</select>
	<delete id="deleteByPrimaryKey">
		delete from MST_INDEX_COMPONENT
		<where>
			<if test="indexId != null">
				and INDEX_ID = #{indexId,jdbcType=VARCHAR}
			</if>
			<if test="valueSource != null">
				and VALUE_SOURCE = #{valueSource,jdbcType=VARCHAR}
			</if>
			<if test="componentId != null">
				and COMPONENT_ID = #{componentId,jdbcType=VARCHAR}
			</if>
			<if test="componentType != null">
				and COMPONENT_TYPE = #{componentType,jdbcType=VARCHAR}
			</if>
		</where>
	</delete>
	<select id="queryIndexInfoContainsElement" resultMap="BaseMstIndexAndComponentInfoDtoMap">
		select
		A.INDEX_ID,A.INDEX_TYPE,A.INDEX_NAME,A.REMARK,A.CREATE_USER,A.CREATE_DEPT,A.CREATE_TIME,A.UPDATE_USER,
		A.UPDATE_TIME,B.INDEX_ID,B.VALUE_SOURCE,B.COMPONENT_ID,B.COMPONENT_TYPE,B.WEIGHT,B.REMARK,B.CREATE_USER,
		B.CREATE_DEPT,B.CREATE_TIME,B.UPDATE_USER,B.UPDATE_TIME
		from
		MST_INDEX_INFO A left join MST_INDEX_COMPONENT B where
		A.INDEX_ID=B.INDEX_ID
		<if test="indexId !=null">
			and A.INDEX_ID = #{indexId,jdbcType=VARCHAR}
		</if>
		<if test="indexType !=null">
			and A.INDEX_TYPE = #{indexType,jdbcType=VARCHAR}
		</if>
		<if test="componentId != null">
			and B.COMPONENT_ID = #{componentId,jdbcType=VARCHAR}
		</if>
		<if test="componentType != null">
			and B.COMPONENT_TYPE = #{componentType,jdbcType=VARCHAR}
		</if>
	</select>
</mapper>