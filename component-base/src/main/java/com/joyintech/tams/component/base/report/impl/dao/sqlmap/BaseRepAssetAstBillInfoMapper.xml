<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.component.base.report.impl.dao.BaseRepAssetAstBillInfoMapper" >
	<select id="select"  resultType="com.joyintech.tams.common.base.entity.RepAssetAstBill">
		SELECT 
			*
		FROM REP_ASSET_AST_BILL
        <where> REP_FINPROD_ID in 
        	<foreach collection="finprodIdList" item="item" index="index" open="(" close=")" separator=",">
        		#{item}
        	</foreach>
        </where>
	</select>

	<delete id="delete" >
	DELETE FROM REP_ASSET_AST_BILL 
	<where>
		REP_FINPROD_ID in 
		<foreach collection="finprodIdList" item="item" index="index" open="(" close=")" separator=",">
			#{item}
		</foreach>
	</where>
	</delete>
</mapper>