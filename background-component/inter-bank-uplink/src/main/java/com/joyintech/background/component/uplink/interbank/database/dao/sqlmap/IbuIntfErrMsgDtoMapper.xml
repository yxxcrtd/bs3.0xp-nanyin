<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.background.component.uplink.interbank.database.dao.IbuIntfErrMsgDtoMapper">
	<resultMap type="com.joyintech.background.component.uplink.interbank.business.dto.IbuIntfErrMsgDto" id="IbuIntfErrMsgMap">
        <id column="ERR_CODE" property="errCode" jdbcType="VARCHAR" />
        <id column="ERR_MSG" property="errMsg" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<resultMap type="com.joyintech.background.component.uplink.interbank.business.dto.IbuQuoteErrlogDto" id="IbuQuoteErrlogMap">
        <id column="I_Q_E_M_QUOTE_ID" property="quoteId" jdbcType="VARCHAR" />
        <id column="I_Q_E_M_VERSION" property="version" jdbcType="DECIMAL" />
        <result column="I_Q_E_M_ERR_CODE" property="errCode" jdbcType="VARCHAR" />
        <result column="I_Q_E_M_ERR_MSG" property="errMsg" jdbcType="VARCHAR" />
        <result column="I_Q_E_M_CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="I_Q_E_M_CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="I_Q_E_M_CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="I_Q_E_M_UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="I_Q_E_M_UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>

	<sql id="Base_Column_List" >
		ERR_CODE ERR_CODE, ERR_MSG ERR_MSG, CREATE_USER CREATE_USER, CREATE_DEPT CREATE_DEPT, 
        CREATE_TIME CREATE_TIME, UPDATE_USER UPDATE_USER, UPDATE_TIME UPDATE_TIME
    </sql>
    
    <sql id="Iqem_Column_List" >
		QUOTE_ID I_Q_E_M_QUOTE_ID, VERSION I_Q_E_M_VERSION, ERR_CODE I_Q_E_M_ERR_CODE, ERR_MSG I_Q_E_M_ERR_MSG, CREATE_USER I_Q_E_M_CREATE_USER, 
        CREATE_DEPT I_Q_E_M_CREATE_DEPT, CREATE_TIME I_Q_E_M_CREATE_TIME, UPDATE_USER I_Q_E_M_UPDATE_USER, UPDATE_TIME I_Q_E_M_UPDATE_TIME
    </sql>
    
    <!-- 根据错误码和错误信息模糊查询 -->
    <select id="selectIbuIntfErrMsg" parameterType="com.joyintech.background.component.uplink.interbank.business.dto.IbuInrfErrMsgSearchDto" resultMap="IbuIntfErrMsgMap">
    	select 
			<include refid="Base_Column_List" />
        from IBU_INTF_ERR_MSG
        <where> 1=1
        	<if test="errCode != null and errCode != ''">
        		and ERR_CODE LIKE concat('%',concat(#{errCode,jdbcType=VARCHAR},'%'))
        	</if>
        	<if test="errMsg != null and errMsg != ''">
        		and ERR_MSG LIKE concat('%',concat(#{errMsg,jdbcType=VARCHAR},'%'))
        	</if>
        </where>
    </select>
    
    <!-- 根据错误码查询 -->
    <select id="selectByErrCode" parameterType="java.lang.String" resultMap="IbuIntfErrMsgMap">
    	select 
			<include refid="Base_Column_List" />
        from IBU_INTF_ERR_MSG
        where ERR_CODE = #{errCode,jdbcType=VARCHAR}
    </select>
    
    <!-- 根据报价编号查询错误日志 -->
    <select id="selectErrlogByQuoteId" parameterType="java.lang.String" resultMap="IbuQuoteErrlogMap">
    	select 
			a.QUOTE_ID    I_Q_E_M_QUOTE_ID,
		    a.VERSION     I_Q_E_M_VERSION,
		    a.ERR_CODE    I_Q_E_M_ERR_CODE,
		    a.ERR_MSG     I_Q_E_M_ERR_MSG,
		    a.CREATE_USER I_Q_E_M_CREATE_USER,
		    a.CREATE_DEPT I_Q_E_M_CREATE_DEPT,
		    a.CREATE_TIME I_Q_E_M_CREATE_TIME,
		    a.UPDATE_USER I_Q_E_M_UPDATE_USER,
		    a.UPDATE_TIME I_Q_E_M_UPDATE_TIME
        from IBU_QUOTE_ERRLOG a
        INNER JOIN
		    (
		        SELECT
		            MAX(version) version,
		            QUOTE_ID
		        FROM
		            IBU_QUOTE_ERRLOG
		        WHERE
		            QUOTE_ID = #{quoteId,jdbcType=VARCHAR}
		        GROUP BY
		            QUOTE_ID) b
		ON
		    a.QUOTE_ID = b.QUOTE_ID
		AND a.VERSION = b.version
    </select>
    
    <!-- 删除错误信息 -->
    <delete id="deleteIbuQuoteErrlog" parameterType="java.lang.String">
    	delete from IBU_QUOTE_ERRLOG
    	where QUOTE_ID = #{quoteId,jdbcType=VARCHAR}
    </delete>
    
    <select id="getVersion" resultType="long">
    	SELECT
		    SEQ_IBU_QUOTE_ERRLOG.Nextval
		FROM
		    dual
    </select>

</mapper>