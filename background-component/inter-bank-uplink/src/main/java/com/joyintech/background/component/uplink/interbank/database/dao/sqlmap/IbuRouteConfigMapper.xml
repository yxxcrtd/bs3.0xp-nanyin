<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.background.component.uplink.interbank.database.dao.IbuRouteConfigMapper" >
	<resultMap id="QuoteSchemeMap" type="com.joyintech.background.component.uplink.interbank.business.dto.RouteConfigSubDto" >
        <result column="SCHEME_ID" property="schemeId" jdbcType="VARCHAR" />
        <result column="ARRT_GRP_ID" property="arrtGrpId" jdbcType="VARCHAR" />
        <result column="SEND_TYPE" property="sendType" jdbcType="VARCHAR" />
        <result column="RESULT_WAIT_TYPE" property="resultWaitType" jdbcType="VARCHAR" />
        <result column="RECEIVE_TYPE" property="receiveType" jdbcType="VARCHAR" />
        <collection column="ARRT_GRP_ID" property="atrrList" ofType="com.joyintech.background.component.uplink.interbank.database.entity.IbuIntfAttrConfig">
        	<result column="ATTR_ID" property="attrId" jdbcType="VARCHAR" />
        	<result column="ATTR_VALUE" property="attrValue" jdbcType="VARCHAR" />
        	<result column="ATTR_TYPE" property="attrType" jdbcType="VARCHAR" />
        </collection>
    </resultMap>
    
	<!-- 获取默认路由配置方案 -->
    <select id="getDefaultScheme" parameterType="java.lang.String" resultMap="com.joyintech.background.component.uplink.interbank.database.dao.IbuIntfSchemeMapper.BaseResultMap">
       select 
        <include refid="com.joyintech.background.component.uplink.interbank.database.dao.IbuIntfSchemeMapper.Base_Column_List" />
        from IBU_INTF_SCHEME
        where ISDEFAULT = #{yes,jdbcType=VARCHAR}
    </select>
    
    <!--  获取所有配置方案 -->
    <select id="queryALLScheme" resultMap="QuoteSchemeMap">
       select 
         iiqs.SCHEME_ID,
         iiqs.ARRT_GRP_ID,
         iis.SEND_TYPE,
         iis.RESULT_WAIT_TYPE,
         iis.RECEIVE_TYPE,
         iiac.ATTR_ID,
         iiac.ATTR_VALUE,
         iiac.ATTR_TYPE
        from IBU_INTF_SCHEME iis
        inner join IBU_INTF_QUOTE_SCHEME iiqs
          on iis.SCHEME_ID = iiqs.SCHEME_ID
        inner join IBU_INTF_ATTR_CONFIG iiac
          on iiqs.ARRT_GRP_ID = iiac.ARRT_GRP_ID
    </select>
    
    <!--  将默认方案更新为非默认方案 -->
    <update id="updateIsdefaultToNo" parameterType="java.util.Map" >
       update IBU_INTF_SCHEME
        set ISDEFAULT = #{no,jdbcType=VARCHAR}
        where ISDEFAULT = #{yes,jdbcType=VARCHAR}
    </update>
    
    <!--  批量插入银行间上行报价属性配置 -->
    <insert id="batchInsertAttrTable" parameterType="java.util.List">
	    insert into IBU_INTF_ATTR_CONFIG (ARRT_GRP_ID, ATTR_ID, ATTR_VALUE, 
	            ATTR_TYPE, CREATE_USER, CREATE_DEPT, 
	            CREATE_TIME, UPDATE_USER, UPDATE_TIME
	            )
	   	<foreach collection="list" item="item" separator="from dual union all select" open="select * from (select "
                 close=" from dual)">
	         #{item.arrtGrpId,jdbcType=VARCHAR}, #{item.attrId,jdbcType=VARCHAR}, #{item.attrValue,jdbcType=VARCHAR}, 
	            #{item.attrType,jdbcType=VARCHAR}, #{item.createUser,jdbcType=VARCHAR}, #{item.createDept,jdbcType=VARCHAR}, 
	            #{item.createTime,jdbcType=TIMESTAMP}, #{item.updateUser,jdbcType=VARCHAR}, #{item.updateTime,jdbcType=TIMESTAMP}
	          
    	</foreach>
	</insert>
</mapper>