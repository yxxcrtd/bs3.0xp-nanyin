<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.disclosure.rptdata.dao.SettReportMapper">
    
   <select id="selectBokBalance" resultType="com.joyintech.tams.common.base.entity.BokBalance">
		SELECT 
		    BOOKSET_ID
			,BALANCE_DATE
			,SUBJECT_NO
			,O_CCY
			,O_AMT
			,TDY_O_D_AMT
		from BOK_BALANCE bb
		WHERE 1=1
		AND STATUS='E'
		<if test="prodId!=null">
			and bb.BOOKSET_ID=#{prodId,jdbcType=VARCHAR}
		</if>
		<if test="reportDate!=null">
			and bb.BALANCE_DATE=#{reportDate,jdbcType=DATE}
		</if>
    </select>
    
    
    <select id="selectWeekend" parameterType="DATE" resultType="DATE">
    	select 
    </select>
    
</mapper>