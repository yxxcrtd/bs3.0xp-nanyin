<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="MstSharePrice.xlsx" name="股票行情信息">
    <Worksheet javaBean="com.joyintech.tams.common.basicdata.marketdata.mstshareprice.dto.ComSharePriceDto">
        <Row>
            <Cell order="1" name="资产代码">sharesId</Cell>
            <Cell order="2" name="资产简称">finprodAbbr</Cell>
            <Cell order="3" name="总股本">sShares</Cell>
            <Cell order="4" name="流通股本">cShares</Cell>
            <Cell order="5" name="交易日期">dealDateStr</Cell>
            <Cell order="6" name="昨收盘价">preClosePrice</Cell>
            <Cell order="7" name="开盘价">openPrice</Cell>
            <Cell order="8" name="最高价">highPrice</Cell>
            <Cell order="9" name="最低价">lowPrice</Cell>
            <Cell order="10" name="收盘价">closePrice</Cell>
            <Cell order="11" name="涨跌">change</Cell>
            <Cell order="12" name="涨跌幅">changePercent</Cell>
            <Cell order="13" name="成交量">dealValume</Cell>
            <Cell order="14" name="成交金额">dealAmount</Cell>
            <Cell order="15" name="均价">avgPrice</Cell>
            <Cell order="16" name="复权昨收盘价">preClosePriceAdj</Cell>
            <Cell order="17" name="复权开盘价">openPriceAdj</Cell>
            <Cell order="18" name="复权最高价">highPriceAdj</Cell>
            <Cell order="19" name="复权最低价">lowPriceAdj</Cell>
            <Cell order="20" name="复权收盘价">closePriceAdj</Cell>
            <Cell order="21" name="复权因子">factorAdj</Cell>
            <Cell order="21" name="交易状态">tradeStatusStr</Cell>
        </Row>
    </Worksheet>
</Workbook>