<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-valuation-report</artifactId>
	<version>2.0.0</version>
	<name>tams-valuation-report</name>
	<description>估值核算报表公用</description>

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.3</version>
	</parent>

	<dependencies>
		<dependency>
			<groupId>dom4j</groupId>
			<artifactId>dom4j</artifactId>
		</dependency>

		<!-- add new for xingXiPiLu -->
		<dependency>
			<groupId>com.alibaba</groupId>
			<artifactId>fastjson</artifactId>
			<version>1.2.61</version>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>dc-client</artifactId>
			<version>3.2</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-valuation-common</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-calculation</artifactId>
			<version>2.0.5.2.1</version>
		</dependency>
		<dependency>
			<groupId>net.sf</groupId>
			<artifactId>jasperreports</artifactId>
			<version>6.4.31</version>
		</dependency>
		<dependency>
			<groupId>com.jaspersoft</groupId>
			<artifactId>jasperserver-api-common</artifactId>
			<version>7.1.0</version>
		</dependency>
		<dependency>
			<groupId>com.jaspersoft</groupId>
			<artifactId>jasperserver-api-common-impl</artifactId>
			<version>7.1.0</version>
		</dependency>
		<dependency>
			<groupId>com.jaspersoft</groupId>
			<artifactId>jasperserver-api-metadata</artifactId>
			<version>7.1.0</version>
		</dependency>
		<dependency>
			<groupId>com.jaspersoft</groupId>
			<artifactId>jasperserver-api-metadata-impl</artifactId>
			<version>7.1.0</version>
		</dependency>
	</dependencies>
	
	<build>
	   <plugins>
		  <!-- 打包源代码插件 -->
		  <plugin>
			 <groupId>org.apache.maven.plugins</groupId>
			 <artifactId>maven-source-plugin</artifactId>
			 <version>2.4</version>
			 <configuration>
				<attach>true</attach>
			 </configuration>
			 <executions>
				<execution>
				   <phase>compile</phase>
				   <goals>
					  <goal>jar</goal>
				   </goals>
				</execution>
			 </executions>
		  </plugin>
	   </plugins>
	</build>
	
</project>
