<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.interf.trade.fromxp.dao.InterfServiceLogMapper">
	<resultMap id="InterfServiceLogResult" type="com.joyintech.tams.invest.interf.trade.common.dto.InterfServiceLogDto" >
        <result column="ID" property="id" jdbcType="VARCHAR" />
        <result column="INTERF_CODE" property="interfCode" jdbcType="VARCHAR" />
        <result column="INTERF_NAME" property="interfName" jdbcType="VARCHAR" />
        <result column="INTERF_TYPE" property="interfType" jdbcType="VARCHAR" />
        <result column="INTERF_SYSTEM" property="interfSystem" jdbcType="VARCHAR" />
        <result column="INTERF_STATUS" property="interfStatus" jdbcType="VARCHAR" />
        <result column="INTERF_MSGBODY" property="interfMsgbody" jdbcType="VARCHAR" />
        <result column="INTERF_REMARK" property="interfRemark" jdbcType="VARCHAR" />
        <result column="EXECUTE_INFO" property="executeInfo" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="VARCHAR" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="DECIMAL" />
    </resultMap>
    
    <resultMap id="InterfServiceConfigResult" type="com.joyintech.tams.invest.interf.trade.common.dto.InterfServiceConfigDto" >
        <result column="INTERF_CODE" property="interfCode" jdbcType="VARCHAR" />
        <result column="INTERF_NAME" property="interfName" jdbcType="VARCHAR" />
        <result column="INTERF_TYPE" property="interfType" jdbcType="VARCHAR" />
        <result column="INTERF_SYSTEM" property="interfSystem" jdbcType="VARCHAR" />
        <result column="INTERF_STATUS" property="interfStatus" jdbcType="VARCHAR" />
        <result column="INTERF_REMARK" property="interfRemark" jdbcType="VARCHAR" />
        <result column="BUSINESS_SERVICE" property="businessService" jdbcType="VARCHAR" />
        <result column="BUSINESS_METHOD" property="businessMethod" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="VARCHAR" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="DECIMAL" />
    </resultMap>
    
	<!-- 查询满足条件的接口服务日志 -->
	<select id="searchInterfServiceLog" resultMap="InterfServiceLogResult" parameterType="com.joyintech.tams.invest.interf.trade.common.dto.InterfServiceLogDto">
		select ID,INTERF_CODE,INTERF_NAME,INTERF_TYPE,INTERF_SYSTEM,INTERF_STATUS,INTERF_MSGBODY,INTERF_REMARK,EXECUTE_INFO,CREATE_USER,CREATE_DEPT,CREATE_TIME,UPDATE_USER,UPDATE_TIME 
			from INTERF_SERVICE_LOG where INTERF_STATUS=#{interfStatus,jdbcType=VARCHAR} and INTERF_SYSTEM=#{interfSystem,jdbcType=VARCHAR}
	</select>
	
	<!-- 更新满足条件的接口服务日志状态 -->
	<update id="updateInterfServiceLogStatus" parameterType="java.util.Map">
		update INTERF_SERVICE_LOG set INTERF_STATUS=#{interfStatus,jdbcType=VARCHAR} where INTERF_SYSTEM=#{interfSystem,jdbcType=VARCHAR} and ID in
		<foreach item="item" index="index" collection="ids" open="(" separator="," close=")">
	  			#{item, jdbcType=VARCHAR}
		</foreach>
	</update>
	
	<!--  通过状态和id更新接口服务日志状态 -->
	<update id="updateInterfServiceLogStatusByStatusAndId" parameterType="java.util.Map">
		update INTERF_SERVICE_LOG set INTERF_STATUS=#{newStatus,jdbcType=VARCHAR} where INTERF_SYSTEM=#{interfSystem,jdbcType=VARCHAR} and ID=#{id,jdbcType=VARCHAR} and INTERF_STATUS=#{oldStatus,jdbcType=VARCHAR}
	</update>
	
	<!-- 查询满足条件的接口服务配置 -->
	<select id="searchInterfServiceConfig" resultMap="InterfServiceConfigResult" parameterType="com.joyintech.tams.invest.interf.trade.common.dto.InterfServiceConfigDto">
		select INTERF_CODE,INTERF_NAME,INTERF_TYPE,INTERF_SYSTEM,INTERF_STATUS,INTERF_REMARK,BUSINESS_SERVICE,BUSINESS_METHOD,CREATE_USER,CREATE_DEPT,CREATE_TIME,UPDATE_USER,UPDATE_TIME
			from INTERF_SERVICE_CONFIG where INTERF_STATUS=#{interfStatus,jdbcType=VARCHAR} and INTERF_SYSTEM=#{interfSystem,jdbcType=VARCHAR} and INTERF_CODE=#{interfCode,jdbcType=VARCHAR}
	</select>
</mapper>