<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.autoperiod.ptlreceinfo.dao.PtlReceInfoMapper">
   <select id="finCashCalcRuleList" resultType="com.joyintech.tams.common.base.entity.FinCashCalcRule" parameterType="java.lang.String">
      SELECT
          CASH_ID,
          EFF_DATE,
          CALC_TYPE,
          BASE_TYPE,
          BASE_DATE_TYPE,
          BASIS,
          YIELD,
          IS_INITIAL,
          FINPROD_ID,
          FINPROD_TYPE,
          FINPROD_TYPE2,
          BRANCH,
          REMARK,
          CREATE_USER,
          CREATE_DEPT,
          CREATE_TIME,
          UPDATE_USER,
          UPDATE_TIME
      FROM
          FIN_CASH_CALC_RULE
        where
        CASH_ID = #{CASH_ID}
   </select>
   <resultMap id="ptlReceInfoMap" type="com.joyintech.tams.invest.common.autoperiod.ptlreceinfo.dto.PtlReceInfo">
      <id column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR" />
      <id column="BRANCH" property="branch" jdbcType="DECIMAL" />
      <id column="CASH_ID" property="cashId" jdbcType="VARCHAR" />
      <result column="FINPROD_TYPE" property="finprodType" jdbcType="VARCHAR" />
      <result column="FINPROD_TYPE2" property="finprodType2" jdbcType="VARCHAR" />
      <result column="PROFIT_TYPE" property="profitType" jdbcType="VARCHAR" />
      <result column="BRANCH_TYPE" property="branchType" jdbcType="VARCHAR" />
      <result column="CHL_AGRT_ID" property="chlAgrtId" jdbcType="VARCHAR" />
      <result column="PRIN" property="prin" jdbcType="DECIMAL" />
      <result column="CCY" property="ccy" jdbcType="VARCHAR" />
      <result column="VDATE" property="vdate" jdbcType="DATE" />
      <result column="MDATE" property="mdate" jdbcType="DATE" />
      <result column="TERM" property="term" jdbcType="DECIMAL" />
      <result column="INT_TYPE" property="intType" jdbcType="VARCHAR" />
      <result column="INT_RATE" property="intRate" jdbcType="DECIMAL" />
      <result column="INT_RATE_ID" property="intRateId" jdbcType="VARCHAR" />
      <result column="BASIS" property="basis" jdbcType="VARCHAR" />
      <result column="M_PRIN_AMT" property="mPrinAmt" jdbcType="DECIMAL" />
      <result column="M_INT_AMT" property="mIntAmt" jdbcType="DECIMAL" />
      <result column="M_TRADE_AMT" property="mTradeAmt" jdbcType="DECIMAL" />
      <result column="CAPI_INCOME_FEATURE" property="capiIncomeFeature" jdbcType="VARCHAR" />
      <result column="O_FINPROD_ID" property="oFinprodId" jdbcType="VARCHAR" />
      <result column="TRADE_MARKET" property="tradeMarket" jdbcType="VARCHAR" />
      <result column="CALENDAR_ID" property="calendarId" jdbcType="VARCHAR" />
      <result column="TERM_TYPE" property="termType" jdbcType="VARCHAR" />
      <result column="COUNTER_ID" property="counterId" jdbcType="VARCHAR" />
      <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
      <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
      <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
      <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
      <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
      <result column="M_UNIT_CPRICE" property="mUnitCprice" jdbcType="DECIMAL" />
      <result column="M_UNIT_INT" property="mUnitInt" jdbcType="DECIMAL" />
      <result column="M_UNIT_FPRICE" property="mUnitFprice" jdbcType="DECIMAL" />
      <result column="M_YIELD" property="mYield" jdbcType="DECIMAL" />
      <result column="M_DELIVERY_TYPE" property="mDeliveryType" jdbcType="VARCHAR" />
      <result column="VPAY_DATE" property="vpayDate" jdbcType="DATE" />
      <result column="MPAY_DATE" property="mpayDate" jdbcType="DATE" />
      <result column="CONTRACT_NO" property="contractNo" jdbcType="VARCHAR" />
      <result column="ACT_CAP_DAYS" property="actCapDays" jdbcType="DECIMAL" />
      <result column="IRS_TYPE" property="irsType" jdbcType="VARCHAR" />
      <result column="EXC_PS" property="excPs" jdbcType="VARCHAR" />
      <result column="CUR_PAIR" property="curPair" jdbcType="VARCHAR" />
      <result column="EXC_FXS_TERM_TYPE" property="excFxsTermType" jdbcType="VARCHAR" />
      <result column="USD_AMT" property="usdAmt" jdbcType="DECIMAL" />
      <result column="DIF_SETTLE_REF_RATE" property="difSettleRefRate" jdbcType="VARCHAR" />
      <result column="CONFLICT_SOLVE_WAY" property="conflictSolveWay" jdbcType="VARCHAR" />
      <result column="PERIOD_ID" property="periodId" jdbcType="VARCHAR" />
      <result column="IS_RUSH_BACK" property="isRushBack" jdbcType="VARCHAR" />
      <result column="PAY_DATE" property="payDate" jdbcType="DATE" />
      <collection column="CASH_ID" property="finCashCalcRuleList" select="finCashCalcRuleList" javaType="java.util.ArrayList" ofType="com.joyintech.tams.common.base.entity.FinCashCalcRule" />
      <collection column="CASH_ID" property="finCashPlanList" select="finCashPlanList" javaType="java.util.ArrayList" ofType="com.joyintech.tams.common.base.entity.FinCashPlan" />
   </resultMap>
   <select id="finCashPlanList" resultType="com.joyintech.tams.common.base.entity.FinCashPlan" parameterType="java.lang.String">
   SELECT
       CASH_ID,
       CASH_NUM,
       CASH_TYPE,
       VDATE_UNADJUST,
       MDATE_UNADJUST,
       PAY_DATE_UNADJUST,
       VDATE,
       MDATE,
       PAY_DATE,
       TERMDAYS,
       VDATE_Y,
       VDATE_TERM,
       MDATE_TERM,
       TERMDAYS_TERM,
       PRIN_AMT,
       INT_PRIN_AMT,
       INT_AMT,
       IS_PAY_INT,
       CASH_AMT,
       CASH_BASEAMT,
       CASH_UNIT_TYPE,
       CALC_FUNCTION,
       FREQUENCY,
       FINPROD_ID,
       FINPROD_TYPE,
       FINPROD_TYPE2,
       BRANCH,
       PAY_TYPE,
       RANGE_YIELD,
       REMARK,
       CREATE_USER,
       CREATE_DEPT,
       CREATE_TIME,
       UPDATE_USER,
       UPDATE_TIME,
       REPAY_WITHOUT_INT
   FROM
       FIN_CASH_PLAN
       where
       CASH_ID = #{CASH_ID}
   </select>
   <select id="genPtlReceInfo" resultMap="ptlReceInfoMap">
        SELECT
          ftp.FINPROD_ID,
          ftp.BRANCH,
          ftp.FINPROD_TYPE,
          ftp.FINPROD_TYPE2,
          ftp.PROFIT_TYPE,
          ftp.BRANCH_TYPE,
          ftp.CHL_AGRT_ID,
          ftp.PRIN,
          ftp.CCY,
          ftp.VDATE,
          ftp.MDATE,
          ftp.TERM,
          ftp.INT_TYPE,
          ftp.INT_RATE,
          ftp.INT_RATE_ID,
          ftp.BASIS,
          ftp.M_PRIN_AMT,
          ftp.M_INT_AMT,
          ftp.M_TRADE_AMT,
          ftp.CAPI_INCOME_FEATURE,
          ftp.O_FINPROD_ID,
          ftp.TRADE_MARKET,
          ftp.CALENDAR_ID,
          ftp.TERM_TYPE,
          ftp.COUNTER_ID,
          ftp.CREATE_USER,
          ftp.CREATE_DEPT,
          ftp.CREATE_TIME,
          ftp.UPDATE_USER,
          ftp.UPDATE_TIME,
          ftp.M_UNIT_CPRICE,
          ftp.M_UNIT_INT,
          ftp.M_UNIT_FPRICE,
          ftp.M_YIELD,
          ftp.M_DELIVERY_TYPE,
          ftp.VPAY_DATE,
          ftp.MPAY_DATE,
          ftp.CONTRACT_NO,
          ftp.ACT_CAP_DAYS,
          ftp.IRS_TYPE,
          ftp.EXC_PS,
          ftp.CUR_PAIR,
          ftp.EXC_FXS_TERM_TYPE,
          ftp.USD_AMT,
          ftp.DIF_SETTLE_REF_RATE,
          ftp.CONFLICT_SOLVE_WAY,
          ftp.PERIOD_ID,
          ftp.IS_RUSH_BACK,
          fcp.CASH_ID CASH_ID
      FROM
          FIN_TRADE_PRODUCT ftp
    left join FIN_CASH_INFO fci on ftp.FINPROD_ID = fci.FINPROD_ID and fci.BRANCH = ftp.BRANCH and fci.CASH_TYPE_2 = #{CASH_TYPE_2_FX}
    left join FIN_CASH_PLAN fcp on ftp.FINPROD_ID = fcp.FINPROD_ID and ftp.MDATE = fcp.MDATE and fcp.BRANCH = #{BRANCH_0}
    and fcp.CASH_TYPE in (#{CASH_CLASS_TYPE_DQSX},#{CASH_CLASS_TYPE_ZJSX})
    where
    ftp.FINPROD_ID = #{finprodId}
    and ftp.BRANCH = #{branch}
   </select>
</mapper>