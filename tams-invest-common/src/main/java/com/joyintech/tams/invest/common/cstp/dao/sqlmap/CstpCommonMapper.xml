<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.cstp.dao.CstpCommonMapper">

    <!--成交编号 查找对应的报价及指令信息-->
    <!--quoteIdFlag 01 表示有报价有委托 02表示有报价无委托 03表示无报价无委托,不会出现 -->
    <select id="selectQuoId" resultType="java.lang.String">
        SELECT
            TT.QUOTE_ID
        FROM
            (
            SELECT
                T1.QUOTE_ID ,
                T1.ENTRUST_ID,
                T2.EXECID,
                T1.PORTFOLIO_ID
            FROM
                IBU_QUOTE_BOND T1
            LEFT JOIN IBU_QUOTE_BOND_DET T2 ON
                T2.QUOTE_ID = T1.QUOTE_ID
                <where>
                    <if test="execId != null and execId != ''">
                        T2.EXECID = #{execId}
                    </if>
                </where>
        UNION ALL
            SELECT
                T1.QUOTE_ID,
                T1.ENTRUST_ID ,
                T1.EXECID ,
                T1.PORTFOLIO_ID
            FROM
                IBU_QUOTE_CREP T1
        <where>
            <if test="execId != null and execId != ''">
                T1.EXECID = #{execId}
            </if>
        </where>
        ) TT
    </select>

    <select id="selectPtlSecPositionFlows" resultType="com.joyintech.tams.invest.common.dto.PtlSecPositionFlowDto">
   select 
        <include refid="com.joyintech.tams.common.base.dao.PtlSecPositionFlowMapper.Base_Column_List" />
        from PTL_SEC_POSITION_FLOW
    WHERE 1=1 
        <if test="tradeId != null and tradeId != ''">
            AND TRADE_ID = #{tradeId}
        </if>
        <if test="entrustId != null and entrustId != ''">
            AND ENTRUST_ID = #{entrustId}
        </if>
    </select>
    
	<select id="selectPtlCashPositionFlows" resultType="com.joyintech.tams.invest.common.dto.PtlCashPositionFlowDto">
   select 
        <include refid="com.joyintech.tams.common.base.dao.PtlCashPositionFlowMapper.Base_Column_List" />
        from PTL_CASH_POSITION_FLOW
    WHERE 1=1 
        <if test="tradeId != null and tradeId != ''">
            AND ORDER_ID = #{tradeId}
        </if>
        <if test="entrustId != null and entrustId != ''">
            AND ENTRUST_ID = #{entrustId}
        </if>
    </select>
   
</mapper>