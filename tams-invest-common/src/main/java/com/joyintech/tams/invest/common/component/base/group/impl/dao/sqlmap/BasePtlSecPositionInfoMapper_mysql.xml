<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.invest.common.component.base.group.impl.dao.BasePtlSecPositionInfoMapper_mysql">
    <select id="selectMaxCdate" resultType="string" >
        select
        date_format(MAX(CDATE), '%Y-%m-%d')
        from PTL_SEC_POSITION
        <where>
            <include refid="whereSql"/>
        </where>
    </select>

    <update id="updatePosition" parameterType="map">
        UPDATE PTL_SEC_POSITION SET AMOUNT = AMOUNT + #{amount}
        where CDATE between str_to_date(#{minDate}, '%Y-%m-%d') AND str_to_date(#{maxDate}, '%Y-%m-%d')
        <include refid="whereSql"/>
    </update>

    <sql id="whereSql">
        <if test="portfolioId != null and portfolioId != ''">
            and PORTFOLIO_ID = #{portfolioId,jdbcType=VARCHAR}
        </if>
        <if test="hodingType != null and hodingType != ''">
            and HODING_TYPE = #{hodingType,jdbcType=VARCHAR}
        </if>
        <if test="channel != null and channel">
            and SEC_ACCT_ID = #{secAcctId,jdbcType=VARCHAR}
        </if>
        <if test="!channel and secAcctId != null and secAcctId != ''">
            and SEC_ACCT_ID = #{secAcctId,jdbcType=VARCHAR}
        </if>
        <if test="!channel and (secAcctId == null or secAcctId == '') and (entrust == null || !entrust)">
            and SEC_ACCT_ID = '999999'
        </if>
        <if test="invAim != null and invAim != ''">
            and INV_AIM = #{invAim,jdbcType=VARCHAR}
        </if>
        <if test="finprodId != null and finprodId != ''">
            and FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
        </if>
        <if test="branch != null">
            and BRANCH = #{branch, jdbcType=DECIMAL}
        </if>
    </sql>
</mapper>
