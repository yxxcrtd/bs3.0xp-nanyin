<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.invest.common.component.base.group.impl.dao.BasePtlCashPositionInfoMapper_mysql">
    <select id="selectMaxCdate" resultType="string" >
        select
        date_format(MAX(CDATE), '%Y-%m-%d')
        from PTL_CASH_POSITION
        <where>
            <include refid="whereSql"/>
        </where>
    </select>

    <update id="updatePosition" parameterType="map">
        UPDATE PTL_CASH_POSITION SET AMOUNT = AMOUNT + #{amount}
        where CDATE between str_to_date(#{minDate}, '%Y-%m-%d') AND str_to_date(#{maxDate}, '%Y-%m-%d')
        <include refid="whereSql"/>
    </update>

    <sql id="whereSql">
        <if test="hodingType != null and hodingType != ''">
            and HODING_TYPE = #{hodingType,jdbcType=VARCHAR}
        </if>
        <if test="portfolioId != null and portfolioId != ''">
            and PORTFOLIO_ID = #{portfolioId,jdbcType=VARCHAR}
        </if>
        <if test="acctId != null and acctId != ''">
            and ACCT_ID = #{acctId, jdbcType=VARCHAR}
        </if>
        <if test="chlFinprodId != null and chlFinprodId != ''">
            and CHL_FINPROD_ID = #{chlFinprodId,jdbcType=VARCHAR}
        </if>
        <if test="ccy != null and ccy != ''">
            and CCY = #{ccy,jdbcType=VARCHAR}
        </if>
    </sql>

</mapper>
