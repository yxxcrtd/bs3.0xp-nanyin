    <select id="selectDealCalendarHolidayCount" resultType="java.lang.Integer" parameterType="java.lang.String">
        SELECT COUNT(1)
          FROM VAL_VW_MST_HOLIDAY
         WHERE CDATE = TO_DATE(#{dateStr,jdbcType=VARCHAR},'YYYY-MM-DD')
           AND TRADE_CALENDAR_ID = #{calId,jdbcType=VARCHAR}
           AND IS_HOLIDAY > 0
    </select>
