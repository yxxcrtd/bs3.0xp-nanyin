<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.settle.dao.SettleDownLinkMapper">
    <select id="listSysBatchTask" resultType="java.lang.String">
        SELECT
            TASK_ID
        FROM
            SYS_BATCH_TASK sbt
        <where>
            BEAN_NAME in
            <foreach collection="beanNames" item="item" index="index" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </where>
    </select>
</mapper>