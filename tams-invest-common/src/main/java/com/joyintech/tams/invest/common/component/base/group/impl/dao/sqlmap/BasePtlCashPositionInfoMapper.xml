<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.component.base.group.impl.dao.BasePtlCashPositionInfoMapper">
    <select id="selectCashPositionFlow" resultType="java.math.BigDecimal" >
        select
        SUM(AMOUNT)
        from PTL_CASH_POSITION_FLOW
        where CDATE &lt;= #{cdate,jdbcType=DATE}
        <include refid="whereSql"/>
        <if test="acctType != null and !acctType.isEmpty() and needAcctType">
            and ACCT_ID in (
            SELECT ACCT_NO from PTL_CAPACCT_INFO where PORTFOLIO_ID = #{portfolioId}
            <foreach collection="acctType" open=" and ACCT_TYPE in (" close=")" item="item" separator=",">#{item}</foreach>
            )
        </if>
    </select>

    <select id="selectCashPosition" resultType="java.math.BigDecimal" >
        select
        SUM(AMOUNT)
        from PTL_CASH_POSITION_FLOW
        where CDATE &lt;= #{cdate,jdbcType=DATE}
        <include refid="whereSql"/>
        <if test="acctType != null and !acctType.isEmpty() and needAcctType">
            and ACCT_ID in (
            SELECT ACCT_NO from PTL_CAPACCT_INFO where PORTFOLIO_ID = #{portfolioId}
            <foreach collection="acctType" open=" and ACCT_TYPE in (" close=")" item="item" separator=",">#{item}</foreach>
            )
        </if>
    </select>
    
    <select id="selectCashPositionMaxCdate" resultType="java.util.Date" >
        select
        max(CDATE)
        from PTL_CASH_POSITION
        where CDATE &lt; = #{cdate,jdbcType=DATE}
        <include refid="whereSql"/>
        <if test="acctType != null and !acctType.isEmpty() and needAcctType">
            and ACCT_ID in (
            SELECT ACCT_NO from PTL_CAPACCT_INFO where PORTFOLIO_ID = #{portfolioId}
            <foreach collection="acctType" open=" and ACCT_TYPE in (" close=")" item="item" separator=",">#{item}</foreach>
            )
        </if>
    </select>

    <select id="selectMaxCdate" resultType="string" >
        select
        to_char(MAX(CDATE), 'yyyy-MM-dd')
        from PTL_CASH_POSITION
        <where>
            <include refid="whereSql"/>
        </where>
    </select>

    <update id="updatePosition" parameterType="map">
        UPDATE PTL_CASH_POSITION SET AMOUNT = AMOUNT + #{amount}
        where CDATE between TO_DATE(#{minDate}, 'yyyy-MM-dd') AND TO_DATE(#{maxDate}, 'yyyy-MM-dd')
        <include refid="whereSql"/>
    </update>

    <delete id="deletePtlCashPositionFlow" parameterType="com.joyintech.tams.invest.common.dto.PtlCashPositionFlowDto">
        DELETE FROM PTL_CASH_POSITION_FLOW
        <where>
            <if test="cdate != null">
                CDATE = #{cdate, jdbcType=DATE}
            </if>
            <if test="orderId != null and orderId != ''">
                AND ORDER_ID = #{orderId}
            </if>
            <include refid="whereSql"/>
        </where>
    </delete>

    <sql id="whereSql">
        <if test="hodingType != null and hodingType != ''">
            and HODING_TYPE = #{hodingType,jdbcType=VARCHAR}
        </if>
        <if test="portfolioId != null and portfolioId != ''">
            and PORTFOLIO_ID = #{portfolioId,jdbcType=VARCHAR}
        </if>
        <if test="acctId != null and acctId != ''">
            and ACCT_ID = #{acctId, jdbcType=VARCHAR}
        </if>
        <if test="chlFinprodId != null and chlFinprodId != ''">
            and CHL_FINPROD_ID = #{chlFinprodId,jdbcType=VARCHAR}
        </if>
        <if test="ccy != null and ccy != ''">
            and CCY = #{ccy,jdbcType=VARCHAR}
        </if>
    </sql>
</mapper>