<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tams-invest-common</artifactId>
	<version>1.0.0</version>

	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.3</version>
	</parent>

	<dependencies>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.9.9</version>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
			<exclusions>
				<exclusion>
					<groupId>com.joyintech</groupId>
					<artifactId>joyintech-workflow</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-redis</artifactId>
			<version>0.0.3</version>
		</dependency>
		<!-- <dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>valinterf-common</artifactId>
			<version>2.0.0</version>
		</dependency> -->
		<!-- <dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency> -->

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common</artifactId>
			<version>2.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-valuation-api</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.jixu</groupId>
			<artifactId>JixuUtil</artifactId>
			<version>0.0.1</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.joyintech.component</groupId>
			<artifactId>msg-generate-1.0.0</artifactId>
			<version>1.0.0</version>
			<scope>compile</scope>
		</dependency>
	</dependencies>
	<build>
	   <plugins>
		  <!-- 打包源代码插件 -->
		  <plugin>
			 <groupId>org.apache.maven.plugins</groupId>
			 <artifactId>maven-source-plugin</artifactId>
			 <version>2.4</version>
			 <configuration>
				<attach>true</attach>
			 </configuration>
			 <executions>
				<execution>
				   <phase>compile</phase>
				   <goals>
					  <goal>jar</goal>
				   </goals>
				</execution>
			 </executions>
		  </plugin>
	   </plugins>
	</build>
</project>
