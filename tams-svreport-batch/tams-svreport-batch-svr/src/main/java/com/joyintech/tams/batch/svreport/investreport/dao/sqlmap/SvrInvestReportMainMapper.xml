<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.batch.svreport.investreport.dao.SvrInvestReportMainMapper" >

    <select id="getPreMstHolidayByParam" resultType="com.joyintech.tams.common.base.entity.MstHoliday"
            parameterType="com.joyintech.tams.common.base.entity.MstHolidayKey" >
        select
            max(CDATE) as CDATE
        from MST_HOLIDAY
        where CALENDAR_ID = #{calendarId,jdbcType=VARCHAR}
          and CDATE <![CDATA[<]]> #{cdate,jdbcType=DATE}
          and  IS_HOLIDAY = 0
    </select>

</mapper>