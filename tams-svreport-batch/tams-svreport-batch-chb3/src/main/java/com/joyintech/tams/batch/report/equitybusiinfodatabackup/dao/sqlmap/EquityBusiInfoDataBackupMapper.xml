<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.batch.report.equitybusiinfodatabackup.dao.EquityBusiInfoDataBackupMapper">

	
	<select id="queryAllPartition" resultType="string">
		select partition_name from user_tab_partitions 
		where table_name=#{tableName} and partition_position!=1
	</select>
	
	<select id="getPartitionTimeByName" resultType="string">
		select  to_char(EQUITY_CONF_DATE,'yyyy-mm-dd') from ${tableName} partition(${partitionName}) where rownum=1
	</select>

	<!-- 创建归档表 -->
	<update id="createBackupTable">
        create table ${newTableName} as select * from ${tableName}  where 1=0
    </update>
    
    <!-- 将分区数据插入归档表 -->
    <insert id="insertBackupData"> 
    	insert into ${newTableName} 
		select * from ${tableName} partition(${partitionName})
    </insert>
    
    <!-- 删除表分区 -->
    <insert id="deleteTablePartition">
    	alter table ${tableName} drop partition(${partitionName})
    </insert>
    
    <!-- 创建归档表 -->
	<update id="rebuildIndex" parameterType="string">
        alter index ${indexName} rebuild online
    </update>
</mapper>