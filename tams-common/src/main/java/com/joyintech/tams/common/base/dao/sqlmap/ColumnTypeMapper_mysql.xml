<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
        namespace="com.joyintech.tams.common.base.dao.ColumnTypeMapper_mysql">
    <resultMap id="BaseResultMap"
               type="com.joyintech.tams.common.base.entity.ColumnTypeDto">
        <result column="COLUMN_NAME" property="columnNname"
                jdbcType="VARCHAR" />
        <result column="COMMENTS" property="comment"
                jdbcType="VARCHAR" />
    </resultMap>

    <select id="queryColmnInfo" resultMap="BaseResultMap" parameterType="java.lang.String" >
        SELECT COLUMN_NAME,COLUMN_COMMENT FROM
        (SELECT DISTINCT A.COLUMN_NAME COLUMN_NAME,
        A.COLUMN_COMMENT COLUMN_COMMENT
        FROM information_schema.`COLUMNS` A
        WHERE 1=1
        <if test="tableId != null" >
            AND A.TABLE_NAME = #{tableId,jdbcType=CHAR}
        </if>
        )
    </select>

    <select id="queryAllColumnByTableId" resultType="java.lang.String" parameterType="java.lang.String" >
        SELECT DISTINCT A.COLUMN_NAME COLUMN_NAME
        FROM information_schema.`COLUMNS` A
        WHERE 1=1
        <if test="tableId != null" >
            AND A.TABLE_NAME = #{tableId,jdbcType=CHAR}
        </if>
    </select>

</mapper>