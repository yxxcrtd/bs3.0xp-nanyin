<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
        namespace="com.joyintech.tams.common.base.dao.FilterInformationMapper_mysql">
    <resultMap id="BaseResultMap"
               type="com.joyintech.tams.common.base.entity.FilterInformationDto">
        <id column="FILTERID" property="filterId"
            jdbcType="VARCHAR" />
        <result column="FILTERUSERID" property="filterUserId"
                jdbcType="VARCHAR" />
        <result column="FILTERNAME" property="filterName"
                jdbcType="VARCHAR" />
    </resultMap>

    <insert id="insertFilterInfo" parameterType="com.joyintech.tams.common.base.entity.FilterInformationDto">
		INSERT INTO CHB_INFOMGR_FILTER
		(FILTERID, FILTERUSERID, FILTERNAME)
		VALUES
		(#{filterId,jdbcType=VARCHAR}, #{filterUserId,jdbcType=VARCHAR}, #{filterName,jdbcType=VARCHAR})
	</insert>

    <delete id="deleteFilterInfo" parameterType="java.lang.String">
        <if test="filterId != null">
            DELETE FROM CHB_INFOMGR_FILTER WHERE FILTERID = #{filterId,jdbcType=VARCHAR}
        </if>
    </delete>

    <update id="updateFilterInfo" parameterType="com.joyintech.tams.common.base.entity.FilterInformationDto">
        <if test="filterId != null">
            UPDATE CHB_INFOMGR_FILTER
            <set>
                <if test="filterName != null">
                    FILTERNAME = #{filterName,jdbcType=VARCHAR}
                </if>
            </set>
            WHERE FILTERID = #{filterId,jdbcType=VARCHAR}
        </if>
    </update>


    <select id="queryFilterInfoByUserId" resultMap="BaseResultMap" parameterType="map">
        <if test="userId != null">
            SELECT FILTERID, FILTERUSERID, FILTERNAME
            FROM CHB_INFOMGR_FILTER
            WHERE FILTERUSERID = #{userId,jdbcType=VARCHAR}
            <if test="searchCondition != null and searchCondition != ''">
                AND FILTERNAME LIKE #{searchCondition,jdbcType=VARCHAR}
            </if>
        </if>
    </select>

    <select id="checkSave" parameterType="java.util.Map" resultType="java.lang.Integer">
		SELECT COUNT(1)
		FROM CHB_INFOMGR_FILTER
		WHERE FILTERUSERID = #{userId,jdbcType=VARCHAR}
		AND FILTERNAME = #{planName,jdbcType=VARCHAR}
	</select>

    <select id="queryFilterNameById" parameterType="java.util.Map" resultType="java.lang.String">
		SELECT FILTERNAME FROM CHB_INFOMGR_FILTER WHERE FILTERID = #{filterId,jdbcType=VARCHAR}
	</select>
    <select id="checkSaveByName" parameterType="String" resultType="java.lang.Integer">
		SELECT COUNT(1)
		FROM CHB_INFOMGR_FILTER
		WHERE FILTERNAME = #{planName,jdbcType=VARCHAR}
	</select>
</mapper>