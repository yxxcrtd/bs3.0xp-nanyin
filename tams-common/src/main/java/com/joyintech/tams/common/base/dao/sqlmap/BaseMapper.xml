<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.common.base.dao.BaseMapper">
    <select id="getSequenceIndexData" parameterType="java.util.Map"
        resultType="java.lang.Long" useCache="false" flushCache="true">
        <if test="databaseType == 'DB2'"> 
          select nextval for ${sequenceName} from SYSIBM.SYSDUMMY1
        </if>
        <if test="databaseType == 'Oracle'"> 
          select ${sequenceName}.nextVal from dual
        </if>
    </select>
