    <select id="selectBankCode" parameterType="java.lang.String" resultType="java.lang.String">
    	select 
    	corb.REGIST_BANK_CODE 
    	from CHB_ORG_REGIST_BANK_CODE corb
    	where 
    	corb.ORG_CODE = #{orgCode,jdbcType=VARCHAR}
    </select>
    
