<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.disclosure.busicommon.jixu.framework.report.dao.ReportInfoMapper">
    <select id="getReportInfoByID" resultType="com.joyintech.tams.disclosure.busicommon.jixu.framework.report.pojo.ReportInfo" parameterType="java.lang.String" >
        select
            REP_REPORTINFO.*,
            rep_info.report_name reportName,
            rep_info.report_category reportCategory,
            rep_info.FILE_NAME
        from REP_REPORTINFO  REP_REPORTINFO
        left join rep_info rep_info on REP_REPORTINFO.REPORTID=rep_info.rep_id
        where REPORTID = #{reportID,jdbcType=VARCHAR}
    </select>
    <select id="getReportInfoByURI" resultType="com.joyintech.tams.disclosure.busicommon.jixu.framework.report.pojo.ReportInfo" parameterType="java.lang.String" >
        select
        REP_REPORTINFO.*
        from REP_REPORTINFO
        where URI = #{uri,jdbcType=VARCHAR}
    </select>
    <select id="loadEntityAll" resultType="com.joyintech.tams.disclosure.busicommon.jixu.framework.report.pojo.ReportInfo">
        select
        REP_REPORTINFO.*
        from REP_REPORTINFO
    </select>

    <select id="getRepInfoStatus" resultType="int">
        select count(*) from REP_INFO_STATUS WHERE  REP_ID = #{repId,jdbcType=VARCHAR}
    </select>

    <select id="getReportInfoByIDS" parameterType="list" resultType="com.joyintech.tams.disclosure.busicommon.jixu.framework.report.pojo.ReportInfo">
        select
            REP_REPORTINFO.*
        from REP_REPORTINFO where 1 = 1
        and reportid in
        <foreach collection="ids" item="item" open="(" close=")"
        				 separator=",">
        			#{item}
        </foreach>
    </select>
</mapper>