	<update id="updateProcstatus" parameterType="com.joyintech.interf.bankname.cfetsup.secrequestquote.dto.FxSecRequestQuoteDto">
        update   fx_sec_request_quote t set
                       t.EFFECTFLAG=#{effectflag}
                      ,t.PROCSTATUS=#{procstatus}
                      ,t.SENDSTATUS=#{sendstatus}
                      ,t.LASTMODIFIERID=#{lastmodifierid}
                      ,t.LASTMODIFIEDTIME=NOW()
            where t.SEQNO=#{seqno}
   </update>
