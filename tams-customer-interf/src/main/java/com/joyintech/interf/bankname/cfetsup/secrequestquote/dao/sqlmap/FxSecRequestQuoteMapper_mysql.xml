	<select id="findPage" resultType="com.joyintech.interf.bankname.cfetsup.secrequestquote.dto.FxSecRequestQuoteDto">
            select      tt.SEQNO,
                        tt.QUOTEID,
                        tt.TRUSTID,
                        tt.ACCOUNTID,
                        pro.finprod_abbr accountname,
                        tt.SECCODE,
                        sec.finprod_abbr SECNAME,
                        f.cfetsname homecstpname,
                        tt.PS,
                        tt.QUOTEDATE,
                        tt.EFFECTTIME,
                        tt.EFFECTFLAG,
                        tt.SENDSTATUS,
                        tt.TRADESTATUS,
                        tt.PRINAMT,
                        tt.CLEANPRICE,
                        tt.CPRICEAMT,
                        tt.DIRTYPRICE,
                        tt.DPRICEAMT,
                        tt.ACCUIR,
                        tt.ACCUIRAMT,
                        tt.SETTLEAMT,
                        tt.DEALAMT,
                        tt.HUNPRINCIPALAMT,
                        tt.PRINCIPALAMT,
                        tt.MATUREYIELD,
                        tt.HOMEROLE,
                        tt.HOMECSTPID,
                        tt.HOMETRADER,
                        tt.COUNTERTYPE,
                        tt.COUNTERID,
                        tt.COUNTERCSTPID,
                        tt.COUNTERTRADER,
                        tt.SETTLETYPE,
                        tt.SETTLESPEED,
                        tt.SETTLEMODE,
                        tt.SETTLEDATE,
                        tt.CCY,
                        tt.EXCHANGERATE,
                        tt.SUPPPROVISION,
                        tt.REMARK,
                        tt.PREPROCINSTID,
                        tt.PROCINSTID,
                        tt.PROCSTATUS,
                        tt.PROCSTAMP,
                        tt.CREATORID,
                        tt.CREATEDTIME,
                        tt.LASTMODIFIERID,
                        tt.LASTMODIFIEDTIME,
                        tt.DEALDATE,
                        tt.EXERCISEYIELD,
                        tt.LIMITTYPE,
                        tt.PSEQNO,
                        tt.QUOTENUM,
                        tt.QUOTETYPE,
                        IFNULL(tt.sendmark, 0) sendmark,
                        tt.errormsg,
                        tt.transactime,
                        tt.NBQUOTEID
                        FROM FX_SEC_REQUEST_QUOTE tt
                        LEFT JOIN fin_product sec
                        ON sec.finprod_id= tt.SECCODE
                        and sec.finprod_type2 = 'F10'
                        LEFT JOIN fin_product pro
                        on pro.finprod_id = tt.Accountid
                        and pro.finprod_type2 = 'F16'
                        left join fx_imix_account_info f on f.accountid=tt.accountid and f.effectflag='E'
                    WHERE 1 = 1 and tt.EFFECTFLAG!='D'
                <if test="accountid != null and accountid != ''"> and tt.accountid = #{accountid}</if>
                <if test="quoteid != null and quoteid != ''">
                    and tt.quoteid like concat(concat('%',#{quoteid}),'%')	</if>
                <if test="trustid != null and trustid != ''">
                    and tt.trustid like concat(concat('%',#{trustid}),'%')	</if>
                <if test="nbquoteid != null and nbquoteid != ''">
                    and tt.nbquoteid like concat(concat('%',#{nbquoteid}),'%')	</if>
                <if test="dealdateBegin != null and dealdateBegin!=''"> and tt.QUOTEDATE >= STR_TO_DATE(#{dealdateBegin},'%Y-%m-%d')</if>
                <if test="dealdateEnd != null and dealdateEnd!=''"> and  STR_TO_DATE(#{dealdateEnd},'%Y-%m-%d') >= tt.QUOTEDATE</if>
                <if test="seccode != null and seccode != ''"> and tt.seccode = #{seccode}</if>
                <if test="sendstatus != null and sendstatus != ''"> and tt.sendstatus = #{sendstatus}</if>
                <if test="ps != null and ps != ''"> and tt.ps = #{ps}</if>
                <if test="tradestatus != null and tradestatus != ''"> and tt.tradestatus = #{tradestatus}</if>
                <if test="userId != null and userId != ''"> and tt.creatorid = #{userId}</if>
      </select>
	<select id="findCounterPage"  resultType="com.joyintech.interf.bankname.cfetsup.secrequestquote.dto.FxSecRequestQuoteCounterDto">
                select
                        t.JYCYID           ,
                        t.JGDM             ,
                        t.JYCYQC           ,
                        t.ZWJC jycyname     from fx_imix_mem_info t
                where 1=1
                <if test="jycyid != null and jycyid != ''"> and t.jycyid = #{jycyid}</if>
                <if test="jycyname != null and jycyname != ''">
                    and t.jycyname like concat(concat('%',#{jycyname}),'%')
                </if>
        </select>

    <select id="findSequence" resultType="string">
        select _NEXTINDEX('SEQ_QUOTE') from dual
    </select>

	<select id="getProductid" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT t.finprod_id id,t.finprod_name text
        FROM fin_product t
        WHERE 1=1 and t.finprod_type2 = 'F16'
        <if test="search != null and search !=null">
            AND (t.finprod_id like  #{search} concat(concat('%',or t.finprod_name like  #{search}),'%'))
        </if>
    </select>
	<select id="getSeccode" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT t.finprod_id id,t.finprod_name text
        FROM fin_product t
        WHERE 1=1 and t.finprod_type2 = 'F01'
        <if test="search != null and search !=null">
            AND (t.finprod_id like #{search} concat(concat('%',or t.finprod_name like  #{search}),'%'))
        </if>
    </select>
	<select id="getDataDict" resultType="com.joyintech.framework.select.SelectOptionDto">
        select t.item_code id ,t.item_value text
        from sys_datadict_list t
        where t.dict_code=#{key}
        <if test="search != null and search !=null">
            AND (t.item_value like #{search} concat(concat('%',or t.item_code like  #{search}),'%'))
        </if>
    </select>
