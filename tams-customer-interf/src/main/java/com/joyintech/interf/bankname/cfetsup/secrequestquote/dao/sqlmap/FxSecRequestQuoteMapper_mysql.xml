        update   fx_sec_request_quote t set
                       t.SENDSTATUS=#{sendstatus,jdbcType=VARCHAR}
                      ,t.TRADESTATUS=#{tradestatus,jdbcType=VARCHAR}
                      ,t.errormsg=#{errormsg,jdbcType=VARCHAR}
                      ,t.LASTMODIFIERID=#{lastmodifierid,jdbcType=VARCHAR}
                      ,t.LASTMODIFIEDTIME=NOW()
            where t.SEQNO=#{seqno}
