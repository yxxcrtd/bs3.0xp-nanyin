<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.interf.bankname.cfetsup.outbound.dao.CfetsUpCommonMapper_mysql">
	<select id="getSendCountWithinInterval" parameterType="string" resultType="int">
        select count(1) from FX_QUOTE_SEND_INFO i where i.PSEQNO = #{value} and i.CREATEDTIME +5/(24*60) > NOW()
    </select>
</mapper>
