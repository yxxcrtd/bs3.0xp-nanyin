<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixjgzcgx.dao.FxImixJgzcgxMapper_mysql">
    <resultMap id="BaseResultMap" type="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixjgzcgx.dto.FxImixJgzcgxDto" >
        <id column="SEQNO" property="seqno" jdbcType="DECIMAL" />
        <result column="ZJGMC" property="zjgmc" jdbcType="VARCHAR" />
        <result column="ZJGLWM" property="zjglwm" jdbcType="VARCHAR" />
        <result column="CJGMC" property="cjgmc" jdbcType="VARCHAR" />
        <result column="CJGLWM" property="cjglwm" jdbcType="VARCHAR" />
        <result column="ZGXLXMC" property="zgxlxmc" jdbcType="VARCHAR" />
        <result column="CGXLXMC" property="cgxlxmc" jdbcType="VARCHAR" />
        <result column="EFFECTFLAG" property="effectflag" jdbcType="VARCHAR" />
        <result column="CREATORID" property="creatorid" jdbcType="DECIMAL" />
        <result column="CREATEDTIME" property="createdtime" jdbcType="TIMESTAMP" />
        <result column="LASTMODIFIERID" property="lastmodifierid" jdbcType="DECIMAL" />
        <result column="LASTMODIFIETIME" property="lastmodifietime" jdbcType="TIMESTAMP" />
    </resultMap>
    <select id="selectPageData" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixjgzcgx.dto.FxImixJgzcgxDto">
    select 
        ZJGMC,ZJGLWM,CJGMC,CJGLWM,ZGXLXMC,CGXLXMC
    from FX_IMIX_JGZCGX
    where 1=1
    <if test="zjgmc != null and zjgmc != ''">
        and ZJGMC like concat(concat('%' #{zjgmc}),'%')
    </if>
    <if test="cjgmc != null and cjgmc != ''">
        and CJGMC like concat(concat('%' #{cjgmc}),'%')
     </if>
    <if test="zjglwm != null and zjglwm != ''">
        and ZJGLWM like concat(concat('%' #{zjglwm}),'%')
     </if>
    <if test="cjglwm != null and cjglwm != ''">
        and CJGLWM like concat(concat('%' #{cjglwm}),'%')
     </if>
  </select>
</mapper>
