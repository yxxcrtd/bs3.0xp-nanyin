<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.quoteloginfo.dao.FxQuoteLogInfo001Mapper">

    <select id ="selectForPage" parameterType="Map" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.quoteloginfo.dto.FxQuoteLogInfoDto">
        select
        quoteid,
        sendtype,
        quotetype,
        message,
        creatorid,
        createdtime,
        lastmodifierid,
        lastmodifiedtime
        from FX_QUOTE_LOG_INFO
        where 1=1
        <if test="quoteid !=null and quoteid != '' ">
            AND quoteid LIKE CONCAT('%', CONCAT(#{quoteid}, '%'))
        </if>
        <if test="nbquoteid !=null and nbquoteid != '' ">
            AND nbquoteid LIKE CONCAT('%', CONCAT(#{nbquoteid}, '%'))
        </if>
        <if test="sendtype != null and sendtype !='' ">
            and sendtype=#{sendtype,jdbcType=VARCHAR}
        </if>
    </select>


</mapper>