<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixbondinfo.dao.FxImixBondInfo001Mapper">

    <select id ="selectForPage" parameterType="Map" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixbondinfo.dto.FxImixBondInfoDto">
        select
        seqno,
        secid,
        specialdebt,
        creatorid,
        createdtime,
        lastmodifierid,
        lastmodifiedtime
        from FX_IMIX_BOND_INFO
        where 1=1
        <if test="secidList != null and secidList.size() > 0">
            AND secid IN
            <foreach collection="secidList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        <if test="specialdebt != null and specialdebt !='' "> and specialdebt=#{specialdebt,jdbcType=VARCHAR}</if>
    </select>

    <select id="querySecId"   parameterType="Map" resultType="com.joyintech.framework.select.SelectOptionDto">
        select  basi.acct_subject_id id,
        basi.acct_subject_name text
        from bok_acct_subject_info basi
        <where>
            basi.acct_subject_type=#{finprodType,jdbcType=VARCHAR}
            <if test="search !=null and search != '' ">
                AND basi.acct_subject_id LIKE CONCAT('%', CONCAT(#{search}, '%'))
            </if>
        </where>
    </select>

</mapper>