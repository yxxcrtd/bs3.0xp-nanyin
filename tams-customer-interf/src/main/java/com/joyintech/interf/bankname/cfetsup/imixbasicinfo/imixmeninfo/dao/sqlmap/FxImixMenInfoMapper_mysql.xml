<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixmeninfo.dao.FxImixMenInfoMapper_mysql">
	<select id="selectPageData" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixmeninfo.dto.FxImixMenInfoDto">
    select JGDM,JYCYID,JYCYQC,ZWJC,YWQC,YWJC,CREATEDTIME,LASTMODIFIEDTIME
    from FX_IMIX_MEM_INFO
    where 1=1
    <if test="jycyid != null and jycyid != ''">
        and JYCYID like concat(concat('%' #{jycyid}),'%')
    </if>
    <if test="jycyqc != null and jycyqc != ''">
        and JYCYQC like concat(concat('%' #{jycyqc}),'%')
    </if>
  </select>
</mapper>
