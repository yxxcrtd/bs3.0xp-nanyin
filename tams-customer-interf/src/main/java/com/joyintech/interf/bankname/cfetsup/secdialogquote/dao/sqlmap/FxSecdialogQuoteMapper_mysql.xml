    <select id="getSequence" resultType="java.lang.String">
        select _NEXTINDEX('SEQ_QUOTE') FROM dual
    </select>

    <select id ="selectForPage" parameterType="Map" resultType="com.joyintech.interf.bankname.cfetsup.secdialogquote.dto.FxSecdialogQuote001Dto">
        select
        SDQ.seqno,
        SDQ.dealdate,
        SDQ.ps,
        SDQ.seccode,
        FP.FINPROD_ABBR secname,
        SDQ.tradestatus,
        SDQ.sendstatus,
        QSI.ERRORMESSAGE errormsg,
        IMI.YWQC homeid,
        SDQ.jycyid,
        SDQ.countertrader,
        SDQ.prinamt,
        SDQ.cleanprice,
        SDQ.matureyield,
        SDQ.dirtyprice,
        SDQ.exerciseyield,
        SDQ.settlespeed,
        'CNY' bondccy,
        SDQ.ccy,
        '10' waitdate,
        SDQ.homerole,
        SDQ.quoteid,
        SDQ.nbquoteid,
        SDQ.trustid,
        PP.PORTFOLIO_ID portfolioId,
        PP.Portfolio_Name portfolioName
        from FX_SEC_DIALOG_QUOTE SDQ LEFT JOIN FX_QUOTE_SEND_INFO QSI ON SDQ.NBQUOTEID = QSI.NBQUOTEID
        LEFT JOIN PTL_PORTFOLIO PP ON SDQ.ACCOUNTID = PP.PORTFOLIO_ID
        LEFT JOIN FX_IMIX_MEM_INFO IMI ON IMI.JYCYID = SDQ.JYCYID
        LEFT JOIN FIN_PRODUCT FP ON FP.FINPROD_ID = SDQ.SECCODE
        WHERE 1=1
        <if test="portfolioIdList != null and portfolioIdList.size() > 0">
            AND SDQ.portfolioId IN
            <foreach collection="portfolioIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        <if test="quoteid != null and quoteid !='' "> and SDQ.quoteid like CONCAT('%',CONCAT(#{quoteid,jdbcType=VARCHAR}),'%')</if>
        <if test="trustid != null and trustid !='' "> and SDQ.trustid like CONCAT('%',CONCAT(#{trustid,jdbcType=VARCHAR}),'%')</if>
        <if test="seccode != null and seccode !='' "> and SDQ.seccode like CONCAT('%',CONCAT(#{seccode,jdbcType=VARCHAR}),'%')</if>
        <if test="ps != null and ps !='' "> and ps= #{SDQ.ps,jdbcType=VARCHAR}</if>
        <if test="tradestatus != null and tradestatus !='' "> and tradestatus = #{SDQ.tradestatus,jdbcType=VARCHAR}</if>
        <if test="sendstatus != null and sendstatus !='' "> and sendstatus = #{SDQ.sendstatus,jdbcType=VARCHAR}</if>
        <if test="nbquoteid != null and nbquoteid !='' "> and nbquoteid = #{SDQ.nbquoteid,jdbcType=VARCHAR}</if>
        <if test="tradeDateBegin != null and tradeDateBegin != ''">
            AND SDQ.dealdate &gt;= STR_TO_DATE(#{tradeDateBegin},'%Y-%m-%d')
        </if>
        <if test="tradeDateEnd != null and tradeDateEnd != ''">
            AND SDQ.dealdate &lt;= STR_TO_DATE(#{tradeDateEnd},'%Y-%m-%d')
        </if>
    </select>
	<select id="getPortfolioId" resultType="com.joyintech.framework.select.SelectOptionDto">
        select PORTFOLIO_ID id ,PORTFOLIO_NAME text,PORTFOLIO_ID object
        from PTL_PORTFOLIO
        where 1=1
        <if test="search != null and search !=null">
            AND (PORTFOLIO_ID like CONCAT(#{search} , '%') or PORTFOLIO_NAME like CONCAT( #{search} , '%'))
        </if>
