    <select id="getPortfolioId" resultType="com.joyintech.framework.select.SelectOptionDto">
        select PORTFOLIO_ID id ,PORTFOLIO_NAME text
        from PTL_PORTFOLIO
        where 1=1
        <if test="search != null and search !=null">
           AND (PORTFOLIO_ID like CONCAT(#{search} ,'%') or PORTFOLIO_NAME like  CONCAT(#{search} , '%'))
        </if>
  </select>
    <select id="getSequence" resultType="java.lang.String">
        select _NEXTINDEX('SEQ_QUOTE') FROM dual
  </select>

	<select id="getPortfolioName" resultType="com.joyintech.framework.select.SelectOptionDto">
    select PORTFOLIO_NAME id,PORTFOLIO_ID text
    from PTL_PORTFOLIO
    where 1=1
    <if test="portfolioId != null and portfolioId !=''">AND PORTFOLIO_ID =#{portfolioId}  </if>
    <if test="search != null and search !=null">
        AND PORTFOLIO_NAME like concat(concat('%',#{search}),'%')
    </if>
  </select>
	<select id="getMenInfo" resultType="com.joyintech.framework.select.SelectOptionDto">
    SELECT ZWJC text,JGDM id
    FROM FX_IMIX_MEM_INFO
    where 1=1
    <if test="search != null and search !=null">
        AND  (
        ZWJC like concat(concat('%',#{search}),'%')
        or
        JGDM like concat(concat('%',#{search}),'%')
        )
    </if>
  </select>
	<select id="getSecrepoQuoteInfo" resultType="com.joyintech.framework.select.SuggestDto">
        SELECT DISTINCT
        <choose>
          <when test="field != null and field != ''">
            ${field} code
          </when>
        </choose>
        from FX_SECREPO_QUOTE
        where 1=1
        <if test="field != null and field != ''and search != null and search !=null">
            and (${field} like concat(concat('%',#{search}),'%'))

        </if>
  </select>
	<select id="getFinprodId" resultType="com.joyintech.framework.select.SelectOptionDto">
    SELECT DISTINCT IFNULL(FINPROD_ID,'') id,IFNULL(FINPROD_NAME,'') text
    FROM FIN_PRODUCT
    WHERE FINPROD_TYPE = #{FINPROD_TYPE}
    <if test="search != null and search !=null">
      AND
        ( FINPROD_ID LIKE CONCAT('%' , #{search} , '%')
        FINPROD_ID like concat('%',#{search},'%') )
        or
        concat(concat('%',FINPROD_NAME like  #{search}),'%'))
    </if>
  </select>

