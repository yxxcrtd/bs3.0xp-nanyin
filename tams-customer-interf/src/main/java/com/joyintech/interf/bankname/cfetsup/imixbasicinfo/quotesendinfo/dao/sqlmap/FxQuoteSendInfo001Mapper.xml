<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.quotesendinfo.dao.FxQuoteSendInfo001Mapper">

    <select id ="selectForPage" parameterType="Map" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.quotesendinfo.dto.FxQuoteSendInfoDto">
        select
        seqno,
        nbquoteid,
        quotetype,
        businesstype,
        errorcode,
        errormessage,
        creatorid,
        createdtime,
        lastmodifierid,
        lastmodifiedtime
        from CSTP_QUOTE_SEND_INFO
        where 1=1
        <if test="nbquoteid !=null and nbquoteid != '' ">
            AND nbquoteid LIKE CONCAT('%', CONCAT(#{nbquoteid}, '%'))
        </if>
    </select>

</mapper>