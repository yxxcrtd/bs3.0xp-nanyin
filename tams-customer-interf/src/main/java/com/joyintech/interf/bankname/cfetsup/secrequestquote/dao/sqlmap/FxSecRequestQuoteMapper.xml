    <!-- 获取外汇交易中心对应本方交易员名称和交易员id-->
    <select id="findHomeTrader" parameterType="string" resultType="com.joyintech.interf.bankname.cfetsup.imixbasicinfo.imixtraderassociation.dto.FxTraderManagerDto">
         select t.cstptrader,t.cstptraderid
