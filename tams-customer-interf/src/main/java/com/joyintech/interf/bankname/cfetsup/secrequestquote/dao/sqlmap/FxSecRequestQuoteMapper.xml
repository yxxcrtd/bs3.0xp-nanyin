                        t.EFFECTFLAG       ,
                        t.SENDSTATUS       ,
                        t.TRADESTATUS      ,
                        t.PRINAMT          ,
                        t.LIMITTYPE        ,
                        t.CLEANPRICE       ,
                        t.CPRICEAMT        ,
                        t.DIRTYPRICE       ,
                        t.DPRICEAMT        ,
                        t.ACCUIR           ,
                        t.ACCUIRAMT        ,
                        t.SETTLEAMT        ,
                        t.DEALAMT          ,
                        t.HUNPRINCIPALAMT  ,
                        t.PRINCIPALAMT     ,
                        t.MATUREYIELD      ,
                        t.EXERCISEYIELD    ,
                        t.HOMEROLE         ,
                        t.HOMECSTPID       ,
                        t.HOMETRADER       ,
                        t.COUNTERTYPE      ,
                        t.COUNTERID        ,
                        t.COUNTERCSTPID    ,
                        t.COUNTERTRADER    ,
                        t.SETTLETYPE       ,
                        t.SETTLESPEED      ,
                        t.SETTLEMODE       ,
                        t.SETTLEDATE       ,
                        t.CCY              ,
                        t.EXCHANGERATE     ,
                        t.SUPPPROVISION    ,
                        t.REMARK           ,
                        t.QUOTETYPE        ,
                        t.BUSINESSTYPE  businessType   ,
                        t.CLORDID          ,
                        t.SENDMARK         ,
                        t.TRANSACTIME      ,
                        t.ERRORMSG         ,
                        t.QUOTENUM         ,
                        t.PREPROCINSTID    ,
                        t.PROCINSTID       ,
                        t.PROCSTATUS       ,
                        t.PROCSTAMP        ,
                        t.CREATORID        ,
                        t.CREATEDTIME      ,
                        t.LASTMODIFIERID   ,
                        t.LASTMODIFIEDTIME
                 from FX_SEC_REQUEST_QUOTE t
                 left join fin_product fp1
                 on t.ACCOUNTID=fp1.finprod_id and fp1.finprod_type2='F16'
                 left join fin_product fp2
                 on t.SECCODE=fp2.finprod_id and fp2.finprod_type2='F01'
                 left join fx_imix_account_info f on f.accountid=t.accountid and f.effectflag='E'
                 left join fx_tradermanager ft on ft.cstptraderid =t.hometrader and ft.effectflag='E'
                 where t.SEQNO=#{value}
        </select>

    <select id="getProductid" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT t.finprod_id id,t.finprod_name text
        FROM fin_product t
        WHERE 1=1 and t.finprod_type2 = 'F16'
        <if test="search != null and search !=null">
            AND (t.finprod_id like #{search} || '%' or t.finprod_name like  #{search} || '%')
        </if>
    </select>


    <select id="getSeccode" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT t.finprod_id id,t.finprod_name text
        FROM fin_product t
        WHERE 1=1 and t.finprod_type2 = 'F01'
        <if test="search != null and search !=null">
            AND (t.finprod_id like #{search} || '%' or t.finprod_name like  #{search} || '%')
        </if>
    </select>


    <select id="findSequence" resultType="string">
        select SEQ_QUOTE.NEXTVAL from dual
    </select>

