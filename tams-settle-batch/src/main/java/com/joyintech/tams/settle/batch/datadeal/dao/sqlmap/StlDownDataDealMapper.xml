    <select id="getNextWorkDay" parameterType="java.util.Map" resultType="java.util.Date">
        SELECT
        	MIN(B.CDATE)
        FROM
        	VAL_VW_MST_HOLIDAY B
        WHERE
        	B.IS_HOLIDAY = 0 and B.CDATE > #{nowday, jdbcType=DATE} and B.TRADE_CALENDAR_ID = #{calendarId, jdbcType=DATE}
    </select>

    <select id="getBeforeWorkDay" parameterType="java.util.Map" resultType="java.util.Date">
        SELECT
        	MAX(B.CDATE)
        FROM
        	VAL_VW_MST_HOLIDAY B
        WHERE
        	B.IS_HOLIDAY = 0 and B.CDATE &lt; #{nowday, jdbcType=DATE} and B.TRADE_CALENDAR_ID = #{calendarId, jdbcType=DATE}
    </select>

