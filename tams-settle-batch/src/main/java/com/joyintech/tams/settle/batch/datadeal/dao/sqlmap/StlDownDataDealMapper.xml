    <delete id="deleteSettleTransTgMapping">
        DELETE FROM SETTLE_TRANS_TG_MAPPING
        <where>
            TRADE_ID IN (
            	SELECT
            		TRADE_ID
            	FROM
            		SETTLE_TRANS_DATA
            	WHERE
            		DEAL_DATE = #{dealDate,jdbcType=DATE}
            		<if test="portfolioIdList != null and portfolioIdList.size() > 0">
	            		AND 
	            		<foreach collection="portfolioIdList" item="portfolioId" open="PORTFOLIO_ID IN (" close=")" separator=",">
	            			#{portfolioId,jdbcType=VARCHAR}
	            		</foreach>
            		</if>
            		<if test="secTypeList != null and secTypeList.size() > 0">
	            		AND 
	            		<foreach collection="secTypeList" item="secType" open="SEC_TYPE IN (" close=")" separator=",">
	            			#{secType,jdbcType=VARCHAR}
	            		</foreach>
            		</if>
            )
        </where>
    </delete>
    
