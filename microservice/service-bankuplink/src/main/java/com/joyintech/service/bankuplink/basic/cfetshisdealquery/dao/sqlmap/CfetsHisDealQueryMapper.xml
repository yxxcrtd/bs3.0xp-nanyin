<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.bankuplink.basic.cfetshisdealquery.dao.CfetsHisDealQueryMapper" >


    <select id="queryQuoteIdList" resultType="com.joyintech.framework.select.SuggestDto">
        select
        A.CFETS_QUOTE_ID AS code,
        A.CFETS_QUOTE_ID AS name
        from
        IBU_QUOTE_BOND_HIS A
        <where>
            <if test="param != null and !param.equals('')">
                AND	(A.CFETS_QUOTE_ID like concat('%',concat(#{param},'%'))
                or A.CFETS_QUOTE_ID like concat('%',concat(#{param},'%')))
            </if>
        </where>

    </select>

</mapper>