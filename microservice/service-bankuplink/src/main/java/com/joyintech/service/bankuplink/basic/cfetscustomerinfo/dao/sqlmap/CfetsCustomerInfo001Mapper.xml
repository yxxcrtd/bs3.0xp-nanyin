<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.bankuplink.basic.cfetscustomerinfo.dao.CfetsCustomerInfo001Mapper" >
	<resultMap id="BaseResultMap" type="com.joyintech.service.bankuplink.basic.cfetscustomerinfo.dto.CfetsCustomerInfo001Dto" >
        <id column="PARTY_ID" property="partyId" jdbcType="VARCHAR" />
        <result column="PARTY_CUSTOMER_ID" property="partyCustomerId" jdbcType="VARCHAR" />
        <result column="PARTY_ABBR" property="partyAbbr" jdbcType="VARCHAR" />
        <result column="MPARTY_ABBR" property="mpartyAbbr" jdbcType="VARCHAR" />
        <result column="PARTY_NAME" property="partyName" jdbcType="VARCHAR" />
        <result column="PARTY_ABBR_EN" property="partyAbbrEn" jdbcType="VARCHAR" />
        <result column="PARTY_NAME_EN" property="partyNameEn" jdbcType="VARCHAR" />
        <result column="REMARK" property="remark" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
    
    <sql id="Base_Column_List" >
	    A.PARTY_ID,
	    A.PARTY_CUSTOMER_ID,
	    A.PARTY_ABBR,
    	C.PARTY_ABBR AS MPARTY_ABBR,
	    A.PARTY_NAME,
	    A.PARTY_ABBR_EN,
	    A.PARTY_NAME_EN,
	    A.REMARK,
	    A.CREATE_USER,
	    A.CREATE_TIME,
	    A.CREATE_DEPT,
	    A.UPDATE_USER,
	    A.UPDATE_TIME
    </sql>
    
    <select id="select" resultMap="BaseResultMap">
        select 
        <include refid="Base_Column_List" />
        FROM
		    MST_CFETS_CUSTOMER_INFO A
		LEFT JOIN
		    MST_CFETS_CUSTOMER_RELA B
		ON
		    A.PARTY_ID=B.SPARTY_ID
		LEFT JOIN
		    MST_CFETS_CUSTOMER_INFO C
		ON
		    B.MPARTY_ID=C.PARTY_ID
        <where>
			<if test="partyId != null and partyId != ''">
				AND (A.PARTY_ID like concat('%',concat(#{partyId,jdbcType=VARCHAR},'%')) or A.PARTY_CUSTOMER_ID like concat('%',concat(#{partyId,jdbcType=VARCHAR},'%')))
			</if>
			<if test="partyName != null and partyName != ''">
				AND A.PARTY_NAME like concat('%',concat(#{partyName,jdbcType=VARCHAR},'%'))
			</if>
		</where>
    </select>
</mapper>