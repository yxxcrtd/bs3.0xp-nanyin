<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.bankuplink.basic.cfetscustomertrader.dao.CfetsCustomerTrader001Mapper" >
	<resultMap id="BaseResultMap" type="com.joyintech.service.bankuplink.basic.cfetscustomertrader.dto.CfetsCustomerTrader001Dto" >
        <id column="TRADER_ID" property="traderId" jdbcType="VARCHAR" />
        <result column="PARTY_ID" property="partyId" jdbcType="VARCHAR" />
        <result column="MPARTY_ID" property="mpartyId" jdbcType="VARCHAR" />
        <result column="TRADER_NAME" property="traderName" jdbcType="VARCHAR" />
        <result column="TEL_NO" property="telNo" jdbcType="VARCHAR" />
        <result column="FAX_NO" property="faxNo" jdbcType="VARCHAR" />
        <result column="MSN" property="msn" jdbcType="VARCHAR" />
        <result column="EMAIL" property="email" jdbcType="VARCHAR" />
        <result column="ADDRESS" property="address" jdbcType="VARCHAR" />
        <result column="POST_CODE" property="postCode" jdbcType="VARCHAR" />
        <result column="REMARK" property="remark" jdbcType="VARCHAR" />
        <result column="PARTY_ABBR" property="partyName" jdbcType="VARCHAR" />
        <result column="PARTY_CUSTOMER_ID" property="partyCustomerId" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
    
    <sql id="Base_Column_List" >
        A.TRADER_ID,
	    A.PARTY_ID,
	    A.MPARTY_ID,
	    A.TRADER_NAME,
	    A.TEL_NO,
	    A.FAX_NO,
	    A.MSN,
	    A.EMAIL,
	    A.ADDRESS,
	    A.POST_CODE,
	    A.REMARK,
	    A.CREATE_USER,
	    A.CREATE_TIME,
	    A.CREATE_DEPT,
	    A.UPDATE_USER,
	    A.UPDATE_TIME,
	    B.PARTY_ABBR,
	    B.PARTY_CUSTOMER_ID
    </sql>
    
    <select id="select" resultMap="BaseResultMap">
        select 
        <include refid="Base_Column_List" />
        FROM
		    MST_CFETS_CUSTOMER_TRADER A
		INNER JOIN
		    MST_CFETS_CUSTOMER_INFO B
		ON
		    A.PARTY_ID = B.PARTY_ID
        <where>
			<if test="traderId != null and traderId != ''">
				AND A.TRADER_ID like concat('%',concat(#{traderId,jdbcType=VARCHAR},'%'))
			</if>
			<if test="traderName != null and traderName != ''">
				AND A.TRADER_NAME like concat('%',concat(#{traderName,jdbcType=VARCHAR},'%'))
			</if>
			<if test="partyId != null and partyId != ''">
				AND (A.PARTY_ID like concat('%',concat(#{partyId,jdbcType=VARCHAR},'%'))
					or B.PARTY_CUSTOMER_ID like concat('%',concat(#{partyId,jdbcType=VARCHAR},'%')))
			</if>
			<if test="partyName != null and partyName != ''">
				AND B.PARTY_ABBR like concat('%',concat(#{partyName,jdbcType=VARCHAR},'%'))
			</if>
		</where>
    </select>
</mapper>