<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.entrust.etrinvestbondinfo.dao.EtrInvestBondInfoMapper_db2">
	<select id="selectForPage"
		resultType="com.joyintech.service.entrust.etrinvestbondinfo.dto.EtrInvestBondInfoDto">
					SELECT
				T1.ENTRUST_ID		 entrustId,
			    T1.ENTRUST_STATUS    entrustStatus,
				T8.REAL_NAME    	 invManagerId,
			    T1.PORTFOLIO_ID      portfolioId,
			    T2.PORTFOLIO_NAME    portfolioName,
			    T1.FINPROD_ID		 finprodId,
			    T3.FINPROD_MARKET_ID finprodMarketId,
			    T3.FINPROD_NAME      finprodName,
		<!-- 去资产简称	zhuyongkang 开始 -->
			  T3.FINPROD_ABBR    finprodAbbr,
		<!-- 去资产简称	zhuyongkang end -->
			    T1.PS                ps,
			    T1.TRADE_MARKET      tradeMarket,
			    T1.TRADE_PLAT        tradePlat,
			    T1.TRADE_MARKET_MODE tradeMarketMode,
			    T1.ENTRUST_NUM*100   entrustNum,
			    T1.CCY               ccy,
			    T1.VDATE             vdate,
			    T1.MDATE             mdate,
			    NVL(T5.FINISH_AMT,0)*100 finishAmt,
			    round(NVL(T5.FINISH_AMT,0)*100/(cast(T1.ENTRUST_NUM as decimal(30,2))*100),4)*100		transactioncom,
			    T1.REMARK            remark,
			    T1.INV_AIM			 invAim,
			    T1.PRICE_MODEL		 priceModel,
			    T7.SETTLE_SPREED	 settleSpreed,
			    T7.ASSET_TYPE1	     assetType1,
			    <!-- 新增个性三、四级分类	王贵奇2019/7/27 	开始 -->
			    T7.ASSET_TYPE_10	 assetType10,
			    T7.ASSET_TYPE_11	 assetType11
			    <!-- 新增个性三、四级分类	王贵奇2019/7/27 	结束 -->
			    
			FROM
			    ETR_ENTRUST T1
			INNER JOIN
			    PTL_PORTFOLIO T2
			ON
			    T1.PORTFOLIO_ID = T2.PORTFOLIO_ID
			LEFT JOIN
			    FIN_PRODUCT T3
			ON
			    T1.FINPROD_ID = T3.FINPROD_ID
			LEFT JOIN
			    FIN_PRODUCT_TYPE T4
			ON
			    T4.FINPROD_ID = T3.FINPROD_ID
			LEFT JOIN
			    (
			        SELECT
			            ENTRUST_ID,
			            SUM(FINISH_AMT) as FINISH_AMT
			        FROM
			            ETR_FINISH_STATUS
			        GROUP BY
			            ENTRUST_ID) T5
			ON
			    T1.ENTRUST_ID = T5.ENTRUST_ID
			<!-- INNER JOIN 
			PTL_PORTFOLIO_AUTHORITY T6
			ON
			T2.PORTFOLIO_ID = T6.PORTFOLIO_ID -->
			LEFT JOIN 
				ETR_ENTRUST_ADD T7
			ON
				T1.ENTRUST_ID = T7.ENTRUST_ID
		LEFT JOIN SYS_USER T8 ON T1.INV_MANAGER_ID = T8.USER_NAME
		<where>
			AND T1.FINPROD_TYPE2 =#{bond}
			<!-- 子组合查询	王贵奇	2019/8/20 -->
			AND T2.PORTFOLIO_TYPE in (#{portfolioType}, #{portfolioType1})
			AND T1.ps != #{PS_T04}
			<!-- AND T6.USER_ID = #{userId}
			AND T1.INV_MANAGER_ID = #{userId} -->
		<!-- <if test="portfolioId != null and !portfolioId.equals('')">
			AND (T1.PORTFOLIO_ID like concat('%',concat(#{portfolioId},'%'))
				OR T2.PORTFOLIO_NAME like concat('%',concat(#{portfolioId},'%')))
		</if> -->
		<if test="portfolioIdList != null and portfolioIdList.size() >0">
			AND (T2.PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" index="index" item="prot" open="(" close=")" separator=",">
				<if test="(index % 998) == 0">
                            null) OR T2.PORTFOLIO_ID IN (
                     </if>
				#{prot}
			</foreach>
			or T2.PARENT_PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" index="index" item="prot" open="(" close=")" separator=",">
				<if test="(index % 998) == 0">
                            null) OR T2.PARENT_PORTFOLIO_ID IN (
                     </if>
				#{prot}
			</foreach>
			)
		</if>
		<if test="ccy != null and !ccy.equals('')">
			AND T1.CCY = #{ccy}
		</if>
		<if test="finprodId != null and !finprodId.equals('')">
			AND (T3.FINPROD_MARKET_ID like concat('%',concat(#{finprodId},'%')) 
				or T3.FINPROD_ABBR like concat('%',concat(#{finprodId},'%')))
		</if>
		<if test="tradeMarket != null and !tradeMarket.equals('')">
			AND T1.TRADE_MARKET=#{tradeMarket}
		</if>
		<if test="tradeMarketMode != null and !tradeMarketMode.equals('')">
			AND T1.TRADE_MARKET_MODE=#{tradeMarketMode}
		</if>
		<if test="tradePlat != null and !tradePlat.equals('')">
			AND T1.TRADE_PLAT=#{tradePlat}
		</if>
		<if test="ps != null and !ps.equals('')">
			AND T1.PS=#{ps}
		</if>
		<if test="startDate != null and !startDate.equals('')">
			AND T1.VDATE &gt;=to_date(#{startDate},'yyyy-MM-dd')
		</if>
		<if test="endDate != null and !endDate.equals('')">
			AND T1.MDATE &lt;=to_date(#{endDate},'yyyy-MM-dd')
		</if>
		<!-- <if test="bondTypeList != null">
			AND T7.ASSET_TYPE1 in 
			<foreach collection="bondTypeList" open="(" close=")" item="item" separator=",">
				#{item}
			</foreach>
		</if>原有的类型改为type9 王贵奇 2019/7/26 -->
		<if test="entrustStatus != null and entrustStatus != ''">
			AND T1.ENTRUST_STATUS = #{entrustStatus}
		</if>
		<if test="priceModel != null and priceModel != ''">
			AND T1.PRICE_MODEL = #{priceModel}
		</if>
		<!-- 新增资产二、三、四级分类 王贵奇 2019/7/26 开始 -->
		<if test="type9List != null and type9List.size()>0">
			AND T7.ASSET_TYPE1 in 
			<foreach collection="type9List" open="(" close=")" item="item" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="type10List != null and type10List.size()>0">
			AND T7.ASSET_TYPE_10 in 
			<foreach collection="type10List" open="(" close=")" item="item" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="type11List != null and type11List.size()>0">
			AND T7.ASSET_TYPE_11 in 
			<foreach collection="type11List" open="(" close=")" item="item" separator=",">
				#{item}
			</foreach>
		</if>
		<!-- 新增资产二、三、四级分类 王贵奇 2019/7/26  结束 -->
		</where>
		order by T1.ENTRUST_ID DESC
	</select>
	
	<resultMap id="finprodIdMap" type="com.joyintech.framework.select.SelectOptionDto">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="text" property="text" jdbcType="VARCHAR"/>
        <association property="object" javaType="java.util.Map">
            <result column="FINPROD_NAME" property="finprodName" jdbcType="VARCHAR" />
            <result column="CALENDAR_ID" property="calendarId" jdbcType="VARCHAR" />
            <result column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR" />
            <result column="TRADE_MARKET" property="tradeMarket" jdbcType="VARCHAR" />
            <result column="IS_RIGHT" property="isRight" jdbcType="VARCHAR" />
            <result column="TYPE_9" property="assetType1" jdbcType="VARCHAR" /><!-- type4改为type9	王贵奇2019/7/27 -->
            <result column="TYPE_10" property="assetType10" jdbcType="VARCHAR" /><!-- type4改为type9	王贵奇2019/7/27 -->
            <result column="TYPE_11" property="assetType11" jdbcType="VARCHAR" /><!-- type4改为type9	王贵奇2019/7/27 -->
            <result column="VDATE" property="finvdate" jdbcType="DATE" />
            <result column="MDATE" property="finmdate" jdbcType="DATE" />
            <result column="CCY" property="ccy" jdbcType="VARCHAR" />
        </association>
    </resultMap>
	
	<resultMap type="com.joyintech.service.entrust.etrinvestbondinfo.dto.EtrInvestBondInfoDto" id="selByKeyResult">
		<id column="entrustId" property="entrustId"/>
		<result column="portfolioId"  property="portfolioId"/>
		<result column="vdate"  property="vdate"/>
		<result column="mdate"  property="mdate"/>
		<result column="assetType1"  property="assetType1"/>
		<!-- 新增个性分类三、四级 王贵奇 开始-->
		<result column="assetType10"  property="assetType10"/>
		<result column="assetType11"  property="assetType11"/>
		<!-- 新增个性分类三、四级 王贵奇 结束 -->
		<result column="ccy"  property="ccy"/>
		<result column="finprodId"  property="finprodId"/>
		<result column="finprodMarketId"  property="finprodMarketId"/>
		<result column="finprodName"  property="finprodName"/>
		<result column="ps"  property="ps"/>
		<result column="tradeMarket"  property="tradeMarket"/>
		<result column="tradePlat"  property="tradePlat"/>
		<result column="tradeMarketMode"  property="tradeMarketMode"/>
		<result column="invAim"  property="invAim"/>
		<result column="availableNum"  property="availableNum"/>
		<result column="entrustNum"  property="entrustNum"/>
		<result column="price"  property="price"/>
		<result column="priceModel"  property="priceModel"/>
		<result column="exerYield"  property="exerYield"/>
		<result column="matureYield"  property="matureYield"/>
		<result column="settleSpeed"  property="settleSpeed"/>
		<result column="secAcctId"  property="secAcctId"/>
		<result column="proAvailableCash"  property="proAvailableCash"/>
		<result column="accAvailableCash"  property="accAvailableCash"/>
		<result column="remark"  property="remark"/>
		<result column="chlId"  property="chlId"/>
		<association property="etrInvestPersonInfo" javaType="com.joyintech.service.entrust.etrinvestbondinfo.dto.BussEtrInvestPersonInfoDto">
		<result column="invManagerId"  property="invManagerId"/>
		<result column="trader"  property="trader"/>
		<result column="counterId"  property="counterId"/>
		<result column="counterTrader"  property="counterTrader"/>
		<result column="contactInfo"  property="contactInfo"/>
		</association>
	</resultMap>
	
	<select id="getClosePriceByPara" resultType="java.math.BigDecimal">
	select t.CLOSE_PRICE from (
		SELECT CLOSE_PRICE,row_number() over() rownum 
		FROM
			(SELECT *
	      	FROM MST_BOND_MARK_INFO_FULL
	      	WHERE
	      		SEC_ID = #{finprodMarketId}
	      	AND
	        	VALUE_DATE &lt;= DATE(#{sysdate}) 
	      	ORDER BY VALUE_DATE DESC)
	 ) t WHERE t.ROWNUM =1
	</select>
</mapper>
