<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
    namespace="com.joyintech.service.entrust.etrstock.dao.EtrStockMapper_db2">

    <select id="selectForPage" resultType="com.joyintech.service.entrust.etrstock.dto.EtrStockDto">
        SELECT
            T1.ENTRUST_ID           entrustId,
            T1.ENTRUST_STATUS       entrustStatus,
            T1.PORTFOLIO_ID         portfolioId,
            T2.PORTFOLIO_NAME       portfolioName,
            T1.FINPROD_ID           finprodId,
            T3.FINPROD_MARKET_ID    finprodMarketId,
            T3.FINPROD_NAME         finprodName,
            T4.BOARD                board,
            T1.PS                   ps,
            T1.TRADE_MARKET         tradeMarket,
            T7.DEAL_MODE            dealMode,
            T1.CCY                  ccy,
            T1.VDATE                vdate,
            T1.MDATE                mdate,
            T1.ENTRUST_NUM          entrustNum,
            T1.PRICE                price,
            T1.ENTRUST_AMT          entrustAmt,
            T1.REMARK               remark,
            T1.PRICE_MODEL          priceModel,
            NVL(T5.FINISH_AMT,0)    finishAmt,
            <!-- round(NVL(T5.FINISH_AMT,0)/NVL(T1.ENTRUST_AMT,T1.ENTRUST_NUM),2) transactioncom -->
            ROUND(NVL(T5.FINISH_AMT,0)/NVL(T1.ENTRUST_AMT,cast(T1.ENTRUST_NUM as decimal(30,2))),2) transactioncom
        FROM ETR_ENTRUST T1
        LEFT JOIN PTL_PORTFOLIO T2 ON
            T1.PORTFOLIO_ID = T2.PORTFOLIO_ID
        INNER JOIN FIN_PRODUCT T3 ON
            T1.FINPROD_ID = T3.FINPROD_ID
        INNER JOIN FIN_PRODUCT_ADD T4 ON
            T1.FINPROD_ID = T4.FINPROD_ID
        LEFT JOIN ( SELECT ENTRUST_ID, SUM(NVL(FINISH_AMT,0)) FINISH_AMT FROM ETR_FINISH_STATUS GROUP BY ENTRUST_ID) T5 ON
            T1.ENTRUST_ID = T5.ENTRUST_ID
        INNER JOIN PTL_PORTFOLIO_AUTHORITY T6 ON
            T2.PORTFOLIO_ID = T6.PORTFOLIO_ID
        INNER JOIN ETR_ENTRUST_ADD T7 ON
            T1.ENTRUST_ID = T7.ENTRUST_ID
        <where>
            AND T6.USER_ID = #{userId}
            <if test="portfolioIdList != null and portfolioIdList.size()>0">
                AND (T2.PORTFOLIO_ID IN
                <foreach collection="portfolioIdList" item="prot" open="(" close=")" separator=",">
                    #{prot}
                </foreach>
                    or T2.PARENT_PORTFOLIO_ID IN
                <foreach collection="portfolioIdList" item="prot" open="(" close=")" separator=",">
                    #{prot}
                </foreach>
                    )
            </if>
            <if test="ccy != null and !ccy.equals('')">
                AND T1.CCY = #{ccy}
            </if>
            <if test="finprodId != null and !finprodId.equals('')">
                AND (T3.FINPROD_MARKET_ID like concat('%',concat(#{finprodId},'%'))
                OR T3.FINPROD_NAME like concat('%',concat(#{finprodId},'%')))
            </if>
            <if test="ps != null and !ps.equals('')">
                AND T1.PS=#{ps}
            </if>
            <if test="tradeMarket != null and !tradeMarket.equals('')">
                AND T1.TRADE_MARKET=#{tradeMarket}
            </if>
            <if test="dealMode != null and !dealMode.equals('')">
                AND T7.DEAL_MODE=#{dealMode}
            </if>
            <!-- 查询条件漏了 add by renping 20190925 start -->
            <if test="board != null and !board.equals('')">
                AND T4.BOARD = #{board}
            </if>
            <!-- 查询条件漏了 add by renping 20190925 end -->
            <if test="entrustStatus != null and !entrustStatus.equals('')">
                AND T1.ENTRUST_STATUS = #{entrustStatus}
            </if>
            <if test="startDate != null and !startDate.equals('')">
                AND T1.VDATE &gt;=date(#{startDate})
            </if>
            <if test="endDate != null and !endDate.equals('')">
                AND T1.MDATE &lt;=date(#{endDate})
            </if>
             <if test="priceModel != null and priceModel != ''">
                AND T1.PRICE_MODEL = #{priceModel}
            </if>
            <if test="finprodType2 != null and finprodType2 != ''">
                AND T3.FINPROD_TYPE2 = #{finprodType2}
            </if>
        </where>
        order by T1.ENTRUST_ID DESC
    </select>
   
    <resultMap id="finprodIdMap" type="com.joyintech.framework.select.SelectOptionDto">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="text" property="text" jdbcType="VARCHAR"/>
        <association property="object" javaType="java.util.Map">
            <result column="text" property="finprodName" jdbcType="VARCHAR"/>
            <result column="CALENDAR_ID" property="calendarId" jdbcType="VARCHAR"/>
            <result column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR"/>
            <result column="VDATE" property="finvdate" jdbcType="DATE"/>
            <result column="MDATE" property="finmdate" jdbcType="DATE"/>
            <result column="CCY" property="ccy" jdbcType="VARCHAR"/>
            <result column="BOARD" property="board" jdbcType="VARCHAR"/>
            <result column="TRADE_MARKET" property="tradeMarket" jdbcType="VARCHAR"/>
        </association>
    </resultMap>

    <resultMap type="com.joyintech.service.entrust.etrstock.dto.EtrStockDto" id="selByKeyResult">
        <id column="entrustId" property="entrustId"/>
        <result column="portfolioId" property="portfolioId"/>
        <result column="vdate" property="vdate"/>
        <result column="mdate" property="mdate"/>
        <result column="ccy" property="ccy"/>
        <result column="TYPE_6" property="assetType1"/>
        <result column="TYPE_7" property="assetType2"/>
        <result column="finprodMarketId" property="finprodMarketId"/>
        <result column="finprodName" property="finprodName"/>
        <result column="entrustNum" property="entrustNum"/>
        <result column="entrustAmt" property="entrustAmt"/>
        <result column="ps" property="ps"/>
        <result column="price" property="price"/>
		<result column="priceModel"  property="priceModel"/>
        <result column="tradeMarket" property="tradeMarket"/>
        <result column="board" property="board"/>
        <result column="dealMode" property="dealMode"/>
        <result column="secAcctId" property="secAcctId"/>
        <result column="chlId" property="chlId"/>
        <result column="saleCode" property="saleCode"/>
        <result column="proAvailableCash" property="proAvailableCash"/>
        <result column="accAvailableCash" property="accAvailableCash"/>
        <result column="remark" property="remark"/>
        <association property="etrInvestPersonInfo"
                     javaType="com.joyintech.service.entrust.etrinvestbondinfo.dto.BussEtrInvestPersonInfoDto">
            <result column="invManagerId" property="invManagerId"/>
            <result column="trader" property="trader"/>
            <result column="counterId" property="counterId"/>
            <result column="counterTrader" property="counterTrader"/>
            <result column="contactInfo" property="contactInfo"/>
        </association>
    </resultMap>
   
	<select id="getClosePriceByPara" resultType="java.math.BigDecimal">
	select t.CLOSE_PRICE from(
		SELECT CLOSE_PRICE,row_number() over() rownum 
		FROM
			(SELECT *
	      	FROM MST_SHARE_PRICE
	      	WHERE
	      		SHARES_ID = #{finprodMarketId}
	      	AND
	        	DEAL_DATE &lt;= DATE(#{sysdate}) 
	      	ORDER BY DEAL_DATE DESC) 
	) t WHERE t.ROWNUM =1
	</select>
</mapper>