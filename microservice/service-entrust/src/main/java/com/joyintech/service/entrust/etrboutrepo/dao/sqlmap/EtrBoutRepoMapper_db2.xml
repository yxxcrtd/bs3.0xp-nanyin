<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.entrust.etrboutrepo.dao.EtrBoutRepoMapper_db2">
	
	<select id="selectForPage" resultType="com.joyintech.service.entrust.etrboutrepo.dto.EtrBoutRepoDto">
	SELECT
				T1.ENTRUST_ID		 entrustId,
			    T1.ENTRUST_STATUS    entrustStatus,
			    T1.PORTFOLIO_ID      portfolioId,
			    T4.ASSET_TYPE1		 assetType1,	
			    T3.FINPROD_MARKET_ID finprodMarketId,
			    T3.FINPROD_NAME      finprodName,
			    T2.PORTFOLIO_NAME    portfolioName,
			    T1.PRICE*100		 price,
			    T4.TERM_TYPE		 termType,
			    T4.BUSI_PS           ps,
				<!--T1.ENTRUST_AMT*100   entrustAmt, -->
			    T1.ENTRUST_NUM*100   entrustAmt,
			    T1.CCY               ccy,
			    T1.VDATE             vdate,
			    T1.MDATE             mdate,
			    T1.PRICE_MODEL       priceModel,
			    NVL(T5.FINISH_AMT,0)*100    finishAmt,
			    round(NVL(T5.FINISH_AMT,0)/ NVL(cast(T1.ENTRUST_NUM as decimal(30,2)), T1.ENTRUST_AMT),4)*100		transactioncom,
				T1.REMARK            remark
			FROM
			    ETR_ENTRUST T1
			LEFT JOIN
			    PTL_PORTFOLIO T2
			ON
			    T1.PORTFOLIO_ID = T2.PORTFOLIO_ID
			INNER JOIN
			    FIN_PRODUCT T3
			ON
			    T1.FINPROD_ID = T3.FINPROD_ID
			INNER JOIN
			    ETR_ENTRUST_ADD T4
			ON
			    T4.ENTRUST_ID = T1.ENTRUST_ID
			LEFT JOIN
			    (
			        SELECT
			            ENTRUST_ID,
			            SUM(NVL(FINISH_AMT,0)) FINISH_AMT
			        FROM
			            ETR_FINISH_STATUS
			        GROUP BY
			            ENTRUST_ID) T5
			ON
			    T1.ENTRUST_ID = T5.ENTRUST_ID
			INNER JOIN 
			PTL_PORTFOLIO_AUTHORITY T6
			ON
			T2.PORTFOLIO_ID = T6.PORTFOLIO_ID
		<where>
			AND T6.USER_ID = #{userId}
		<if test="portfolioIdList != null and portfolioIdList.size()>0">
			AND (T2.PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" index="index" item="prot" open="(" close=")" separator=",">
			<if test="(index % 998) == 0">
                            null) OR T2.PORTFOLIO_ID IN (
                     </if>
				#{prot}
			</foreach>
			or T2.PARENT_PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" index="index" item="prot" open="(" close=")" separator=",">
				<if test="(index % 998) == 0">
                            null) OR T2.PARENT_PORTFOLIO_ID IN (
                     </if>
				#{prot}
			</foreach>
			)
		</if>
		<if test="assetType1 !=null and !assetType1.equals('')">
			AND T4.ASSET_TYPE1 = #{assetType1}
			<!-- <foreach collection="assetType1List" index="index" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach> -->
		</if>
		<if test="ccy != null and !ccy.equals('')">
			AND T1.CCY = #{ccy}
			<!-- <foreach collection="ccyList" index="index" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach> -->
		</if>
		<if test="ps != null and !ps.equals('')">
			AND T1.PS=#{ps}
		</if>
		<if test="entrustStatus != null and !entrustStatus.equals('')">
			AND T1.ENTRUST_STATUS = #{entrustStatus}
		</if>
		<if test="startDate != null and !startDate.equals('')">
			AND T1.VDATE &gt;=date(#{startDate})
		</if>
		<if test="endDate != null and !endDate.equals('')">
			AND T1.MDATE &lt;=date(#{endDate})
		</if>
		<if test="priceModel != null and priceModel != ''">
			AND T1.PRICE_MODEL = #{priceModel}
		</if>
			AND T1.FINPROD_TYPE2 in (#{FINPROD_TYPE2_Z},#{FINPROD_TYPE2_N})
		</where>
		order by T1.ENTRUST_ID DESC
	</select>
	
	<resultMap type="com.joyintech.service.entrust.etrboutrepo.dto.EtrBoutRepoDto" id="selByKeyResult">
		<id column="entrustId" property="entrustId"/>
		<result column="portfolioId"  property="portfolioId"/>
		<result column="vdate"  property="vdate"/>
		<result column="mdate"  property="mdate"/>
		<result column="availableDay"  property="availableDay"/>
		<result column="securitiesCust"  property="securitiesCust"/>
		<result column="termType"  property="termType"/>
		<result column="firstprice"  property="firstprice"/>
		<result column="firstprice2"  property="firstprice2"/>
		<result column="ccy"  property="ccy"/>
		<result column="finprodMarketId"  property="finprodMarketId"/>
		<result column="finprodName"  property="finprodName"/>
		<result column="assetType1"  property="assetType1"/>
		<result column="vdateAdd"  property="vdateAdd"/>
		<result column="mdateAdd"  property="mdateAdd"/>
		<result column="termDays"  property="termDays" javaType="java.math.BigDecimal"/>
		<result column="termDays2"  property="termDays2" javaType="java.math.BigDecimal"/>
		<result column="entrustAmt"  property="entrustAmt"/>
		<result column="entrustNum" property="entrustNum" />
		<result column="tradeMarket"  property="tradeMarket"/>
		<result column="calendarId"  property="calendarId"/>
		<result column="settleSpeed"  property="settleSpeed"/>
		<result column="ps"  property="ps"/>
		<result column="price"  property="price"/>
		<result column="priceModel"  property="priceModel"/>
		<result column="proAvailableCash"  property="proAvailableCash"/>
		<result column="accAvailableCash"  property="accAvailableCash"/>
		<result column="remark"  property="remark"/>
		<association property="etrInvestPersonInfo" javaType="com.joyintech.service.entrust.etrinvestbondinfo.dto.BussEtrInvestPersonInfoDto">
		<result column="invManagerId"  property="invManagerId"/>
		<result column="trader"  property="trader"/>
		<result column="counterId"  property="counterId"/>
		<result column="counterTrader"  property="counterTrader"/>
		<result column="contactInfo"  property="contactInfo"/>
		</association>
	</resultMap>
	
</mapper>