<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.entrust.etrplanassetn.dao.EtrPlanAssetNMapper_db2">
	
	<select id="selectForPage" resultType="com.joyintech.service.entrust.etrplanassetn.dto.EtrPlanAssetNDto">
	SELECT
				T1.ENTRUST_ID		 entrustId,
			    T1.ENTRUST_STATUS    entrustStatus,
			    T1.PORTFOLIO_ID      portfolioId,
				/*增加投资经理 guyunfei 2019/08/31 start*/
				T1.INV_MANAGER_ID    invManagerId,
				/*增加投资经理 guyunfei 2019/08/31 end*/
			    T2.PORTFOLIO_NAME    portfolioName,
			    T4.ASSET_TYPE1		 assetType1,
			    <!--添加查询字段三四级分类 zhangpuyu 2019/7/31 start-->
			    T4.ASSET_TYPE_10     assetType10,
		        T4.ASSET_TYPE_11     assetType11,
		        <!--添加查询字段三四级分类 zhangpuyu 2019/7/31 end-->
			    T1.FINPROD_ID		 finprodId,
			    T3.FINPROD_MARKET_ID finprodMarketId,
			    T3.FINPROD_NAME      finprodName,
			    T1.PS                ps,
			    T1.ENTRUST_AMT       entrustAmt,
			    T1.ENTRUST_NUM       entrustNum,
			    T1.CCY               ccy,
			    T1.VDATE             vdate,
			    T1.MDATE             mdate,
			    NVL(T5.FINISH_AMT,0)    finishAmt,
			    round(NVL(T5.FINISH_AMT,0)/NVL(T1.ENTRUST_AMT,cast(T1.ENTRUST_NUM as decimal(30,2))),4)*100		transactioncom,
			    T1.REMARK            remark
			FROM
			    ETR_ENTRUST T1
			LEFT JOIN
			    PTL_PORTFOLIO T2
			ON
			    T1.PORTFOLIO_ID = T2.PORTFOLIO_ID
			INNER JOIN
			    FIN_PRODUCT T3
			ON
			    T1.FINPROD_ID = T3.FINPROD_ID
			INNER JOIN
			    ETR_ENTRUST_ADD T4
			ON
			    T4.ENTRUST_ID = T1.ENTRUST_ID
			LEFT JOIN
			    (
			        SELECT
			            ENTRUST_ID,
			            SUM(NVL(FINISH_AMT,0)) FINISH_AMT
			        FROM
			            ETR_FINISH_STATUS
			        GROUP BY
			            ENTRUST_ID) T5
			ON
			    T1.ENTRUST_ID = T5.ENTRUST_ID
			INNER JOIN 
			PTL_PORTFOLIO_AUTHORITY T6
			ON
			T2.PORTFOLIO_ID = T6.PORTFOLIO_ID
		<where>
			AND T6.USER_ID = #{userId}
		<!-- <if test="portfolioId != null and !portfolioId.equals('')">
			AND (T1.PORTFOLIO_ID like concat('%',concat(#{portfolioId},'%'))
				OR T2.PORTFOLIO_NAME like concat('%',concat(#{portfolioId},'%')))
		</if> -->
		<if test="portfolioIdList != null and portfolioIdList.size() >0">
			AND (T2.PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" item="prot" open="(" close=")" separator=",">
				#{prot}
			</foreach>
			or T2.PARENT_PORTFOLIO_ID IN
			<foreach collection="portfolioIdList" item="prot" open="(" close=")" separator=",">
				#{prot}
			</foreach>
			)
		</if>
		<if test="assetType1List !=null">
			AND T4.ASSET_TYPE1 in 
			<foreach collection="assetType1List" item="item" open="(" close=")" separator=",">
			#{item}
			</foreach>
		</if>
		<!--添加资产二-四级分类 zhangpuyu 2019/7/31 start-->
		<if test="assetType10List !=null">
			AND T4.ASSET_TYPE_10 in
			<foreach collection="assetType10List" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="assetType11List !=null">
			AND T4.ASSET_TYPE_11 in
			<foreach collection="assetType11List" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</if>
		<!--添加资产二-四级分类 zhangpuyu 2019/7/31 end-->
		<if test="ccy != null and !ccy.equals('')">
			AND T1.CCY = #{ccy}
		</if>
		<if test="finprodId != null and !finprodId.equals('')">
			AND (T3.FINPROD_MARKET_ID like concat('%',concat(#{finprodId},'%')) 
			OR T3.FINPROD_NAME like concat('%',concat(#{finprodId},'%')))
		</if>
		<if test="ps != null and !ps.equals('')">
			AND T1.PS=#{ps}
		</if>
		<if test="entrustStatus != null and !entrustStatus.equals('')">
			AND T1.ENTRUST_STATUS = #{entrustStatus}
		</if>
		<if test="startDate != null and !startDate.equals('')">
			AND T1.VDATE &gt;=date(#{startDate})
		</if>
		<if test="endDate != null and !endDate.equals('')">
			AND T1.MDATE &lt;=date(#{endDate})
		</if>
			AND T1.FINPROD_TYPE2 = #{FINPROD_TYPE2}
			AND T3.PROFIT_TYPE = #{PROFIT_TYPE}
		</where>
		order by T1.ENTRUST_ID DESC
	</select>

	<resultMap id="finprodIdMap" type="com.joyintech.framework.select.SelectOptionDto">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="text" property="text" jdbcType="VARCHAR"/>
        <association property="object" javaType="java.util.Map">
            <result column="FINPROD_NAME" property="finprodName" jdbcType="VARCHAR" />
            <result column="CALENDAR_ID" property="calendarId" jdbcType="VARCHAR" />
            <result column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR" />
            <result column="VDATE" property="finvdate" jdbcType="DATE" />
            <result column="MDATE" property="finmdate" jdbcType="DATE" />
            <result column="CCY" property="ccy" jdbcType="VARCHAR" />
            <!--修改TYPE_6为TYPE_9,添加type10-11 zhangpuyu 2019/7/29 start-->
            <!-- <result column="TYPE_6" property="assetType1" jdbcType="VARCHAR" /> -->
            <result column="TYPE_9" property="assetType1" jdbcType="VARCHAR" />
			<result column="TYPE_10" property="assetType10" jdbcType="VARCHAR" />
			<result column="TYPE_11" property="assetType11" jdbcType="VARCHAR" />
			<!--修改TYPE_6为TYPE_9,添加type10-11 zhangpuyu 2019/7/29 end-->
            <result column="TYPE_7" property="assetType2" jdbcType="VARCHAR" />
        </association>
    </resultMap>
	
	<resultMap type="com.joyintech.service.entrust.etrplanassetn.dto.EtrPlanAssetNDto" id="selByKeyResult">
		<id column="entrustId" property="entrustId"/>
		<result column="portfolioId"  property="portfolioId"/>
		<result column="vdate"  property="vdate"/>
		<result column="mdate"  property="mdate"/>
		<result column="ccy"  property="ccy"/>
		<!--修改TYPE_6为TYPE_9,添加type10-11 zhangpuyu 2019/7/29 start-->
		<!-- <result column="TYPE_6"  property="assetType1"/> -->
		<result column="TYPE_9"  property="assetType1"/>
		<result column="TYPE_10" property="assetType10" />
		<result column="TYPE_11" property="assetType11" />
		<!--修改TYPE_6为TYPE_9,添加type10-11 zhangpuyu 2019/7/29 end-->
		<result column="TYPE_7"  property="assetType2"/>
		<result column="finprodMarketId"  property="finprodMarketId"/>
		<result column="finprodName"  property="finprodName"/>
		<result column="entrustNum"  property="entrustNum"/>
		<result column="entrustAmt"  property="entrustAmt"/>
		<result column="ps"  property="ps"/>
		<result column="proAvailableCash"  property="proAvailableCash"/>
		<result column="accAvailableCash"  property="accAvailableCash"/>
		<result column="remark"  property="remark"/>
		<association property="etrInvestPersonInfo" javaType="com.joyintech.service.entrust.etrinvestbondinfo.dto.BussEtrInvestPersonInfoDto">
		<result column="invManagerId"  property="invManagerId"/>
		<result column="trader"  property="trader"/>
		<result column="counterId"  property="counterId"/>
		<result column="counterTrader"  property="counterTrader"/>
		<result column="contactInfo"  property="contactInfo"/>
		</association>
	</resultMap>
	
</mapper>