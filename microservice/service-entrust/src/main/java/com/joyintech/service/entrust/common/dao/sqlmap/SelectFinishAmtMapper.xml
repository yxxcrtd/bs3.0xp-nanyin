<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.entrust.common.dao.SelectFinishAmtMapper">
	
	<select id="selectfinishAmt" resultType="java.math.BigDecimal">
		select
		sum(FINISH_AMT)
		from
		ETR_FINISH_STATUS
		<where>
		ENTRUST_ID = #{entrustId}
		</where>
	</select>
	
</mapper>