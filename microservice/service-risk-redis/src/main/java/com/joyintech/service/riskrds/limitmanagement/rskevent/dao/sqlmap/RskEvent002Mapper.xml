<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.riskrds.limitmanagement.rskevent.dao.RskEvent002Mapper">
	<resultMap id="rskEvent002DtoMap" type="com.joyintech.service.riskrds.limitmanagement.rskevent.dto.RskEvent002Dto">
		<id column="EVENT_CODE" property="eventCode" jdbcType="VARCHAR" />
        <result column="EVENT_NAME" property="eventName" jdbcType="VARCHAR" />
        <result column="IS_CALC_INDICATOR" property="isCalcIndicator" jdbcType="VARCHAR" />
        <result column="REMARK" property="remark" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
        <collection property="paramList" ofType="com.joyintech.tams.common.base.entity.RskEventItemRule" column="paramList">
	        <id column="EVENT_RULE_CODE" property="eventCode" jdbcType="VARCHAR" />
	        <id column="ITEM_CODE" property="itemCode" jdbcType="VARCHAR" />
	        <id column="GROUP_ID" property="groupId" jdbcType="VARCHAR" />
	        <result column="ITEM_ANO_NAME" property="itemAnoName" jdbcType="VARCHAR" />
	        <result column="ITEM_VALUE" property="itemValue" jdbcType="VARCHAR" />
	        <result column="MATCH_TYPE" property="matchType" jdbcType="VARCHAR" />
	        <result column="OFFSET_VAL" property="offsetVal" jdbcType="DECIMAL" />
	        <result column="OFFSET_TYPE" property="offsetType" jdbcType="VARCHAR" />
	        <result column="OFFSET_UNIT" property="offsetUnit" jdbcType="VARCHAR" />
        </collection>
	</resultMap>
	<select id="selectEventDetailInfoByCode"
		resultMap="rskEvent002DtoMap"
		parameterType="java.lang.String">
		SELECT
		ev.EVENT_NAME,
		ev.EVENT_CODE,
		ev.IS_CALC_INDICATOR,
		ev.REMARK ,
		ev.CREATE_USER ,
		ev.CREATE_DEPT ,
		ev.CREATE_TIME ,
		ev.UPDATE_USER ,
		ev.UPDATE_TIME ,
		er.EVENT_CODE as EVENT_RULE_CODE,
		er.ITEM_CODE ,
		er.ITEM_ANO_NAME ,
		er.ITEM_VALUE ,
		er.MATCH_TYPE ,
		er.OFFSET_VAL ,
		er.OFFSET_TYPE ,
		er.OFFSET_UNIT ,
		er.GROUP_ID
		FROM
		RSK_EVENT ev
		LEFT JOIN RSK_EVENT_ITEM_RULE er
		ON
		ev.EVENT_CODE = er.EVENT_CODE
		<where>
			ev.EVENT_CODE = #{eventCode,jdbcType=VARCHAR}
		</where>
	</select>
	<select id="selectMultiOptionEvent" resultType="com.joyintech.framework.select.SelectOptionDto"
		parameterType="java.util.Map">
		SELECT
		e.EVENT_NAME text,
		e.EVENT_CODE id
		FROM
		RSK_EVENT e
		<where>
			<if test="eventCode != null and eventCode !=''">
				e.EVENT_CODE LIKE CONCAT(CONCAT(#{eventCode,
				jdbcType=VARCHAR}),'%') OR
				e.EVENT_NAME LIKE
				CONCAT(CONCAT(#{eventCode, jdbcType=VARCHAR}),'%')
			</if>
		</where>
	</select>

</mapper>