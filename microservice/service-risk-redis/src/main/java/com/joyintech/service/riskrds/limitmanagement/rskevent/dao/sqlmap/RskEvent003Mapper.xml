<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.riskrds.limitmanagement.rskevent.dao.RskEvent003Mapper">
	<resultMap id="rskEvent003DtoMap" type="com.joyintech.service.riskrds.limitmanagement.rskevent.dto.RskEvent003Dto">
		<id column="EVENT_CODE" property="eventCode" jdbcType="VARCHAR" />
		<result column="EVENT_NAME" property="eventName" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		<collection property="paramList" ofType="com.joyintech.tams.common.base.entity.RskEventParaRel" column="paramList">
			<id column="PARA_CODE" property="paraCode" jdbcType="VARCHAR" />
			<id column="EVENT_CODE" property="eventCode" jdbcType="VARCHAR" />
			<id column="PARA_GRANULARITY" property="paraGranularity" jdbcType="VARCHAR" />
			<result column="REL_TYPE" property="relType" jdbcType="VARCHAR" />
			<result column="REL_ITEM" property="relItem" jdbcType="VARCHAR" />
			<result column="REMARK" property="remark" jdbcType="VARCHAR" />
			<result column="CUSTOM_VAL" property="customVal" jdbcType="DECIMAL" />
			<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
			<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
			<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
			<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
			<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		</collection>
	</resultMap>
	<select id="selectEventRelParaByCode"
		resultMap="rskEvent003DtoMap"
		parameterType="java.lang.String">
		SELECT
		er.EVENT_NAME,
		ev.EVENT_CODE,
		ev.PARA_CODE ,
		ev.EVENT_CODE ,
		ev.PARA_GRANULARITY,
		ev.REL_TYPE ,
		ev.REL_ITEM ,
		ev.REMARK,
		ev.CUSTOM_VAL
		FROM
		RSK_EVENT_PARA_REL ev
		LEFT JOIN RSK_EVENT er
		ON
		ev.EVENT_CODE = er.EVENT_CODE
		<where>
			ev.EVENT_CODE = #{eventCode,jdbcType=VARCHAR}
		</where>
	</select>

</mapper>