    <!-- 资产代码下拉框查询条件 -->
    <sql id="getFinprodIdWhere">
        <where>
            <if test="search != null and search != ''">
                (
                A.FINPROD_MARKET_ID LIKE CONCAT('%', CONCAT(#{search}, '%'))
                or
                A.FINPROD_NAME LIKE CONCAT('%', CONCAT(#{search}, '%'))
                )
            </if>
            <if test="initValue != null and initValue != ''">
                AND A.FINPROD_ID = #{initValue}
            </if>
            <if test="initValue == null or initValue == ''">
            <if test="FINPROD_TYPE_TG != null and FINPROD_TYPE_TG != ''">
                AND A.FINPROD_TYPE2 = #{FINPROD_TYPE_TG}
            </if>
            </if>
            <if test="windtypeone != null and windtypeone != ''">
                AND B.TYPE_4 = #{windtypeone}
            </if>
        </where>
    </sql>
    
    <select id="selectBondHasEexrPlanCount" resultType="java.lang.Integer">
        select count(1)
        from FIN_EXERCISE_PLAN
        where
            FINPROD_ID = #{finprodId}
            and EXERCISE_DATE &gt;= #{sysDate,jdbcType=DATE}
    </select>
    
        <!-- 查询债券市值净价和摊销净价（交易日前最近一天）（吉林银行产品化需求）malinlin 2019.12.2-->
    <select id="getCprice" resultType="com.joyintech.service.trade.bond.dto.SecCpriceInfoDto">
        SELECT
            t.FINPROD_ID finprodId, round(t.DSC_CLEAN_PRICE_B,4) dscprice, round(VALUATION_INFO.NETPRICE,4) netprice
        FROM ptl_sec_valution t	
        left join fin_product fp on t.FINPROD_ID = fp.FINPROD_ID
        left join (
        	select t.SEC_ID,	
                   t.NETPRICE						
            from (select t.*,							
                        row_number() over(partition by t.SEC_ID order by t.VALUE_DATE desc) as rnum							
                   from MST_BOND_VALUATION_INFO t							
                  where VALUE_DATE &lt;= to_date(#{tradeDate}, 'yyyy-MM-dd')-1 day) t							
        	where rnum = 1
        ) VALUATION_INFO							
		ON fp.FINPROD_MARKET_ID = VALUATION_INFO.SEC_ID
        <where>
            t.cdate = to_date(#{tradeDate}, 'yyyy-MM-dd')-1 day
            and t.PORTFOLIO_ID = #{portfolioId}
            and t.FINPROD_ID = #{finprodId}
            and t.INV_AIM = #{invAim} 
            <if test="chlId != null and chlId != ''">
                AND t.SEC_ACCT_ID = #{chlId}
            </if>
        </where>
    </select>
