	<select id="selectDeal" resultMap="TrdaProductDealResultMap">
				select 
				#{VALID_STATUS_01} VALID_STATUS,
				wtrd.TRADE_ID,
				wtrda.ENTRUST_ID,
				pp.PORTFOLIO_ID,
				pp.PORTFOLIO_NAME,
				fp.FINPROD_MARKET_ID,
				fp.FINPROD_ABBR,
				fpa.BOARD,
				wtrd.PS,
				wtrda.DEAL_MODE,
				fpa.FINPROD_ID,
				wtrd.TRADE_MARKET,
				wtrd.TRADE_DATE,
				wtrd.UNIT_CPRICE,
				wtrd.SHARE_AMT,
				wtrd.TRADE_AMT,
				wtrd.CCY,
				wtrd.REMARK,
				wtrd.WORKFLOW_ID ,
				wtrd.workflow_status 
				from
				WFL_TRD_PRODUCT_DEAL wtrd
				left join WFL_TRD_PRODUCT_DEAL_ADD wtrda
									on wtrd.TRADE_ID = wtrda.TRADE_ID
				left join FIN_PRODUCT fp
									on wtrd.FINPROD_ID = fp.FINPROD_ID
				left join FIN_PRODUCT_ADD fpa
									on fpa.FINPROD_ID = fp.FINPROD_ID
				left join PTL_PORTFOLIO pp
									on wtrda.PORTFOLIO_ID = pp.PORTFOLIO_ID
				where pp.INVEST_YESORNO='Y'
				and fp.FINPROD_TYPE2 = #{FINPROD_TYPE_TG_F10}
				AND  wtrd.TRADE_STATUS =#{VALID_STATUS_01}
				
				AND wtrd.PS IN
					<foreach collection="psListDict" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				
				<if test="portFolioIdList != null and portFolioIdList.size() > 0">
					AND (pp.PORTFOLIO_ID IN
					<foreach collection="portFolioIdList" item="item" open="("
							 close=")" separator=",">
						#{item}
					</foreach>
					OR pp.PARENT_PORTFOLIO_ID IN
					<foreach collection="portFolioIdList" item="item" open="("
							 close=")" separator=",">
						#{item}
					</foreach>)
				</if>
				
				<if test="finProdIdList != null and finProdIdList.size() > 0">
					AND wtrd.FINPROD_ID IN
					<foreach collection="finProdIdList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="finProdMARKETList != null and finProdMARKETList.size() > 0">
					AND wtrd.FINPROD_MARKET_ID IN
					<foreach collection="finProdMARKETList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="tradeMarketList != null and tradeMarketList.size() > 0">
					AND wtrd.TRADE_MARKET IN
					<foreach collection="tradeMarketList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="psList != null and psList.size() > 0">
					AND wtrd.PS IN
					<foreach collection="psList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="dealModeList != null and dealModeList.size() > 0">
					AND wtrda.DEAL_MODE IN
					<foreach collection="dealModeList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="boardList != null and boardList.size() > 0">
					AND fpa.BOARD IN
					<foreach collection="boardList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="ccyList != null and ccyList.size() > 0">
					AND wtrd.CCY IN
					<foreach collection="ccyList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="entrustId != null and entrustId != ''">
					AND wtrda.ENTRUST_ID LIKE CONCAT_WS('', '%', #{entrustId}, '%')
				</if>
				
				<if test="finprodId != null and finprodId != ''">
					AND fpa.FINPROD_ID = #{finprodId, jdbcType=VARCHAR}
				</if>
				
				<if test="traderList != null and traderList.size() > 0">
					AND trd.TRADER IN
					<foreach collection="traderList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				<if test="tradeDateBegin != null and tradeDateBegin != ''">
                        AND wtrd.TRADE_DATE >= STR_TO_DATE(#{tradeDateBegin}, '%Y-%m-%d')
                    </if>
                <if test="tradeDateEnd != null and tradeDateEnd != ''">
                    AND wtrd.TRADE_DATE &lt;= STR_TO_DATE(#{tradeDateEnd}, '%Y-%m-%d')
                </if>
                
				<if test="validStatus != null and validStatus != ''">
					and #{VALID_STATUS_01} = #{validStatus}
				</if>
			UNION ALL
				select  
				
				if(trd.IS_CANCEL=#{YES_NO_YES},#{VALID_STATUS_03},#{YES_NO_NO}, if(trd.IS_CANCEL=#{VALID_STATUS_02},#{VALID_STATUS_02}, null)) as VALID_STATUS,
				trd.TRADE_ID,
				tpda.ENTRUST_ID,
				PP.PORTFOLIO_ID,
				pp.PORTFOLIO_NAME,
				fp.FINPROD_MARKET_ID,
				fp.FINPROD_ABBR,
				fpa.BOARD,
				trd.PS,
				tpda.DEAL_MODE,
				fpa.FINPROD_ID,
				trd.TRADE_MARKET,
				trd.TRADE_DATE,
				trd.UNIT_CPRICE,
				trd.SHARE_AMT,
				trd.TRADE_AMT,
				trd.CCY,
				trd.REMARK,
				null WORKFLOW_ID , 
             	null workflow_status  
				from TRD_PRODUCT_DEAL trd
				left join TRD_PRODUCT_DEAL_ADD tpda
									on trd.TRADE_ID = tpda.TRADE_ID
				left join FIN_PRODUCT fp
									on trd.FINPROD_ID = fp.FINPROD_ID
				left join FIN_PRODUCT_ADD fpa
									on fpa.FINPROD_ID = fp.FINPROD_ID
				LEFT JOIN PTL_TRADE PT ON IFNULL(trd.P_TRADE_ID,trd.TRADE_ID) = PT.BUSI_NO
				LEFT JOIN PTL_PORTFOLIO PP ON PT.PORTFOLIO_ID = PP.PORTFOLIO_ID
				where PP.INVEST_YESORNO = 'Y'
				AND fp.FINPROD_TYPE2 = #{FINPROD_TYPE_TG_F10}
				
					AND trd.PS IN
					<foreach collection="psListDict" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				<if test="validStatus != null and validStatus != ''">
					
					<if test="validStatus == VALID_STATUS_02">
						AND (trd.IS_CANCEL is null or trd.IS_CANCEL = #{YES_NO_NO})
					</if>
					
					<if test=" validStatus == VALID_STATUS_03">
						AND  trd.IS_CANCEL = #{YES_NO_YES}
					</if>
					AND ( #{validStatus} =#{VALID_STATUS_02} or #{validStatus} =#{VALID_STATUS_03} )
				</if>
				
				<if test="portFolioIdList != null and portFolioIdList.size() > 0">
					AND (pp.PORTFOLIO_ID IN
					<foreach collection="portFolioIdList" item="item" open="("
							 close=")" separator=",">
						#{item}
					</foreach>
					OR pp.PARENT_PORTFOLIO_ID IN
					<foreach collection="portFolioIdList" item="item" open="("
							 close=")" separator=",">
						#{item}
					</foreach>)
				</if>
				
				<if test="finprodIdList != null and finprodIdList.size() > 0">
					AND trd.FINPROD_ID IN
					<foreach collection="finprodIdList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="finprodMARKETList != null and finprodMARKETList.size() > 0">
					AND fp.FINPROD_MARKET_ID IN
					<foreach collection="finprodMARKETList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="tradeMarketList != null and tradeMarketList.size() > 0">
					AND trd.TRADE_MARKET IN
					<foreach collection="tradeMarketList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="psList != null and psList.size() > 0">
					AND trd.PS IN
					<foreach collection="psList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="dealModeList != null and dealModeList.size() > 0">
					AND tpda.DEAL_MODE IN
					<foreach collection="dealModeList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="boardList != null and boardList.size() > 0">
					AND fpa.BOARD IN
					<foreach collection="boardList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="ccyList != null and ccyList.size() > 0">
					AND trd.CCY IN
					<foreach collection="ccyList" item="item" open="(" close=")"
						separator=",">
						#{item}
					</foreach>
				</if>
				
				<if test="entrustId != null and entrustId != ''">
					AND tpda.ENTRUST_ID LIKE CONCAT_WS('', '%', #{entrustId}, '%')
				</if>
				
				<if test="finprodId != null and finprodId != ''">
					AND fpa.FINPROD_ID = #{finprodId, jdbcType=VARCHAR}
				</if>
				
				<if test="traderList != null and traderList.size() > 0">
					AND trd.TRADER IN
					<foreach collection="traderList" item="item" open="("
						close=")" separator=",">
						#{item}
					</foreach>
				</if>
				<if test="tradeDateBegin != null and tradeDateBegin != ''">
                        AND trd.TRADE_DATE >= STR_TO_DATE(#{tradeDateBegin}, '%Y-%m-%d')
                    </if>
                    <if test="tradeDateEnd != null and tradeDateEnd != ''">
                        AND trd.TRADE_DATE &lt;= STR_TO_DATE(#{tradeDateEnd}, '%Y-%m-%d')
                    </if>
				and trd.P_TRADE_ID is null
		ORDER BY  TRADE_ID DESC
	</select>
	<select id="selectEtrByKey" resultMap="TrdaProductDealResultMap">
        SELECT
            T1.ENTRUST_ID           ENTRUST_ID,
            T1.PORTFOLIO_ID         PORTFOLIO_ID,
            T1.VDATE                vdate,
            T1.MDATE                mdate,
            T6.TYPE_6               assetType1,
            T6.TYPE_7               assetType2,
            T1.CCY                  CCY,
            T3.FINPROD_MARKET_ID    FINPROD_MARKET_ID,
            T3.FINPROD_ID    		FINPROD_ID,
            T3.FINPROD_ABBR         FINPROD_ABBR,
            T3.FINPROD_NAME	        FINPROD_NAME,
            T1.PS                   PS,
            T1.PRICE                price,
            T1.TRADE_MARKET         TRADE_MARKET,
            T4.BOARD                BOARD,
            T5.DEAL_MODE            DEAL_MODE,
            T5.SEC_ACCT_ID          SEC_MANAGE_ACCT_ID,
            T1.ENTRUST_AMT          ENTRUST_AMT,
            T1.ENTRUST_NUM          ENTRUST_NUM,
            T1.PRICE				PRICE,
            T1.PRO_AVAILABLE_CASH   PRO_AVAILABLE_CASH,
            T1.ACC_AVAILABLE_CASH   ACC_AVAILABLE_CASH,
            T1.REMARK               REMARK,
            T1.COUNTER_ID           COUNTER_ID,
            T1.COUNTER_TRADER       COUNTER_TRADER,
            T1.CONTACT_INFO         CONTACT_INFO,
            T2.TRADER               TRADER,
            IFNULL(T7.FINISH_AMT,0)    FINISH_AMT,
            T1.INV_MANAGER_ID       INV_MANAGER_ID,
            T1.CHL_ID               CHL_ID,
            T1.SALE_CODE            SALE_CODE
        FROM ETR_ENTRUST T1
        LEFT JOIN ETR_DISTRIBUTE T2 ON
            T1.ENTRUST_ID = T2.ENTRUST_ID
        LEFT JOIN FIN_PRODUCT T3 ON
            T1.FINPROD_ID = T3.FINPROD_ID
        INNER JOIN FIN_PRODUCT_ADD T4 ON
            T1.FINPROD_ID = T4.FINPROD_ID
        INNER JOIN ETR_ENTRUST_ADD T5 ON
            T1.ENTRUST_ID = T5.ENTRUST_ID
        LEFT JOIN FIN_PRODUCT_TYPE T6 ON
            T1.FINPROD_ID = T6.FINPROD_ID
        LEFT JOIN ( SELECT ENTRUST_ID, SUM(IFNULL(FINISH_AMT,0)) FINISH_AMT FROM ETR_FINISH_STATUS GROUP BY ENTRUST_ID) T7 ON
            T1.ENTRUST_ID = T7.ENTRUST_ID
        <where>
            T1.ENTRUST_ID = #{entrustId}
        </where>
    </select>
</mapper>
