<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.asset.common.dao.BussRepDlRepoInfoMapper">
    <select id="getBussRepDlRepoInfoByProductId"  parameterType="Map" resultType="com.joyintech.service.asset.common.dto.BussRepDlRepoInfoDto">
		SELECT
	<include refid="com.joyintech.tams.common.base.dao.AssetComonFieldMapper.RepAssetInterLend_Base_Column_List" />
	,T2.REP_ASSET_TYPE
	,T2.REP_TRADE_MARKET	
	FROM
	REP_ASSET_INTER_LEND T1
	INNER JOIN REP_ASSET_DEPT T2 ON T2.REP_FINPROD_ID = T1.REP_FINPROD_ID 
	<where>
		<if test="finprodId != null and finprodId != ''">
			AND T1.REP_FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
		</if>
	</where>
	</select>
</mapper>