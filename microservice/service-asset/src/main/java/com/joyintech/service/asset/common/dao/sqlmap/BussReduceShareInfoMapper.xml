<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.asset.common.dao.BussReduceShareInfoMapper">
	<select id="getBussReduceShareInfoByProductId" parameterType="Map" resultType="com.joyintech.tams.common.base.entity.FinReduceShareInfo">
		SELECT
		 REDUCE_DATE
		 ,REDUCE_PER*100 REDUCE_PER
		 ,REMARK
		 FROM 
		 FIN_REDUCE_SHARE_INFO
		<where>
			<if test="finprodId != null and finprodId != ''">
				AND FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
			</if>
		</where>
	</select>
	
	<delete id="deleteByProductId">
        delete from FIN_REDUCE_SHARE_INFO
        where FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
    </delete>
</mapper>