<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.asset.common.dao.BussSubscriptionInfoMapper">
	<select id="getBussSubscriptionInfoByProductId" parameterType="Map" resultType="com.joyintech.tams.common.base.entity.FinSubscriptionInfo">
		SELECT
		 INSTITUTION_NAME
		 ,SUBSCRIB_AMOUT
		 ,SUBSCRIB_DATE
		 ,SUBSCRIB_RATE*100  SUBSCRIB_RATE
		 FROM 
		 FIN_SUBSCRIPTION_INFO
		<where>
			<if test="finprodId != null and finprodId != ''">
				AND FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
			</if>
		</where>
	</select>
	
	<delete id="deleteByProductId">
        delete from FIN_SUBSCRIPTION_INFO
        where FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
    </delete>
</mapper>