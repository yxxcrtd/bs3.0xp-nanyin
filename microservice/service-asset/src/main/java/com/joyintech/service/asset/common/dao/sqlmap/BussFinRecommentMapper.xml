<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.asset.common.dao.BussFinRecommentMapper">
	<select id="getFinProductRecommentByProductId" parameterType="Map" resultMap="com.joyintech.tams.common.base.dao.FinProductRecommentMapper.BaseResultMap">
		SELECT
		<include refid="com.joyintech.tams.common.base.dao.FinProductRecommentMapper.Base_Column_List" />
		FROM
			FIN_PRODUCT_RECOMMENT
		WHERE
			<if test="finprodId != null and finprodId != ''">
				FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
			</if>
	</select>

	<delete id="deleteByProductId" parameterType="Map">
		DELETE FROM FIN_PRODUCT_RECOMMENT
		<where>
		FINPROD_ID = #{finprodId}
		</where>
	</delete>

    <select id="qryRecommenderSelect" resultType="com.joyintech.framework.select.SelectOptionDto">
    	SELECT
    		T1.COUNTER_ID id,
    		T1.COUNTER_NAME text
    	FROM 
    		MST_COUNTER_PARTY T1 
<!--     	INNER JOIN -->
<!--     		MST_CUSTOMER_INFO T2 -->
<!--     	ON -->
<!--     		T1.LINK_ID = T2.CUSTOMER_ID -->
        <where>
            <if test="search != null and search != ''">
                (
                    T1.COUNTER_ID LIKE CONCAT('%', CONCAT(#{search}, '%'))
                    OR
                    T1.COUNTER_NAME LIKE CONCAT('%', CONCAT(#{search}, '%'))
                )
            </if>
            <if test="initValue != null and initValue != ''">
                AND T1.COUNTER_ID = #{initValue}
            </if>
            <if test="counterType != null and counterType != ''">
                AND T1.COUNTER_TYPE = #{counterType}
            </if>
        </where>
    </select>
</mapper>