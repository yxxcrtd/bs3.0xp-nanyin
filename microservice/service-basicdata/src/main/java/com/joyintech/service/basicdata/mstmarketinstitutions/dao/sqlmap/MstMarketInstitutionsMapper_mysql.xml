<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.basicdata.mstmarketinstitutions.dao.MstMarketInstitutionsMapper_mysql">
	<resultMap id="BaseResultMap" type="com.joyintech.service.basicdata.mstmarketinstitutions.dto.MstMarketInstitutionsDto" >
		<id column="CUSTOMER_ID" property="customerId" jdbcType="VARCHAR" />
		<result column="CUSTOMER_NAME" property="customerName" jdbcType="VARCHAR" />
		<!--添加'是否持有金融牌照' add by lishuping 20190823 start-->
		<result column="IS_FIN_LICENCE" property="isFinLicence" jdbcType="VARCHAR" />
		<!--添加'是否持有金融牌照' add by lishuping 20190823 start-->
		<result column="PARTY_TYPE3" property="partyType3" jdbcType="VARCHAR" />
		<result column="PARTY_TYPE2" property="partyType2" jdbcType="VARCHAR" />
		<result column="PARTY_TYPE1" property="partyType1" jdbcType="VARCHAR" />
		<result column="INDUSTRY" property="industry" jdbcType="VARCHAR" />
		<result column="INDUSTRY2" property="industry2" jdbcType="VARCHAR" />
		<result column="INSITITUTE_CODE" property="insitituteCode" jdbcType="VARCHAR" />
		<result column="IS_GOV" property="isGov" jdbcType="VARCHAR" />
		<result column="MAIN_CAPITAL" property="mainCapital" jdbcType="DECIMAL" />
		<result column="REGISTER_CAPITAL" property="registerCapital" jdbcType="DECIMAL" />
		<result column="PROVINCE" property="province" jdbcType="VARCHAR" />
		<result column="CITY" property="city" jdbcType="VARCHAR" />
		<result column="COUNTY" property="county" jdbcType="VARCHAR" />
		<result column="HOLDING_TYPE" property="holdingType" jdbcType="VARCHAR" />
		<result column="CUSTOMER_OBJ_TYPE" property="customerObjType" jdbcType="VARCHAR" />
		<result column="IS_LISTED_COMPANY" property="isListedCompany" jdbcType="VARCHAR" />
		<result column="IS_GROUP_CUSTOMER" property="isGroupCustomer" jdbcType="VARCHAR" />
		<result column="PARENT_CUSTOMER_ID" property="parentCustomerId" jdbcType="VARCHAR" />
		<result column="PARENT_CUSTOMER_NAME" property="parentCustomerName" jdbcType="VARCHAR" />
		<result column="IS_PRIVATE" property="isPrivate" jdbcType="VARCHAR" />
		<result column="IS_ESCAPE_DEPT" property="isEscapeDept" jdbcType="VARCHAR" />
		<result column="CREDIT_TYPE" property="creditType" jdbcType="VARCHAR" />
		<result column="IS_CREDIT_RELATED_TRD" property="isCreditRelatedTrd" jdbcType="VARCHAR" />
		<result column="STRUCT_ADJUST_TYPE" property="structAdjustType" jdbcType="VARCHAR" />
		<result column="INDUS_UPGRATE_TYPE" property="indusUpgrateType" jdbcType="VARCHAR" />
		<!--        <result column="BUSI_SCOPE" property="busiScope" jdbcType="VARCHAR" />-->
		<result column="MAIN_BUSI" property="mainBusi" jdbcType="VARCHAR" />
		<result column="SEX" property="sex" jdbcType="VARCHAR" />
		<result column="PERSON_ID" property="personId" jdbcType="VARCHAR" />
		<result column="M_PHONE" property="mPhone" jdbcType="VARCHAR" />
		<result column="PHONE" property="phone" jdbcType="VARCHAR" />
		<result column="POSITION" property="position" jdbcType="VARCHAR" />
		<result column="COMPANY_NAME" property="companyName" jdbcType="VARCHAR" />
		<result column="ADDRESS" property="address" jdbcType="VARCHAR" />
		<result column="MAIL" property="mail" jdbcType="VARCHAR" />
		<result column="PROPERTY" property="property" jdbcType="VARCHAR" />
		<result column="LINK_ID1" property="linkId1" jdbcType="VARCHAR" />
		<result column="LINK_ID2" property="linkId2" jdbcType="VARCHAR" />
		<result column="LINK_ID3" property="linkId3" jdbcType="VARCHAR" />
		<result column="REMARK" property="remark" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>
	<select id="select" parameterType="Map" resultMap="BaseResultMap">
		select 
        	T1.CUSTOMER_ID, T1.CUSTOMER_NAME,
        	T2.PARTY_TYPE3, T2.PARTY_TYPE2, T2.PARTY_TYPE1, 
	        T2.INDUSTRY, T2.INDUSTRY2, T2.INSITITUTE_CODE, T2.IS_GOV, 
	        T2.MAIN_CAPITAL, T2.REGISTER_CAPITAL, T2.PROVINCE, 
	        T2.CITY, T2.COUNTY, T2.HOLDING_TYPE, T2.CUSTOMER_OBJ_TYPE, 
	        T2.IS_LISTED_COMPANY, T2.IS_GROUP_CUSTOMER, T2.PARENT_CUSTOMER_ID, 
	        T2.PARENT_CUSTOMER_NAME, T2.IS_PRIVATE, T2.IS_ESCAPE_DEPT, 
	        T2.CREDIT_TYPE, T2.IS_CREDIT_RELATED_TRD, T2.STRUCT_ADJUST_TYPE, 
	        T2.INDUS_UPGRATE_TYPE, T2.BUSI_SCOPE, MAIN_BUSI, 
	        T2.SEX, T2.PERSON_ID, T2.M_PHONE, T2.PHONE, T2.POSITION, T2.COMPANY_NAME, 
	        T2.ADDRESS, T2.MAIL, T2.PROPERTY, T2.LINK_ID1, T2.LINK_ID2, 
	        T2.LINK_ID3, T2.REMARK, T2.CREATE_USER, T2.CREATE_DEPT, 
	        T2.CREATE_TIME, T2.UPDATE_USER, T2.UPDATE_TIME
			
	        ,T2.IS_FIN_LICENCE
			
        from MST_CUSTOMER_INFO T1 left  outer join MST_CUSTOMER_INFO_ADD T2
        on T1.CUSTOMER_ID = T2.CUSTOMER_ID
        <where>
			<if test="customerId != null and customerId != ''">
			AND	T1.CUSTOMER_ID like concat('%',concat(#{customerId,jdbcType=VARCHAR},'%'))
			</if>
			<if test="customerName != null and customerName != ''">
			AND	T1.CUSTOMER_NAME like concat('%',concat(#{customerName,jdbcType=VARCHAR},'%'))
			</if>
			<if test="customerType != null and customerType != ''">
			AND T1.CUSTOMER_TYPE = #{customerType,jdbcType=VARCHAR}
			</if>
			
			<if test="isFinLicence != null and isFinLicence != '' and isFinLicence != 'NULL'">
				AND T2.IS_FIN_LICENCE = #{isFinLicence,jdbcType=VARCHAR}
			</if>
			<if test="isFinLicence != null and isFinLicence != '' and isFinLicence == 'NULL'">
				AND T2.IS_FIN_LICENCE is null
			</if>
			
		</where>
		order by CUSTOMER_ID desc
	</select>

	<!-- 行删除按钮check -->
	<select id="checkCodeIsUse" parameterType="com.joyintech.service.basicdata.mstmarketinstitutions.dto.MstMarketInstitutionsDto" resultType="java.lang.Integer">
		select sum(count) from (
		select count(*) count from MST_CUSTOMER_INFO T1,MST_COUNTER_PARTY T2
		where T1.CUSTOMER_ID = T2.LINK_ID
			and T1.CUSTOMER_ID = #{customerId,jdbcType=VARCHAR}
		union all
		select count(*)  count from MST_CUSTOMER_INFO T3,FIN_PRODUCT T4
		where T3.CUSTOMER_ID=T4.ISSUER
			and T3.CUSTOMER_ID= #{customerId,jdbcType=VARCHAR}
		union all
		select count(*) count from MST_CUSTOMER_INFO T5,FIN_PRODUCT_ADD T6
		where T5.CUSTOMER_ID = T6.UNDER_WRITER_ID
			and T5.CUSTOMER_ID = #{customerId,jdbcType=VARCHAR}
			) de
	</select>
</mapper>
