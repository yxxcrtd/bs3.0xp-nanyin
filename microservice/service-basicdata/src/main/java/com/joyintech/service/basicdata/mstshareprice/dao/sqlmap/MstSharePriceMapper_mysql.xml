<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.basicdata.mstshareprice.dao.MstSharePrice001Mapper_mysql">
    <resultMap id="BaseResultMap" type="com.joyintech.service.basicdata.mstshareprice.dto.MstSharePriceDto" >
        <id column="SHARES_ID" property="sharesId" jdbcType="VARCHAR" />
        <id column="DEAL_DATE" property="dealDate" jdbcType="DATE" />
        <result column="CCY" property="ccy" jdbcType="VARCHAR" />
        <result column="FINPROD_ABBR" property="finprodAbbr" jdbcType="VARCHAR" />
        <result column="PRE_CLOSE_PRICE" property="preClosePrice" jdbcType="DECIMAL" />
        <result column="OPEN_PRICE" property="openPrice" jdbcType="DECIMAL" />
        <result column="HIGH_PRICE" property="highPrice" jdbcType="DECIMAL" />
        <result column="LOW_PRICE" property="lowPrice" jdbcType="DECIMAL" />
        <result column="CLOSE_PRICE" property="closePrice" jdbcType="DECIMAL" />
        <result column="S_SHARES" property="sShares" jdbcType="DECIMAL" />
        <result column="C_SHARES" property="cShares" jdbcType="DECIMAL" />
        <result column="CHANGE" property="change" jdbcType="DECIMAL" />
        <result column="CHANGE_PERCENT" property="changePercent" jdbcType="DECIMAL" />
        <result column="DEAL_VALUME" property="dealValume" jdbcType="DECIMAL" />
        <result column="DEAL_AMOUNT" property="dealAmount" jdbcType="DECIMAL" />
        <result column="AVG_PRICE" property="avgPrice" jdbcType="DECIMAL" />
        <result column="PRE_CLOSE_PRICE_ADJ" property="preClosePriceAdj" jdbcType="DECIMAL" />
        <result column="OPEN_PRICE_ADJ" property="openPriceAdj" jdbcType="DECIMAL" />
        <result column="HIGH_PRICE_ADJ" property="highPriceAdj" jdbcType="DECIMAL" />
        <result column="LOW_PRICE_ADJ" property="lowPriceAdj" jdbcType="DECIMAL" />
        <result column="CLOSE_PRICE_ADJ" property="closePriceAdj" jdbcType="DECIMAL" />
        <result column="FACTOR_ADJ" property="factorAdj" jdbcType="DECIMAL" />
        <result column="TRADE_STATUS" property="tradeStatus" jdbcType="VARCHAR" />
        <result column="INPUT_TYPE" property="inputType" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
	<select id="getLatelyShareById" resultMap="BaseResultMap" parameterType="Map" >
        select 
        <include refid="com.joyintech.service.basicdata.mstshareprice.dao.MstSharePrice001Mapper.Base_Column_List" />
        from MST_SHARE_PRICE
        where SHARES_ID = #{sharesId,jdbcType=VARCHAR}
        	and  deal_date= (select max(deal_date) from mst_share_price 
          						where DATE_FORMAT(DEAL_DATE,'%Y-%m-%d') &lt; #{dealDateString}
          						and SHARES_ID = #{sharesId,jdbcType=VARCHAR}) 
    </select>
	<select id="select" resultMap="BaseResultMap" parameterType="Map" >
        select  distinct
        a.SHARES_ID 			SHARES_ID, 
        a.DEAL_DATE 			DEAL_DATE, 
        a.CCY 					CCY, 
        a.PRE_CLOSE_PRICE 		PRE_CLOSE_PRICE, 
        a.OPEN_PRICE 			OPEN_PRICE, 
        a.HIGH_PRICE 			HIGH_PRICE, 
        a.LOW_PRICE 			LOW_PRICE, 
        a.CLOSE_PRICE 			CLOSE_PRICE, 
        a.S_SHARES 				S_SHARES, 
        a.C_SHARES 				C_SHARES, 
        a.CHANGE 				CHANGE, 
        a.CHANGE_PERCENT 		CHANGE_PERCENT, 
        a.DEAL_VALUME 			DEAL_VALUME, 
        a.DEAL_AMOUNT 			DEAL_AMOUNT, 
        a.AVG_PRICE 			AVG_PRICE, 
        a.PRE_CLOSE_PRICE_ADJ 	PRE_CLOSE_PRICE_ADJ, 
        a.OPEN_PRICE_ADJ 		OPEN_PRICE_ADJ, 
        a.HIGH_PRICE_ADJ 		HIGH_PRICE_ADJ, 
        a.LOW_PRICE_ADJ 		LOW_PRICE_ADJ, 
        a.CLOSE_PRICE_ADJ 		CLOSE_PRICE_ADJ, 
        a.FACTOR_ADJ 			FACTOR_ADJ, 
        a.TRADE_STATUS 			TRADE_STATUS, 
        a.INPUT_TYPE 			INPUT_TYPE, 
        a.CREATE_USER 			CREATE_USER, 
        a.CREATE_DEPT 			CREATE_DEPT, 
        a.CREATE_TIME 			CREATE_TIME, 
        a.UPDATE_USER 			UPDATE_USER, 
        a.UPDATE_TIME 			UPDATE_TIME,
        b.finprod_abbr 			finprod_abbr
        from mst_share_price a 
        left join fin_product b on a.shares_id=b.finprod_market_id
        <where> 
         <if test="sharesId != null and !sharesId.equals('')" >
               and SHARES_ID =#{sharesId}
          </if>
          <if test="dealDateString != null and !dealDateString.equals('')" >
            and  DATE_FORMAT(DEAL_DATE,'%Y-%m-%d') =#{dealDateString}
          </if>
         </where>
    </select>
</mapper>
