<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.riskrdsinf.process.dao.RskApprovalMapper" >
    <sql id="where_sql">
    	<if test="pageId != null and pageId !=''">
     		and pm.PAGE_ID = #{pageId}
     	</if>
        <if test="businessDataPk1 != null and businessDataPk1 != ''">
           	and pm.BUSINESS_DATA_PK1 = #{businessDataPk1}
		</if>
		<if test="businessDataPk2 != null and businessDataPk2 != ''">
			and pm.BUSINESS_DATA_PK2 = #{businessDataPk2}
		</if>
		<if test="businessDataPk3 != null and businessDataPk3 != ''">
			and pm.BUSINESS_DATA_PK3 = #{businessDataPk3}
		</if>
		<if test="businessDataPk4 != null and businessDataPk4 != ''">
			and pm.BUSINESS_DATA_PK4 = #{businessDataPk4}
		</if>
		<if test="businessDataPk5 != null and businessDataPk5 != ''">
			and pm.BUSINESS_DATA_PK5 = #{businessDataPk5}
		</if>
		<if test="businessDataPk6 != null and businessDataPk6 != ''">
			and pm.BUSINESS_DATA_PK6 = #{businessDataPk6}
		</if>
		<if test="businessDataPk7 != null and businessDataPk7 != ''">
			and pm.BUSINESS_DATA_PK7 = #{businessDataPk7}
		</if>
		<if test="businessDataPk8 != null and businessDataPk8 != ''">
			and pm.BUSINESS_DATA_PK8 = #{businessDataPk8}
		</if>
		<if test="businessDataPk9 != null and businessDataPk9 != ''">
			and pm.BUSINESS_DATA_PK9 = #{businessDataPk9}
		</if>
		<if test="businessDataPk10 != null and businessDataPk10 != ''">
			and pm.BUSINESS_DATA_PK10 = #{businessDataPk10}
		</if>
    </sql>
    <select id="getLastWorkflowId" resultType="java.lang.String">
	     select DISTINCT pm.WORKFLOW_ID from SYS_DATA_PROCESS_MARK pm
	     <where>
	     	pm.CREATE_TIME = (
	     	select MAX(CREATE_TIME) from SYS_DATA_PROCESS_MARK
	        <where> 
				<if test="pageId != null and pageId !=''">
		     		and PAGE_ID = #{pageId}
		     	</if>
		        <if test="businessDataPk1 != null and businessDataPk1 != ''">
		           	and BUSINESS_DATA_PK1 = #{businessDataPk1}
				</if>
				<if test="businessDataPk2 != null and businessDataPk2 != ''">
					and BUSINESS_DATA_PK2 = #{businessDataPk2}
				</if>
				<if test="businessDataPk3 != null and businessDataPk3 != ''">
					and BUSINESS_DATA_PK3 = #{businessDataPk3}
				</if>
				<if test="businessDataPk4 != null and businessDataPk4 != ''">
					and BUSINESS_DATA_PK4 = #{businessDataPk4}
				</if>
				<if test="businessDataPk5 != null and businessDataPk5 != ''">
					and BUSINESS_DATA_PK5 = #{businessDataPk5}
				</if>
				<if test="businessDataPk6 != null and businessDataPk6 != ''">
					and BUSINESS_DATA_PK6 = #{businessDataPk6}
				</if>
				<if test="businessDataPk7 != null and businessDataPk7 != ''">
					and BUSINESS_DATA_PK7 = #{businessDataPk7}
				</if>
				<if test="businessDataPk8 != null and businessDataPk8 != ''">
					and BUSINESS_DATA_PK8 = #{businessDataPk8}
				</if>
				<if test="businessDataPk9 != null and businessDataPk9 != ''">
					and BUSINESS_DATA_PK9 = #{businessDataPk9}
				</if>
				<if test="businessDataPk10 != null and businessDataPk10 != ''">
					and BUSINESS_DATA_PK10 = #{businessDataPk10}
				</if>
			</where>
			)
	        <include refid="where_sql"/>
	     </where>
	     
    </select>
</mapper>