<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.riskrdsinf.cache.dao.SysParaMapper">
    
    <resultMap type="com.joyintech.service.riskrdsinf.cache.entity.SysPara" id="resultMap">
        <id column="SYSTEM_CODE" property="systemCode" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <id column="PARA_CODE" property="paraCode" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="PARAM_VALUE" property="paramValue" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" javaType="java.lang.String"/>
    </resultMap>

	<select id="selectInfAll" resultMap="resultMap">
		SELECT
		 SYSTEM_CODE,
		 PARA_CODE,
		 PARAM_VALUE,
		 CREATE_DEPT
		FROM SYS_PARA
		WHERE SYSTEM_CODE = 'INF'
	</select>
	<select id="selectParaOne" resultMap="resultMap" parameterType="com.joyintech.service.riskrdsinf.cache.entity.SysParaKey">
		SELECT
		 SYSTEM_CODE,
		 PARA_CODE,
		 PARAM_VALUE,
		 CREATE_DEPT
		FROM SYS_PARA
		WHERE SYSTEM_CODE = #{systemCode}
		AND PARA_CODE = #{paraCode}
	</select>
</mapper>