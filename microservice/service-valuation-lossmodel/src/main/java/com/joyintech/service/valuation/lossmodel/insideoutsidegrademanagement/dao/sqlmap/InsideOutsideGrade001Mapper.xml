<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
        namespace="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dao.InsideOutsideGrade001Mapper">

    <insert id="insert" parameterType="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dto.InsideOutsideGrade001Dto" >
        insert into MOD_STANDARD_GRADE_MAPPING (SEQ_NO,GRADE_INST,GRADE_RESULT,GRADE_STANDARD_RESULT,CREATE_USER,CREATE_DEPT,CREATE_TIME,UPDATE_USER,UPDATE_TIME)
        values (#{seqNo,jdbcType=VARCHAR}, #{gradeInst,jdbcType=VARCHAR},
        #{gradeResult,jdbcType=VARCHAR}, #{gradeStandardResult,jdbcType=VARCHAR},
        #{createUser,jdbcType=VARCHAR},#{createDept,jdbcType=VARCHAR},#{createTime,jdbcType=TIMESTAMP}, #{updateUser,jdbcType=VARCHAR},
        #{updateTime,jdbcType=TIMESTAMP})
    </insert>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.String" >
        delete from MOD_STANDARD_GRADE_MAPPING
        where GRADE_INST = #{gradeInst,jdbcType=VARCHAR}
    </delete>

    <select id="checkData" resultType="int" parameterType="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dto.InsideOutsideGrade001Dto" >
        select COUNT(1)
        from MOD_STANDARD_GRADE_MAPPING
        where 1=1
        <if test="gradeInst!=null and gradeInst != ''">
            AND  GRADE_INST = #{gradeInst,jdbcType=VARCHAR}
        </if>
        <if test="gradeResult!=null and gradeResult != ''">
            AND  GRADE_RESULT = #{gradeResult,jdbcType=VARCHAR}
        </if>
    </select>

    <select id="getQueryData" resultType="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dto.InsideOutsideGrade001Dto">
        SELECT distinct
        A.GRADE_INST AS gradeInst
        FROM
        MOD_STANDARD_GRADE_MAPPING A
        WHERE
        1=1
        <if test="gradeInst!=null and gradeInst != ''">
            AND  GRADE_INST = #{gradeInst,jdbcType=VARCHAR}
        </if>
</select>

    <select id="getBySeqNo" resultType="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dto.InsideOutsideGrade001Dto">
        SELECT
        A.SEQ_NO AS seqNo,
        A.GRADE_INST AS gradeInst,
        A.GRADE_RESULT AS gradeResult,
        A.GRADE_STANDARD_RESULT AS gradeStandardResult,
        A.CREATE_USER AS createUser,
        A.CREATE_DEPT AS createDept,
        A.CREATE_TIME AS createTime,
        A.UPDATE_USER AS updateUser,
        A.UPDATE_TIME AS updateTime
        FROM
        MOD_STANDARD_GRADE_MAPPING A LEFT JOIN SYS_DATADICT_LIST L ON DICT_CODE = 'MAIN_GRADE_RESULT' AND ITEM_CODE = A.GRADE_STANDARD_RESULT
        WHERE
        1=1
        <if test="gradeInst!=null and gradeInst != ''">
            AND  GRADE_INST = #{gradeInst,jdbcType=VARCHAR}
        </if>
        ORDER BY L.ORDER_NO
    </select>

    <select id="getExportData" resultType="com.joyintech.service.valuation.lossmodel.insideoutsidegrademanagement.dto.InsideOutsideGrade001Dto">
        SELECT
        A.GRADE_INST AS gradeInst,
        A.GRADE_RESULT AS gradeResult,
        A.GRADE_STANDARD_RESULT AS gradeStandardResult
        FROM
        MOD_STANDARD_GRADE_MAPPING A
        WHERE
        1=1
        <if test="gradeInst!=null and gradeInst != ''">
            AND  GRADE_INST = #{gradeInst,jdbcType=VARCHAR}
        </if>
        <if test="list !=null and list.size>0">
            and GRADE_INST IN
            <foreach  item="item" index="index" collection="list"  open="(" separator="," close=")">
                #{item.gradeInst}
            </foreach>
        </if>
        ORDER BY GRADE_INST ASC
    </select>
</mapper>