<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dao.ModPdFactorKpmgConfigInfoMapper">
    <select id="selectForPage"
            resultType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfigInfoDto">
        SELECT 
			A.SEQNO seqno,
			A.VOUCH_YEAR vouchYear,
			A.COMBINED_FACTOR combinedFactor
		FROM MOD_PD_FACTOR_CONFIG A WHERE 1=1
        <if test="vouchYear != null and vouchYear != ''">
            AND A.VOUCH_YEAR = #{vouchYear,jdbcType=VARCHAR}
        </if>
        ORDER BY A.VOUCH_YEAR DESC
    </select>
    <select id="selectByYear"
            resultType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfigInfoDto">
		SELECT 
			A.SEQNO seqno,
			A.VOUCH_YEAR vouchYear
		FROM MOD_PD_FACTOR_CONFIG A
		WHERE A.VOUCH_YEAR = #{vouchYear,jdbcType=VARCHAR}
    </select>
    
    <select id="selectByPrimaryKey" resultType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfigInfoDto">
        SELECT 
			A.SEQNO seqno,
			A.VOUCH_YEAR vouchYear,
			A.COMBINED_FACTOR combinedFactor
		FROM MOD_PD_FACTOR_CONFIG A WHERE 1=1 
		AND A.SEQNO = #{seqno}
    </select>
    


    <!--判断前瞻因子是否被使用-->
	<select id="checkBySeqNo" parameterType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfigInfoDto" resultType="java.lang.Integer">
		select count(1)
        	from MOD_CONFIG_USEAGE A
        WHERE
        	A.CONFIG_SEQNO=#{seqno,jdbcType=VARCHAR}
        	AND A.CONFIG_TYPE='04'
	</select>


    <insert id="insertSelective" parameterType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfig" >
        insert into MOD_PD_FACTOR_CONFIG
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="seqno != null" >
                SEQNO,
            </if>
            <if test="vouchYear != null" >
                VOUCH_YEAR,
            </if>
            <if test="combinedFactor != null" >
                COMBINED_FACTOR,
            </if>
            <if test="createUser != null" >
                CREATE_USER,
            </if>
            <if test="createDept != null" >
                CREATE_DEPT,
            </if>
            <if test="createTime != null" >
                CREATE_TIME,
            </if>
            <if test="updateUser != null" >
                UPDATE_USER,
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="seqno != null" >
                #{seqno,jdbcType=VARCHAR},
            </if>
            <if test="vouchYear != null" >
                #{vouchYear,jdbcType=VARCHAR},
            </if>
            <if test="combinedFactor != null" >
                #{combinedFactor,jdbcType=VARCHAR},
            </if>
            <if test="createUser != null" >
                #{createUser,jdbcType=VARCHAR},
            </if>
            <if test="createDept != null" >
                #{createDept,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateUser != null" >
                #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>

    <update id="updateByPrimaryKey" parameterType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfig" >
        update MOD_PD_FACTOR_CONFIG
        set VOUCH_YEAR = #{vouchYear,jdbcType=VARCHAR},
            COMBINED_FACTOR = #{combinedFactor,jdbcType=VARCHAR},
            UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP}
        where  SEQNO= #{seqno,jdbcType=VARCHAR}
    </update>

    <delete id="deleteByPrimaryKey" parameterType="com.joyintech.service.valuation.lossmodel.pddefaultmanager.pdfactorkpmgconfig.dto.ModPdFactorKpmgConfigKey" >
        delete from MOD_PD_FACTOR_CONFIG
        where SEQNO = #{seqno,jdbcType=VARCHAR}
    </delete>
</mapper>