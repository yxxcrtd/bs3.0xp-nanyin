<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper	namespace="com.joyintech.service.basicdata.marketdata.mstmarketcalendarinfo.dao.ComMarketCalendarInfoMapper_mysql">
	<select id="selectInfo"
		resultType="com.joyintech.service.basicdata.marketdata.mstmarketcalendarinfo.dto.ComMarketCalendarInfo001Dto">
		select 
		T1.calendar_id calendarId , 
		T1.cdate cdate , 
		T1.is_holiday isHoliday , 
		T1.is_holiday yorn ,
		T2.CALENDAR_NAME calendarName
		from
		MST_HOLIDAY T1
		left join MST_CALENDAR_INFO T2 on T1.calendar_Id = T2.calendar_Id
		<where>
			<if test="calendarTypeList != null">
				<foreach collection="calendarTypeList" item="item"
					open="T1.calendar_id in(" close=")" separator=",">
					#{item}
				</foreach>
			</if>
			<if test='ishDay != null and !ishDay.equals("")'>
				and T1.is_holiday = #{ishDay}
			</if>
			<if test="startDate != null and ! startDate.equals('')">
				and T1.cdate &gt;= STR_TO_DATE(#{startDate},'%Y-%m-%d')
			</if>
			<if test="endDate != null and ! endDate.equals('')">
				and T1.cdate &lt;= STR_TO_DATE(#{endDate},'%Y-%m-%d')
			</if>
		</where>
		ORDER BY calendarId ASC,cdate DESC
	</select>
	<insert id="insertBtachEquityInfo" parameterType="java.util.List">
		insert into
		MST_HOLIDAY(MST_HOLIDAY.CALENDAR_ID,MST_HOLIDAY.CDATE,MST_HOLIDAY.IS_HOLIDAY,MST_HOLIDAY.CREATE_USER,MST_HOLIDAY.CREATE_DEPT,MST_HOLIDAY.CREATE_TIME,MST_HOLIDAY.UPDATE_USER,MST_HOLIDAY.UPDATE_TIME)
		values (
		<foreach collection="listN" item="item" index="index"
				 separator=",">
			#{item.calendarId,jdbcType=VARCHAR} ,
			#{item.cdate,jdbcType=DATE} ,
			#{item.isHoliday,jdbcType=VARCHAR} ,
			#{item.createUser,jdbcType=VARCHAR} ,
			#{item.createDept,jdbcType=VARCHAR} ,
			#{item.createTime,jdbcType=TIMESTAMP} ,
			#{item.updateUser,jdbcType=VARCHAR} ,
			#{item.updateTime,jdbcType=TIMESTAMP}
		</foreach>
		)
	</insert>
</mapper>
