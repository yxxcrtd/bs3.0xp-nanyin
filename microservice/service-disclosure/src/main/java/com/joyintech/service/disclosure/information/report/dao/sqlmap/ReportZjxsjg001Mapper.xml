<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.service.disclosure.information.report.dao.ReportZjxsjg001Mapper">

	<select id="queryZjxsjg" resultType="com.joyintech.service.disclosure.information.report.dto.ReportZjxsjg001Dto">
		select
			rpi.prod_id prod_id,
			rpi.prod_name prod_name,
			rpi.prod_re reg_code
		from rep_prod_info rpi
		where rpi.prod_id = #{prodId,jdbcType=VARCHAR}
	</select>
</mapper>