<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-..mybatis.org..DTD Mapper 3.0..EN" "http:..mybatis.org.dtd.mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.disclosure.information.config.reportcontentenum.dao.ReportContentEnum002Mapper_db2">
      <update id="updateByPrimaryKeySelective" parameterType="com.joyintech.service.disclosure.information.config.reportcontentenum.dto.ReportContentEnum002Dto">
     update REP_INDEX_SUB 
       <set >
            <if test="indexName != null" >
                INDEX_NAME = #{indexName,jdbcType=VARCHAR},
            </if>
            <if test="indexDate != null" >
                INDEX_DATE = date(#{indexDate}),
            </if>
            <if test="indexValue != null" >
                INDEX_VALUE = #{indexValue,jdbcType=VARCHAR},
            </if>
            <if test="indexFile != null" >
                INDEX_FILE = #{indexFile,jdbcType=VARCHAR},
            </if>
             <if test="indexType != null" >
                INDEX_TYPE = #{indexType,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = current date,
            </if>
        </set>
        where ID=#{id,jdbcType=VARCHAR}
  </update>
</mapper>
