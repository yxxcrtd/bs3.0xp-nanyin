<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.CbondspecialconditionsMapper_db2">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InterfCbondspecialconditions">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InterfCbondspecialconditionsMapper.Base_Column_List" />
        from (
            select t.*, row_number() over() num from CBONDSPECIALCONDITIONS t			<!-- 中国债券特殊条款 -->
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>