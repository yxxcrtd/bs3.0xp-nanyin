<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.ChinamutualfunddescriptionMapper">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InfChinamutualfunddescriptionWithBLOBs">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InfChinamutualfunddescriptionMapper.Base_Column_List" />
        ,
        <include refid="com.joyintech.tams.common.base.dao.InfChinamutualfunddescriptionMapper.Blob_Column_List" />
        from (
            select t.*, rownum num from CHINAMUTUALFUNDDESCRIPTION t
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>