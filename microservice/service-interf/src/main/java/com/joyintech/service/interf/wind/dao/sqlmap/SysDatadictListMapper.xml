<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.SysDatadictListMapper">
    <select id="selectSysDatadictList"
     resultType="com.joyintech.tams.systemtools.dto.SysDataDict">
        SELECT DICT_CODE dictCode, ITEM_CODE itemCode, ITEM_VALUE itemValue
        FROM SYS_DATADICT_LIST
        <if test="dictCodeList != null and dictCodeList.size() > 0">
            WHERE DICT_CODE IN 
            <foreach item="item" index="index" collection="dictCodeList" open="(" separator=","  close=")">  
                    #{item}   
            </foreach>
        </if>
    </select>
</mapper>