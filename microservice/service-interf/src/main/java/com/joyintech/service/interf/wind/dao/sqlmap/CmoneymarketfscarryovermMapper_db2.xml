<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.CmoneymarketfscarryovermMapper_db2">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InfCmoneymarketfscarryoverm">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InfCmoneymarketfscarryovermMapper.Base_Column_List" />
        from (
            select t.*, row_number() over() num from CMONEYMARKETFSCARRYOVERM t			<!-- 中国货币市场基金份额结转方式 -->
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>