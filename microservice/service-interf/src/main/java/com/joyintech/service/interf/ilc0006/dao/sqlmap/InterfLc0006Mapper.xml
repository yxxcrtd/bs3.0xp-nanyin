<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.ilc0006.dao.InterfLc0006Mapper">
    <select id="selectByCashOutNo" parameterType="java.lang.String" resultType="java.lang.Integer">
        select count(1) 
        from INTERF_CREDIT_ITEM_INFO crinfo
        where crinfo.CASH_OUT_NO = #{cashOutNo,jdbcType=VARCHAR}
    </select>
</mapper>