<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.PayhsrcholidayMapper">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InterfPayhsrcholiday">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InterfPayhsrcholidayMapper.Base_Column_List" />
        from (
            select t.*, rownum num from PAYHSRCHOLIDAY t			<!-- 节假日信息数据 -->
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>