<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.CbondcurvecnbdMapper_db2">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InterfCbondcurvecnbd">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InterfCbondcurvecnbdMapper.Base_Column_List" />
        from (
            select t.*, row_number() over() num from CBONDCURVECNBD t		<!-- 中债登收益率曲线  -->
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>