<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.interf.wind.dao.FxrmbmidrateMapper">
    <select id="select" 
     resultType="com.joyintech.tams.common.base.entity.InterfFxrmbmidrate">
        select 
        <include refid="com.joyintech.tams.common.base.dao.InterfFxrmbmidrateMapper.Base_Column_List" />
        from (
            select t.*, rownum num from FXRMBMIDRATE t			<!-- 中国外汇市场汇率 -->
            where to_char(OPDATE, 'yyyyMMdd') = '${sysDate}'
            order by num
        )
        where num &gt; ${startNum} and num &lt;= ${endNum}
    </select>
</mapper>