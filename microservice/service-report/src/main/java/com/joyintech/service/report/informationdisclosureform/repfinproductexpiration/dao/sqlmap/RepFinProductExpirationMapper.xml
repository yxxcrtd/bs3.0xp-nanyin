<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.report.informationdisclosureform.repfinproductexpiration.dao.RepFinProductExpirationMapper">
	<resultMap id="BaseResultMap" type="com.joyintech.service.report.informationdisclosureform.repfinproductexpiration.dto.RepFinProductExpirationDto" >
        <id column="FINPROD_ID" property="finprodId" jdbcType="VARCHAR" />
        <result column="BRANCH" property="branch" jdbcType="DECIMAL" />
        <result column="P_FINPROD_ID" property="pFinprodId" jdbcType="VARCHAR" />
        <result column="REVEAL_FILE_ID" property="revealFileId" jdbcType="VARCHAR" />
        <result column="FILE_TYPE" property="fileType" jdbcType="VARCHAR" />
        <result column="SALE_CHANNEL" property="saleChannel" jdbcType="VARCHAR" />
        <result column="FINPROD_MARKET_ID" property="finprodMarketId" jdbcType="VARCHAR" />
        <result column="FINPROD_NAME" property="finprodName" jdbcType="VARCHAR" />
        <result column="VDATE" property="vdate" jdbcType="DATE" />
        <result column="MDATE" property="mdate" jdbcType="DATE" />
        <result column="PORTFOLIO_ID" property="portfolioId" jdbcType="VARCHAR" />
        <result column="PROFIT_FLAG" property="profitFlag" jdbcType="VARCHAR" />
        <result column="REP_RISK_LEVEL" property="repRiskLevel" jdbcType="VARCHAR" />
        <result column="YIELD" property="yield" jdbcType="DECIMAL" />
        <result column="TRUST_FEE" property="trustFee" jdbcType="DECIMAL" />
        <result column="SALE_FEE" property="saleFee" jdbcType="DECIMAL" />
        <result column="PAY_DAY" property="payDay" jdbcType="DATE" />
        <result column="CCY" property="ccy" jdbcType="VARCHAR" />
    </resultMap>
    
    <!-- 组合代码联想下拉框 -->
	<select id="getSelectOption" resultType="com.joyintech.framework.select.SelectOptionDto">
	    select distinct 
	    	pp.PORTFOLIO_ID id,pp.PORTFOLIO_NAME text 
	    from PTL_PORTFOLIO pp
	    INNER JOIN 
	    	PTL_MANAGE_OBJ pmo
	    ON	
	    	pp.PORTFOLIO_ID = pmo.PORTFOLIO_ID
	    INNER JOIN 
			PTL_PORTFOLIO_AUTHORITY ppa
		ON
			pp.PORTFOLIO_ID = ppa.PORTFOLIO_ID
			AND ppa.USER_ID = #{userId} 
	    <where>
	    	<if test="manageObjType !=null and manageObjType !=''">
	    	AND	pmo.MANAGE_OBJ_TYPE=#{manageObjType,jdbcType=VARCHAR}
	    	</if> 
	    	<if test="profitType != null and profitType != ''">
	    	AND pmo.MANAGE_OBJ_ID in (select FINPROD_ID from FIN_PRODUCT where FIN_PRODUCT.PROFIT_TYPE = #{profitType,jdbcType=VARCHAR})
	    	</if>
	    	<if test="search != null and search != ''">
	    	AND (pp.PORTFOLIO_ID like concat('%',concat(#{search},'%'))
	    		OR pp.PORTFOLIO_NAME like concat('%',concat(#{search},'%')))
	    	</if>
	    </where>																																										
	    	
    </select>
    
    <select id="select" resultMap="BaseResultMap">
    	select distinct																																													
			temp.FINPROD_ID,																																												
			temp.BRANCH,																																												
			temp.P_FINPROD_ID,																																											
			temp.REVEAL_FILE_ID,																																												
			temp.FILE_TYPE,																																											
			temp.SALE_DEPARTMENT,																																												
			temp.FINPROD_MARKET_ID,																																												
			temp.FINPROD_NAME,																																												
			temp.VDATE,																																												
			temp.MDATE,																																												
			temp.PORTFOLIO_ID																																											
		from																																													
		(select distinct																																												
			A.FINPROD_ID as FINPROD_ID,																																												
			C.BRANCH as BRANCH,																																											
			A.FINPROD_ID as P_FINPROD_ID,																																												
			D.REVEAL_FILE_ID,																																												
			D.FILE_TYPE,																																												
			E.SALE_DEPARTMENT,																																												
			A.FINPROD_MARKET_ID as FINPROD_MARKET_ID,																																												
			A.FINPROD_NAME as FINPROD_NAME,																																												
			A.VDATE as VDATE,																																												
			A.MDATE as MDATE,																																												
			B.PORTFOLIO_ID as PORTFOLIO_ID																																										
		from																																													
			FIN_PRODUCT A
			left join PRD_FILE D on D.FINPROD_ID = A.FINPROD_ID																																												
			left join FIN_PRODUCT_ADD E on E.FINPROD_ID = A.FINPROD_ID,																																												
			PTL_MANAGE_OBJ B,																																												
			TRD_PRODUCT_DEAL C,																																												
			PA_TRD_PRODUCT_DEAL F																																												
		where																																													
			A.FINPROD_TYPE2 = #{finprodType2,jdbcType=VARCHAR} AND A.PROFIT_TYPE = #{porfitType,jdbcType=VARCHAR}																																												
			AND A.P_FINPROD_ID IS NULL AND A.MDATE <![CDATA[<=]]>  #{sysDate,jdbcType=DATE}  AND A.FINPROD_ID = B.MANAGE_OBJ_ID																																												
			AND A.FINPROD_ID = C.FINPROD_ID  AND C.BRANCH != #{noBranchNoValue,jdbcType=DECIMAL} <!-- AND C.BUSI_TYPE = #{busiType,jdbcType=VARCHAR} -->																																												
			AND C.TRADE_STATUS = #{tradeStatus,jdbcType=VARCHAR} AND (C.IS_CANCEL IS NULL OR C.IS_CANCEL = #{no,jdbcType=VARCHAR})																																												
			AND C.TRADE_ID = F.TRADE_ID  AND F.PA_BUSS_TYPE = #{paBussType,jdbcType=VARCHAR}																																												
		union all																																													
		select distinct																																												
			A.FINPROD_ID as FINPROD_ID,																																												
			A.BRANCH as BRANCH,																																												
			A.FINPROD_ID as P_FINPROD_ID,																																												
			D.REVEAL_FILE_ID,																																												
			D.FILE_TYPE,																																												
			E.SALE_DEPARTMENT,																																												
			C.FINPROD_MARKET_ID as FINPROD_MARKET_ID,																																												
			C.FINPROD_NAME as FINPROD_NAME,																																												
			A.VDATE as VDATE,																																												
			A.MDATE as MDATE,																																												
			B.PORTFOLIO_ID as PORTFOLIO_ID																																												
		from																																													
			FIN_TRADE_PRODUCT A,																																												
			PTL_MANAGE_OBJ B,																																												
			FIN_PRODUCT C
			left join PRD_FILE D on D.FINPROD_ID = C.FINPROD_ID																																												
			left join FIN_PRODUCT_ADD E on E.FINPROD_ID = C.FINPROD_ID,																																												
			TRD_PRODUCT_DEAL F,																																												
			PA_TRD_PRODUCT_DEAL G																																												
		where																																													
			A.MDATE <![CDATA[<=]]> #{sysDate,jdbcType=DATE} AND A.FINPROD_ID = C.FINPROD_ID  AND C.P_FINPROD_ID IS NULL AND C.FINPROD_TYPE2 = #{finprodType2,jdbcType=VARCHAR}																																												
			AND C.PROFIT_TYPE = #{porfitType,jdbcType=VARCHAR}  AND A.FINPROD_ID = B.MANAGE_OBJ_ID																																												
			AND A.FINPROD_ID = F.FINPROD_ID AND F.BRANCH IS NOT NULL <!-- AND F.BUSI_TYPE = #{busiType,jdbcType=VARCHAR} --> AND F.PS = #{ps,jdbcType=VARCHAR}																																											
			AND F.TRADE_STATUS = #{tradeStatus,jdbcType=VARCHAR} AND (F.IS_CANCEL IS NULL OR F.IS_CANCEL = #{no,jdbcType=VARCHAR})																																												
			AND F.TRADE_ID = G.TRADE_ID AND G.PA_BUSS_TYPE = #{paBussType,jdbcType=VARCHAR}																																												
		union all																																													
		select distinct																																													
			A.FINPROD_ID as FINPROD_ID,																																												
			A.BRANCH as BRANCH,																																												
			C.P_FINPROD_ID as P_FINPROD_ID,																																												
			D.REVEAL_FILE_ID,																																												
			D.FILE_TYPE,																																												
			E.SALE_DEPARTMENT,																																												
			C.FINPROD_MARKET_ID as FINPROD_MARKET_ID,																																												
			C.FINPROD_NAME as FINPROD_NAME,																																												
			A.VDATE as VDATE,																																												
			A.MDATE as MDATE,																																												
			B.PORTFOLIO_ID as PORTFOLIO_ID																																												
		from																																													
			FIN_TRADE_PRODUCT A,																																												
			PTL_MANAGE_OBJ B,																																												
			FIN_PRODUCT C
			left join PRD_FILE D on D.FINPROD_ID = C.P_FINPROD_ID																																												
			left join FIN_PRODUCT_ADD E on E.FINPROD_ID = C.P_FINPROD_ID,																																												
			TRD_PRODUCT_DEAL F,																																												
			PA_TRD_PRODUCT_DEAL G																																												
		where																																													
			A.MDATE <![CDATA[<=]]> #{sysDate,jdbcType=DATE} AND A.FINPROD_ID = C.FINPROD_ID AND C.P_FINPROD_ID IN (select E.FINPROD_ID from FIN_PRODUCT E, FIN_PRODUCT_ADD F 																																												
			  where E.P_FINPROD_ID IS NULL AND E.FINPROD_TYPE2 = #{finprodType2,jdbcType=VARCHAR}																																												
			  AND E.PROFIT_TYPE = #{porfitType,jdbcType=VARCHAR} AND E.FINPROD_ID = F.FINPROD_ID AND F.IS_LAY = #{yes,jdbcType=VARCHAR})																																												
			AND C.P_FINPROD_ID = B.MANAGE_OBJ_ID																																												
			AND A.FINPROD_ID = F.FINPROD_ID AND F.BRANCH IS NOT NULL <!-- AND F.BUSI_TYPE = #{busiType,jdbcType=VARCHAR} -->																																												
			AND F.TRADE_STATUS = #{tradeStatus,jdbcType=VARCHAR} AND (F.IS_CANCEL IS NULL OR F.IS_CANCEL = #{no,jdbcType=VARCHAR})																																												
			AND F.TRADE_ID = G.TRADE_ID AND G.PA_BUSS_TYPE = #{paBussType,jdbcType=VARCHAR}																																												
		) temp																																													
		<where>																																												
			<if test="finprodIdList != null and !finprodIdList.equals('')">
				AND temp.PORTFOLIO_ID in 
				<foreach collection="finprodIdList" index="index" item="item" open="(" separator="," close=")">
	               #{item}       
	      	 	</foreach>
      	 	</if>
      	 	<if test="endVDate != null ">
            	AND temp.VDATE <![CDATA[<=]]> #{endVDate,jdbcType=DATE}
        	</if>
        	<if test="startVDate != null ">
            	AND temp.VDATE >= #{startVDate,jdbcType=DATE}
	        </if>
	        <if test="endMDate != null">
	            AND temp.MDATE <![CDATA[<=]]> #{endMDate,jdbcType=DATE}
	        </if>
	        <if test="startMDate != null ">
	            AND temp.MDATE >= #{startMDate,jdbcType=DATE}
	        </if>
	        <if test="department != null and '' != department ">
	            AND temp.SALE_DEPARTMENT = #{department,jdbcType=VARCHAR}	
	        </if>
	        <if test="fileType != null and '' != fileType ">
	           AND temp.FILE_TYPE = #{fileType,jdbcType=VARCHAR}
	        </if>
        </where>																																										
    </select>
    
    <select id="selectResult" resultType="com.joyintech.tams.common.base.entity.PtlGoal">
		select																																											
			ASSET_CLASSIFY as assetClassify,																																										
			round(INVEST_MAX*100,2) as investMax,																																										
			round(INVEST_MIN*100,2) as investMin																																										
		from																																											
			PTL_GOAL																																										
		where																																											
			FINPROD_ID = #{pFinprodId,jdbcType=VARCHAR}																																										
		<!-- 循环上面取得的投资标的比例相关信息，按照右记规则生成（最后一个元素不要加分号）：资产分类+投资占比上限（小数点保留2位）+"-"+投资占比下限（小数点保留2位）+";" -->																																											
	</select>
	
