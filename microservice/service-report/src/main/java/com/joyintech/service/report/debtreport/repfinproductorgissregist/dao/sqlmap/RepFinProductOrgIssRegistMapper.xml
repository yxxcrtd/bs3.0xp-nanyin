	<!-- 
	/**
     * 产品代码/名称的联想下拉框
     */
    List<SelectOptionDto> getRepFinprodName(Map<String, Object> param);
	 -->
	<select id="getRepFinprodName" resultType="com.joyintech.framework.select.SelectOptionDto">
		SELECT
			A.REP_BANK_PROD_CODE id,
			B.REP_FINPROD_NAME text,
			A.REP_FINPROD_ID object
		FROM 
			REP_PROD_ISSUE A,
			REP_PROD_DECLARE B
		WHERE
			A.REP_FINPROD_ID = B.REP_FINPROD_ID AND B.REP_INVESTOR_TYPE NOT IN (#{SALETARGET_DECLARE_05}, #{SALETARGET_DECLARE_06})
		<if test="search != null and search != ''">
			AND (A.REP_BANK_PROD_CODE LIKE CONCAT('%',CONCAT(#{search,jdbcType=VARCHAR},'%'))
				OR B.REP_FINPROD_NAME LIKE CONCAT('%',CONCAT(#{search,jdbcType=VARCHAR},'%')))
		</if>
	</select>
	<!-- 
	/**
     * 页面查询
     */
    List<RepFinProductOrgIssRegistDto> select(Map<String, Object> pageParam);
	 -->
	 <select id="select" resultType="com.joyintech.service.report.debtreport.repfinproductorgissregist.dto.RepFinProductOrgIssRegistDto">
	 select 
	 	#{YES_OR_NO_N,jdbcType=VARCHAR} as isItStructured,																												
		'' as hierarchicalCategory,	
        <include refid="com.joyintech.service.report.debtreport.repfinproductorgissregist.dao.RepFinProductOrgIssRegistMapper.Base_Column_List" />
	 FROM REP_PROD_ISSUE A,REP_PROD_DECLARE B
	 <where>
	 	A.REP_FINPROD_ID = B.REP_FINPROD_ID																																		
		AND B.REP_INVESTOR_TYPE <![CDATA[!= ]]> #{SALETARGET_DECLARE_05,jdbcType=VARCHAR}	
		AND B.REP_INVESTOR_TYPE <![CDATA[!= ]]> #{SALETARGET_DECLARE_06,jdbcType=VARCHAR}																																
		<if test="repFinprodName != null and repFinprodName.size()>0">
			AND (B.REP_FINPROD_ID IN 
			<foreach collection="repFinprodName" item="item" index="index" separator="," open="(" close =")">
				<if test="(index % 998) == 0">
						null) OR B.REP_FINPROD_ID in (
					</if>
				#{item}
			</foreach>
			)
		</if>	
		<if test="repInvestorType != null and repInvestorType != ''">
			AND B.REP_INVESTOR_TYPE = #{repInvestorType}
		</if>	
		<if test="productStartingSDate != null and productStartingSDate != ''">
			AND A.REP_PRD_VDATE BETWEEN to_date(#{productStartingSDate},'yyyy-mm-dd')
			AND to_date(#{productStartingEDate},'yyyy-mm-dd')
		</if>		
		<if test="repStatusSDate != null and repStatusSDate != ''">
			AND B.REP_STATUS_DATE BETWEEN to_date(#{repStatusSDate},'yyyy-mm-dd')
			AND to_date(#{repStatusEDate},'yyyy-mm-dd')
		</if>
		<if test="repFinprodId != null and repFinprodId.size()>0">
			AND B.REP_FINPROD_ID IN 
			<foreach collection="repFinprodId" item="item" separator="," open="(" close =")">
				#{item}
			</foreach>
		</if>																													
	 </where>
	 </select>
