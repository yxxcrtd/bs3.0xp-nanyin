<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dao.RskValSumnameMapper">
	<!-- 
	/**
     * 查询映射名称
     */
    List<RskValSumnameDto> getSumName(Map<String, Object> map);
	 -->
	<select id="getSumName" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dto.RskValSumnameDto">
	SELECT
	 distinct
	 ID id,
	 NAME name,
	 TRIM_CHARS trimChars
	 FROM RSK_VALTBL_SUMSUB_MAP
	 order by NAME DESC
	</select>
	<!-- 
	/**
     * 页面查询
     */
    List<RskValSumnameDto> selectForPage(Map<String, Object> pageParam);
	 -->
	 <select id="selectForPage" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dto.RskValSumnameDto">
	 SELECT
	 	distinct
		 ID id,
	 	SUM_CODE sumCode,
	 	SUM_NAME sumName,
	 	NEXT_INDEX_TYPE nextIndexType
	  FROM RSK_VALTBL_SUMSUB_MAP_DTL
	  WHERE
    		ID = #{sumId,jdbcType=VARCHAR}
      order by SUM_CODE DESC
	 </select>
	 
	 <select id="selectForList" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dto.RskValSumnameDto">
	 SELECT
	 	distinct
		 ID id,
	 	SUM_CODE sumCode,
	 	SUM_NAME sumName,
	 	NEXT_INDEX_TYPE nextIndexType
	  FROM RSK_VALTBL_SUMSUB_MAP_DTL
	  WHERE
    		ID = #{sumId,jdbcType=VARCHAR}
      order by SUM_CODE DESC
	 </select>
	 
	 <!-- 
	 /**
     * 根据id删除汇总映射明细表
     */
    void deleteById(RskValSumnameDto dto);
	  -->
	 <delete id="deleteById" >
        delete from RSK_VALTBL_SUMSUB_MAP_DTL
        where ID = #{id,jdbcType=VARCHAR}
     </delete>
     <!-- 
     /**
     * 根据映射名称查询汇总映射表
     */
    List<RskValSumnameDto> selectBySumName(String name);
      -->
      <select id="selectBySumName" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dto.RskValSumnameDto">
      SELECT
	 	 ID id,
		 NAME structName
	 	FROM RSK_VALTBL_SUMSUB_MAP
	 	<where>
	 	NAME = #{name,jdbcType=VARCHAR}
	 	</where>
      </select>
      <!-- 
      /**
     * 根据id和映射明细名称查询数据
     */
    RskValSumnameDto selectByName(RskValSumnameDto dto);
       -->
       <select id="selectByName" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalsumname.dto.RskValSumnameDto">
       SELECT
	 	distinct
		 ID id,
	 	SUM_CODE sumCode,
	 	SUM_NAME sumName,
	 	NEXT_INDEX_TYPE nextIndexType
	  FROM RSK_VALTBL_SUMSUB_MAP_DTL
	  WHERE
    		ID = #{id,jdbcType=VARCHAR}
    		AND SUM_NAME = #{sumName,jdbcType=VARCHAR}
       </select>
       <!-- 
       /**
     * 选中记录在业务表中是否已关联组合关联组合
     */
    int getCountById(RskValSumnameDto dto);
        -->
        <select id="getCountById" resultType="java.lang.Integer">
        SELECT
	     COUNT(*)
	     FROM RSK_VALTBL_PRT_IMP_MAP
	     <where>
	     SUMSUB_MAP_ID = #{id,jdbcType=VARCHAR}
	     </where>
        </select>
</mapper>