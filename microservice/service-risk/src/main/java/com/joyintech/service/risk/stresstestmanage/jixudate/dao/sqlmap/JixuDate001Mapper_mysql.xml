<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.risk.stresstestmanage.jixudate.dao.JixuDate001Mapper_mysql">
	<select id="getJixuDate" resultType="java.util.Date">
		select 
			DATA_DATE 
		from 
			(select  DATA_DATE from STT_DATA_READY order by seq_no desc) 
		where LIMIT 1
	</select>
</mapper>
