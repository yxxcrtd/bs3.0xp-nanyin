<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.risk.stresstestmanage.jixudate.dao.JixuDate001Mapper">
	 
	<!-- 查询jixu日期 -->
	<select id="getJixuDate" resultType="java.util.Date">
		select 
			DATA_DATE 
		from 
			(select  DATA_DATE from STT_DATA_READY order by seq_no desc) 
		where rownum =1
	</select>
	
	<!-- 更新jixu日期 -->
	<update id="updateJixuDate" parameterType="java.util.Date">
		update STT_DATA_READY set DATA_DATE=#{newDate, jdbcType=DATE}
	</update>
	
	
	
</mapper>