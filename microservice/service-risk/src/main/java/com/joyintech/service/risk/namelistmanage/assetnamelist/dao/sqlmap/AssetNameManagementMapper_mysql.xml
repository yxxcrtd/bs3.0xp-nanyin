<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.risk.namelistmanage.assetnamelist.dao.AssetNameManagementMapper_mysql">
	<select id="queryForPage"  resultType="com.joyintech.service.risk.namelistmanage.assetnamelist.dto.RskAccessListDto" parameterType="Map">
        <choose>
            <when test="isEffFlag != null and isEffFlag.equals('01')">
                SELECT
                LIST_ID LIST_ID,
                LIST_NAME LIST_NAME,
                LIST_TYPE LIST_TYPE,
                LIST_LEVEL LIST_LEVEL,
                EFFDATE,
                DELDATE, 
                WORKFLOW_ID,
                WORKFLOW_STATUS
                FROM
                WFL_RSK_ACCESS_LIST
                <where>
                    <if test="rskSubjectType != null and rskSubjectType != ''">
                        LIST_DETAIL_TYPE  = #{rskSubjectType}
                    </if>
                    <if test="listIdList != null and listIdList.size() > 0">
                        AND LIST_ID IN
                        <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                            #{item}
                        </foreach>
                    </if>
                </where>
                UNION
            </when>
        </choose>
        SELECT
        LIST_ID LIST_ID,
        LIST_NAME LIST_NAME,
        LIST_TYPE LIST_TYPE,
        LIST_LEVEL LIST_LEVEL,
        EFFDATE,
        DELDATE,
        NULL WORKFLOW_ID,
        NULL WORKFLOW_STATUS
        FROM
        RSK_ACCESS_LIST
        WHERE
        LIST_ID not in
        (
            SELECT LIST_ID LIST_ID FROM WFL_RSK_ACCESS_LIST
            <where>
                <if test="rskSubjectType != null and rskSubjectType != ''">
                    LIST_DETAIL_TYPE  = #{rskSubjectType}
                </if>
                <if test="listIdList != null and listIdList.size() > 0">
                    AND LIST_ID IN
                    <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
            </where>
        )
        <if test="listName != null and listName != ''">
            AND LIST_NAME  LIKE concat_ws('','%', #{listName}, '%')
        </if>
        <choose>
            <when test="isEffFlag != null and isEffFlag.equals('01')">
                <![CDATA[AND  DELDATE > #{sysDate} ]]>
            </when>
            <otherwise>
                <![CDATA[AND  DELDATE <= #{sysDate} ]]>
            </otherwise>
        </choose>
        <if test="rskSubjectType != null and rskSubjectType != ''">
            AND LIST_DETAIL_TYPE  = #{rskSubjectType}
        </if>
        <if test="listIdList != null and listIdList.size() > 0">
            AND LIST_ID IN
            <foreach collection="listIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
	</select>
</mapper>
