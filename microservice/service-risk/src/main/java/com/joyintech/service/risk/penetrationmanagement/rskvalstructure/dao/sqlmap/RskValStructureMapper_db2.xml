<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dao.RskValStructureMapper_db2">
	
	 <!-- 
	 /**
     * 画面查询
     */
    List<RskValStructureDto> selectForPage(Map<String, Object> pageParam);
	  -->
	  <select id="selectForPage" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dto.RskValStructureDto">
	  SELECT
	 	distinct
		 ID id,
	 	SRC_COL_INDEX srcColIndex,
	 	SRC_COL_DATA_TYPE srcColDataType,
	 	TGT_INDEX tgtIndex,
	 	MEMO memo,
	 	CREATE_TIME
	  FROM RSK_VALTBL_STRUCT_MAP_DTL
	  WHERE
    		ID = #{structId,jdbcType=VARCHAR}
    ORDER BY CREATE_TIME DESC
	  </select>
	  
</mapper>