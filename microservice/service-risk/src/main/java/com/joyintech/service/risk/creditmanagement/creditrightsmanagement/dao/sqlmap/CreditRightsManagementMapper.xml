<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.risk.creditmanagement.creditrightsmanagement.dao.CreditRightsManagementMapper" >
    <resultMap id="BaseResultMap" type="com.joyintech.service.risk.creditmanagement.creditrightsmanagement.dto.CreditRightsManagementDto" >
        <id column="SEQNO" property="seqno" jdbcType="VARCHAR" />
        <result column="ASSET_TYPE_ONE" property="assetTypeOne" jdbcType="VARCHAR" />
        <result column="ASSET_TYPE_TWO" property="assetTypeTwo" jdbcType="VARCHAR" />
        <result column="RISK_WEIGHT" property="riskWeight" jdbcType="DECIMAL" />
        <result column="EFF_DATE" property="effDate" jdbcType="DATE" />
        <result column="REMARK" property="remark" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
    
    <select id="select" resultMap="BaseResultMap">
    	select 
    		SEQNO,
    		ASSET_TYPE_ONE,
    		ASSET_TYPE_TWO,
    		RISK_WEIGHT,
    		EFF_DATE,
    		REMARK
   		from RISK_WEIGHT
   		<where>
   			<if test="assetTypeOne != null and assetTypeOne != ''">
   			AND	ASSET_TYPE_ONE = #{assetTypeOne}
   			</if>
   			<if test="assetTypeTwo != null and assetTypeTwo != ''">
   			AND	ASSET_TYPE_TWO = #{assetTypeTwo}
   			</if>
   			<if test="startDate != null">
   			AND	EFF_DATE >= #{startDate,jdbcType=DATE}
   			</if>
   			<if test="endDate != null">
   			AND	EFF_DATE <![CDATA[<=]]> #{endDate,jdbcType=DATE}
   			</if>
   		</where>
    </select>
	
	<select id="selectDetail" resultMap="BaseResultMap">
		select
			SEQNO,
    		ASSET_TYPE_ONE,
    		ASSET_TYPE_TWO,
    		RISK_WEIGHT,
    		EFF_DATE,
    		REMARK
   		from RISK_WEIGHT
   		where SEQNO=#{seqno}
	</select>
	
	<select id="checkalreadyhave" resultMap="BaseResultMap">
		select 
			SEQNO,
    		ASSET_TYPE_ONE,
    		ASSET_TYPE_TWO,
    		RISK_WEIGHT,
    		EFF_DATE,
    		REMARK
   		from RISK_WEIGHT
   		<where>
	   		<if test="assetTypeOne != null and assetTypeOne != ''">
	   		AND	ASSET_TYPE_ONE = #{assetTypeOne,jdbcType=VARCHAR}
   			</if>
   			<if test="assetTypeTwo != null and assetTypeTwo != ''">
   			AND	ASSET_TYPE_TWO = #{assetTypeTwo,jdbcType=VARCHAR}
   			</if>
   			<if test="effDate != null">
   			AND	EFF_DATE = #{effDate,jdbcType=DATE}
   			</if>
   		</where>	
	</select>
	
</mapper>