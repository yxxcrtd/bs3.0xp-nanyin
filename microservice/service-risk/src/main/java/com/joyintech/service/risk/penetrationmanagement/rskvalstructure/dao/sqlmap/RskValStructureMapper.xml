<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dao.RskValStructureMapper">
	<!-- 
	/**
     * 查询估值表结构映射信息
     */
    List<RskValStructureDto> getStructName(Map<String, Object> map);
	 -->
	 <select id="getStructName" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dto.RskValStructureDto">
	 SELECT 
		 ID id,
		 NAME structName
	 FROM 
		RSK_VALTBL_STRUCT_MAP
	 order by CREATE_TIME DESC
	 </select>
	 <!-- 
	 /**
     * 画面查询
     */
    List<RskValStructureDto> selectForPage(Map<String, Object> pageParam);
	  -->
	  <select id="selectForPage" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dto.RskValStructureDto">
	  SELECT
	 	distinct
		 ID id,
	 	SRC_COL_INDEX srcColIndex,
	 	SRC_COL_DATA_TYPE srcColDataType,
	 	TGT_INDEX tgtIndex,
	 	MEMO memo
	  FROM RSK_VALTBL_STRUCT_MAP_DTL
	  WHERE
    		ID = #{structId,jdbcType=VARCHAR}
    ORDER BY CREATE_TIME DESC
	  </select>
	  
	  <select id="selectForList" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dto.RskValStructureDto">
	  SELECT
	 	distinct
		 ID id,
	 	SRC_COL_INDEX srcColIndex,
	 	SRC_COL_DATA_TYPE srcColDataType,
	 	TGT_INDEX tgtIndex,
	 	MEMO memo
	  FROM RSK_VALTBL_STRUCT_MAP_DTL
	  WHERE
    		ID = #{structId,jdbcType=VARCHAR}
	  </select>
	  
	  <!-- 
	  /**
     * 根据映射名称查询数据
     */
    List<RskValStructureDto> selectByName(String structName);
	   -->
	   <select id="selectByName" resultType="com.joyintech.service.risk.penetrationmanagement.rskvalstructure.dto.RskValStructureDto">
	   SELECT
	 	 ID id,
		 NAME structName
	 	FROM RSK_VALTBL_STRUCT_MAP
	 	<where>
	 	NAME = #{structName,jdbcType=VARCHAR}
	 	</where>
	   </select>
	   <!-- 
	   /**
     * 根据映射id删除映射明细表
     */
    void deleteById(RskValStructureDto dto);
	    -->
	    <delete id="deleteById">
	    delete from RSK_VALTBL_STRUCT_MAP_DTL
        where ID = #{id,jdbcType=VARCHAR}
	    </delete>
	    <!-- 
	    /**
     * 选中记录在业务表中是否已关联组合关联组合
     */
    int getCountById(RskValStructureDto dto);
	     -->
	     <select id="getCountById" resultType="java.lang.Integer">
	     SELECT
	     COUNT(*)
	     FROM RSK_VALTBL_PRT_IMP_MAP
	     <where>
	     STRUCT_MAP_ID = #{id,jdbcType=VARCHAR}
	     </where>
	     </select>
</mapper>