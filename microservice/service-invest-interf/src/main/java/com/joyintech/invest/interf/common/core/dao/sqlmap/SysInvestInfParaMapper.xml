<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.invest.interf.common.core.dao.SysInvestInfParaMapper">

    <resultMap type="com.joyintech.invest.interf.common.core.entity.SysPara" id="resultMap">
        <id column="SYSTEM_CODE" property="systemCode" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <id column="PARA_CODE" property="paraCode" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="PARAM_VALUE" property="paramValue" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" javaType="java.lang.String"/>
    </resultMap>

    <select id="selectInfAll" resultMap="resultMap">
		SELECT
		 SYSTEM_CODE,
		 PARA_CODE,
		 PARAM_VALUE,
		 CREATE_DEPT
		FROM SYS_PARA
	</select>
    <select id="selectParaOne" resultMap="resultMap" parameterType="com.joyintech.invest.interf.common.core.entity.SysParaKey">
		SELECT
		 SYSTEM_CODE,
		 PARA_CODE,
		 PARAM_VALUE,
		 CREATE_DEPT
		FROM SYS_PARA
		WHERE SYSTEM_CODE = #{systemCode}
		AND PARA_CODE = #{paraCode}
	</select>

    <select id="getSysDate" resultType="java.util.Date">
		select CUR_DATE from SYS_DATE
	</select>

	<select id="getNextValBySequenceName" resultType="java.lang.String" useCache="false" flushCache="true">
		select ${sequenceName}.nextval from dual
	</select>
</mapper>