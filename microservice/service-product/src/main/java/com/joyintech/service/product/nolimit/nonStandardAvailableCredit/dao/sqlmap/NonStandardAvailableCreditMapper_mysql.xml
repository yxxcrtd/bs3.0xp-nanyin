<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.product.nolimit.nonStandardAvailableCredit.dao.NonStandardAvailableCreditMapper_mysql">
	<select id="selectForPage" resultType="com.joyintech.service.product.nolimit.nonStandardAvailableCredit.dto.NonStandardAvailableCreditDto"  >
        select 
              VDATE vdate,EDATE edate,TARGET_SCALE targetScale,BENCH_DATE benchDate
         from ASSET_PLAN_INFO
       <where>     
       
			<if test="curveDate != null and curveDate != ''">	
				  VDATE <![CDATA[ <= ]]> STR_TO_DATE(#{curveDate,jdbcType=VARCHAR}, '%Y-%m-%d')
			</if>
			 
			<if test="curveDate != null and curveDate != ''">	
				and EDATE <![CDATA[ >= ]]> STR_TO_DATE(#{curveDate,jdbcType=VARCHAR}, '%Y-%m-%d')
			</if>
		 
		</where> 	 
    </select>
</mapper>
