<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.product.common.dao.FinProductGoalInfoMapper">
    
    <select id="queryFinProdGoalInfo" resultType="com.joyintech.tams.common.base.entity.PtlGoal" parameterType="java.lang.String">
    	select ASSET_CLASSIFY assetClassify,
    		INVEST_MAX * 100 investMax,
    		INVEST_MIN * 100  investMin
    	from PTL_GOAL
    	where FINPROD_ID = #{finprodId}
    </select>
    
    <update id="deleteFinProdGoalInfo" parameterType="java.lang.String">
    	delete from PTL_GOAL where FINPROD_ID = #{finprodId}
    </update>
</mapper>
