<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.service.product.rddesgin.proddevelopmanage.dao.ProdDevelopManageMapper_db2">
	<!-- 分页查询 -->
	<select id="selectForPage"
		resultType="com.joyintech.service.product.rddesgin.proddevelopmanage.dto.ProdDevelopManageDto">
		SELECT A.SEQ_NO seqNo,
				TO_CHAR(A.GENERATE_TIME,'YYYY-MM-DD HH24:MI:SS') generateTimeStr,
			  A.PRD_DESIGN_ID prdDesignId,
			  B.PRD_DESIGN_SERIAL_NAME prdDesignName,
			  A.FEASIBILITY_RESULT feasibilityResult,
			  substr(A.PRD_DESIGN_RESULT,1,4000) prdDesignResult,
			  substr(A.PRD_LOAD_RESULT,1,4000) prdLoadResult,
			  substr(A.PRD_MOCK_RESULT,1,4000) prdMockResult,
			  A.PRD_RISK_LEVEL prdRiskLevel,
			  A.SCHEME_RESULR schemeResulr,
			  TO_CHAR(A.UPDATE_TIME,'YYYY-MM-DD HH24:MI:SS') updateTimeStr
			FROM PRD_RESEARCH_SCHEME A
			LEFT JOIN PRODUCT_DESIGN_INFO B
			ON A.PRD_DESIGN_ID = B.PRD_DESIGN_ID
			<where>
				<if test='startQueryDate != null and startQueryDate != ""'>
					TO_CHAR(A.GENERATE_TIME,'YYYY-MM-DD') BETWEEN #{startQueryDate} AND #{endQueryDate}
				</if>
				<if test="prdDesignIdList != null and prdDesignIdList.size()>0">
				    AND A.PRD_DESIGN_ID in 
				    <foreach collection="prdDesignIdList" separator="," open="(" close=")" index="index" item="item">
				          #{item}
	                </foreach>
	            </if>
			</where>
	</select>
	
	<!-- 根据系列编号获取结果信息 -->
	<resultMap type="com.joyintech.service.product.rddesgin.proddevelopmanage.dto.ProdDevelopManageDto" id="resultMap">
		<id column="B_PRD_DESIGN_ID" property="prdDesignId"/>
		<result column="B_PRD_DESIGN_SERIAL_NAME" property="prdDesignName"/>
		<result column="AJUST_RISK_LEVEL" property="prdRiskLevel"/>
		<result column="FEASIBILITY_STATUS" property="feasibilityResult"/>
		<!-- 产品要素设计信息 -->
		<association property="productBaseInfo" javaType="com.joyintech.tams.common.base.entity.ProductBaseInfo">
			<result column="B_PRD_DESIGN_ID" property="prdDesignId" jdbcType="VARCHAR" />
	        <result column="B_REQUIREMENT_ID" property="requirementId" jdbcType="VARCHAR" />
	        <result column="B_PRD_DESIGN_SERIAL_NAME" property="prdDesignSerialName" jdbcType="VARCHAR" />
	        <result column="B_PRD_BASE_GOAL" property="prdBaseGoal" jdbcType="VARCHAR" />
	        <result column="B_PRD_CHARATER" property="prdCharater" jdbcType="VARCHAR" />
	        <result column="B_RAISE_TYPE" property="raiseType" jdbcType="VARCHAR" />
	        <result column="B_INVEST_NATURE" property="investNature" jdbcType="VARCHAR" />
	        <result column="B_OPERATE_MODE" property="operateMode" jdbcType="VARCHAR" />
	        <result column="B_TAR_CUSTOMER_TYPE" property="tarCustomerType" jdbcType="VARCHAR" />
	        <result column="B_TAR_INVESTOR" property="tarInvestor" jdbcType="VARCHAR" />
	        <result column="B_RSK_LEVEL" property="rskLevel" jdbcType="VARCHAR" />
	        <result column="B_OPEN_DESCRIBE" property="openDescribe" jdbcType="VARCHAR" />
	        <result column="B_PRD_TERM" property="prdTerm" jdbcType="VARCHAR" />
	        <result column="B_PLAN_ISSUE_DATE" property="planIssueDate" jdbcType="VARCHAR" />
	        <result column="B_PLAN_ISSUE_SCALE" property="planIssueScale" jdbcType="VARCHAR" />
	        <result column="B_SALE_AREA" property="saleArea" jdbcType="VARCHAR" />
	        <result column="B_BASE_RULE_INFO" property="baseRuleInfo" jdbcType="VARCHAR" />
	        <result column="B_FEE_RATE" property="feeRate" jdbcType="VARCHAR" />
	        <result column="B_TOFF_START" property="toffStart" jdbcType="VARCHAR" />
	        <result column="B_HUGE_RED_RATIO" property="hugeRedRatio" jdbcType="VARCHAR" />
	        <result column="B_INV_ASSET_RATE" property="invAssetRate" jdbcType="VARCHAR" />
	        <result column="B_INTEN_INV_STRATEGY" property="intenInvStrategy" jdbcType="VARCHAR" />
	        <result column="B_OTHER" property="other" jdbcType="VARCHAR" />
	        <result column="B_DATA_STATUS" property="dataStatus" jdbcType="VARCHAR" />
	        <result column="B_CREATE_USER" property="createUser" jdbcType="VARCHAR" />
	        <result column="B_CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
	        <result column="B_CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
	        <result column="B_UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
	        <result column="B_UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		</association>
		<!-- 模拟试算结果 -->
		<association property="mockResultInfo" javaType="com.joyintech.tams.common.base.entity.MockResultInfo">
			<result column="C_SEQ_NO" property="seqNo" jdbcType="VARCHAR" />
	        <result column="C_GENERATE_TIME" property="generateTime" jdbcType="TIMESTAMP" />
	        <result column="C_MOCK_DATE" property="mockDate" jdbcType="DATE" />
	        <result column="C_PRD_DESIGN_ID" property="prdDesignId" jdbcType="VARCHAR" />
	        <result column="C_PRD_SCALE" property="prdScale" jdbcType="DECIMAL" />
	        <result column="C_PRD_PERIOD" property="prdPeriod" jdbcType="VARCHAR" />
	        <result column="C_RATE_MAX" property="rateMax" jdbcType="VARCHAR" />
	        <result column="C_RATE_MIX" property="rateMix" jdbcType="VARCHAR" />
	        <result column="C_REQUIREMENT_ID" property="requirementId" jdbcType="VARCHAR" />
	        <result column="C_BATCH_ID" property="batchId" jdbcType="CHAR" />
	        <result column="C_DATA_STATUS" property="dataStatus" jdbcType="VARCHAR" />
	        <result column="C_CREATE_USER" property="createUser" jdbcType="VARCHAR" />
	        <result column="C_CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
	        <result column="C_CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
	        <result column="C_UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
	        <result column="C_UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
		</association>
	</resultMap>
</mapper>