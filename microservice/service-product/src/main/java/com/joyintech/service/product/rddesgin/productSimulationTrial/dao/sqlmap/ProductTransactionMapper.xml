<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.product.rddesgin.productSimulationTrial.dao.ProductTransactionMapper">

	<insert id="insertproductTransaction">
		insert into MOCK_TRADE_DEAL
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="assetType != null">
				ASSET_TYPE,
			</if>
			<if test="assetRiskLevel != null">
				ASSET_RISK_LEVEL,
			</if>
			<if test="mockAmt != null">
				MOCK_AMT,
			</if>
			<if test="mockShareAmt != null">
				MOCK_SHARE_AMT,
			</if>
			<if test="assetType != null">
				ASSET_TYPE,
			</if>
			<if test="assetType != null">
				ASSET_TYPE,
			</if>
			<if test="assetType != null">
				ASSET_TYPE,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="registSeqno != null">
				#{registSeqno,jdbcType=CHAR},
			</if>

		</trim>
	</insert>


</mapper>