	<select id="selectForPage" resultMap="BaseResultMap"  >
        select 
        <include refid="com.joyintech.service.product.productelement.reportregister.dao.ProductReportRegisterMapper.Base_Column_List" />
        from REP_PROD_DECLARE
        where 1=1
        <if test="repFinprodName != null and repFinprodName.size() > 0">
			and REP_FINPROD_NAME in 
			<foreach collection="repFinprodName" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="repFinprodInsId != null and repFinprodInsId.size() > 0">
			and REP_FINPROD_INS_ID in 
			<foreach collection="repFinprodInsId" item="item" open="(" close=")" separator=",">
				#{item}
			</foreach>
		</if>
		<if test="repRaisePstrdateStart != null and repRaisePstrdateStart != ''">
			and REP_RAISE_PSTRDATE &gt;= STR_TO_DATE(#{repRaisePstrdateStart}, '%Y-%m-%d')
		</if>
		<if test="repRaisePstrdateEnd != null and repRaisePstrdateEnd != ''">
			and REP_RAISE_PSTRDATE &lt;= STR_TO_DATE(#{repRaisePstrdateEnd}, '%Y-%m-%d')
		</if>
		<if test="repTerm != null and !repTerm.equals('')">
			AND REP_TERM = #{repTerm}
		</if>
		<if test="repOperateMode != null and !repOperateMode.equals('')">
			AND REP_OPERATE_MODE = #{repOperateMode}
		</if>
    </select>
