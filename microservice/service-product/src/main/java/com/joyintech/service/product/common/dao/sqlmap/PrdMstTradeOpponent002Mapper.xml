&lt;!&ndash; 查询账号信息  &ndash;&gt;
<select id="selectStlCapacctInfo" resultType="com.joyintech.service.product.common.dto.StlCapacctDto">
	SELECT 
		STL.ACCT_NO acctNo,
		ACC.CCY ccy,
		ACC.ACCT_TYPE accountType,
		STL.ACCT_NAME acctName,
		STL.BANK_DEP bankDep,
		STL.LARGE_PAYNO largePayno,
		ACC.IS_OPEN isOpen
		,STL.BUSI_ACCT_NO busiAcctNo
	FROM
		MST_COUNTER_ACCT ACC
	INNER JOIN 
		STL_CAPACCT_INFO STL
	ON
		ACC.ACCT_NO = STL.ACCT_NO
	AND 
		ACC.CCY = STL.CCY
	WHERE 
		ACC.COUNTER_ID = #{counterId,jdbcType=VARCHAR}
		
</select>
&lt;!&ndash; 查询交易对手的证券账号信息  &ndash;&gt;
<select id="selectSecurityAcctByCounterId" resultType="com.joyintech.tams.common.base.entity.MstCounterSecurityAcct">
	SELECT 
		ACC.SECURITY_ACCT_NO securityAcctNo,		
		ACC.SECURITY_ACCT_NAME securityAcctName,
		ACC.REGIST_ORG registOrg,
		ACC.IS_OPEN isOpen
	FROM
		MST_COUNTER_SECURITY_ACCT ACC	
	WHERE 
		ACC.COUNTER_ID = #{counterId,jdbcType=VARCHAR}
		
</select>
&lt;!&ndash; 查询费用信息 &ndash;&gt;
<select id = "selectFinCashInfo" resultType="com.joyintech.service.product.common.dto.FinCashDto">
	SELECT 
		CASH.FEE_ID feeId,
		FEE.FEE_TYPE feeType,
		RATE.RATE * 100 rate,
		RULE.BASE_TYPE basicBill,
		RULE.BASIS basis
	FROM 
		FIN_CASH_INFO CASH
	INNER JOIN
		FIN_RATE_INFO  RATE
	ON
		CASH.CASH_ID = RATE.CASH_ID
	INNER JOIN 
		FIN_CASH_CALC_RULE RULE
	ON
		RULE.CASH_ID = CASH.CASH_ID
	INNER JOIN 
		MST_FEEINFO FEE
	ON 
		CASH.FEE_ID = FEE.FEE_ID
	WHERE
		CASH.FINPROD_ID = #{finprodId,jdbcType=VARCHAR}
</select>
