<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.product.common.dao.ProductCommonMapper_db2">
    <select id="getFeeIdByFeeType" resultType="java.lang.String" parameterType="java.lang.String" >
        <!-- select fee_id from mst_feeinfo where fee_type=#{feeId,jdbcType=VARCHAR} and rownum =1 -->
        select t.fee_id from(  select fee_id,row_number() over() as rownid  from mst_feeinfo where fee_type=#{feeId,jdbcType=VARCHAR}) as t where t.rownid =1
    </select>
</mapper>
