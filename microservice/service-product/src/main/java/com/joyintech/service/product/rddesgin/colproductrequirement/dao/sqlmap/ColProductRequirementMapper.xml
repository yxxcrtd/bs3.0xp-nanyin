<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.product.rddesgin.colproductrequirement.dao.ColProductRequirementMapper">
	
	<resultMap id="base" type="com.joyintech.service.product.rddesgin.colproductrequirement.dto.ColProductRequirement001Dto">
        <id column="REQUIREMENT_ID" property="requirementId" jdbcType="VARCHAR"/>
        <result column="REQUIREMENT_BASIS" property="requirementBasis" jdbcType="VARCHAR"/>
        <result column="REQUIREMENT_DATE" property="requirementTime" jdbcType="DATE" />
        <result column="TAR_CUSTOMER" property="tarCustomer" jdbcType="VARCHAR"/>
        <result column="PRD_SCALE" property="prdScale" jdbcType="VARCHAR"/>
        <result column="PRD_PERIOD" property="prdPeriod" jdbcType="VARCHAR"/>
        <result column="PRD_RATE" property="prdRate" jdbcType="VARCHAR"/>
        <result column="PRD_REQUIREMENT_DETIAL" property="prdRequirementDetail" jdbcType="VARCHAR"/>
        <result column="REQUIREMENT_SOURCE" property="requirementSource" jdbcType="VARCHAR"/>
        <result column="DATA_STATUS" property="dataStatus" jdbcType="VARCHAR"/>
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR"/>
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR"/>
        <result column="CREATE_TIME" property="createTime" jdbcType="DATE"/>
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR"/>
        <result column="UPDATE_TIME" property="updateTime" jdbcType="DATE"/>
       <!--  <association property="colProductRequirementAdd" javaType="com.joyintech.service.product.rddesgin.colproductrequirement.dto.ColProductRequirementAddDto">
            <result column="REPORT_STATUS" property="reportStatus" jdbcType="VARCHAR"/>
        </association> -->
        <result column="REPORT_STATUS" property="reportStatus" jdbcType="VARCHAR"/>
        <result column="REVIEW_YESNO" property="reviewYesno" jdbcType="VARCHAR"/>
        <result column="REQUIREMENT_USER" property="requirementUser" jdbcType="VARCHAR"/>
    </resultMap>
    
	 <select id="selectForPage" resultType="com.joyintech.service.product.rddesgin.colproductrequirement.dto.ColProductRequirement001Dto">
	 																											
		<!-- 产品需求表.数据状态 as 有效状态	 -->																								
		<!-- 产品需求附属表.上报状态 as 是否上报	 -->																								
		SELECT 
			pr.DATA_STATUS dataStatus,
			pr.REVIEW_YESNO reviewYesno,
			pr.REQUIREMENT_USER requirementUser,
			pra.REPORT_STATUS reportStatus,
			pr.REQUIREMENT_ID requirementId,
			pr.REQUIREMENT_BASIS requirementBasis,
			pr.REQUIREMENT_DATE requirementTime,
			pr.TAR_CUSTOMER tarCustomer,
			pr.PRD_SCALE prdScale,
			pr.PRD_PERIOD prdPeriod,
			pr.PRD_RATE prdRate,
			pr.PRD_REQUIREMENT_DETIAL prdRequirementDetail,
			pr.REQUIREMENT_SOURCE requirementSource
		FROM 
			PRODUCT_REQUIREMENT pr
		LEFT JOIN 
			PRODUCT_REQUIREMENT_ADD pra
		ON
			pr.REQUIREMENT_ID = pra.REQUIREMENT_ID
		WHERE
			1 = 1
		<if test="dataStatus != null and !dataStatus.equals('')">
			AND pr.DATA_STATUS = #{dataStatus}
		</if> 
		<if test="requirementSource != null and !requirementSource.equals('')">
			AND pr.REQUIREMENT_SOURCE = #{requirementSource}
		</if>
		<if test="requirementTimeStart != null and requirementTimeStart != ''">
			and pr.REQUIREMENT_DATE &gt;= to_date(#{requirementTimeStart}, 'yyyy-MM-dd')
		</if>
		<if test="requirementTimeEnd != null and requirementTimeEnd != ''">
			and pr.REQUIREMENT_DATE &lt;= to_date(#{requirementTimeEnd}, 'yyyy-MM-dd')
		</if>
		<if test="tarCustomer != null and !tarCustomer.equals('')">
			AND pr.TAR_CUSTOMER like concat(concat('%',#{tarCustomer}),'%') 
		</if>
		<if test="reportStatus != null and !reportStatus.equals('')">
			AND pra.REPORT_STATUS = #{reportStatus}
		</if>
			 
	</select>
	
	<select id ="queryRequirementByRequireId" resultMap="base" parameterType="java.lang.String">
		SELECT 
			pr.DATA_STATUS,
			pra.REPORT_STATUS,
			pr.REQUIREMENT_USER,
			pr.REQUIREMENT_ID,
			pr.REQUIREMENT_BASIS,
			pr.REQUIREMENT_DATE,
			pr.TAR_CUSTOMER,
			pr.PRD_SCALE,
			pr.PRD_PERIOD,
			pr.PRD_RATE,
			pr.PRD_REQUIREMENT_DETIAL,
			pr.REQUIREMENT_SOURCE
		FROM 
			PRODUCT_REQUIREMENT pr
		LEFT JOIN 
			PRODUCT_REQUIREMENT_ADD pra
		ON
			pr.REQUIREMENT_ID = pra.REQUIREMENT_ID
		WHERE
			pr.REQUIREMENT_ID = #{requirementId,jdbcType=VARCHAR}
	</select>
	
	<insert id="insertColProductRequirement">
		INSERT INTO PRODUCT_REQUIREMENT(REQUIREMENT_ID,DATA_STATUS,REQUIREMENT_BASIS,REQUIREMENT_DATE,TAR_CUSTOMER,PRD_SCALE,PRD_PERIOD,PRD_RATE,PRD_REQUIREMENT_DETIAL,REQUIREMENT_SOURCE,CREATE_USER,CREATE_TIME,UPDATE_USER,UPDATE_TIME,REQUIREMENT_USER,REVIEW_YESNO) 
		VALUES (#{requirementId},#{dataStatus},#{requirementBasis},#{requirementTime},#{tarCustomer},#{prdScale},#{prdPeriod},#{prdRate},#{prdRequirementDetail},#{requirementSource},#{createUser},#{createTime},#{updateUser},#{updateTime},#{requirementUser},#{reviewYesno})
	</insert>
	
	<delete id="deleteColProductRequirement" parameterType="java.lang.String">
		DELETE FROM 
			PRODUCT_REQUIREMENT
		WHERE
			REQUIREMENT_ID = #{requirementId}
	</delete>
	
	<update id="updateColProductRequirement">
		UPDATE
			PRODUCT_REQUIREMENT
		<set>
			<if test="requirementSource != null and !requirementSource.equals('')">
				REQUIREMENT_SOURCE = #{requirementSource},
			</if>
			<if test="requirementBasis != null and !requirementBasis.equals('')">
				REQUIREMENT_BASIS = #{requirementBasis},
			</if>
			<if test="tarCustomer != null and !tarCustomer.equals('')">
				TAR_CUSTOMER = #{tarCustomer},
			</if>
			<if test="prdRequirementDetail != null and !prdRequirementDetail.equals('')">
				PRD_REQUIREMENT_DETIAL = #{prdRequirementDetail},
			</if>
			<if test="prdScale != null and !prdScale.equals('')">
				PRD_SCALE = #{prdScale},
			</if>
			<if test="prdPeriod != null and !prdPeriod.equals('')">
				PRD_PERIOD = #{prdPeriod},
			</if>
			<if test="prdRate != null and !prdRate.equals('')">
				PRD_RATE = #{prdRate},
			</if>
			<if test="updateUser != null and !updateUser.equals('')">
				UPDATE_USER = #{updateUser},
			</if>
			<if test="updateTime != null and !updateTime.equals('')">
				UPDATE_TIME = #{updateTime},
			</if>
		</set>
		WHERE
			REQUIREMENT_ID = #{requirementId}
	</update>
	
	<update id="deleteByRequirementId">
		UPDATE
			PRODUCT_REQUIREMENT
		SET 
			DATA_STATUS = #{dataStatus}
		WHERE 
			REQUIREMENT_ID = #{requirementId}
	</update>
	
	<update id="reviewStart">
		UPDATE
			PRODUCT_REQUIREMENT
		SET 
			REVIEW_YESNO = #{reviewYesno}
		WHERE 
			REQUIREMENT_ID = #{requirementId}
	</update>
</mapper>