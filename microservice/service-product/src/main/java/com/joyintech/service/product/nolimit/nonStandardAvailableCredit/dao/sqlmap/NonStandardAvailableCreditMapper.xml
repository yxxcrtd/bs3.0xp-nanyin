<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.product.nolimit.nonStandardAvailableCredit.dao.NonStandardAvailableCreditMapper" >
    <resultMap id="BaseResultMap" type="com.joyintech.service.product.nolimit.nonStandardAvailableCredit.dto.NonStandardAvailableCreditDto" >
        <id column="ASSET_PLAN_CODE" property="assetPlanCode" jdbcType="VARCHAR" />
        <result column="BENCH_DATE" property="benchDate" jdbcType="DATE" />
        <result column="VDATE" property="vdate" jdbcType="DATE" />
        <result column="EDATE" property="edate" jdbcType="DATE" />
        <result column="TARGET_SCALE" property="targetScale" jdbcType="DECIMAL" />
        <result column="REMARK" property="remark" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
    <sql id="Base_Column_List" >
        ASSET_PLAN_CODE ASSET_PLAN_CODE, BENCH_DATE BENCH_DATE, VDATE VDATE, EDATE EDATE, 
        TARGET_SCALE TARGET_SCALE, REMARK REMARK, CREATE_USER CREATE_USER, CREATE_DEPT CREATE_DEPT, 
        CREATE_TIME CREATE_TIME, UPDATE_USER UPDATE_USER, UPDATE_TIME UPDATE_TIME
    </sql>
   
     
    <select id="selectForPage" resultType="com.joyintech.service.product.nolimit.nonStandardAvailableCredit.dto.NonStandardAvailableCreditDto"  >
        select 
              VDATE vdate,EDATE edate,TARGET_SCALE targetScale,BENCH_DATE benchDate
         from ASSET_PLAN_INFO
       <where>     
       
			<if test="curveDate != null and curveDate != ''">	
				  VDATE <![CDATA[ <= ]]> to_date(#{curveDate,jdbcType=VARCHAR}, 'yyyy-mm-dd')
			</if>
			 
			<if test="curveDate != null and curveDate != ''">	
				and EDATE <![CDATA[ >= ]]> to_date(#{curveDate,jdbcType=VARCHAR}, 'yyyy-mm-dd')
			</if>
		 <!--	 <if test="benchDate != null and benchDate != ''">	
				AND BENCH_DATE = to_date(#{benchDate,jdbcType=VARCHAR}, 'yyyy-mm-dd')
			</if>   -->
		</where> 	 
    </select>
     
  
     
</mapper>