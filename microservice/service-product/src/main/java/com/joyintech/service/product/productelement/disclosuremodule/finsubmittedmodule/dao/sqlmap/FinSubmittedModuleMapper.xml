<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dao.FinSubmittedModuleMapper">
    <select id="getSchemeName" resultType="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dto.FinSubmittedModuleDto">
		SELECT 
		       SCHEME_ID schemeId,
		       SCHEME_NAME schemeName 
		FROM 
		        PRD_DECLARE_SCHEME 
		<where> 
		       <if test="schemeName != null and schemeName != ''">
		        SCHEME_NAME like concat(concat('%', #{schemeName,jdbcType=VARCHAR}),'%')
		        OR SCHEME_ID like concat(concat('%', #{schemeName,jdbcType=VARCHAR}),'%')
		       </if>
		</where>
		order by SCHEME_ID DESC
    </select>

    <select id="select" resultType="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dto.FinSubmittedModuleDetailDto">
    	SELECT
    		SEQNO seqno,
    		DOC_TYPE docType,
    		TPL_TYPE tplType,
    		REMARK remark
    	FROM
    		PRD_DECLARE_SCHEME_DOC
    	WHERE
    		SCHEME_ID = #{schemeId,jdbcType=VARCHAR}
    </select>

    <select id="selectScheme" resultType="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dto.FinSubmittedModuleDto">
		SELECT 
		       SCHEME_ID schemeId,
		       SCHEME_NAME schemeName
		FROM 
		       PRD_DECLARE_SCHEME 
		WHERE 
			   SCHEME_ID = #{schemeId,jdbcType=VARCHAR}
    </select>

    <delete id="delete">
        delete from PRD_DECLARE_SCHEME_DOC
        where SCHEME_ID = #{schemeId,jdbcType=VARCHAR}
    </delete>

    <select id="deleteCheck" resultType="java.lang.String">
		SELECT 
		       FINPROD_ID
		FROM 
		        PA_PRD_ISSUE_SCHEDULE
		<where> 
		       <if test="schemeId != null and schemeId != ''">
                   SCHEME_ID = #{schemeId,jdbcType=VARCHAR}
		       </if>
		</where>
    </select>

    <insert id="insertSelective" parameterType="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dto.FinSubmittedModuleDto" >
        insert into PRD_DECLARE_SCHEME_DOC
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="seqno != null" >
                SEQNO,
            </if>
            <if test="schemeId != null" >
                SCHEME_ID,
            </if>
            <if test="docType != null" >
                DOC_TYPE,
            </if>
            <if test="tplType != null" >
                TPL_TYPE,
            </if>
            <if test="remark != null" >
                REMARK,
            </if>
            <if test="createUser != null" >
                CREATE_USER,
            </if>
            <if test="createDept != null" >
                CREATE_DEPT,
            </if>
            <if test="createTime != null" >
                CREATE_TIME,
            </if>
            <if test="updateUser != null" >
                UPDATE_USER,
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="seqno != null" >
                #{seqno,jdbcType=VARCHAR},
            </if>
            <if test="schemeId != null" >
                #{schemeId,jdbcType=VARCHAR},
            </if>
            <if test="docType != null" >
                #{docType,jdbcType=VARCHAR},
            </if>
            <if test="tplType != null" >
                #{tplType,jdbcType=VARCHAR},
            </if>
            <if test="remark != null" >
                #{remark,jdbcType=VARCHAR},
            </if>
            <if test="createUser != null" >
                #{createUser,jdbcType=VARCHAR},
            </if>
            <if test="createDept != null" >
                #{createDept,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateUser != null" >
                #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>

    <select id="selectDocTplType" resultType="com.joyintech.service.product.productelement.disclosuremodule.finsubmittedmodule.dto.FinSubmittedModuleDto">
		SELECT
    		DOC_TYPE,
    		TPL_TYPE,
    		REMARK
		FROM
     		PRD_DECLARE_SCHEME_DOC
     	WHERE
     	    SEQNO=#{seqno,jdbcType=VARCHAR}
    </select>

    <update id="update">
    	UPDATE
    		PRD_DECLARE_SCHEME
        <set>
            <if test="schemeName != null" >
                SCHEME_NAME = #{schemeName,jdbcType=VARCHAR},
            </if>
            <if test="remark != null" >
                REMARK = #{remark,jdbcType=VARCHAR},
            </if>
            <if test="updateUser != null" >
                UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </set>
        WHERE
        	SCHEME_ID = #{schemeId,jdbcType=VARCHAR}
    </update>

    <select id="selectSchemeName" resultType="java.lang.String">
		SELECT
    		SCHEME_ID
		FROM
     		PRD_DECLARE_SCHEME
     	WHERE
     	    SCHEME_NAME like concat(concat('%', #{schemeName,jdbcType=VARCHAR}),'%')
     	AND SCHEME_ID!=#{schemeId}
    </select>

</mapper>