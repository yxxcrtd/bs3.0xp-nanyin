	   <!-- 
	   /**
     * 删除时判断选中的记录是否已经被使用
     * <功能详细描述>
     * @param revealFileId 披露文档代码
     * @return  String
     * @see
     * @since 1.0
     */
    String isUsed(String revealFileId)
	    -->
	   <select id="isUsed" resultType="java.lang.String">
	   	SELECT
	   		REVEAL_FILE_ID
	   	FROM
	   		PRD_FILE
	   	WHERE
	   		REVEAL_FILE_ID=#{revealFileId}
	   </select> 
