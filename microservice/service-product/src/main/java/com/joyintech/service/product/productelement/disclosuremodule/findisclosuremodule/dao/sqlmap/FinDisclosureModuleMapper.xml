	   <!-- 
	   /**
     * 通过披露文档代码查询数据
     * <功能详细描述>
     * @param map 披露文档代码
     * @return dto
     * @see
     * @since 1.0
     */
    FinDisclosureModuleDto getDataByRevealFileId(Map<String, Object> map);
	    -->
	   <select id="getDataByRevealFileId" resultType="com.joyintech.service.product.productelement.disclosuremodule.findisclosuremodule.dto.FinDisclosureModuleDto">
	   SELECT
	  	REVEAL_FILE_ID AS revealFileId,
	  	FILE_TYPE AS fileType,
	  	REMARK AS remark
	  FROM 
	  	PRD_FILE_TEMPLAT
	  WHERE
	  	REVEAL_FILE_ID = #{revealFileId,jdbcType=VARCHAR}
	   </select>
	   <!-- 
