<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.product.productelement.disclosuremodule.findisclosuremodule.dao.FinDisclosureModuleMapper">
	
	
	 <!-- 
	 /**
     * @param param param
     * @return list集合
     */
    List<String> getRevealFileIdList(Map<String, Object> param);
	  -->
	  <select id="getRevealFileIdList" resultType="java.lang.String">
		SELECT
			REVEAL_FILE_ID
		FROM
			PRD_FILE_TEMPLAT
		<where>
			<if test="fileType !=null and fileType !=''">
				FILE_TYPE = #{fileType,jdbcType=VARCHAR}
			</if>
		</where>
	  </select>
	  
	  <!-- 
	  /**
     * 在base库中查询文件名
     * 
     * @param param 查询条件
     * @return 文本框
     * @see
     * @since 1.0
     */
    List<SuggestDto> getFileNameByBase(Map<String, Object> param)
	   -->
	  <select id="getFileNameByBase" resultType="com.joyintech.framework.select.SuggestDto">
	  SELECT
	  	BUSINESS_ID AS code,
	  	FILE_NAME AS shortName
	  FROM
	  	SYS_UPLOAD_FILE_INFO
	  <where>
	  	<if test="revealFileIdList != null and revealFileIdList.size()>0">
  		BUSINESS_ID IN (
  		<foreach item="item" collection="revealFileIdList" separator=",">
    		#{item}
  		</foreach>
  		)
  		</if>
	  	<if test="fileName !=null and fileName !=''">
	  	AND FILE_NAME LIKE CONCAT('%',CONCAT(#{fileName,jdbcType=VARCHAR},'%'))
	  	</if>
	  	</where>
	  </select>
	  
	  <!-- 
	  /**
     * 根据文档类型查询信息披露表中的信息
     * <功能详细描述>
     * @param pageParam 页面.文档类型
     * @return list集合
     * @see
     * @since 1.0
     */
    List<FinDisclosureModuleDto> getFileList(Map<String, Object> pageParam);
	   -->
	   <select id="getFileList" resultType="com.joyintech.service.product.productelement.disclosuremodule.findisclosuremodule.dto.FinDisclosureModuleDto">
	   SELECT
	  	REVEAL_FILE_ID AS revealFileId,
	  	FILE_TYPE AS fileType,
	  	REMARK AS remark
	  FROM 
	  	PRD_FILE_TEMPLAT
	  <where>
	  	<if test="fileType !=null and fileType !=''">
	  	 FILE_TYPE = #{fileType,jdbcType=VARCHAR}
	  	</if>
	  	<if test="fileId !=null and fileId !=''">
	  	 and REVEAL_FILE_ID = #{fileId,jdbcType=VARCHAR}
	  	</if>
	  	</where>
	  	ORDER BY REVEAL_FILE_ID ASC
	   </select>
