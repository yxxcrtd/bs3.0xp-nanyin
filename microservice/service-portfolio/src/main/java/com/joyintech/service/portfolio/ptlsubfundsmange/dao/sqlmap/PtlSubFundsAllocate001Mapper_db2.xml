<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace = "com.joyintech.service.portfolio.ptlsubfundsmange.dao.PtlSubFundsAllocate001Mapper_db2">
	<resultMap type="com.joyintech.service.portfolio.ptlsubfundsmange.dto.PtlSubFundsAllocateDto" id="BaseResultMap">
		<id column="FINPROD_ID" property="portfolioId" jdbcType="VARCHAR" />
		<result column="FINPROD_ABBR" property="portfolioName" jdbcType="VARCHAR" />
		<result column="FINPROD_MARKET_ID" property="finprodMarketId" jdbcType="VARCHAR" />
		<result column="FINPROD_ABBR" property="subPortfolioId" jdbcType="VARCHAR" />
		<result column="FINPROD_MARKET_ID" property="subPortfolioName" jdbcType="VARCHAR" />
		<result column="YIELD" property="disPercent" jdbcType="DECIMAL" />
        <result column="EFF_DATE" property="settleDate" jdbcType="DATE" />
		<result column="FEE_NAME" property="ccy" jdbcType="VARCHAR" />
		<result column="YIELD" property="tradeAmt" jdbcType="DECIMAL" />
		<result column="FEE_TYPE" property="deployrRemark" jdbcType="VARCHAR" />
	</resultMap>
	
	<select id="getBusinessWorkflowId" parameterType="java.util.Map" resultType="java.lang.Integer">
		select count(pm.WORKFLOW_ID)
    	from SYS_DATA_PROCESS_MARK pm
    	<where>
    		pm.status in ('A','U','P')
    		<if test="pageId != null and pageId != ''">
    			and pm.PAGE_ID = #{pageId}
    		</if>
    		<if test="businessDataPk1 != null">
            	and pm.BUSINESS_DATA_PK1 = #{businessDataPk1}
			</if>
			<if test="businessDataPk2 != null">
				and pm.BUSINESS_DATA_PK2 = #{businessDataPk2}
			</if>
			<if test="businessDataPk3 != null">
				and pm.BUSINESS_DATA_PK3 = #{businessDataPk3}
			</if>
    	</where>
    	<!-- order by pm.create_time desc -->
	</select>
</mapper>