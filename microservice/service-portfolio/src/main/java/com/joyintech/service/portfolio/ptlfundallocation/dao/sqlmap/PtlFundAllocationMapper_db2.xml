    <sql id="Base_Column_List" >
        S.ORDER_ID ORDER_ID, S.ORDER_TYPE ORDER_TYPE, T.PS PAY_TYPE, S.SETTLE_DATE SETTLE_DATE, 
        S.MY_ACCT_NO MY_ACCT_NO, S.PS PS, S.COUNTER_ACCT_NO COUNTER_ACCT_NO, S.SETTLE_AMT SETTLE_AMT, 
        S.CCY CCY, S.SETTLE_STATUS SETTLE_STATUS, S.PURPOSE PURPOSE, S.IS_NEED_SEND IS_NEED_SEND, 
        S.IS_TOTAL_TRADE IS_TOTAL_TRADE, S.TRADE_ID TRADE_ID, T.TRADE_STATUS ORDER_STATUS, S.P_TRADE_ID P_TRADE_ID, 
        S.CREATE_USER CREATE_USER, S.CREATE_DEPT CREATE_DEPT, S.CREATE_TIME CREATE_TIME, S.UPDATE_USER UPDATE_USER, 
        S.UPDATE_TIME UPDATE_TIME,
		coalesce(P.PARENT_PORTFOLIO_ID, S.PORTFOLIO_ID) ACT_PORTFOLIO_ID,
		S.PORTFOLIO_ID PORTFOLIO_ID,
		S.PROD_ID PROD_ID, S.REMARK REMARK,
        S.SEND_DATE SEND_DATE, S.SEND_STATUS SEND_STATUS, S.ORDER_REC_STATUS ORDER_REC_STATUS, 
        S.ORDER_RET_STATUS ORDER_RET_STATUS,P.PORTFOLIO_NAME PORTFOLIO_NAME
    </sql>
	<select id="getPayOrderId" resultType="java.lang.String">
	select t.ORDER_ID from(
		SELECT ORDER_ID,row_number() over() as rownum
		FROM 
			STL_PAY_ORDERS
		<where>
			<if test="tradeId != null and !tradeId.isEmpty()">
				AND TRADE_ID = #{tradeId}
			</if>
				<!-- AND ROWNUM = 1 -->
		</where>
	) t where t.rownum = 1
	</select>
</mapper>