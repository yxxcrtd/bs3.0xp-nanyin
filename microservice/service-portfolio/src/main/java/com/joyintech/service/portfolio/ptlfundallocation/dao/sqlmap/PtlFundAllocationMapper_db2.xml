        <result column="IS_NEED_SEND" property="isNeedSend" jdbcType="VARCHAR" />
        <result column="IS_TOTAL_TRADE" property="isTotalTrade" jdbcType="VARCHAR" />
        <result column="TRADE_ID" property="tradeId" jdbcType="VARCHAR" />
