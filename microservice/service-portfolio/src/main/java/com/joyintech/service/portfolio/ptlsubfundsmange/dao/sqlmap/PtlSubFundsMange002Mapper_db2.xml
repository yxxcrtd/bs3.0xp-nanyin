<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper
	namespace="com.joyintech.service.portfolio.ptlsubfundsmange.dao.PtlSubFundsMange002Mapper_db2">
	<update id="updatePtlCashPositionFlowBySeqnos">
		UPDATE PTL_CASH_POSITION_FLOW
		SET SPLIT_TYPE = #{SPLIT_TYPE,jdbcType=VARCHAR},
		UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
		UPDATE_TIME = current date
		WHERE 1=1
		<if test="SEQNO != null and SEQNO.size > 0">
			AND SEQNO IN(
				<foreach collection="SEQNO" item="item" separator=",">
		            #{item}
		        </foreach>
			)
	    </if>
	</update>
</mapper>