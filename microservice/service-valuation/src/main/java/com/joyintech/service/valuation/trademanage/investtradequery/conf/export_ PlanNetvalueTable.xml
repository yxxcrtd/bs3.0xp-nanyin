<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/PlanNetvalueTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="资产代码">assetId</Cell>
			<Cell order="5" name="资产名称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="申购日">purchaseDate</Cell>
			<Cell order="8" name="申购/赎回确认日">tradeDate</Cell>
			<Cell order="9" name="到账日">payDate</Cell>
			<Cell order="10" name="净值日">cpriceDate</Cell>
			<Cell order="11" name="单位净值">unitCprice</Cell>
			<Cell order="12" name="交易份额">shareAmt</Cell>
			<Cell order="13" name="交易金额">tradeAmt</Cell>
			<Cell order="14" name="分红日">branchDate</Cell>
			<Cell order="15" name="红利再投日">bonusReinvestDate</Cell>
			<Cell order="16" name="单位分红">unitInt</Cell>
			<Cell order="17" name="现金分红金额">cashBranchAmt</Cell>
			<Cell order="18" name="红利再投份额">bonusReinvestQty</Cell>
			<Cell order="19" name="红利再投金额">bonusReinvestAmt</Cell>
			<Cell order="20" name="再投单位净值">reinvestUnitCprice</Cell>
			<Cell order="21" name="入账日">enterDate</Cell>
			<Cell order="22" name="币种">ccy</Cell>
		</Row>
	</Worksheet>
</Workbook>