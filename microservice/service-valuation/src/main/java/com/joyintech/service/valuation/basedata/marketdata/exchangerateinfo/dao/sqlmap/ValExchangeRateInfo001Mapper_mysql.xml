<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.basedata.marketdata.exchangerateinfo.dao.ValExchangeRateInfo001Mapper_mysql">
	<select id="tableLoad"
	parameterType="map"
		resultType="com.joyintech.service.valuation.basedata.marketdata.exchangerateinfo.dto.ValExchangeRateInfo001Dto">
		SELECT			


			TRADE_DATE AS tradeDate







		FROM
			MST_EXCHARGE_QUOTE		
		WHERE
			1=1






		<if test="startDate != null and startDate != ''"> 
			AND TRADE_DATE &gt; = STR_TO_DATE(#{startDate},'%Y-%m-%d')
		</if>
		<if test="endDate != null and endDate != ''">
			AND TRADE_DATE &lt; = STR_TO_DATE(#{endDate},'%Y-%m-%d')
		</if>
	</select>
</mapper>
