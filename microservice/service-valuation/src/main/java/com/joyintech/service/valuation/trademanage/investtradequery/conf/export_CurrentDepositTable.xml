<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/CurrentDepositTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="资金账户名">acctName</Cell>
			<Cell order="5" name="上次收息日">vDate</Cell>
			<Cell order="6" name="本次收息日">mDate</Cell>
			<Cell order="7" name="理论利息">theoryIntAmt</Cell>
			<Cell order="8" name="实际利息">realIntAmt</Cell>
			<Cell order="9" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>