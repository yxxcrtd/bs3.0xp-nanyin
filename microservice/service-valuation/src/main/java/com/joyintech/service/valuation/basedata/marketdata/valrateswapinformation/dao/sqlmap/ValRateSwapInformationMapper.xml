<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.valuation.basedata.marketdata.valrateswapinformation.dao.ValRateSwapInformationMapper">
    <select id="selectByParams" resultType="com.joyintech.tams.common.base.entity.MstYieldCurveInfo">
        SELECT
        T1.CURVE_DATE,
        T1.CURVE_CODE,
        T1.KEY_POINT,
        T1.YIELD * 100 YIELD,
        T1.CURVE_TYPE,
        T1.INPUT_TYPE
        FROM MST_YIELD_CURVE_INFO T1
        <where>
            AND T1.CURVE_CODE = #{curveCode,jdbcType=VARCHAR}
            AND T1.CURVE_DATE = #{curveDate,jdbcType=DATE}
        </where>
        order by KEY_POINT
    </select>
    <delete id="deleteSelective" parameterType="com.joyintech.service.valuation.basedata.marketdata.valrateswapinformation.dto.ValRateSwapInformationDto">
        delete FROM MST_IRS_QUOTATION
        <where>
            AND CURVE_CODE = #{curveCode,jdbcType=VARCHAR}
            AND CURVE_DATE = #{curveDate,jdbcType=DATE}
            AND DATA_TIME = #{dataTime,jdbcType=VARCHAR}
        </where>
    </delete>
    <update id="updateSelective" parameterType="com.joyintech.service.valuation.basedata.marketdata.valrateswapinformation.dto.ValRateSwapInformationDto" >
        update MST_IRS_QUOTATION
        <set >
            <if test="bidPrice != null" >
                BID_PRICE = #{bidPrice,jdbcType=DECIMAL},
            </if>
            <if test="offerPrice != null" >
                OFFER_PRICE = #{offerPrice,jdbcType=DECIMAL},
            </if>
            <if test="avgPrice != null" >
                AVG_PRICE = #{avgPrice,jdbcType=DECIMAL},
            </if>
            <if test="updateUser != null" >
                UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </set>
        <where>
            AND CURVE_CODE = #{curveCode,jdbcType=VARCHAR}
            AND CURVE_DATE = #{curveDate,jdbcType=DATE}
            AND TERM_TYPE_IRS = #{termTypeIrs,jdbcType=VARCHAR}
            AND DATA_TIME = #{dataTime,jdbcType=VARCHAR}
        </where>
    </update>
    <insert id="insertSelective" parameterType="com.joyintech.service.valuation.basedata.marketdata.valrateswapinformation.dto.ValRateSwapInformationDto" >
        insert into MST_IRS_QUOTATION
        <trim prefix="(" suffix=")" suffixOverrides="," >
            <if test="curveCode != null" >
                CURVE_CODE,
            </if>
            <if test="curveDate != null" >
                CURVE_DATE,
            </if>
            <if test="dataTime != null" >
                DATA_TIME,
            </if>
            <if test="curveType != null" >
                CURVE_TYPE,
            </if>
            <if test="termTypeIrs != null" >
                TERM_TYPE_IRS,
            </if>
            <if test="curveIntType != null" >
                CURVE_INT_TYPE,
            </if>
            <if test="bidPrice != null" >
                BID_PRICE,
            </if>
            <if test="offerPrice != null" >
                OFFER_PRICE,
            </if>
            <if test="avgPrice != null" >
                AVG_PRICE,
            </if>
            <if test="n != null" >
                N,
            </if>
            <if test="k != null" >
                K,
            </if>
            <if test="inputType != null" >
                INPUT_TYPE,
            </if>
            <if test="remark != null" >
                REMARK,
            </if>
            <if test="createUser != null" >
                CREATE_USER,
            </if>
            <if test="createDept != null" >
                CREATE_DEPT,
            </if>
            <if test="createTime != null" >
                CREATE_TIME,
            </if>
            <if test="updateUser != null" >
                UPDATE_USER,
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >
            <if test="curveCode != null" >
                #{curveCode,jdbcType=VARCHAR},
            </if>
            <if test="curveDate != null" >
                #{curveDate,jdbcType=DATE},
            </if>
            <if test="dataTime != null" >
                #{dataTime,jdbcType=VARCHAR},
            </if>
            <if test="curveType != null" >
                #{curveType,jdbcType=VARCHAR},
            </if>
            <if test="termTypeIrs != null" >
                #{termTypeIrs,jdbcType=VARCHAR},
            </if>
            <if test="curveIntType != null" >
                #{curveIntType,jdbcType=VARCHAR},
            </if>
            <if test="bidPrice != null" >
                #{bidPrice,jdbcType=DECIMAL},
            </if>
            <if test="offerPrice != null" >
                #{offerPrice,jdbcType=DECIMAL},
            </if>
            <if test="avgPrice != null" >
                #{avgPrice,jdbcType=DECIMAL},
            </if>
            <if test="n != null" >
                #{n,jdbcType=DECIMAL},
            </if>
            <if test="k != null" >
                #{k,jdbcType=DECIMAL},
            </if>
            <if test="inputType != null" >
                #{inputType,jdbcType=DECIMAL},
            </if>
            <if test="remark != null" >
                #{remark,jdbcType=VARCHAR},
            </if>
            <if test="createUser != null" >
                #{createUser,jdbcType=VARCHAR},
            </if>
            <if test="createDept != null" >
                #{createDept,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateUser != null" >
                #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>
    
    <resultMap id="curveTypeMap" type="com.joyintech.framework.select.SelectOptionDto">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="text" property="text" jdbcType="VARCHAR"/>
        <association property="object" javaType="java.util.Map">
            <result column="CURVE_TYPE" property="curveType" jdbcType="VARCHAR" />
            <result column="CURVE_INT_TYPE" property="curveIntType" jdbcType="VARCHAR" />
            <result column="BASE_INT_CODE" property="baseIntCode" jdbcType="VARCHAR" />
            <result column="PRICE_TYPE" property="priceType" jdbcType="VARCHAR" />
        </association>
    </resultMap>
    <select id="getCurveType" resultMap="curveTypeMap">
		SELECT DISTINCT
			CURVE_CODE id,
			CURVE_TYPE ||'-'|| CURVE_INT_TYPE||'-'|| BASE_INT_CODE||'-'|| PRICE_TYPE text,
			CURVE_TYPE,
			CURVE_INT_TYPE,
			BASE_INT_CODE,
			PRICE_TYPE
		FROM
			MST_CURVE_DEF
		<where>
			CURVE_TYPE = #{CURVE_TYPE_02}
		</where>
	</select>
</mapper>