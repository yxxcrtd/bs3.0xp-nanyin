<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/FundNetvalueTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="产品代码">prodId</Cell>
			<Cell order="3" name="产品名称">prodAbbr</Cell>
			<Cell order="4" name="资产代码">assetId</Cell>
			<Cell order="5" name="资产名称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="交易日">tradeDate</Cell>
			<Cell order="8" name="确认日">confirmDate</Cell>
			<Cell order="9" name="交易份额">shareAmt</Cell>
			<Cell order="10" name="交易费用">feeAmt</Cell>
			<Cell order="11" name="交易金额">tradeAmt</Cell>
			<Cell order="12" name="入账日">bookDate</Cell>
			<Cell order="13" name="币种">ccy</Cell>
			<Cell order="14" name="利息金额">intAmt</Cell>
			<Cell order="15" name="净值日">cpriceDate</Cell>
			<Cell order="16" name="赎回净值">unitCprice</Cell>
			<Cell order="17" name="预计到账日">settleDate</Cell>
			<Cell order="18" name="实际到账日">realDate</Cell>
			<Cell order="19" name="现金分红金额">cashAmt</Cell>
			<Cell order="20" name="红利再投金额">bonusAmt</Cell>
			<Cell order="21" name="红利再投份额">bonusShare</Cell>
		</Row>
	</Worksheet>
</Workbook>