<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.service.valuation.financemanage.balancecheck.unfairlendingquery.dao.ValUnfairlendingQuery001Mapper">
   
    <select id="findBooksets" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT
            BOOKSET_ID AS id,
            BOOKSET_NAME AS text,
            BOOKSET_TYPE as col
        FROM BOK_BOOKSET
    </select>

	
	<select id="queryPageList" parameterType="com.joyintech.service.valuation.financemanage.balancecheck.unfairlendingquery.dto.ValUnfairlendingQuery001Dto"
	resultType="com.joyintech.service.valuation.financemanage.balancecheck.unfairlendingquery.dto.ValUnfairlendingQuery001Dto">
		                                                                                            
        with B as
(
               <!--查询凭证借贷不平的凭证编号，借贷方向*凭证发生额 -->  
               <!-- modify by wujie on 20190902 remark:本位币发生额进行比较 -->
              select * from BOK_VOUCH_DETAIL where VOUCH_NUM in (
  						SELECT VOUCH_NUM FROM(                                                                              
                    SELECT b2.VOUCH_NUM ,
                    SUM(DECODE(b2.cd_flag,'D',1,-1)*B2.B_HAPPEN_AMT)
                  FROM BOK_VOUCH_DETAIL B2
                  GROUP BY B2.VOUCH_NUM
                  HAVING SUM(DECODE(b2.cd_flag,'D',1,-1)*B2.B_HAPPEN_AMT)!=0 )))
SELECT                                                                                     
                  to_char(A.BOOK_DATE,'yyyy-mm-dd') bookDate,                               <!-- 记账日期   -->                                                       
                  A.BOOKSET_ID booksetId,                               <!--  账套代码 -->                                                         
                  bb.BOOKSET_NAME booksetName,                              <!--  账套名称   -->                                                       
                  A.VOUCH_NUM vouchNum,                               <!-- 凭证编号   -->                                                       
                  A.COM_TABLE_ID tableId,                                                     <!-- 业务类别   -->                                                       
                  NVL(B.DETAIL_SUBJECT_NO,B.SUBJECT_NO) subjectNo,                            <!-- 科目号  -->                                      
                  NVL(bbd.DETAIL_SUBJECT_NAME,bs.SUBJECT_NAME) subjectName,          <!-- 科目名称 -->                                       
                  B.CD_FLAG cdFlag,                              <!-- 借贷      -->                                                    
                  B.ccy ccy,                          <!-- 币种      -->                                                    
                  B.HAPPEN_AMT happenAmt,                              <!-- 金额-->
                  B.B_CCY bCcy,                          <!-- 币种-->
                  B.B_HAPPEN_AMT bHappenAmt,                              <!-- 金额-->
                  B.HAPPEN_NUMBER happenNumber,                               <!-- 数量-->
                  B.BUSI_ID busiId,                               <!-- 资产/负债代码  -->                                                        
                  NVL(fp.FINPROD_ABBR, stl.acct_name) busiName,                                         <!-- 资产/负债名称 -->                                               
                  B.TRADE_ID tradeId,                                <!--业务编号    -->                                                      
                  fpd.P_TRADE_ID pTradeId,                               <!-- 原始业务编号          -->                                                
                  B.Book_Type bookType,                                 <!--凭证类型        -->                                                  
                  A.OFFSET_FLAG offsetFlag,                                <!--冲销标识    -->                                                      
                  A.VOUCH_REMARK vouchRemark                            <!--  摘要    -->                                                      
              FROM   B                                                                                          
              JOIN bok_VOUCH_MAIN A                                                                                           
                  ON A.VOUCH_NUM = B.VOUCH_NUM                                                                                          
              LEFT JOIN BOK_BOOKSET bb                                                                                           
                  ON BB.BOOKSET_ID = A.BOOKSET_ID                                                                                          
              LEFT JOIN BOK_SUBJECT bs                                                                                            
                  ON bs.BOOKSET_ID = bb.BOOKSET_ID_TMPL                                                                                          
                  AND bs.SUBJECT_NO = B.SUBJECT_NO                                                                                           
              LEFT JOIN BOK_BUSS_DETSUB bbd                                                                                          
                 ON bbd.BOOKSET_ID = A.BOOKSET_ID                                                                                          
                 AND bbd.DETAIL_SUBJECT_NO = B.DETAIL_SUBJECT_NO                                                                                          
              LEFT JOIN trd_PRODUCT_DEAL fpd                                                                                          
                  ON fpd.TRADE_ID = B.TRADE_ID                                                                                          
              lEFT JOIN FIN_PRODUCT fp                                                                                          
                  ON fp.FINPROD_ID = B.BUSI_ID                                                                                          
              left join STL_CAPACCT_INFO stl                                                                                          
                 on stl.acct_no = B.BUSI_ID                                                                                          
              WHERE 1=1                                                                                        
              <!-- 账套 -->                                                                                                  
                  <if test="booksetIdArr != null and booksetIdArr.length > 0">                                                                                          
                       AND A.BOOKSET_ID IN                                                                                          
                      <foreach collection="booksetIdArr" item="booksetId" open="( " close=" )" separator=",">                                                                                          
                          #{booksetId}                                                                                          
                      </foreach>                                                                                          
                  </if>                                                                                          
                                                                                                            
                   <!-- 资产/负债代码 -->                                                                                          
                  <if test="busiId !=null and busiId !='' ">                                                                                          
                      AND (                                                                                          
                          B.BUSI_ID LIKE '%' || #{busiId} || '%'                                                                                          
                      )                                                                                          
                  </if>                                                                                          
                   <!-- 记账日期 -->                                                                                          
                  <if test="bookDateBegin !=null ">                                                                                          
                      AND A.BOOK_DATE &gt;= #{bookDateBegin}                                                                                          
                  </if>                                                                                          
                  <if test="bookDateEnd !=null ">                                                                                          
                      AND A.BOOK_DATE &lt;= #{bookDateEnd}                                                                                          
                  </if>        
              	  AND b.SUBJECT_NO not like '7%'
              ORDER BY                                                                                           
                  A.BOOK_DATE DESC,                                                                                          
                  A.BUS_VOUCHNUM DESC                                                                                          

	</select>
</mapper>