<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/LendTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="5" name="拆借方向">finprodType</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="交易对手">counterName</Cell>
			<Cell order="8" name="拆借金额">prinAmt</Cell>
			<Cell order="9" name="期限品种">termTypeLend</Cell>
			<Cell order="10" name="币种">ccy</Cell>
			<Cell order="11" name="交易日">tradeDate</Cell>
			<Cell order="12" name="交割日">settleDate</Cell>
			<Cell order="13" name="起息日">vDate</Cell>
			<Cell order="14" name="到期日">mDate</Cell>
			<Cell order="15" name="拆借利率(%)">intRate</Cell>
			<Cell order="16" name="应计利息">intAmt</Cell>
			<Cell order="17" name="到期本息和">tradeAmt</Cell>
			<Cell order="18" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>