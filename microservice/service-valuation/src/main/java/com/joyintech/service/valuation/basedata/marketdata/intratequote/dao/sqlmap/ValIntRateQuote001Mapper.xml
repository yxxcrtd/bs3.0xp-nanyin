<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.service.valuation.basedata.marketdata.intratequote.dao.ValIntRateQuote001Mapper">
	
	<select id="tableLoad" 
	resultType="com.joyintech.service.valuation.basedata.marketdata.intratequote.dto.ResultDto">
		SELECT 
		    A.INT_RATE_ID AS intRateId, /**利率代码**/
<!-- 		     一体化问题8：表删除（行情信息（MST_RATE_INFO）） 修改：利率名称从数据字典取 -->
		    <!-- B.RATE_NAME AS rateName, /**利率名称**/-->
		    '' as rateName,
<!-- 		    B.RATE_TYPE AS rateType, /**利率类型**/  -->
		    to_char(A.RELAESE_DATE,'yyyy-MM-dd') AS relaeseDate, /**发布日**/
		    to_char(A.EFF_DATE,'yyyy-MM-dd') AS effDate, /**生效日**/
	        A.INT_RATE*100 AS intRate, /**利率值(%)**/
<!-- 		    C.QUO_CCY quoCcy /**币种**/ -->
            '' AS quoCcy
<!-- 		    C.QUO_SRC quoSrc /**数据来源**/ -->
        FROM MST_INT_RATE_INFO A
        <!-- LEFT JOIN MST_RATE_INFO B
        ON A.INT_RATE_ID=B.RATE_ID
        LEFT JOIN MST_EXCHARGE_QUOTE C
        ON B.RATE_ID=C.BASE_CCY
        LEFT JOIN MST_EXCHARGE_QUOTE C ON A.INT_RATE_ID=C.BASE_CCY  -->
        WHERE 1=1
		<if test="intRateId !=null and intRateId !=''">
		AND A.INT_RATE_ID  LIKE '%'||#{intRateId}||'%'
		</if>
		<!-- <if test="rateName!=null and rateName!=''">
		AND B.RATE_NAME  LIKE '%'||#{rateName}||'%'
		</if> -->
<!-- 		<if test="rateType!=null and rateType!=''"> -->
<!-- 		AND B.RATE_TYPE  LIKE '%'||#{rateType}||'%' -->
<!-- 		</if> -->
		<if test="relaeseStartDate != null and relaeseStartDate !=''">
		AND A.RELAESE_DATE <![CDATA[>=]]> to_date(#{relaeseStartDate},'yyyy-MM-dd')
		</if>
		<if test="relaeseEndDate != null and relaeseEndDate !=''">
		AND A.RELAESE_DATE  <![CDATA[<=]]> to_date(#{relaeseEndDate},'yyyy-MM-dd')
		</if>
		<if test="effStartDate != null and effStartDate !=''">
		AND A.EFF_DATE <![CDATA[>=]]> to_date(#{effStartDate},'yyyy-MM-dd')
		</if>
		<if test="effEndDate != null and effEndDate !=''">
		AND A.EFF_DATE <![CDATA[<=]]> to_date(#{effEndDate},'yyyy-MM-dd')
		</if>
		</select>
  
</mapper>