<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.service.valuation.basedata.marketdata.valinterestratequotationinfo.dao.ValInterestRateQuotationInfoMapper" >
    <resultMap id="BaseResultMap" type="com.joyintech.tams.common.base.entity.MstIntRateInfo" >
        <id column="INT_RATE_ID" property="intRateId" jdbcType="VARCHAR" />
        <id column="EFF_DATE" property="effDate" jdbcType="DATE" />
        <result column="RELAESE_DATE" property="relaeseDate" jdbcType="DATE" />
        <result column="INT_RATE" property="intRate" jdbcType="DECIMAL" />
        <result column="CCY" property="ccy" jdbcType="VARCHAR" />
        <result column="INPUT_TYPE" property="inputType" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>
    <sql id="Base_Column_List" >
        INT_RATE_ID intRateId, EFF_DATE effDate, RELAESE_DATE relaeseDate, INT_RATE*100 AS intRate, 
        CCY
    </sql>
    <select id="select" resultType="com.joyintech.service.valuation.basedata.marketdata.valinterestratequotationinfo.dto.ValInterestRateQuotationInfoDto">
		SELECT 
			<include refid="Base_Column_List"></include>
		FROM MST_INT_RATE_INFO
		<where>
			INT_RATE_TYPE = #{BENCHMARK_TYPE_04,jdbcType=VARCHAR}
			<if test="releaseDate != null and releaseDate != ''">
				AND RELAESE_DATE = TO_DATE(#{releaseDate},'YYYY-MM-DD')
			</if>
			<if test="intRateId != null and intRateId != ''">
				AND INT_RATE_ID =  #{intRateId,jdbcType=VARCHAR}
			</if>
			<if test="intRateIdList != null and intRateIdList.size() > 0">
				AND (INT_RATE_ID in
				<foreach collection="intRateIdList" item="item" index="index" open="(" close=")" separator=",">
					<if test="(index % 998) == 0">
						null) OR INT_RATE_ID in (
					</if>
					#{item}
				</foreach>)
			</if>
		</where>
	</select>
	<select id="selectByPrimaryKey" resultType="com.joyintech.service.valuation.basedata.marketdata.valinterestratequotationinfo.dto.ValInterestRateQuotationInfoDto">
		select 
			<include refid="Base_Column_List"></include>
		from MST_INT_RATE_INFO where INT_RATE_ID =#{intRateId,jdbcType=VARCHAR} and EFF_DATE = #{effDate,jdbcType=DATE} and CCY = #{ccy}
	</select>
</mapper>