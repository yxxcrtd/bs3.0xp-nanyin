<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.service.valuation.finncproductbuild.dao.FinNCProductBuild002Mapper">
	
	<select id="getpFinprodId"
		resultType="com.joyintech.framework.select.SelectOptionDto">
		select prd.finprod_id id,
				nvl(prd.finprod_abbr,prd.finprod_name) text
		from fin_product prd
		where prd.P_FINPROD_ID IS NULL
		<if test="finprodType != null and finprodType != '' ">
			AND prd.FINPROD_TYPE = #{finprodType}
		</if>
		<if test="search !=null and search != ''">
        	AND	(prd.finprod_id like concat('%',concat(#{search},'%'))
        		OR prd.finprod_abbr like concat('%',concat(#{search},'%'))
        		OR prd.finprod_name like concat('%',concat(#{search},'%')))
		</if>
		order by prd.finprod_id
	</select>
	
	<select id="getCustomerId"
		resultType="com.joyintech.framework.select.SelectOptionDto">
		select mci.CUSTOMER_ID id,
				mci.CUSTOMER_NAME text
		from MST_CUSTOMER_INFO mci
		where 1=1
		<if test="search !=null and search != ''">
        	AND	(prd.finprod_id like concat('%',concat(#{search},'%'))
        		OR prd.finprod_abbr like concat('%',concat(#{search},'%'))
        		OR prd.finprod_name like concat('%',concat(#{search},'%')))
		</if>
	</select>
	
	<select id="findByFinprodId"
		resultType="com.joyintech.service.valuation.finncproductbuild.dto.FinNCProductBuild001Dto">
		select fpt.finprod_id as finprodId
		    from fin_product fpt
		where fpt.finprod_id = #{finprodId}
	</select>
	
