<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.accounadjustmanage.valsztinterfcommon.dao.ValSztInterfCommonMapper">

	<!-- 页面产品下拉框公共查询方法 -->
	<select id="getFinprodId" resultType="com.joyintech.framework.select.SelectOptionDto">
		select basi.acct_subject_id id,
				basi.acct_subject_name text
		from bok_acct_subject_info basi
		where 1=1 
		<if test="finprodType != null and finprodType != '' ">
			AND basi.acct_subject_type = #{finprodType}
		</if>
	</select>
    
</mapper>