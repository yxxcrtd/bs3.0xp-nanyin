<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.accounadjustmanage.manualvoucher.dao.ValManualVoucher003Mapper_mysql">

<select id="querySubjectNo" resultType="com.joyintech.framework.select.SelectOptionDto">
        SELECT
        DISTINCT
        SUBJECT_NO id,
        SUBJECT_NAME text
        FROM BOK_SUBJECT
        WHERE SUBJECT_LEVEL = #{level3}
        <if test="search != null and search != ''">
            AND (
            SUBJECT_NO like concat_ws('','%',#{search},'%')
            OR
            SUBJECT_NAME like concat_ws('','%',#{search},'%')
            )<!-- modify by dongjun on 20181220  -->
        </if>
    </select>
</mapper>
