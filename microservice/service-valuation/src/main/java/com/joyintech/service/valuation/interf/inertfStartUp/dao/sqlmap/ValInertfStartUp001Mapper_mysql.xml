<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.interf.inertfStartUp.dao.ValInertfStartUp001Mapper_mysql">
	<select id="selectInertfTask"  parameterType="java.lang.String"
	resultType="com.joyintech.tams.common.base.entity.ValInterfTask">
	SELECT BEAN_NAME,TASK_NAME,ORDERNO
	FROM VAL_INTERF_TASK
	WHERE 1=1
	<if test="_parameter!=null and _parameter!=''">
	AND (
		BEAN_NAME like concat_ws('','%',#{name},'%')
		OR
		TASK_NAME like concat_ws('','%',#{name},'%')	)
	</if>
	ORDER BY ORDERNO
	
	
	
	</select>
</mapper>
