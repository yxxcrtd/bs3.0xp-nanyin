<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.trademanage.trdplannetvaluationtrade.dao.TrdPlanNetValuationTradeMapper">

	<resultMap id="finprodIdMap" type="com.joyintech.framework.select.SelectOptionDto">
		<id column="id" property="id" jdbcType="VARCHAR"/>
		<result column="text" property="text" jdbcType="VARCHAR"/>
		<association property="object" javaType="java.util.Map">
			<result column="id" property="finprodId" jdbcType="VARCHAR" />
		</association>
	</resultMap>
	<select id="findFinprodId" resultMap="finprodIdMap">
		select
		FINPROD_MARKET_ID id,
		FINPROD_ABBR text
		from
		FIN_PRODUCT
		<where>
			1=1
			<if test="assetType !=null and assetType != ''">
				and FINPROD_TYPE = #{assetType}
			</if>
			<if test="search !=null and search != ''">
				AND	(FINPROD_MARKET_ID like concat('%',concat(#{search},'%'))
				OR FINPROD_ABBR like concat('%',concat(#{search},'%')))
			</if>
		</where>
	</select>


	<resultMap id="portfolioIdMap" type="com.joyintech.framework.select.SelectOptionDto">
		<id column="id" property="id" jdbcType="VARCHAR"/>
		<result column="text" property="text" jdbcType="VARCHAR"/>
		<association property="object" javaType="java.util.Map">
			<result column="id" property="finprodId" jdbcType="VARCHAR" />
		</association>
	</resultMap>
	<select id="findPortfolioId" resultMap="portfolioIdMap">
		select
		p.FINPROD_ID id,
		p.FINPROD_ABBR text
		from
		FIN_PRODUCT p
		<where>
			1=1
			<if test="finprodType !=null and finprodType != ''">
				and FINPROD_TYPE =#{finprodType}
			</if>
			<if test="search !=null and search != ''">
				AND	(FINPROD_ID like concat('%',concat(#{search},'%'))
				OR FINPROD_ABBR like concat('%',concat(#{search},'%')))
			</if>
		</where>
	</select>

    <select id="getNextId" resultType="java.lang.String">
		SELECT REPLACE(LPAD(${sequenceName}.NEXTVAL, 4), ' ', '0') FROM DUAL
	</select>


    <select id="selectCountByTradeId" resultType="java.lang.Integer" parameterType="java.lang.String" >
        select
        count(1)
        from TRD_PRODUCT_DEAL
        where TRADE_ID = #{tradeId,jdbcType=VARCHAR}
    </select>


</mapper>