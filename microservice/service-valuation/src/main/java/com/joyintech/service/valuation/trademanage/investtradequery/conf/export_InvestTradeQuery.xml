<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/InvestTradeQueryInfo.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="债券代码">assetId</Cell>
			<Cell order="5" name="债券简称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="交易场所">tradeMarket</Cell>
			<Cell order="8" name="投资目的">invAim</Cell>
			<Cell order="9" name="发生日">tradeDate</Cell>
			<Cell order="10" name="币种">ccy</Cell>
			<Cell order="11" name="券面总额/交易本金">shareAmt</Cell>
			<Cell order="12" name="单位净价">unitCprice</Cell>
			<Cell order="13" name="单位全价">unitFprice</Cell>
			<Cell order="14" name="净价总额">cpriceAmt</Cell>
			<Cell order="15" name="应收利息总额">intAmt</Cell>
			<Cell order="16" name="全价总额">fpriceAmt</Cell>
			<Cell order="17" name="总交易费用">feeAmt</Cell>
			<Cell order="18" name="通道费">tdFeeAmt</Cell>
			<Cell order="19" name="交易金额">tradeAmt</Cell>
			<Cell order="20" name="到期收益率（%）">yield</Cell>
			<Cell order="21" name="行权收益率（%）">exerYield</Cell>
			<Cell order="22" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>