<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/RepurchaseTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="回购类型">busiType</Cell>
			<Cell order="5" name="回购方向">finprodType</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="8" name="交易对手">counterName</Cell>
			<Cell order="9" name="币种">ccy</Cell>
			<Cell order="10" name="交易日">tradeDate</Cell>
			<Cell order="11" name="起息日">vDate</Cell>
			<Cell order="12" name="到期日">mDate</Cell>
			<Cell order="13" name="期限品种">termType</Cell>
			<Cell order="14" name="回购利率(%)">intRate</Cell>
			<Cell order="15" name="交易本金">prinAmt</Cell>
			<Cell order="16" name="首次结算金额">firSetAmt</Cell>
			<Cell order="17" name="到期结算金额">expSetAmt</Cell>
			<Cell order="18" name="应计利息">intAmt</Cell>
			<Cell order="19" name="派息金额">divAmt</Cell>
			<Cell order="20" name="转入/转出利息金额">tranAmt</Cell>
			<Cell order="21" name="随交易支付费用">feeAmtPay</Cell>
			<Cell order="22" name="不随交易支付费用">feeAmtUnpay</Cell>
			<Cell order="23" name="交易金额">tradeAmt</Cell>
			<Cell order="24" name="通道">chlId</Cell>
			<Cell order="25" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>