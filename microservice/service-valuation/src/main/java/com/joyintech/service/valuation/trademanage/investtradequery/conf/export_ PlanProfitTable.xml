<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="/trademanage/investtradequery/PlanProfitTable.xlsx" name="投资交易查询">
	<Worksheet javaBean="com.joyintech.service.valuation.trademanage.investtradequery.dto.InvestTradeDto">
		<Row>
			<Cell order="1" name="交易编号">tradeId</Cell>
			<Cell order="2" name="投资主体代码">prodId</Cell>
			<Cell order="3" name="投资主体名称">prodAbbr</Cell>
			<Cell order="4" name="资产代码">assetId</Cell>
			<Cell order="5" name="资产名称">assetAbbr</Cell>
			<Cell order="6" name="交易方向">ps</Cell>
			<Cell order="7" name="发生日">tradeDate</Cell>
			<Cell order="8" name="币种">ccy</Cell>
			<Cell order="9" name="交易份额">shareAmt</Cell>
			<Cell order="10" name="单位净价">unitCprice</Cell>
			<Cell order="11" name="单位全价">unitFprice</Cell>
			<Cell order="12" name="净价总额">cpriceAmt</Cell>
			<Cell order="13" name="应收利息总额">intAmt</Cell>
			<Cell order="14" name="全价总额">fpriceAmt</Cell>
			<Cell order="15" name="通道费">tdFeeAmt</Cell>
			<Cell order="16" name="交易金额">tradeAmt</Cell>
			<Cell order="17" name="到期收益率">yield</Cell>
			<Cell order="18" name="交易状态">tradeStatus</Cell>
		</Row>
	</Worksheet>
</Workbook>