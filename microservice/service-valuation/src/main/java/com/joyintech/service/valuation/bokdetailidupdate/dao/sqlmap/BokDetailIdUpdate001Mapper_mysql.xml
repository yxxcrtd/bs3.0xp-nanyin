<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.bokdetailidupdate.dao.BokDetailIdUpdate001Mapper_mysql">
	<select id="getBokDetailId" resultType="com.joyintech.framework.select.SelectOptionDto">
	    select 
 			BOK_DETAIL_ID as id
		from BOK_DETAIL_ID  
        WHERE 1 = 1
            <if test="search !=null and  search !='' ">
                AND
                BOK_DETAIL_ID like concat_ws('','%',#{search},'%')
            </if>
        GROUP BY 
            BOK_DETAIL_ID
	</select>
	<select id="selectList"
            resultType="com.joyintech.service.valuation.bokdetailidupdate.dto.BokDetailIdUpdate001Dto">
        select
               BOOKSET_ID                     booksetId, 
               BOK_DETAIL_ID    			  bokDetailId,  
               BUSI_ID                        busiId, 
               BUSI_DETAIL_TYPE               busiDetailType, 
               INV_AIM                        invAim, 
               SEC_MANAGE_ACCT_ID             secManageAcctId, 
               DETAIL_SUBJECT_NO_TAIL         detailSubjectNoTail, 
               DETAIL_SUBNAME_TAIL            detailSubnameTail, 
               BRANCH                         branch, 
               CCY                            ccy 
        from BOK_DETAIL_ID 
        
        WHERE  1 = 1
	        <if test="booksetId !=null and booksetId !='' ">
	        	AND  BOOKSET_ID in
	         	<foreach collection="booksetId.split(',')" item="item" open="(" separator="," close=")">
	         		#{item}
	         	</foreach>
	        </if>
             <if test="bokDetailId != null  and bokDetailId !=''">
                AND
                 BOK_DETAIL_ID like concat_ws('','%',#{bokDetailId},'%')
             </if>
            <if test="busiId != null  and busiId !=''">
                AND
                BUSI_ID like concat_ws('','%',#{busiId},'%')
            </if>
            <if test="busiDetailType != null  and busiDetailType !=''">
                AND
                BUSI_DETAIL_TYPE like concat_ws('','%',#{busiDetailType},'%')
            </if>
            <if test="invAim !=null and invAim !='' ">
                and INV_AIM in 
 				<foreach collection="invAim.split(',')" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="ccy != null  and ccy !=''">
                AND  CCY in
                <foreach collection="ccy.split(',')" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
    </select>
</mapper>
