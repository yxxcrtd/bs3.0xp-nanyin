<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.service.valuation.taxparametermanage.taxscheme.dao.TaxScheme004Mapper">

    <select id="selectByPrimaryKey" resultType="com.joyintech.service.valuation.taxparametermanage.taxscheme.dto.TaxScheme004Dto" parameterType="java.lang.String" >
        select
        tax_id as taxId, /*税则代码 */
        sch_id as schId, /* 方案代码 */
        add_tax_type as addTaxType, /* 附加税类型 */
        tax_rate*100 as taxRate, /* 应税税率 */
        TO_CHAR(eff_date, 'yyyy-MM-dd') as effDate/* 生效日 */
        from TAX_ADT_SCHEDULE
        where tax_id = #{tax_id,jdbcType=VARCHAR}
    </select>

    <insert id="insertSelective" parameterType="com.joyintech.service.valuation.taxparametermanage.taxscheme.dto.TaxScheme004Dto" >
        insert into TAX_ADT_SCHEDULE
        <trim prefix="(" suffix=")" suffixOverrides="," >
            TAX_ID,

            <if test="schId != null" >
                SCH_ID,
            </if>
            <if test="addTaxType != null" >
                ADD_TAX_TYPE,
            </if>
            <if test="taxRate != null" >
                TAX_RATE,
            </if>
            <if test="effDate != null" >
                EFF_DATE,
            </if>
            <if test="chlCpctId != null" >
                CHL_CPCT_ID,
            </if>
            <if test="createUser != null" >
                CREATE_USER,
            </if>
            <if test="createDept != null" >
                CREATE_DEPT,
            </if>
            <if test="createTime != null" >
                CREATE_TIME,
            </if>
            <if test="updateUser != null" >
                UPDATE_USER,
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides="," >

            <if test="schId != null" >
                #{taxId,jdbcType=VARCHAR},
            </if>
            <if test="schId == null" >
                TAX_SEQUENCE.NEXTVAL,
            </if>
            <if test="schId != null" >
                #{schId,jdbcType=VARCHAR},
            </if>
            <if test="addTaxType != null" >
                #{addTaxType,jdbcType=VARCHAR},
            </if>
            <if test="taxRate != null" >
                #{taxRate,jdbcType=DECIMAL}/100 ,
            </if>
            <if test="effDate != null" >
                TO_DATE(#{effDate}, 'yyyy-MM-dd'),
            </if>
            <if test="chlCpctId != null" >
                #{chlCpctId,jdbcType=VARCHAR},
            </if>
            <if test="createUser != null" >
                #{createUser,jdbcType=VARCHAR},
            </if>
            <if test="createDept != null" >
                #{createDept,jdbcType=VARCHAR},
            </if>
            <if test="createTime != null" >
                #{createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="updateUser != null" >
                #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>



    <update id="updateByPrimaryKeySelective" parameterType="com.joyintech.service.valuation.taxparametermanage.taxscheme.dto.TaxScheme004Dto" >
        update TAX_ADT_SCHEDULE
        <set >
            <if test="schId != null" >
                SCH_ID = #{schId,jdbcType=VARCHAR},
            </if>
            <if test="addTaxType != null" >
                ADD_TAX_TYPE = #{addTaxType,jdbcType=VARCHAR},
            </if>
            <if test="taxRate != null" >
                TAX_RATE = #{taxRate,jdbcType=DECIMAL}/100,
            </if>
            <if test="effDate != null" >
                EFF_DATE = TO_DATE(#{effDate}, 'yyyy-MM-dd'),
            </if>
            <if test="chlCpctId != null" >
                CHL_CPCT_ID = #{chlCpctId,jdbcType=VARCHAR},
            </if>
            <if test="updateUser != null" >
                UPDATE_USER = #{updateUser,jdbcType=VARCHAR},
            </if>
            <if test="updateTime != null" >
                UPDATE_TIME = #{updateTime,jdbcType=TIMESTAMP},
            </if>
        </set>
        where TAX_ID = #{taxId,jdbcType=VARCHAR}
    </update>



    <select id="getPrimaryKey" resultType="java.lang.String" >
        select
        TAX_SEQUENCE.NEXTVAL
        from dual
    </select>


</mapper>