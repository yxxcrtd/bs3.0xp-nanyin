	<subDataset name="Table Dataset 1" uuid="c5a6efa0-60aa-4765-923b-42277e77bcd4">
		<parameter name="param1" class="java.lang.String"/>
		<parameter name="param2" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
	ygz.ledgerDate,
    (case
	when ygz.issueType=15 then '普通股'
    when ygz.issueType=16 then '回购'
    when ygz.issueType=105 then '定期存款'
    when ygz.issueType=108 then '债券'
    else '汇总' end) as zqpz,
    rps.typename as mxpz,
    ii.securityid,
    ex.exgname,
    (case when ygz.ysfs=1 then '应税' else '免税' end) as ysfs,
    '' as sfdm,
    round(ygz.drsfjzfse,2) as drsfjzfse,
	round(ygz.drsfjzye,2) as drsfjzye,
    round(ygz.lsjzye,2) as lsjzye,
    round(ygz.syrsfye,2) as syrsfye,
    round(ygz.drsffse,2) as drsffse,
    round(ygz.drsfye,2) as drsfye,
    round(ygz.syrkmye,2) as syrkmye,
    round(ygz.drpzjt,2) as drpzjt,
    round(ygz.drkmye,2) as drkmye
	from ygztaizhang ygz
    left join issue_info ii on ii.cusip=ygz.cusip
    left join exchanges ex on ex.exgcode=ygz.exchangeid
    left join rpsectype rps on rps.id=ygz.rpsectype
    where ygz.ledgerdate=$P{param2} and ygz.portnum=$P{param1} order by ygz.issuetype desc,ygz.id desc;]]>
		</queryString>
		<field name="ledgerDate" class="java.sql.Date">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="zqpz" class="java.lang.String"/>
		<field name="mxpz" class="java.lang.String"/>
		<field name="securityid" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="exgname" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="ysfs" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="sfdm" class="java.lang.String"/>
		<field name="drsfjzfse" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="drsfjzye" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="lsjzye" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="syrsfye" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="drsffse" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="drsfye" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="syrkmye" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="drpzjt" class="java.lang.Double">
