<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="基金管理费" language="groovy" pageWidth="800" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="760" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" uuid="407051a1-8eb9-454e-99ed-7723b422ab8e">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Reports\\report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    round(sum(vd.cr_func-vd.dr_func),2) as totalfee
    from voucher v, voucherdetails vd
    where v.vouchernum=vd.vouchernum and v.portfolionum=1 and v.ledgerDate>=date'2017-06-02' and v.ledgerDate<=date'2017-06-26'
    and vd.accountnum='220601';]]>
	</queryString>
	<field name="totalfee" class="java.lang.Double"/>
	<variable name="management_fees" class="java.lang.Double">
		<variableExpression><![CDATA[$F{totalfee}]]></variableExpression>
	</variable>
	<group name="001report">
		<groupExpression><![CDATA[$F{totalfee}]]></groupExpression>
		<groupFooter>
			<band height="43">
