<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="管理费子" language="groovy" pageWidth="150" pageHeight="100" whenNoDataType="AllSectionsNoDetail" columnWidth="110" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" uuid="7e9b11b7-a26c-4fb8-881c-77bfe5dcdf4c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[select
    round(sum(vd.cr_func-vd.dr_func),2) as totalfee
    from voucher v, voucherdetails vd
    where v.vouchernum=vd.vouchernum and v.portfolionum=1 and v.ledgerDate>=date'2017-06-02' and v.ledgerDate<=date'2017-06-26'
    and vd.accountnum='220601';]]>
	</queryString>
	<field name="totalfee" class="java.lang.Double"/>
	<variable name="management_fees1" class="java.lang.Double">
		<variableExpression><![CDATA[$F{totalfee}]]></variableExpression>
	</variable>
	<columnFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="100" height="20" uuid="b5e5079f-9088-403b-87e3-466b59353b0a"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$V{management_fees1}]]></textFieldExpression>
			</textField>
		</band>
	</columnFooter>
</jasperReport>
