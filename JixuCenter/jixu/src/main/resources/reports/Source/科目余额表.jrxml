	<subDataset name="jixu" uuid="70276882-632c-4275-ae9e-192e19fb89f3">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NEW_DATAADAPTER.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="TablePortnum" class="java.lang.String"/>
		<parameter name="TableStartDate" class="java.lang.String"/>
		<parameter name="TableEndDate" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
  ph.port_name,
  t1.accountnum,
  coa.accntname,
  t1.startBalance,
  t1.cr_func,
  t1.dr_func,
  t1.cr_local,
  t1.dr_local,
  t1.cr_func_period,
  t1.dr_func_period,
  t1.cr_local_period,
  t1.dr_local_period,
  t1.endBalance
from
(select
  vd.ACCOUNTNUM,
  round(sum((case when v.ledgerdate<to_date($P{TableStartDate},'yyyy-mm-dd') then (vd.DR_FUNC-vd.CR_FUNC) else 0 end)),2) as startBalance,
  round(sum(vd.CR_FUNC),2) as cr_func,
  round(sum(vd.dr_func),2) as dr_func,
  round(sum(vd.cr_local),2) as cr_local,
  round(sum(vd.dr_local),2) as dr_local,
  round(sum((case when v.ledgerdate>=to_date($P{TableStartDate},'yyyy-mm-dd') then vd.CR_FUNC else 0 end)),2) as cr_func_period,
  round(sum((case when v.ledgerdate>=to_date($P{TableStartDate},'yyyy-mm-dd') then vd.dr_func else 0 end)),2) as dr_func_period,
  round(sum((case when v.ledgerdate>=to_date($P{TableStartDate},'yyyy-mm-dd') then vd.cr_local else 0 end)),2) as cr_local_period,
  round(sum((case when v.ledgerdate>=to_date($P{TableStartDate},'yyyy-mm-dd') then vd.dr_local else 0 end)),2) as dr_local_period,
  round(sum(vd.DR_FUNC-vd.CR_FUNC),2) as endBalance
  from
  voucher v, voucherdetails vd
  where v.vouchernum=vd.vouchernum and ((v.portfolionum in (select portID from PortfolioClassIDMap where classID=$P{TablePortnum})) or v.portfolionum=$P{TablePortnum}) and v.ledgerdate<=to_date($P{TableEndDate},'yyyy-mm-dd')
  group by vd.ACCOUNTNUM) t1, coaa coa, portfolio_hdr ph
  where (t1.startBalance!=0 or t1.cr_func_period!=0 or t1.dr_func_period!=0 or t1.startBalance !=0)
  and ph.portfolio=$P{TablePortnum} and ph.CHARTNUMBER=coa.CHARTNUMBER and coa.ACCNTNUM=t1.ACCOUNTNUM
  order by t1.accountnum asc]]>
		</queryString>
		<field name="port_name" class="java.lang.String"/>
		<field name="accountnum" class="java.lang.String"/>
		<field name="accntname" class="java.lang.String"/>
		<field name="startBalance" class="java.lang.Double"/>
		<field name="cr_func" class="java.lang.Double"/>
		<field name="dr_func" class="java.lang.Double"/>
		<field name="cr_local" class="java.lang.Double"/>
		<field name="dr_local" class="java.lang.Double"/>
		<field name="cr_func_period" class="java.lang.Double"/>
		<field name="dr_func_period" class="java.lang.Double"/>
		<field name="cr_local_period" class="java.lang.Double"/>
		<field name="dr_local_period" class="java.lang.Double"/>
		<field name="endBalance" class="java.lang.Double"/>
	</subDataset>
	<parameter name="StartDate" class="java.lang.String"/>
	<parameter name="EndDate" class="java.lang.String"/>
	<parameter name="Portnum" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select * from portfolio_hdr where portfolio=$P{Portnum}]]>
	</queryString>
	<field name="PORT_NAME" class="java.lang.String"/>
