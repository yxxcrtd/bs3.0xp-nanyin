	<parameter name="Portnum" class="java.lang.String"/>
	<parameter name="StartDate" class="java.lang.String"/>
	<parameter name="EndDate" class="java.lang.String"/>
	<queryString>
		<![CDATA[select vd.accountnum, ph.port_name, round(sum(vd.cr_func-vd.dr_func),2) as func
    from voucher v, voucherdetails vd,portfolio_hdr ph
    where v.portfolionum=ph.portfolio and v.vouchernum=vd.vouchernum and v.portfolionum=$P{Portnum} and  v.ledgerDate>=$P{StartDate} and v.ledgerDate<=$P{EndDate}
    group by ph.port_name,vd.accountnum asc;]]>
	</queryString>
	<field name="accountnum" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="port_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="func" class="java.lang.Double"/>
	<variable name="1.interest_income" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6011" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="bond_interest" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "601101" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="deposit_interest" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "601103" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Buy_back_securities" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "601104" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Monetary_fund_interest" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "601105" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="2.investment_income" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6111" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Stock_price_income" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611101" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="The_difference_of_income_bonds" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611102" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="The_difference_of_income_of_warrants" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611105" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Futures_income" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611106" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Fund_differential_income" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611107" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="income_gain" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "611199" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Gains_and_losses_from_changes_in_fair_value" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6101" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="exchange_earning " class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6408" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="other_revenue" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6302" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Managerial_compensation" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6403" )?$F{func}*-1:0]]></variableExpression>
	</variable>
	<variable name="trustee_fee" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6404" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Sales_service_fee" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6405" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Transaction_Cost" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6407" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="interest_expense " class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6411" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Repurchase_of_financial_assets_interest_expense" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6411" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="other_expenses " class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6605" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="Prior_year_income_adjustment" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6901" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="income_tax_expense" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "6406" )?$F{func}:0]]></variableExpression>
	</variable>
	<variable name="income" class="java.lang.Double" resetType="Column">
		<variableExpression><![CDATA[$V{Gains_and_losses_from_changes_in_fair_value}+$V{1.interest_income}+$V{2.investment_income}+$V{exchange_earning }+$V{other_revenue}]]></variableExpression>
	</variable>
	<variable name="expense" class="java.lang.Double" resetType="Column">
		<variableExpression><![CDATA[$V{Managerial_compensation}]]></variableExpression>
	</variable>
	<variable name="total_profit " class="java.lang.Double">
		<variableExpression><![CDATA[$V{income}-$V{expense}]]></variableExpression>
	</variable>
	<variable name="net_margin" class="java.lang.Double">
		<variableExpression><![CDATA[$V{total_profit }-$V{Prior_year_income_adjustment}-$V{income_tax_expense}]]></variableExpression>
	</variable>
