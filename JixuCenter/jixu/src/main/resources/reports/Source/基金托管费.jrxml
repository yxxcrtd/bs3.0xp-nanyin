<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="基金托管费" language="groovy" pageWidth="800" pageHeight="842" columnWidth="760" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" uuid="7333193b-5c3a-4d09-a472-c7937402551c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Reports\\report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    round(sum(vd.cr_func-vd.dr_func),2) as totalfee
    from voucher v, voucherdetails vd
    where v.vouchernum=vd.vouchernum and v.portfolionum=15 and v.ledgerDate>=date'2012-01-01' and v.ledgerDate<=date'2012-12-31'
    and vd.accountnum='220701';]]>
	</queryString>
	<field name="totalfee" class="java.lang.Double"/>
	<variable name="trustee_fee" class="java.lang.Double">
		<variableExpression><![CDATA[$F{totalfee}]]></variableExpression>
	</variable>
	<group name="002report">
		<groupExpression><![CDATA[$F{totalfee}]]></groupExpression>
		<groupFooter>
			<band height="39">
				<staticText>
