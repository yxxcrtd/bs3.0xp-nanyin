<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="托管费子表" language="groovy" pageWidth="150" pageHeight="100" columnWidth="110" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3bcc7ec9-aa35-4c48-a686-04b746a2ba2b">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[select
    round(sum(vd.cr_func-vd.dr_func),2) as totalfee
    from voucher v, voucherdetails vd
    where v.vouchernum=vd.vouchernum and v.portfolionum=15 and v.ledgerDate>=date'2012-01-01' and v.ledgerDate<=date'2012-12-31'
    and vd.accountnum='220701';]]>
	</queryString>
	<field name="totalfee" class="java.lang.Double"/>
	<variable name="trustee_fees1" class="java.lang.Double">
		<variableExpression><![CDATA[$F{totalfee}]]></variableExpression>
	</variable>
	<columnFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="100" height="20" uuid="ef804573-8c16-4d4e-a4cb-215b68bac5c0"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$V{trustee_fees1}]]></textFieldExpression>
			</textField>
		</band>
	</columnFooter>
</jasperReport>
