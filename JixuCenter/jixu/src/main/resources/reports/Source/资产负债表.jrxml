	<parameter name="Portnum" class="java.lang.String"/>
	<parameter name="StartDate" class="java.lang.String"/>
	<parameter name="EndDate" class="java.lang.String"/>
	<queryString>
		<![CDATA[select vd.accountnum, round(sum(vd.dr_func-vd.cr_func),2) as func,ph.port_name
    from voucher v, voucherdetails vd,portfolio_hdr ph
    where v.vouchernum=vd.vouchernum and v.portfolionum=$P{Portnum} and  v.ledgerDate>=$P{StartDate} and v.ledgerDate<=$P{EndDate} 
    and v.portfolionum=ph.portfolio 
    group by vd.accountnum asc;]]>
	</queryString>
	<field name="accountnum" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="func" class="java.lang.Double"/>
	<field name="port_name" class="java.lang.String"/>
	<variable name="the_Balance_Sheet" class="java.lang.String"/>
	<variable name="bk_account" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{accountnum}.startsWith( "1002" )?$F{func}:0]]></variableExpression>
	</variable>
