{
"jsonoptions": {
    "title": "编辑"
  },
  "基本信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "700"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "select",
      "label": "冲销类型",
      "id": "offsetType",
      "opt_func": "CashOffsetOption"
    },
    {
      "type": "input",
      "id": "tranDesc",
      "label": "冲销说明"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "date",
      "label": "结算日期",
      "id": "settleDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    }
  ],
  "冲销信息": [
    {
      "type": "select",
      "id": "secAcct",
      "label": "证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "现金账户",
      "parent_id": ["secAcct"],
      "opt_func": "secCashList"
    },
    {
      "type": "select",
      "id": "tradeCurrency",
      "label": "冲销货币",
      "parent_id": ["bankAcct"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "label": "冲销金额",
      "df_func": "round(tradeCash,2)",
      "verify":"required|number"
    },
    {
      "type": "selecttab",
      "id": "glacct",
      "label": "冲销科目",
      "opt_func": "acctList",
      "verify":"required"
    },
    {
      "type": "select",
      "id": "settleCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "settleCash",
      "label": "记账金额",
      "df_func": "round(settleCash,2)",
      "verify":"required|number"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "cashOffset_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
