{
  "证券信息": [
    {
      "type": "input",
      "id": "smf_id",
      "label": "股票ID",
      "disabled": "yes"
    },
    { "type": "input", "id": "secid", "label": "证券主ID" },
    { "type": "input", "id": "secname", "label": "证券名称" },
    {
      "type": "select",
      "label": "证券类型",
      "id": "type",
      "opt_func": "allAssets",
      "df_val": "17"
    },
    { "type": "br" },
    {
      "type": "selecttab",
      "label": "发行商",
      "id": "issuer",
      "opt_func": "issuerList"
    },
    {
      "type": "select",
      "label": "所在国家",
      "id": "country",
      "df_val": "3",
      "opt_func": "countryList"
    },
    {
      "type": "select",
      "id": "exchange",
      "label": "交易所",
      "df_val": "255",
      "opt_func": "exchangeList"
    }
  ],
  "币种信息": [
    {
      "type": "select",
      "label": "成本货币",
      "id": "prcurrency",
      "df_val": "1",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "label": "收入货币",
      "id": "incurrency",
      "df_val": "1",
      "opt_func": "currencyList"
    }
  ],
  "财务信息": [
    {
      "type": "select",
      "label": "总账组",
      "id": "glgroup",
      "opt_func": "glListInCOA"
    },
    {
      "type": "hidden",
      "df_val": "普通股"
    },
    {
      "type": "date",
      "id": "activeDate",
      "label": "生效时间"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "smf_money_fund_Update",
      "cb_target": "message",
      "cb_done_message": "保存成功"
    }
  ]
}
