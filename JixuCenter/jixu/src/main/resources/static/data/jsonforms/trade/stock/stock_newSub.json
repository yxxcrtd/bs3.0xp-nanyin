{
"jsonoptions": {
    "title": "新建"
  },
  "证券信息":[
  {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "F10"
    },
  {
      "type": "selecttab",
      "label": "证券名称",
      "id": "secid",
      "opt_func": "newSmfShortList",
          "verify":"required"
    },
  {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "105"
    },
  {
      "type": "selecttab",
      "label": "投资组合",
      "id": "port",
      "opt_func": "portShortList",
      "df_func": "port"
    },
   {
      "type": "select",
      "label": "市场类型",
      "id": "market",
      "opt_func": "tradeMarkets"
    },
  {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort"
    }
],
"交易信息":[
  {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
          "verify":"required|date"
    },
  {
      "type": "input",
      "id": "shares",
      "label": "申购份数",
      "df_func": "round(shares,2)",
          "verify":"required|number"
    },
  {
      "type": "input",
      "id": "price",
      "label": "发行价格",
      "parent_id": ["principal", "shares", "secid"],
      "df_func": "tranPrice",
          "verify":"required|number"
    },
  {
      "type": "input",
      "id": "principal",
      "label": "申购本金",
      "parent_id": ["shares", "price", "secid"],
      "df_func": "round(tranPrincipal,2)",
          "verify":"required|number"
    }
],
"结算信息":[
  {
      "type": "select",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    }, 
  {
      "type": "select",
      "id": "tradeCurrency",
      "label": "交易货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "smfTradeCurrency",
      "opt_func": "currencyList"
    },
  {
      "type": "input",
      "id": "tradeCash",
      "disabled": "yes",
      "label": "交易金额",
      "parent_id": ["principal","shares","price","tradeFx","settleFx","totalExpense"],
      "df_func": "round(calcTradeTotal..tradeCash,2)"
    },
    {
      "type": "input",
      "id": "tradeFx",
      "label": "交易汇率",
      "parent_id": ["tradeDate","port","secid"],
      "df_func": "DefaultFxRateTrade",
      "tips":"交易(结算)货币/记账货币",
          "verify":"required|number"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "stock_buy_Create",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
