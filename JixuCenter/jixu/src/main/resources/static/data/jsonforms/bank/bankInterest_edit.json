{
"jsonoptions": {
    "title": "编辑"
  },
  "银行利息信息": [
    {
      "type": "input",
      "disabled": "yes",
      "id": "interest_id",
      "label": "编号"
    },
    { "type": "input", "id": "code", "label": "利息代码" ,"verify":"required"},
    { "type": "input", "id": "name", "label": "利息名称","verify":"required" },
    {
      "type": "br"
    },
    {
      "type": "select",
      "disabled": "yes",
      "id": "bank_id",
      "label": "银行",
      "opt_func": "bankList"
    },
    { "type": "input", "id": "delayDays", "label": "推迟天数" ,"verify":"required"},
    {
      "type": "select",
      "id": "settleMethod",
      "label": "结算方法",
      "df_val": "1",
      "opt_func": "interestSettleMethods"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "id": "dayCounts",
      "label": "利率基础",
      "df_val": "65",
      "opt_func": "interestDayCount"
    },
    {
      "type": "select",
      "id": "period",
      "label": "期间方法",
      "opt_func": "interestPeriods",
      "df_val": "1"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "付息频率",
      "df_val": "65",
      "opt_func": "interestFrequency"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "id": "interestMonth",
      "label": "付息月份",
      "parent_id": ["frequency"],
      "opt_func": "interestMonth1",
      "df_val": "1"
    },
    { "type": "input", "id": "day", "label": "付息日" ,"verify":"required|number"},
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "bankInterestUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ],
  "利率筛选": [
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "rateSearchBtn",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "interest_id",
      "cb_target": "modal",
      "cb_modal_size":"m",
      "cb_target_url": "bankrate_new",
      "cb_done_clickbtn":"rateSearchBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "rateList",
      "parent_id": ["rateSearchBtn"],
      "tablecols": [
        {
          "colname": "rate_id",
          "label": "利率代码",
          "width":"300"
        },
        {
          "colname": "startDate",
          "label": "起息时间",
          "width":"500"
        },
        {
          "colname": "rate",
          "label": "利率(支持阶梯模式)",
          "width":"500"
        },
        {
          "id": "rateEditBtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["rateDetail"],
          "cb_target": "modal",
          "cb_modal_size":"m",
          "cb_target_url": "bankrate_edit"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "rateRemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
      ]
    }
  ]
}
