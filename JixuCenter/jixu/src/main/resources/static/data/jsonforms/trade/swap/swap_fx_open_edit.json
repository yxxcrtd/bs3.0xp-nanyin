{
  "jsonoptions": {
    "title": "新建",
    "formgroup": {
      "合约信息": "12",
      "近端信息": "6",
      "远端信息": "6",
      "费用详情": "12",
      "操作": "12"
    }
  },
  "合约信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "F13",
      "colwidth": "4"
    },
    { "type": "input", "id": "secid", "label": "合同编号","verify": "required","colwidth": "4"},
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "760",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort",
      "colwidth": "4"
    },
    {
      "type": "hidden",
      "id": "broker",
      "label": "交易对手方",
      "parent_id": ["port"],
      "opt_func": "brokerList",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "近端日期",
      "id": "settleDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "远端日期",
      "id": "maturityDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses",
      "parent_id": ["totalExpense"],
      "colwidth": "4"
    },
    {
      "type": "input",
      "id": "totalExpense2",
      "label": "不随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses2",
      "parent_id": ["totalExpense2"],
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "面额互换",
      "id": "swapExchangeInd",
      "opt_func": "FXswapSetPrincipalType",
      "colwidth": "4"
    }
    ],
"近端信息": [
    {
      "type": "input",
      "id": "principal",
      "label": "收入端本金",
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "principal2",
      "label": "支出端本金",
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "收入银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "支出银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "收入币种",
      "id": "incurrency",
      "parent_id": ["bankAcct"],
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "支出币种",
      "id": "incurrency2",
      "parent_id": ["bankAcct2"],
      "df_func": "bankAccountCurrency2",
      "opt_func": "currencyList",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "tradeFX",
      "label": "近端汇率",
      "df_func": "",
      "verify": "required|number",
      "colwidth": "6"
    }
  ],

  "远端信息": [
    {
      "type": "input",
      "id": "tradeCash2",
      "label": "收入端本金",
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "label": "支出端本金",
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bank",
      "label": "收入银行账户",
      "parent_id": ["bankAcct2"],
      "df_func": "bankAcct2",
      "opt_func": "portfolioAccountShortList",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bank2",
      "label": "支出银行账户",
      "parent_id": ["bankAcct"],
      "opt_func": "portfolioAccountShortList",
      "df_func": "bankAcct",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "收入币种",
      "id": "currency",
      "parent_id": ["bankAcct2"],
      "df_func": "incurrency2",
      "opt_func": "currencyList",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "支出币种",
      "id": "currency2",
      "parent_id": ["bankAcct"],
      "df_func": "incurrency",
      "opt_func": "currencyList",
      "disabled":"yes",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "tradeFX2",
      "label": "远端汇率",
      "df_func": "",
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "hidden",
      "label": "总账组",
      "id": "glgroup",
      "df_func":"autoMapGlGroupForJoyin",
      "parent_id":["bankAcct","bankAcct2"],
      "opt_func": "glListInCOA",
      "colwidth": "6"
    }
  ],
  "费用详情": [
    {
   "type": "formoption",
   "backcolor": "#f5f5f5",
   "hide_func": "",
   "formjson":"trade_fee"
  },
  {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "expense",
          "label": "交易费用",
          "col_func":"tradeExpenseType"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户",
          "col_func":"bankAcctNameByActID"
        },
        {
          "colname": "tradeCurrency",
          "label": "交易货币",
          "col_func":"tradeCurrencyCode"
        },
        {
          "colname": "tableFeeCurrency",
          "label": "费用货币",
          "col_func":"feeCurrencyCode"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "cashAmount",
          "label": "应收应付金额",
          "total": "yes"
        },
        {
          "colname": "expenseSettleDate",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["incurrency"],
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":"totalExpense",
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "hidden",
              "label": "应收应付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "0"
            },
            {
		      "type": "select",
		      "id": "bankAccount",
		      "label": "费用现金账户",
		      "parent_id": ["port"],
		      "opt_func": "portfolioAccountShortList"
		    },
            {
              "type": "select",
              "label": "交易货币",
              "id": "tradeCurrency",
              "opt_func": "currencyList"
            },
            {
		      "type": "select",
		      "id": "tableFeeCurrency",
		      "label": "费用货币",
		      "disabled": "yes",
		      "parent_id": ["bankAccount"],
		      "df_func": "bankAccountFeeCurrency",
		      "opt_func": "currencyList"
		    },
		    {
		      "type": "input",
		      "id": "fxRate",
		      "label": "交易汇率",
		      "parent_id": ["bankAccount","tradeCurrency"],
		      "df_func": "DefaultFeeFxRateTrade",
		      "tips":"费用货币/记账货币",
              "verify":"required|number"
		    },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "label": "费用化金额"
            },
            {
              "type": "input",
              "id": "cashAmount",
              "label": "应收应付金额"
            },
            {
              "type": "date",
              "label": "结转时间",
              "id": "expenseSettleDate"
            }
          ]
        }
      ]
    }
    ],
"操作": [
    { "type": "br"},
    { "type": "blank", "colwidth": "5" },
    {
      "type": "btngroup",
      "label": "<i class='layui-icon layui-icon-delete'></i>提交",
       "colwidth": "2" ,
       "buttons":[
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "swap_fx_open_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }]}
  ]
}