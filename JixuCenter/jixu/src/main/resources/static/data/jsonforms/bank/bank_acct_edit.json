{
"jsonoptions": {
    "title": "编辑"
  },
  "银行账户信息": [
    {
      "type": "input",
      "id": "bankAccount_id",
      "label": "编号",
      "disabled": "yes"
    },
    { "type": "input", "id": "acct", "label": "账户" ,"verify":"required"},
    {
      "type": "select",
      "disabled": "yes",
      "id": "bank_id",
      "label": "银行",
      "opt_func": "bankList",
      "disabled": "yes"
    },
    {
      "type": "br"
    },
    { "type": "input", "id": "code", "label": "机构代码" ,"verify":"required"},
    { "type": "input", "id": "desc", "label": "账户描述" ,"verify":"required"},
    {
      "type": "select",
      "label": "账户货币",
      "id": "currency",
      "opt_func": "currencyList"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "label": "状态",
      "id": "status",
      "opt_func": "bankAccountStatus"
    },
    {
      "type": "select",
      "label": "结算货币",
      "id": "settlement1",
      "opt_func": "settleCurrencyTypes"
    },
    {
      "type": "select",
      "id": "port",
      "label": "关联组合",
      "opt_func": "portShortList",
      "disabled": "yes"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "id": "interest",
      "label": "利息配置",
      "opt_func": "bankInterestListWithNo"
    },
    {
      "type": "input",
      "id": "balance",
      "label": "当前账户余额",
      "disabled": "yes"
    },
    {
      "type": "input",
      "id": "date",
      "label": "当前账户余额日期",
      "disabled": "yes"
    },
    {
      "type": "br"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "bankAccountUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ],
  "关联科目": [
    {
      "type": "button",
      "id": "searchCOABtn",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>关联科目",
      "cb_func": ["port"],
      "cb_target": "modal",
      "cb_done_clickbtn":"searchCOABtn",
      "cb_target_form": [
      {
			"type":"select",
			"label":"业务类型",
			"id":"category",
			"opt_func":"bankAccountCats"
						
		},
		{ "type":"selecttab",
          "label": "会计科目",
          "id":"bankacct_acct",
          "opt_func":"acctList"
        },
        {
        "type": "button",
        "label":"提交",
        "center":"yes" ,
        "cb_func": "bankCOACreate",
        "cb_target": "message",
        "cb_done_message": "提交成功",
        "cb_done_action": "_closemodal"
        }
        ]
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "bankCOADetail",
      "parent_id": ["searchCOABtn"],
      "tablecols": [
        {
          "colname": "category",
          "label": "业务类型",
          "col_func":"bankAccountCatById",
          "width":"700"
        },
        {
          "colname": "bankacct_acct",
          "label": "会计科目",
          "width":"700"
        },
        {
          "id": "bankCOAEditBtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["port", "acct1","bankAccount_id"],
          "cb_target": "modal",
          "cb_modal_size":"m",
          "cb_target_url": "bankcoa_edit"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "bankCOARemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
        ]
    }
  ]
}
