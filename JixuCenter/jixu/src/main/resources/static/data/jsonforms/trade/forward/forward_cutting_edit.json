{
"jsonoptions": {
    "title": "编辑"
  },
  "基本信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "fxAssets",
      "df_val": "F12"
    },
    {
      "type": "selecttab",
      "label": "原合约编号",
      "id": "secid",
      "opt_func": "newForwardSmfShortList",
      "verify":"required"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "409"
    },
    {
      "type": "input",
      "id": "counterparty",
      "disabled": "yes",
      "label": "交易对手方"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort"
    },
    {
      "type": "date",
      "label": "交割日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    }
  ],
  "多空头信息": [
    {
      "type": "select",
      "id": "longCurrency",
      "label": "多头货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "forward_FCOpenTrade..longCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "disabled": "yes",
      "label": "多头金额",
       "parent_id": ["secid"],
      "df_func": "forward_FCOpenTrade..tradeCash"
    },
    {
      "type": "input",
      "id": "longFX",
      "label": "合约汇率",
      "disabled": "yes",
      "parent_id": ["secid"],
      "df_func": "forward_FCOpenTrade..longFX"
    },
    {
      "type": "select",
      "id": "shortCurrency",
      "label": "空头货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "forward_FCOpenTrade..shortCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash2",
      "label": "空头金额",
      "disabled": "yes",
       "parent_id": ["secid"],
      "df_func": "forward_FCOpenTrade..tradeCash2"
    },
    {
      "type": "input",
      "id": "shortFX",
      "label": "合约汇率",
      "disabled": "yes",
      "parent_id": ["secid"],
      "df_func": "forward_FCOpenTrade..shortFX"
    }
  ],
  "结算信息": [
    {
      "type": "select",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "hidden",
      "id": "tradeCurrency",
      "label": "多头货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "forward_FCOpenTrade..longCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "hidden",
      "id": "tradeFX",
      "label": "多头结算汇率",
      "parent_id": ["tradeDate","port","secid"],
      "tips":"多头货币/记账货币",
      "df_func": "DefaultFxRateTrade"
    },
    {
      "type": "hidden",
      "id": "funcCurrency",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "hidden",
      "id": "settleCurrency1",
      "label": "空头货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "forward_FCOpenTrade..shortCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "hidden",
      "id": "settleFX",
      "label": "空头结算汇率",
      "parent_id": ["tradeDate","port","secid"],
      "tips":"空头货币/记账货币",
      "df_func": "DefaultFxRateSettle"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "结算银行",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList"
    },
    {
      "type": "select",
      "id": "diffSide",
      "label": "差额收付方向",
      "opt_func": "DiffSides"
    },
    {
      "type": "input",
      "id": "diffCash",
      "label": "差额收付金额"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses",
      "parent_id": ["totalExpense"]
    },
    {
      "type": "input",
      "id": "totalExpense2",
      "label": "不随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses2",
      "parent_id": ["totalExpense2"]
    }
  ],
  "费用详情": [
    {
   "type": "formoption",
   "backcolor": "#f5f5f5",
   "hide_func": "",
   "formjson":"trade_fee_edit"
  },
  {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "Expensescode",
          "type":"hidden",
          "label": "费用编号"
        },
        {
          "colname": "expense",
          "label": "交易费用",
          "col_func":"tradeExpenseType"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户",
          "col_func":"bankAcctNameByActID"
        },
        {
          "colname": "tradeCurrency",
          "label": "交易货币",
          "col_func":"tradeCurrencyCode"
        },
        {
          "colname": "tableFeeCurrency",
          "label": "费用货币",
          "col_func":"feeCurrencyCode"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "cashAmount",
          "label": "应收应付金额",
          "total": "yes"
        },
        {
          "colname": "expenseSettleDate",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["incurrency"],
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":"totalExpense",
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "hidden",
              "label": "应收应付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "0"
            },
            {
		      "type": "select",
		      "id": "bankAccount",
		      "label": "费用现金账户",
		      "parent_id": ["port"],
		      "opt_func": "portfolioAccountShortList"
		    },
            {
              "type": "select",
              "label": "交易货币",
              "id": "tradeCurrency",
              "opt_func": "currencyList"
            },
            {
		      "type": "select",
		      "id": "tableFeeCurrency",
		      "label": "费用货币",
		      "disabled": "yes",
		      "parent_id": ["bankAccount"],
		      "df_func": "bankAccountFeeCurrency",
		      "opt_func": "currencyList"
		    },
		    {
		      "type": "input",
		      "id": "fxRate",
		      "label": "交易汇率",
		      "parent_id": ["bankAccount","tradeCurrency"],
		      "df_func": "DefaultFeeFxRateTrade",
		      "tips":"费用货币/记账货币",
              "verify":"required|number"
		    },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "label": "费用化金额"
            },
            {
              "type": "br"
            },
            {
              "type": "input",
              "id": "cashAmount",
              "label": "应收应付金额"
            },
            {
              "type": "date",
              "label": "结转时间",
              "id": "expenseSettleDate"
            }
          ]
        }
      ]
    }
    ],
"操作": [
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "forward_cutting_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
