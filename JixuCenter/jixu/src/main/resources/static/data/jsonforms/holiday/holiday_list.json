{
  "节假日": [
    {
      "id": "holiday_select",
      "type": "select",
      "label": "节假日安排选择",
      "opt_func": "holidayList"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>搜索",
      "id": "holidaySearchBtn"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-file'></i>新建节假日",
      "cb_func": "",
      "cb_target": "modal",
      "cb_target_form": [
        {
          "type": "input",
          "label": "节假日名称",
          "id": "holidayname"
        },
        {
          "type": "button",
          "label": "创建",
          "cb_func": "holidayCreate",
          "cb_target": "message",
          "cb_done_message": "创建成功"
        }
      ]
    },
    {
      "id": "tableConnList",
      "type": "table",
      "parent_id": ["holiday_select", "holidaySearchBtn"],
      "df_func": "holidayList",
      "parent_id": ["holidaySearchBtn"],
      "tablecols": [
        {
          "colname": "holiday_id",
          "label": "编号"
        },
        {
          "colname": "holidayname",
          "label": "节假日名称"
        },
        {
          "id": "daeditbtn",
          "type": "button",
          "label": "编辑",
          "cb_func": "holidayDetail",
          "cb_target": "modal",
          "cb_target_url": "holiday_edit"
        },
        {
          "type": "button",
          "label": "删除",
          "cb_func": "holidayRemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
      ]
    }
  ]
}
