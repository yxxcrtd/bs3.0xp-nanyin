{
"jsonoptions": {
    "title": "编辑"
  },
  "现金流配置": [
    {
      "type": "hidden",
      "id": "cashflowcfg",
      "label": "ID",
      "disabled": "yes"
    },
        {
      "type": "hidden",
      "id": "cashflowcfg2",
      "label": "ID",
      "disabled": "yes"
    },
    {
      "type": "hidden",
      "id": "couponType",
      "label": "利率类型",
      "opt_func": "cfTypes",
      "df_func": "couponType"
    },
    {
      "type": "hidden",
      "id": "type",
      "label": "类型",
      "opt_func": "getexpenseRPType",
      "df_val":"0"
    },
    {
      "type": "hidden",
      "id": "couponRate",
      "label": "利率(%)",
      "verify": "required|number|percent",
      "df_val":"0" 
    },
    {
      "type": "select",
      "label": "利率基础",
      "id": "dayCount",
      "opt_func": "expenseDayCount"
    },
    {
      "type": "select",
      "label": "付款频率",
      "id": "frequency",
      "opt_func": "expenseFrequency"
    },
    {
      "type": "select",
      "label": "付款月份",
      "id": "paymentMonth",
      "parent_id": ["frequency"],
      "opt_func": "expenseMonth"
    },
    { "type": "input", "label": "付款日", "verify": "required|number","parent_id":"frequency","disable_func":"iif(frequency=expireFrequency,true,false)","id": "paymentDay" },
    {
      "type": "date",
      "label": "起息日期",
      "id": "accurStartDate",
      "verify": "required|date",
      "df_func":"returnDateControl"
    },
    {
      "type": "select",
      "label": "是否生效",
      "id": "status",
      "opt_func": "expenseStatus"
    },
    {
      "type": "hidden",
      "label": "自动结转本金?",
      "id": "autoFlag"
    },
    {
      "type": "hidden",
      "label": "自动结转利息?",
      "id": "autoInterestFlag"
    }
  ],
  "浮动利率重置": [
    {
      "type": "select",
      "id": "base",
      "label": "基准利率",
      "opt_func": "basisRates"
    },
    {
      "type": "select",
      "id": "vrMethod",
      "label": "计算方法",
      "opt_func": "cashFlowFloatMethod"
    },
    {
      "type": "input",
      "id": "factor",
      "label": "利差(%)",
	  "verify": "required|number|percent"
    },
    {
      "type": "input",
      "id": "max",
      "label": "最大值(%)",
	  "verify": "required|number|percent"
    },
    {
      "type": "input",
      "id": "min",
      "label": "最小值(%)",
	  "verify": "required|number|percent"
    },
    {
      "type": "select",
      "label": "重置频率",
      "id": "resetfrequency",
      "opt_func": "expenseFrequency"
    },
    {
      "type": "select",
      "label": "重置月份",
      "id": "month",
      "parent_id": ["resetfrequency"],
      "opt_func": "resetExpenseMonth"
    },
    { "type": "input", "label": "重置日", "id": "day", "parent_id":"resetfrequency","disable_func":"iif(resetfrequency=expireFrequency,true,false)","verify": "required|number" },
    { "type": "input", "label": "付款日后N天", "id": "vrResetNDays" ,"df_val":"0" },
    { "type": "input", "label": "调整月", "id": "vrDeterAdjMo","df_val":"0"  },
    { "type": "input", "label": "调整日", "id": "vrDeterAdjDays","df_val":"0"  },
    {
	      "type": "select",
	      "label": "计息方法",
	      "id": "interest_method",
	      "opt_val": {
	      		"1":"单利",
	      		"2":"复利"
	      },
	      "df_val": "1"
	    },
		{ "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "5" },
		{
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
	      "cb_func": "swap_cf_floatingUpdate",
	      "cb_target": "message",
	      "cb_done_message": "提交成功",
	      "cb_done_upelem":["cashflowcfg","cashflowcfg2"],
	      "cb_done_action": "_closemodal",
	      "colwidth": "1"
	    },
	    {
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
	      "cb_func": "_closemodal",
	       "colwidth": "1" 
	    } 
  ]
}
