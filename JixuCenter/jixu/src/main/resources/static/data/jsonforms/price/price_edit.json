{
"jsonoptions": {
    "title": "编辑"
  },
  "价格信息": [
     {
  		  "type":"input",
          "id": "price_id",
          "label": "价格编号",
          "disabled":"yes"
		},
		{
      "type": "select",
      "label": "定价基准",
      "id": "priceto",
      "opt_func": "PriceDecideTypeOption",
      "df_val": "1"
    },
    {
      "type": "selecttab",
      "label": "证券ID",
      "id": "secid",
      "opt_func": "newpriceShortList",
      "verify":"required"
    },
    {
      "type": "date",
      "label": "价格时间",
      "id": "date",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "input",
      "label": "行情",
      "id": "price",
      "parent_id":"price",
      "verify":"required|number"
    },
    {
      "type": "input",
      "label": "当前收益率",
      "id": "yield",
      "df_val":"0",
      "verify":"number"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "priceUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
