{
  "证券信息":[
        {
  		  "type":"input",
          "id": "smf_id",
          "label": "期权ID",
          "disabled":"yes"
		},
		{ "type":"input",
          "id": "secid",
          "label": "证券主ID",
          "verify":"required"
        },
        { "type":"input",
          "id": "secname",
          "label": "证券名称",
          "verify":"required"
        },
         {
	      "type":"select",
		  "label":"证券类型",
          "disabled":"yes",
		  "id":"type",
		  "opt_func":"allAssets",
		  "df_val":"60"
	    },
	    {
		  "type": "selecttab",
	      "label": "发行商",
	      "id":"issuer",
	      "opt_func":"issuerList",
	      "verify":"required"				
		},
        {
	      "type":"select",
		  "label":"权证类型",
		  "id":"optionType",
		  "opt_func":"optionTypes"
	    },
        {
	      "type":"select",
		  "label":"合约类型",
		  "id":"optionContractType",
		  "opt_func":"optionContractTypes"
	    },
	    { "type": "input", "id": "endPrice", "label": "行权价格" ,"df_func": "endPrice","verify":"required|number"},
        { "type":"date",
          "label": "到期日期",
          "id": "secExpireDate",
          "verify":"required|date"
        },
         {
		  "type": "selecttab",
	      "label": "标的证券",
	      "id":"underCusip",
	      "opt_func":"underCusipList",
	      "verify":"required"				
		},
        {
			"type":"select",
			"id":"country",
			"label":"所在国家",
			"opt_func":"countryList"
		},
		{
			"type":"select",
			"id":"exchange",
			"label":"交易所",
			"opt_func":"exchangeList"
						
		}
  ],
  "币种信息":[
        {
			"type":"select",
			"label":"成本货币",
			"id":"prcurrency",
			"df_val":"1",
			"opt_func":"currencyList"
		}
  ],
  "财务信息":[
        {
			"type":"select",
			"label":"总账组",
			"id":"glgroup",
			"opt_func":"glListInCOA"
		},
		{
      "type": "select",
      "label": "资产类别",
      "id": "assetType",
      "opt_func": "newAssets",
      "parent_id":"type"
    },
    {
      "type": "select",
      "label": "资产主类别",
      "id": "assetMajor",
      "opt_func": "newMajorAsset",
      "parent_id":"assetType"
    },
    {
      "type": "select",
      "label": "资产次类别",
      "id": "assetMinor",
      "opt_func": "newMinorAsset",
      "parent_id":"assetType"
    },
        {
			"type":"date",
            "id": "activeDate",
            "label": "生效时间",
            "verify":"required|date"
		},
		{ "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
        { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "5" },
		{
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
	      "cb_func": "smf_optionupdate",
	      "cb_target": "message",
	      "cb_done_message": "提交成功",
	      "cb_done_action": "_closemodal",
	      "colwidth": "1"
	    },
	    {
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
	      "cb_func": "_closemodal",
	       "colwidth": "1" 
	    }
 ]
