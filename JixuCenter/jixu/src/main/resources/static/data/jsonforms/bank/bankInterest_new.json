{
"jsonoptions": {
    "title": "新建"
  },
  "银行利息信息": [
    { "type": "input", "id": "code", "label": "利息代码" ,"verify":"required"},
    {
      "type": "input",
      "id": "name",
      "label": "利息名称",
      "verify": "required"
    },
    {
      "type": "select",
      "disabled": "yes",
      "id": "bank_id",
      "label": "银行",
      "opt_func": "bankList"
    },
    {
      "type": "br"
    },
    { "type": "input", "id": "delayDays", "label": "推迟天数" ,"verify":"required"},
    {
      "type": "select",
      "id": "settleMethod",
      "label": "结算方法",
      "df_val": "1",
      "opt_func": "interestSettleMethods"
    },
    {
      "type": "select",
      "id": "dayCounts",
      "label": "利率基础",
      "df_val": "65",
      "opt_func": "interestDayCount"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "id": "period",
      "label": "期间方法",
      "opt_func": "interestPeriods",
      "df_val": "1"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "付息频率",
      "df_val": "65",
      "opt_func": "interestFrequency"
    },
    {
      "type": "select",
      "id": "interestMonth",
      "label": "付息月份",
      "parent_id": ["frequency"],
      "opt_func": "interestMonth1",
      "df_val": "1"
    },
    {
      "type": "br"
    },
    { "type": "input", "id": "day", "label": "付息日", "verify": "required|number" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "bankInterestCreate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
