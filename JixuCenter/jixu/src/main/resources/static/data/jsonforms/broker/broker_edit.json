{
"jsonoptions": {
    "title": "编辑"
  },
  "券商信息": [
    { "type": "input", "id": "broker_id", "label":"券商编号","disabled": "yes" },
    {
      "type": "input",
      "id": "code",
      "label": "券商主代码",
      "verify": "required"
    },
    { "type": "input", "id": "bic", "label": "BIC代码" },
    { "type": "br" },
    { "type": "input", "id": "fin", "label": "FIN代码" },
    {
      "type": "input",
      "id": "name",
      "label": "券商名称",
      "verify": "required"
    },
    {
      "type": "select",
      "label": "所在国家",
      "id": "country",
      "opt_func": "countryList"
    },
    { "type": "br" },
    { "type": "input", "id": "contact", "label": "联系人" },
    { "type": "input", "id": "address", "label": "地址","verify": "required" },
    { "type": "input", "id": "tel", "label": "电话" ,"verify": "phone"},
    { "type": "br" },
    { "type": "input", "id": "fax", "label": "传真","verify": "phone" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "brokerUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ],
  "证券账户筛选": [
    
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "secacctSearchBtn",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "broker_id",
      "cb_target": "modal",
      "cb_target_url": "secacct_new",
      "cb_done_clickbtn":"secacctSearchBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "secAcctsInBroker",
      "parent_id": ["secacctSearchBtn"],
      "tablecols": [
        {
          "colname": "secacct_id",
          "label": "账户代码"
        },
        {
          "colname": "acct",
          "label": "账户名称"
        },
        {
          "colname": "broker",
          "label": "所属券商"
        },
        {
          "colname": "desc",
          "label": "账户描述",
          "width":"200"
        },
        {
          "colname": "portname",
          "label": "关联组合",
          "width":"220"
        },
        {
          "colname": "glgroup",
          "label": "总账组"
        },
        {
          "colname": "seccash",
          "label": "关联现金账户个数"
        },
        {
          "id": "secAcctEditBtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": "secAcctDetail",
          "cb_target": "modal",
          "cb_target_url": "secacct_edit"
        }
      ]
    }
  ],
  "席位号筛选": [
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "seatNumFreshBtn"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "broker_id",
      "cb_target": "modal",
      "cb_modal_size":"m",
      "cb_target_url": "broker_seatnumber_new",
      "cb_done_clickbtn":"seatNumFreshBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "seatNumbers",
      "parent_id": ["seatNumFreshBtn"],
      "tablecols": [
        {
          "colname": "seatnum_id",
          "label": "代码",
          "width":"350"
        },
        {
          "colname": "seatnum_code",
          "label": "席位代码",
          "width":"350"
        },
        {
          "colname": "seatnum_name",
          "label": "席位名称",
          "width":"350"
        },
        {
          "colname": "seatnum_desc",
          "label": "席位描述",
          "width":"300"
        },
        {
          "id": "daeditbtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": "",
          "cb_target": "modal",
          "cb_modal_size":"m",
          "cb_target_url": "broker_seatnumber_edit"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "seatNumberRemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
      ]
    }
  ]
}
