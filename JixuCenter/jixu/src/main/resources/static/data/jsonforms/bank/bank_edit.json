{
"jsonoptions": {
    "title": "编辑"
  },
  "银行配置信息": [
    { "type": "input", "id": "bank_id", "label": "银行ID", "disabled": "yes" },
    { "type": "input", "id": "code", "label": "银行代码" ,"disabled":"yes","verify":"required"},
    { "type": "input", "id": "name", "label": "银行名称" ,"disabled":"yes","verify":"required"},
    { "type": "br" },
    {
      "type": "select",
      "id": "country",
      "label": "所在国家",
      "df_val": "3",
      "opt_func": "countryList",
      "verify":"required"
    },
    { "type": "input", "label": "联系人", "id": "contact" },
    { "type": "input", "label": "地址", "id": "address" ,"verify":"required"},
    { "type": "br" },
    { "type": "input", "label": "电话", "id": "tel" ,"verify":"phone"},
    { "type": "input", "label": "传真", "id": "fax","verify":"phone" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "bankUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ],
  "银行账户信息": [
    
    {
      "type": "button",
      "id": "bankAcctSearchBtn",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "bank_id",
      "cb_target": "modal",
      "cb_target_url": "bank_acct_new",
      "cb_done_clickbtn":"bankAcctSearchBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "bankAccountList",
      "parent_id": ["bankAcctSearchBtn"],
      "tablecols": [
        {
          "colname": "bankAccount_id",
          "label": "银行账户代码",
          "width":"700"
        },
        {
          "colname": "bankAccount_name",
          "label": "银行账户名称",
          "width":"700"
        },
        {
          "id": "bankAcctEditBtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": "bankAccountDetail",
          "cb_target": "modal",
          "cb_target_url": "bank_acct_edit"
        }
      ]
    }
  ],
  "银行利息信息": [
    
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "bankIntSearchBtn",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "bank_id",
      "cb_target": "modal",
      "cb_target_url": "bankInterest_new",
      "cb_done_clickbtn":"bankIntSearchBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "bankInterestList",
      "parent_id": ["bankIntSearchBtn"],
      "tablecols": [
        {
          "colname": "interest_id",
          "label": "利息代码",
          "width":"700"
        },
        {
          "colname": "interest_name",
          "label": "银行利息名称",
          "width":"700"
        },
        {
          "id": "daeditbtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": "bankInterestDetail",
          "cb_target": "modal",
          "cb_target_url": "bankInterest_edit"
        }
      ]
    }
  ]
}
