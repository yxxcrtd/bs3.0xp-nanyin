{
"jsonoptions": {
    "title": "编辑"
  },
  "总账组信息": [
    
    {
      "type": "hidden",
      "id": "glgroup_id",
      "df_func": "glgroup_id"
    },
    {
      "type": "select",
      "label": "会计科目表",
      "opt_func": "coaList",
      "id": "coa_id",
      "verify": "required"
    },
    {
      "type": "input",
      "disabled": "yes",
      "label": "总账组名称",
      "id": "glgroup_name"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "cb_func": "glgroup_id",
      "id": "glColRefreshBtn"
    },
        {
          "type": "button",
          "label": "复制",
          "cb_func": "",
          "cb_target": "modal",
          "cb_target_form": [
            {
              "type": "input",
              "label": "新总账组名称",
              "id": "glname"
            },
            {
              "type": "button",
              "label": "提交",
              "cb_func": "glCopy",
              "cb_target": "message",
              "cb_done_message": "提交成功",
              "cb_done_action": "_closemodal"
            }
          ]
        },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "glgroup_id",
      "cb_target": "modal",
      "cb_target_form": [
        {
          "type": "selecttab",
          "label": "总账栏",
          "id": "glCol",
          "opt_func": "newGlColList",
          "verify":"required"
        },
        {
          "type": "selecttab",
          "label": "会计科目",
          "id": "acct",
          "opt_func": "acctListInCOA",
          "verify":"required"
          
        },
        {
          "type": "button",
          "label": "提交",
          "cb_func": "glColCreate",
          "cb_target": "message",
          "cb_done_message": "提交成功",
          "cb_done_action": "_closemodal"
        }
      ]
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "newGlDetail",
      "parent_id": ["glColRefreshBtn"],
      "tablecols": [
        {
          "colname": "glCol_id",
          "label": "编号",
          "width":"400"
        },
        {
          "colname": "glCol",
          "label": "总账栏号|总账栏名称",
          "width":"450"
        },
        {
          "colname": "acct",
          "label": "会计科目",
          "width":"500"
        },
        {
          "id": "daeditbtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["glgroup_id","coa_id","glCol"],
          "cb_target": "modal",
          "cb_target_url": "gl_col_edit"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "glColRemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
      ]
    }
  ]
}
