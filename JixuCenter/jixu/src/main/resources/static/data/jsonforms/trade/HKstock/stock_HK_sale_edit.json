{
"jsonoptions": {
    "title": "编辑"
  },
  "证券信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "F10"
    },
    {
      "type": "selecttab",
      "label": "证券名称",
      "id": "secid",
      "disabled": "yes",
      "opt_func": "newSmfShortList",
      "verify":"required"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeTypes",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "210"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "select",
      "label": "市场类型",
      "id": "market",
      "opt_func": "tradeMarkets"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort"
    },
    {
      "type": "select",
      "id": "broker",
      "label": "所属券商",
      "parent_id": ["port"],
      "opt_func": "brokerList"
    },
    {
      "type": "select",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    }
  ],
  "结算账户信息": [
    {
      "type": "date",
      "label": "一级结算日期",
      "id": "settleDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "select",
      "id": "secAcct",
      "label": "一级证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "一级现金账户",
      "parent_id": ["secAcct"],
      "opt_func": "secCashList"
    },
    {
      "type": "date",
      "label": "二级结算日期",
      "id": "settleDate2",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "select",
      "id": "secAcct2",
      "label": "二级证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "二级现金账户",
      "parent_id": ["secAcct2"],
      "opt_func": "secCashList"
    }
  ],
  "交易信息": [
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "input",
      "id": "shares",
      "label": "份数",
      "df_func": "round(shares,2)",
          "verify":"required|number"
    },
    {
      "type": "input",
      "id": "price",
      "label": "价格",
      "parent_id": ["principal", "shares", "secid"],
      "df_func": "tranPrice",
          "verify":"required|number"
    },
    {
      "type": "input",
      "id": "principal",
      "label": "本金",
      "parent_id": ["shares", "price", "secid"],
      "df_func": "round(tranPrincipal,2)",
          "verify":"required|number"
    },
    {
      "type": "hidden",
      "id": "accruedIncome",
      "label": "计提收入",
      "df_val": "0"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "费用总计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses",
      "parent_id": ["totalExpense"]
    }
  ],
  "结算信息": [
    {
      "type": "select",
      "id": "tradeCurrency",
      "label": "交易货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "smfTradeCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "disabled": "yes",
      "label": "交易金额",
      "parent_id": ["principal","shares","price","tradeFx","settleFx","totalExpense"],
      "df_func": "round(calcTradeTotal..tradeCash,2)"
    },
    {
      "type": "input",
      "id": "tradeFx",
      "label": "交易汇率",
      "parent_id": ["tradeDate","port","secid"],
      "df_func": "DefaultFxRateTrade",
      "tips":"交易(结算)货币/记账货币",
          "verify":"required|number"
    },
    {
      "type": "hidden",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "id": "settleCurrency",
      "label": "结算货币",
      "parent_id": ["bankAcct"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "settleCash",
      "disabled": "yes",
      "label": "结算金额",
      "parent_id": ["principal","shares","price","tradeFx","settleFx","totalExpense"],
      "df_func": "round(calcTradeTotal..settleCash,2)"
    },
    {
      "type": "input",
      "id": "settleFx",
      "label": "结算汇率",
      "parent_id": ["port","tradeDate","bankAcct"],
      "df_func": "DefaultFxRateSettle",
      "tips":"交易(结算)货币/记账货币",
      "verify":"required|number"
    }
  ],
  "费用详情": [
    {
   "type": "formoption",
   "backcolor": "#f5f5f5",
   "hide_func": "",
   "formjson":"trade_fee_edit"
  },
  {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "expense",
          "label": "交易费用",
          "col_func":"tradeExpenseType"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户",
          "col_func":"bankAcctNameByActID"
        },
        {
          "colname": "tradeCurrency",
          "label": "交易货币",
          "col_func":"tradeCurrencyCode"
        },
        {
          "colname": "tableFeeCurrency",
          "label": "费用货币",
          "col_func":"feeCurrencyCode"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "expenseSettleDate",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["funcCurrency1", "tradeCurrency", "tableFeeCurrency"],
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":"totalExpense",
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "hidden",
              "label": "应收应付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "1"
            },
            {
              "type": "select",
              "id": "bankAccount",
              "label": "现金账户",
              "parent_id": ["secAcct"],
              "opt_func": "secCashList"
            },
            {
              "type": "select",
              "label": "交易货币",
              "id": "tradeCurrency3",
              "disabled": "yes",
              "opt_func": "currencyList",
              "df_func": "tradeCurrency"
            },
            {
		      "type": "select",
		      "id": "tableFeeCurrency",
		      "label": "费用货币",
		      "disabled": "yes",
		      "parent_id": ["bankAccount"],
		      "df_func": "bankAccountFeeCurrency",
		      "opt_func": "currencyList"
		    },
		    {
		      "type": "input",
		      "id": "fxRate",
		      "label": "交易汇率",
		      "parent_id": ["bankAccount","tradeCurrencys"],
		      "df_func": "DefaultFeeFxRateTrade",
		      "tips":"费用货币/记账货币",
              "verify":"required|number"
		    },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "label": "费用化金额"
            },
            {
              "type": "hidden",
              "id": "cashAmount",
              "label": "应收应付金额",
              "df_func":"round(cashAmount,0)"
            },
            {
              "type": "date",
              "label": "结转时间",
              "id": "expenseSettleDate"
            }
          ]
        }
      ]
    }
    ],
"操作": [

    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "stock_HK_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
