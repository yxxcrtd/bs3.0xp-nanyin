{
"jsonoptions": {
    "title": "新建"
  },
  "银行账户信息": [
    { "type": "input", "id": "acct", "label": "账户" ,"verify":"required"},
    {
      "type": "select",
      "disabled": "yes",
      "id": "bank_id",
      "label": "银行",
      "opt_func": "bankList",
      "disabled": "yes"
    },
    { "type": "input", "id": "code", "label": "机构代码" ,"verify":"required"},
    {
      "type": "br"
    },
    { "type": "input", "id": "desc", "label": "账户描述" ,"verify":"required"},
    {
      "type": "select",
      "label": "账户货币",
      "id": "currency",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "label": "状态",
      "id": "status",
      "opt_func": "bankAccountStatus"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "label": "结算货币",
      "id": "settlement",
      "opt_func": "settleCurrencyTypes"
    },
    {
      "type": "select",
      "id": "port",
      "label": "关联组合",
      "opt_func": "portShortList"
    },
    {
      "type": "select",
      "id": "interest",
      "label": "利息配置",
      "opt_func": "bankInterestListWithNo"
    },
    {
      "type": "br"
    },
    {
      "type": "checkbox",
      "id": "major",
      "label": "主账户",
      "opt_val":{
       "0":"是",
       "1":"否"},
      "df_val":"0",
      "verify":"required"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "bankAccountCreate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
