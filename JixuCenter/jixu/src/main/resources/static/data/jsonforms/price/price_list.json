{
	"toobar": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#fff"
		},
		{
			"type": "btngroup",
			"label": "<i class='iconfont icon-btn-filter'></i><span>&nbsp;&nbsp;筛选",
			"cb_func": "",
			"colwidth": "2",
			"id": "filterbtn",
			"buttons": [
				{
					"label": "<i class='iconfont icon-btn-filter'></i><span>&nbsp;&nbsp;筛选"
				},
				{
					"label": "<i class='iconfont icon-export'></i><span>&nbsp;&nbsp;导出",
					"color": "white",
					"cb_func":"voucherList",
					"cb_target":"export",
					"cb_export_source":"tableConnList"
				},
				{
				  "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
				  "cb_func": "",
				  "cb_target": "modal",
				  "cb_target_url": "price_new",
				  "cb_done_clickbtn":"priceListBtn"
				}
			]
		}
	],
	"行情": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#f5f5f5",
			"hide_func": ""
		},
		{
			  "type": "date",
			  "label": "开始日期",
			  "df_func":"returnDateControl",
			  "id": "start",
			  "verify":"required|date"
			},
			{
			  "type": "date",
			  "label": "结束日期",
			  "df_func":"returnDateControl",
			  "id": "end",
			  "verify":"required|date"
			},
			{ "type": "blank", "colwidth": "3" },
			{
			  "type": "button",
			  "label": "<i class='layui-icon layui-icon-search'></i>查询",
			  "id": "priceListBtn"
			},
			{
			  "type": "selecttab",
			  "label": "证券ID",
			  "id": "smf",
			  "opt_func": "newpriceShortList"
			}
	],
	"tabledata": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#fff",
			"hide_func": ""
		},
		{
			"id": "tableConnList",
			"type": "table",
			"pagedown": "true",
			"df_func": "priceList",
			"cb_func": "priceDetail",
		    "cb_target": "modal",
			"cb_target_url": "price_edit",
			"parent_id": ["priceListBtn"],
			"tablecols": [
				{
					"type": "checkbox"
				},
				{
				  "colname": "price_id",
				  "label": "价格代码",
				  "width":"150"
				},
				{
				  "colname": "source",
				  "label": "数据来源",
				  "width":"120"
				},
				{
				  "colname": "date",
				  "label": "日期",
				  "width":"100"
				},
				{
				  "colname": "secid",
				  "label": "证券代码",
				  "width":"100"
				},
				{
				  "colname": "security",
				  "label": "证券名称",
				  "width":"180"
				},
				{
				  "colname": "currency",
				  "label": "货币"
				},
				{
				  "colname": "price",
				  "label": "价格"
				},
				{
				  "colname": "yield",
				  "label": "收益率"
				},
				{
				  "colname": "priceto1",
				  "label": "定价基准"
				},
				{
				  "id": "daeditbtn",
				  "type": "button",
				  "label": "<i class='layui-icon layui-icon-edit'></i>",
				  "cb_func": "priceDetail",
				  "cb_target": "modal",
				  "cb_done_clickbtn":"priceListBtn",
				  "cb_target_url": "price_edit"
				},
				{
				  "type": "button",
				  "label": "<i class='layui-icon layui-icon-delete'></i>",
				  "cb_func": "priceRemove",
				  "cb_target": "message",
				  "cb_done_clickbtn":"priceListBtn",
				  "cb_done_action": "_delrow"
				}
			]
		}
	]
