{
"jsonoptions": {
    "title": "编辑"
  },
	"证券信息": [
		{
	      "type": "input",
	      "id": "trade_id",
	      "label": "交易编号",
	      "disabled": "yes"
	    },
	    {
			"type": "select",
			"label": "资产类型",
			"id": "assetType",
		    "disabled":"yes",
			"opt_func": "allAssets",
			"df_val": "60"
		},
		{
			"type": "selecttab",
			"label": "证券名称",
			"id": "secid",
			"opt_func": "newoptionSmfShortList",
            "verify":"required"
		},
		{
			"type": "select",
			"label": "交易类型",
			"id": "tradeType",
		    "disabled":"yes",
			"opt_func": "allTradeTypes",
			"df_val": "822"
		},
		{
			"type": "select",
			"label": "投资组合",
			"id": "port",
		    "disabled":"yes",
			"opt_func": "portShortList",
			"df_func": "port"
		},
		{
			"type": "select",
			"label": "市场类型",
			"id": "market",
			"opt_func": "tradeMarkets"
		},
		{
			"type": "select",
			"label": "基金经理",
			"id": "manager",
			"opt_func": "managersInPort"
		},
		{
	      "type": "select",
	      "id": "broker",
	      "label": "所属券商",
	      "parent_id": ["port"],
	      "opt_func": "brokerList"
	    },
	    {
	      "type": "select",
	      "id": "secAcct",
	      "label": "证券账户",
	      "parent_id": ["port"],
	      "opt_func": "secAcctListInPort"
	    },
	    {
	      "type": "select",
	      "id": "bankAcct",
	      "label": "现金账户",
	      "parent_id": ["secAcct"],
	      "opt_func": "secCashList"
	    }
	],
	"交易信息": [
		{
			"type": "date",
			"label": "交易日期",
			"id": "tradeDate",
            "df_func":"returnDateControl",
            "verify":"required|date"
		},
		{
			"type": "date",
			"label": "结算日期",
			"id": "settleDate",
            "df_func":"returnDateControl",
            "verify":"required|date"
		},
		{
			"type": "input",
			"id": "shares",
			"label": "份数",
			"df_func": "round(shares,2)",
			"verify":"required|number"
		},
		{
			"type": "hidden",
			"id": "price",
			"label": "价格"
		},
		{
	      "type": "hidden",
	      "id": "principal",
	      "label": "本金",
	      "parent_id": ["shares", "price"],
	      "df_func": "round(shares*price,2)"
	    },
		{
			"type": "hidden",
			"id": "accruedIncome",
			"label": "计提收入",
			"df_val": "0"
		},
		{
			"type": "hidden",
			"id": "totalExpense",
			"label": "费用总计",
			"df_func":"tablefee..totalAmount",
			"parent_id":["principal"]
		},
		{
			"type": "hidden",
			"id": "funcCurrency1",
			"label": "记账货币",
			"parent_id": [
				"port"
			],
			"disabled":"yes",
			"df_func": "portfolioCurrency",
			"opt_func": "currencyList"
		},
		{
			"type": "hidden",
			"id": "tradeCurrency",
			"label": "交易货币",
			"parent_id": [
				"secid"
			],
			"disabled":"yes",
			"df_func": "smfTradeCurrency",
			"opt_func": "currencyList"
		},
		{
			"type": "hidden",
			"id": "tradeCash",
			"disabled": "yes",
			"label": "交易金额",
			"parent_id": [
				"principal",
				"totalExpense"
			],
			"df_func": "principal+totalExpense"
		},
		{
			"type": "hidden",
			"id": "tradeFx",
			"label": "交易汇率",
			"df_val": "1"
		},
		{
			"type": "br"
		},
		{
			"type": "hidden",
			"id": "funcCurrency1",
			"label": "记账货币",
			"parent_id": [
				"port"
			],
			"disabled":"yes",
			"df_func": "portfolioCurrency",
			"opt_func": "currencyList"
		},
		{
			"type": "hidden",
			"id": "settleCurrency",
			"label": "结算货币",
			"parent_id": [
				"bankAcct"
			],
			"disabled":"yes",
			"df_func": "bankAccountCurrency",
			"opt_func": "currencyList"
		},
		{
			"type": "hidden",
			"id": "settleCash",
			"disabled": "yes",
			"label": "结算金额",
			"parent_id": [
				"principal",
				"totalExpense"
			],
			"df_func": "principal+totalExpense"
		},
		{
			"type": "hidden",
			"id": "settleFx",
			"label": "结算汇率",
			"df_val": "1"
		},
		{
			"id": "tablefee",
			"type": "hidden",
			"search": "yes",
			"df_func": "trade_FeeList",
			"parent_id": [
				"Trade_FeeListBtn"
			],
			"tablecols": [
				{
					"colname": "expense",
					"label": "交易费用"
				},
				{
					"colname": "rpType",
					"label": "应收应付"
				},
				{
					"colname": "funcCurrency",
					"label": "记账货币"
				},
				{
					"colname": "tradeCurrency",
					"label": "交易货币"
				},
				{
					"colname": "settleCurrency",
					"label": "费用货币"
				},
				{
					"colname": "fxRate",
					"label": "汇率"
				},
				{
					"colname": "totalAmount",
					"label": "费用|费率",
							"total":"yes"
				},
				{
					"colname": "expenseAmount",
					"label": "费用化金额",
							"total":"yes"
				},
				{
					"colname": "cashAmount",
					"label": "应收应付金额"
				},
				{
					"colname": "secAcct",
					"label": "证券账户"
				},
				{
					"colname": "bankAccount",
					"label": "现金账户"
				},
				{
					"colname": "settleDate",
					"label": "结转时间"
				},
				{
					"type": "button",
					"label": "删除",
					"cb_func": "",
					"cb_target": "message",
					"cb_done_action":"_delrow"
				},
				{
					"type": "button",
					"label": "编辑",
					"cb_func": ["funcCurrency1","tradeCurrency","settleCurrency"],
					"cb_done_action":"_updaterow",
					"cb_target_form": [
						{
							"type": "select",
							"label": "费用选择",
							"id": "expense",
							"opt_func": "gettradeExpenses",
							"df_val": "1"
						},
						{
							"type": "select",
							"label": "应收应付",
							"id": "rpType",
							"opt_func": "getexpenseRPType",
							"df_val": "0"
						},
						{
							"type": "select",
							"label": "记账货币",
							"id": "funcCurrency3",
							"disabled": "yes",
							"opt_func": "currencyList",
							"df_func": "funcCurrency1"
						},
						{
							"type": "select",
							"label": "交易货币",
							"id": "tradeCurrency3",
							"disabled": "yes",
							"opt_func": "currencyList",
							"df_func": "tradeCurrency"
						},
						{
							"type": "select",
							"label": "费用货币",
							"id": "settleCurrency3",
							"disabled": "yes",
							"opt_func": "currencyList",
							"df_func": "settleCurrency"
						},
						{
							"type": "input",
							"id": "fxRate",
							"df_val": "1",
							"label": "汇率"
						},
						{
							"type": "input",
							"id": "totalAmount",
							"label": "费用|费率"
						},
						{
							"type": "input",
							"id": "expenseAmount",
							"label": "费用化金额"
						},
						{
							"type": "br"
						},
						{
							"type": "input",
							"id": "cashAmount",
							"label": "应收应付金额"
						},
						{
							"type": "select",
							"id": "secAcct3",
							"label": "证券账户",
							"parent_id": [
								"port"
							],
							"opt_func": "secAcctListInPort"
						},
						{
							"type": "select",
							"id": "bankAccount",
							"label": "现金账户",
							"parent_id": [
								"secAcct"
							],
							"opt_func": "secCashList"
						},
						{
							"type": "date",
							"label": "结转时间",
							"id": "settleDate1"
						}
					]
				}
			]
		},
		{ "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "5" },
		{
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
	      "cb_func": "option_awarded_Update",
	      "cb_target": "message",
	      "cb_done_message": "提交成功",
	      "cb_done_action": "_closemodal",
	      "colwidth": "1"
	    },
	    {
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
	      "cb_func": "_closemodal",
	       "colwidth": "1" 
	    }
	]
}