{
  "货币基金证券信息": [
    {
      "type": "hidden",
      "label": "开始日期",
      "id": "start"
    },
    {
      "type": "hidden",
      "label": "结束日期",
      "id": "end"
    },
    {
      "type": "hidden",
      "label": "证券类型",
