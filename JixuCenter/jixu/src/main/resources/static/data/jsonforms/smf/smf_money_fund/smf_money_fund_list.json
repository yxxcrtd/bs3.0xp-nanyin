      "df_val": "17"
    },
    {
      "type": "input",
      "label": "证券名称/ID",
      "id": "smf"
    },
    { "type": "blank",
      "colwidth":"2"},

    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "smfListBtn"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "",
      "cb_target": "modal",
      "cb_target_url": "false",
      "cb_target_func": "newAssetForm"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "smf_money_fund_List",
      "pagedown":"true",
      "parent_id": ["smfListBtn"],
      "tablecols": [
        {
          "colname": "smf_id",
          "label": "数据编号"
        },
        {
          "colname": "assettype",
          "type":"hidden",
          "label": "资产类别"
        },
        {
          "colname": "secid",
          "label": "证券代码"
        },
        {
          "colname": "secname",
          "label": "证券名称"
        },
        {
          "colname": "industry",
          "type":"hidden",
          "label": "所属行业"
        },
        {
          "colname": "currency",
          "label": "货币"
        },
        {
          "colname": "countrycode",
          "label": "国家"
        },
        {
          "colname": "glgroupcode",
          "label": "总账组"
        },
        {
          "id": "daeditbtn",
