{
  "jsonoptions": {
    "title": "创建证券主文件",
    "formgroup": {
      "证券信息": "8",
      "币种信息": "4",
      "财务信息": "4",
      "操作": "2"
    }
  },
  "证券信息": [
    { "type": "input", "id": "secid", "label": "基金编号", "colwidth": "4" },
    { "type": "input", "id": "secname", "label": "基金名称", "colwidth": "4" },
    {
      "type": "select",
      "label": "证券类型",
      "id": "type",
      "opt_func": "allAssets",
      "df_val": "107",
      "colwidth": "4"
    },
    { "type": "br" },
    {
      "type": "selecttab",
      "label": "基金管理人",
      "id": "issuer",
      "opt_func": "issuerList",
      "colwidth": "4"
    },
    {
      "type": "select",
      "id": "country",
      "label": "所在国家",
      "df_val": "3",
      "opt_func": "countryList",
      "colwidth": "4"
    },
    {
      "type": "select",
      "id": "exchange",
      "label": "交易所",
      "df_val": "255",
      "opt_func": "exchangeList",
      "colwidth": "4"
    }
  ],

  "操作": [
    {
      "type": "button",
      "label": "创建",
      "cb_func": "smf_common_fund_Create",
      "cb_target": "message",
      "cb_done_message": "创建成功"
    },
    { "type": "blank", "colwidth": "12" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" },
    { "type": "hr" }
  ],
  "币种信息": [
    {
      "type": "select",
      "label": "成本货币",
      "id": "prcurrency",
      "df_val": "1",
      "opt_func": "currencyList",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "收入货币",
      "id": "incurrency",
      "df_val": "1",
      "opt_func": "currencyList",
      "colwidth": "6"
    }
  ],

  "财务信息": [
    {
      "type": "select",
      "label": "总账组",
      "id": "glgroup",
      "opt_func": "glListInCOA",
      "colwidth": "6"
    },
    {
      "type": "hidden",
      "df_val": "普通股"
    },
    {
      "type": "date",
      "id": "activeDate",
      "label": "生效时间",
      "colwidth": "6"
    }
  ]
}
