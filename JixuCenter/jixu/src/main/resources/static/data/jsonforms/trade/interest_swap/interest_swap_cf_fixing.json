{
"jsonoptions": {
    "title": "新建"
  },
  "固定利率现金流": [
    {
      "type": "hidden",
      "id": "cashflowcfg",
      "label": "ID",
      "disabled": "yes"
    },
        {
      "type": "hidden",
      "id": "cashflowcfg2",
      "label": "ID",
      "disabled": "yes"
    },
    {
      "type": "hidden",
      "id": "couponType",
      "label": "利率类型",
      "opt_func": "cfTypes",
      "df_func": "couponType"
    },
    {
      "type": "hidden",
      "id": "type",
      "label": "类型",
      "opt_func": "getexpenseRPType",
      "df_val":"0"
    },
    {
      "type": "input",
      "id": "couponRate",
      "label": "利率(%)",
      "verify": "required|number|percent"
    },
    {
      "type": "select",
      "label": "利率基础",
      "id": "dayCount",
      "opt_func": "expenseDayCount"
    },
    {
      "type": "select",
      "label": "付款频率",
      "id": "frequency",
      "opt_func": "swapCfFrequency"
    },
    {
      "type": "select",
      "label": "付款月份",
      "id": "paymentMonth",
      "parent_id": ["frequency"],
      "opt_func": "expenseMonth"
    },
    {
     "type": "input", 
     "label": "理论付款日", 
     "id": "paymentDay", 
     "parent_id":"frequency",
     "disable_func":"iif(frequency=expireFrequency,true,iif(frequency=scheduledFrequency,true,false))"
    },
    {
      "type": "date",
      "label": "起息日期",
      "id": "accurStartDate",
      "verify": "required|date",
      "df_func":"returnDateControl"
    },
    {
	      "type": "select",
	      "label": "计息方法",
	      "id": "interest_method",
	      "opt_val": {
	      		"1":"单利",
	      		"2":"复利"
	      },
	      "df_val": "1"
    },
    {
      "type": "hidden",
      "label": "自动结转本金?",
      "id": "autoFlag"
    },
    {
      "type": "hidden",
      "label": "自动结转利息?",
      "id": "autoInterestFlag"
    },
    {
      "type": "select",
      "label": "是否生效",
      "id": "status",
      "opt_func": "expenseStatus"
    },
    {
      "id": "tablePayInt",
      "type": "table",
      "search": "yes",
      "hide_func":"iif(frequency=scheduledFrequency,false,true)",
      "df_func": "cfPaymentDetail",
      "parent_id": ["frequency"],
      "tablecols": [
        {
          "colname": "settleDate",
          "label": "付息日期",
          "width":"1350"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": "",
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":"tablePayIntDate",
          "cb_target_form": [
            {
              "type": "date",
              "label": "付息日期",
              "id": "settleDate"
            }
          ]
        }
      ]
      },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "swap_cf_fixedCreate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_upelem":["cashflowcfg","cashflowcfg2"],
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
