{
"jsonoptions": {
    "title": "新建"
  },
  "基本信息": [
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "711"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "date",
      "label": "结算日期",
      "id": "settleDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    }
  ],
  "划拨信息": [
    {
      "type": "select",
      "id": "secAcct2",
      "label": "转出证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "转出现金账户",
      "parent_id": ["secAcct2"],
      "opt_func": "secCashList2"
    },
    {
      "type": "select",
      "id": "tradeCurrency2",
      "label": "转出货币",
      "parent_id": ["bankAcct2"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency2",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash2",
      "label": "转出金额",
      "df_func": "round(tradeCash,2)",
      "verify":"required|number"
    },
    {
      "type": "select",
      "id": "secAcct",
      "label": "转入证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "转入现金账户",
      "parent_id": ["secAcct"],
      "opt_func": "secCashList"
    },
    {
      "type": "select",
      "id": "tradeCurrency",
      "label": "转入货币",
      "parent_id": ["bankAcct"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "label": "转入金额",
      "df_func": "round(tradeCash2,2)",
      "verify":"required|number"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "cashMove_new",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
