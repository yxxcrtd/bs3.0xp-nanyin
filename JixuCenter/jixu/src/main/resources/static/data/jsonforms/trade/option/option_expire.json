{
"jsonoptions": {
    "title": "新建"
  },
  "证券信息":[
		{
	      "type":"select",
		  "label":"资产类型",
		  "id":"assetType",
		  "opt_func":"allAssets",
		  "df_val":"60"
	    },
		{
		  "type": "selecttab",
	      "label": "证券名称",
	      "id":"secid",
	      "opt_func":"newoptionSmfShortList",
          "verify":"required"				
		},
        {
	      "type":"select",
		  "label":"交易类型",
		  "id":"tradeType",
		  "opt_func":"allTradeTypes",
		  "disabled":"yes",
		  "df_val":"825"
	    },
		{
	      "type":"select",
		  "label":"投资组合",
		  "id":"port",
		  "opt_func":"portShortList",
		  "df_func":"port"
	    },
        {
	      "type":"select",
		  "label":"市场类型",
		  "id":"market",
		  "opt_func":"tradeMarkets"
	    },
        {
	      "type":"select",
		  "label":"基金经理",
		  "id":"manager",
		  "opt_func":"managersInPort"
	    },
	    { "type":"select",
          "id": "broker",
          "label": "所属券商",
          "parent_id": ["port"],
          "opt_func":"brokerList"
        },
        { "type":"select",
          "id": "secAcct",
          "label": "证券账户",
	      "parent_id": ["port"],
          "opt_func":"secAcctListInPort"
        },
        { "type":"select",
          "id": "bankAcct",
          "label": "现金账户",
	      "parent_id": ["secAcct"],
          "opt_func":"secCashList"
        }
  ],
  "交易信息":[
        {
	  	  "type":"date",
		  "label":"交易日期",
		  "id":"tradeDate",
          "df_func":"returnDateControl",
          "verify":"required|date"
	  	},
	  	{
	  	  "type":"date",
		  "label":"结算日期",
		  "id":"settleDate",
          "df_func":"returnDateControl",
          "verify":"required|date"
	  	},
	  	{ "type":"input",
          "id": "shares",
          "label": "放弃份数",
          "parent_id": ["secid","secAcct"],
          "df_func": "round(option_exercisePosition..shares,2)",
		  "verify":"required|number"
        },
        { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "5" },
		{
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
	      "cb_func": "option_expire_Create",
	      "cb_target": "message",
	      "cb_done_message": "提交成功",
	      "cb_done_action": "_closemodal",
	      "colwidth": "1"
	    },
	    {
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
	      "cb_func": "_closemodal",
	       "colwidth": "1" 
	    }
 ]
}