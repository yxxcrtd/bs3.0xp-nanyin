{
"jsonoptions": {
    "title": "编辑"
  },
  "证券信息":[
        {
  		  "type":"input",
          "id": "smf_id",
          "label": "期货ID",
          "disabled":"yes"
		},
		{ "type":"input",
          "id": "secid",
          "label": "证券主ID",
          "verify":"required"
        },
        { "type":"input",
          "id": "secname",
          "label": "证券名称",
          "verify":"required"
        },
         {
	      "type":"select",
		  "label":"证券类型",
		  "id":"type",
		  "disabled":"yes",
		  "opt_func":"allAssets",
		  "df_val":"F30"
	    },
        {
		  "type": "selecttab",
	      "label": "发行商",
	      "id":"issuer",
	      "opt_func":"issuerList",
          "verify":"required"				
		},
		{
			"type":"select",
			"id":"exchange",
			"label":"交易所",
			"opt_func":"futuresExchanges"
						
		},
		{
	      "type":"select",
		  "label":"期货类型",
		  "id":"futuresType",
		  "parent_id": ["exchange"],
		  "opt_func":"futuresList"
	    },
	    {
	      "type":"select",
		  "label":"合约标的",
		  "id":"futuresTarget",
		  "parent_id": ["exchange","futuresType"],
		  "opt_func":"futuresTargets"
	    },
	    { "type":"input",
          "id": "secContractSize",
          "label": "合约乘数",
          "verify":"required|number"
        },
        {
	      "type":"select",
		  "label":"报价单位",
		  "id":"futuresPriceUnit",
		  "opt_func":"futuresPriceUnits"
	    },
		 { "type":"input",
          "id": "marginRate",
          "label": "保证金(%)",
          "verify":"required|number|percent"
        },
        {
	  	  "type":"date",
		  "label":"合约到期",
		  "id":"secExpireDate",
		  "df_func":"returnDateControl",
          "verify":"required|date"
	  	},
        {
			"type":"select",
			"id":"country",
			"label":"所在国家",
			"opt_func":"countryList"
		}
		
  ],
  "币种信息":[
		{
			"type":"select",
			"label":"成本货币",
			"id":"prcurrency",
			"opt_func":"currencyList"
		},
		{
			"type":"select",
			"label":"收入货币",
			"id":"incurrency",
			"opt_func":"currencyList"
		}
  ],
  "财务信息":[
        {
			"type":"select",
			"label":"总账组",
			"id":"glgroup",
			"opt_func":"glListInCOA"
		},
		{
      "type": "select",
      "label": "资产类别",
      "id": "assetType",
      "opt_func": "newAssets",
      "parent_id":"type"
    },
    {
      "type": "select",
      "label": "资产主类别",
      "id": "assetMajor",
      "opt_func": "newMajorAsset",
      "parent_id":"assetType"
    },
    {
      "type": "select",
      "label": "资产次类别",
      "id": "assetMinor",
      "opt_func": "newMinorAsset",
      "parent_id":"assetType"
    },
        {
			"type":"date",
            "id": "activeDate",
            "label": "生效时间",
          "verify":"required|date"
		},
		{ "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
        { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "12" },
	    { "type": "br" },
	    { "type": "blank", "colwidth": "5" },
		{
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
	      "cb_func": "smf_futuresUpdate",
	      "cb_target": "message",
	      "cb_done_message": "提交成功",
	      "cb_done_action": "_closemodal",
	      "colwidth": "1"
	    },
	    {
	      "type": "button",
	      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
	      "cb_func": "_closemodal",
	       "colwidth": "1" 
	    }
 ]
}