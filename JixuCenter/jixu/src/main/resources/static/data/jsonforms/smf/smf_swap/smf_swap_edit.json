    },
    {
      "type": "select",
      "id": "country",
      "label": "所在国家",
      "df_val": "3",
      "opt_func": "countryList"
    },
    {
      "type": "select",
      "id": "exchange",
      "label": "交易所",
      "df_val": "255",
      "opt_func": "exchangeList"
    }
  ],
"财务信息": [
    {
      "type": "select",
      "label": "收入币种",
      "id": "tradeCurrency",
      "df_val": "1",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "label": "支出币种",
      "id": "tradeCurrency2",
      "df_val": "1",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "label": "总账组",
      "id": "glgroup",
      "opt_func": "glListInCOA"
    },
    {
      "type": "hidden",
      "df_val": "普通股"
    },
    {
      "type": "date",
      "id": "activeDate",
      "label": "生效时间"
    }
  ],
  "现金流信息": [
    {
      "type": "input",
      "id": "cashflowcfg",
      "label": "收入现金流",
      "disabled":"yes"
    },
    {
      "type": "button",
