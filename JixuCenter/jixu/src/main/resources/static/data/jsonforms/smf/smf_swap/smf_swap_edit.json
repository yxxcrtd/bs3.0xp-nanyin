{
  "证券信息": [
    {
  		  "type":"input",
          "id": "smf_id",
          "label": "互换ID",
          "disabled":"yes"
		},
	{ "type": "input", "id": "secid", "label": "证券主ID" },
    {
      "type": "select",
      "label": "证券类型",
      "id": "type",
