      "cb_target_func": "cfURL"
    },
    {
      "type": "input",
      "id": "cashflowcfg",
      "label": "支出现金流",
      "disabled":"yes"
    },
    {
      "type": "button",
      "label": "现金流配置",
      "cb_func": "couponType2",
      "cb_target": "modal",
      "cb_target_func": "cfURL2"
    },
    {
      "type": "button",
      "label": "创建",
      "cb_func": "smf_stockCreate",
      "cb_target": "message",
      "cb_done_message": "创建成功"
    }
  ]
