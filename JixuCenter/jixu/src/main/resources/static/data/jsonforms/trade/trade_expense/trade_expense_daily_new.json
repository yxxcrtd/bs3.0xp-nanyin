{
"jsonoptions": {
    "title": "新建"
  },
  "费用详情": [
    { "type": "input", "id": "expense_name", "label": "费用名称" ,"verify":"required"},
    {
      "type": "select",
      "label": "费用类型",
      "id": "expense_type",
      "disabled": "yes",
      "opt_func": "expenseTypes",
      "df_val": "1"
    },
    {
      "type": "input",
      "id": "expenseRatio",
      "label": "费用比例%",
      "disabled": "yes"
    },
    {
      "type": "input",
      "id": "cashRatio",
      "label": "现金比例%",
      "disabled": "yes"
    },
    {
      "type": "select",
      "label": "成本总账栏",
      "id": "principalGL",
      "opt_func": "glColList",
      "df_val": "1"
    },
    {
      "type": "select",
      "label": "费用总账栏",
      "id": "expenseGL",
      "opt_func": "glColList",
      "df_val": "1"
    },
    {
      "type": "select",
      "label": "清算总账栏",
      "id": "settleGL",
      "opt_func": "glColList",
      "df_val": "1"
    },
    {
      "type": "select",
      "label": "收付总账栏",
      "id": "rcpyGL",
      "opt_func": "glColList",
      "df_val": "1"
    },
    {
      "type": "select",
      "label": "费率类型",
      "id": "rateType",
      "opt_func": "expenseRateTypes",
      "df_val": "1"
    }
  ],
  "现金流详情": [
    {
      "type": "select",
      "label": "计提基础",
      "id": "basis",
      "opt_func": "accrualBasis",
      "df_val": "1"
    },
    { "type": "input", "label": "计提开始(T+N)", "id": "accrStartN" ,"verify":"number","df_val":"0"},
    {
      "type": "select",
      "label": "日期类型",
      "id": "accrStartType0",
      "opt_func": "repoPaymentDateOptions",
      "df_val": "1"
    },

    { "type": "input", "label": "费率(%)", "id": "contractRate" ,"verify":"required|number|percent"},
    {
      "type": "select",
      "label": "日计数方法",
      "id": "dayCount",
      "opt_func": "expenseDayCount",
      "df_val": "65"
    },
    {
      "type": "select",
      "label": "付款频率",
      "id": "frequency",
      "opt_func": "expenseFrequency",
      "df_val": "65"
    },
    {
      "type": "select",
      "label": "付款月份",
      "id": "paymentMonth",
      "parent_id": ["frequency"],
      "opt_func": "expenseMonth"
    },
    { "type": "input", "label": "付款日", "id": "paymentDay", "parent_id":"frequency","disable_func":"iif(frequency=66,true,false)","verify":"required|number" },
    {
      "type": "select",
      "label": "日期类型",
      "id": "accrStartType1",
      "opt_func": "repoPaymentDateOptions",
      "df_val": "1"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": ["expense_cfCreate", "expenseCreate"],
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
