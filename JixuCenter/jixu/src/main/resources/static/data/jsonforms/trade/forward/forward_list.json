	"远期换汇": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#f5f5f5",
			"hide_func": ""
		},
		{
		  "type": "hidden",
		  "label": "客户",
		  "id": "client",
		  "opt_func": "clientList",
		  "df_val": "21"
		},
		{
		  "type": "selecttab",
		  "label": "投资组合",
		  "id": "port",
		  "opt_func": "portShortList"
		},
		{
		  "type": "date",
		  "label": "开始日期",
		  "id": "start"
		},
		{
		  "type": "blank",
		  "colwidth": "3"
		},
		{
		  "type": "button",
		  "label": "<i class='layui-icon layui-icon-search'></i>查询",
		  "id": "Trade_forwardListBtn",
		  "colwidth": "1"
		},
        {
		  "type": "hidden",
		  "label": "证券类型",
		  "id": "porttype",
		  "opt_func": "portAssets",
		  "df_val": "F12"
		},
		{
		  "type": "date",
		  "label": "结束日期",
		  "id": "end"
		},
		{ "type": "hidden", "id": "smf", "label": "证券名称/ID" },
		{
		  "type": "hidden",
		  "label": "显示已删除交易",
		  "id": "displayDelete",
		  "colwidth": "2"
		}
	],
	"tabledata": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#fff",
			"hide_func": ""
		},
		{
			"id": "tableConnList",
			"type": "table",
			"pagedown": "true",
			"df_func": "Trade_forwardList",
			"cb_func": ["port", "tradeDetail"],
			"cb_target": "modal",
			"cb_target_func": "newTradeForm",
			"parent_id": [
				"Trade_forwardListBtn"
			],
			"tablecols": [
				{
					"type": "checkbox"
				},
				{
				  "colname": "trade_id",
				  "label": "交易代码"
				},
				{
				  "colname": "portname",
				  "label": "投资组合"
				},
				{
				  "colname": "tradetypeCode",
				  "type": "hidden",
				  "label": "交易编码"
				},
				{
				  "colname": "tradeTypes",
				  "label": "交易类型"
				},
				{
				  "colname": "status",
				  "type":"hidden",
				  "label": "过账状态"
				},
				{
				  "colname": "tradedate",
				  "label": "交易时间",
				  "sort": "true"
				},
				{
				  "colname": "settledate",
				  "label": "结算时间",
				  "sort": "true"
				},
				{
				  "colname": "counterparty",
				  "label": "对手方"
				},
				{
				  "colname": "tradeCash",
				  "label": "多方金额"
				},
				{
				  "colname": "longCurrency1",
				  "label": "多方货币"
				},
				{
				  "colname": "tradeCash2",
				  "label": "空方金额"
				},
				{
				  "colname": "shortCurrency1",
				  "label": "空方货币"
				},
				{
				  "id": "daeditbtn",
				  "type": "button",
				  "label": "<i class='layui-icon layui-icon-edit'></i>",
				  "cb_func": ["port", "tradeDetail"],
				  "cb_target": "modal",
				  "cb_target_func": "newTradeForm"
				},
				{
				  "type": "button",
				  "label": "<i class='layui-icon layui-icon-delete'></i>",
				  "cb_func": "tradeRemove",
				  "cb_target": "message",
				  "cb_done_clickbtn":"Trade_forwardListBtn",
				  "cb_done_action": "_delrow"
				}
      ]
    }
  ]
