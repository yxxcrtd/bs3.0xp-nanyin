{
  "证券信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "17"
    },
    {
      "type": "selecttab",
      "label": "证券名称",
      "id": "secid",
      "disabled": "yes",
      "opt_func": "newSmfShortList"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeTypes",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "801"
    },
    { "type": "br" },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "select",
      "label": "市场类型",
      "id": "market",
      "opt_func": "tradeMarkets",
      "df_val": "1"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort",
      "df_val": "11"
    },
    {
      "type": "select",
      "id": "broker",
      "label": "所属券商",
      "parent_id": ["port"],
      "opt_func": "brokerList"
    },
    { "type": "br" },
    {
      "type": "select",
      "id": "secAcct",
      "label": "证券账户",
      "parent_id": ["port"],
      "opt_func": "secAcctListInPort"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "现金账户",
      "parent_id": ["secAcct"],
      "opt_func": "secCashList"
    }
  ],
  "交易信息": [
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate"
    },
    {
      "type": "date",
      "label": "结算日期",
      "id": "settleDate"
    },
    { "type": "input", "id": "shares", "label": "份数" },
    { "type": "input", "id": "price", "label": "价格" },
    { "type": "br" },
    {
      "type": "input",
      "id": "principal",
      "label": "本金",
      "parent_id": ["shares", "price"],
      "df_func": "round(shares*price,2)"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "费用总计",
      "df_func": "tablefee..totalAmount",
      "parent_id": ["principal"]
    }
  ],
  "结算信息": [
    {
      "type": "select",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "id": "tradeCurrency",
      "label": "交易货币",
      "parent_id": ["secid"],
      "disabled": "yes",
      "df_func": "smfTradeCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "disabled": "yes",
      "label": "交易金额",
      "parent_id": ["principal", "totalExpense"],
      "df_func": "principal-totalExpense"
    },
    {
      "type": "input",
      "id": "tradeFx",
      "label": "交易汇率",
      "df_val": "1"
    },
    {
      "type": "br"
    },
    {
      "type": "select",
      "id": "funcCurrency1",
      "label": "记账货币",
      "parent_id": ["port"],
      "disabled": "yes",
      "df_func": "portfolioCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "select",
      "id": "settleCurrency",
      "label": "结算货币",
      "parent_id": ["bankAcct"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "settleCash",
      "disabled": "yes",
      "label": "结算金额",
      "parent_id": ["principal", "totalExpense"],
      "df_func": "principal-totalExpense"
    },
    {
      "type": "input",
      "id": "settleFx",
      "label": "结算汇率",
      "df_val": "1"
    }
  ],
  "费用详情": [
    {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "Expensescode",
          "label": "费用编号"
        },
        {
          "colname": "expense",
          "label": "交易费用"
        },
        {
          "colname": "rpType",
          "label": "应收应付"
        },
        {
          "colname": "funcCurrency",
          "label": "记账货币"
        },
        {
          "colname": "tradeCurrency",
          "label": "交易货币"
        },
        {
          "colname": "settleCurrency",
          "label": "费用货币"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "cashAmount",
          "label": "应收应付金额"
        },
        {
          "colname": "secAcct",
          "label": "证券账户"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户"
        },
        {
          "colname": "settleDate",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "删除",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "编辑",
          "cb_func": ["funcCurrency1", "tradeCurrency", "settleCurrency"],
          "cb_done_action": "_updaterow",
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "select",
              "label": "应收应付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "0"
            },
            {
              "type": "select",
              "label": "记账货币",
              "id": "funcCurrency3",
              "disabled": "yes",
              "opt_func": "currencyList",
              "df_func": "funcCurrency1"
            },
            {
              "type": "select",
              "label": "交易货币",
              "id": "tradeCurrency3",
              "disabled": "yes",
              "opt_func": "currencyList",
              "df_func": "tradeCurrency"
            },
            {
              "type": "select",
              "label": "费用货币",
              "id": "settleCurrency3",
              "disabled": "yes",
              "opt_func": "currencyList",
              "df_func": "settleCurrency"
            },
            {
              "type": "input",
              "id": "fxRate",
              "df_val": "1",
              "label": "汇率"
            },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "label": "费用化金额"
            },
            {
              "type": "br"
            },
            {
              "type": "input",
              "id": "cashAmount",
              "label": "应收应付金额"
            },
            {
              "type": "select",
              "id": "secAcct3",
              "label": "证券账户",
              "parent_id": ["port"],
              "opt_func": "secAcctListInPort"
            },
            {
              "type": "select",
              "id": "bankAccount",
              "label": "现金账户",
              "parent_id": ["secAcct"],
              "opt_func": "secCashList"
            },
            {
              "type": "date",
              "label": "结转时间",
              "id": "settleDate1"
            }
          ]
        }
      ]
    },
    {
      "type": "br"
    },
    {
      "type": "hr"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "money_fund_tradeUpdate",
      "cb_target": "message",
      "cb_done_message": "保存成功"
    }
  ]
}
