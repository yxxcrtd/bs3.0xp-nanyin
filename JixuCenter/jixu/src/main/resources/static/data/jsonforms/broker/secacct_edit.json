{
"jsonoptions": {
    "title": "编辑"
  },
  "证券账户信息": [
    { "type": "input", "id": "secacct_id", "label": "编号", "disabled": "yes" },
    { "type": "input", "id": "acct", "label": "账户名称","verify":"required" },
    {
      "type": "select",
      "disabled": "yes",
      "id": "broker_id",
      "label": "所属券商",
      "opt_func": "allBrokers", 
      "disabled": "yes"
    },
    { "type": "br" },
    { "type": "input", "id": "code", "label": "机构代码" ,"verify":"required"},
    { "type": "input", "id": "desc", "label": "账户描述" },
    {
      "type": "select",
      "id": "port",
      "label": "关联组合",
      "opt_func": "portShortList", 
      "disabled": "yes"
    },
    { "type": "br" },
    { "type": "select", "id": "gl", "label": "总账组", "opt_func": "glList" },
    {
      "type": "checkbox",
      "label": "是否为主账户",
      "opt_val":{
       "0":"是",
       "1":"否"},
      "df_val":"0",
      "id": "majorAcct"
    },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "12" },
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "secAcctUpdate",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ],
  "关联现金账户": [
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-search'></i>查询",
      "id": "secCashResearchBtn",
      "cb_func": ""
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
      "cb_func": "secacct_id",
      "cb_target": "modal",
      "cb_modal_size":"m",
      "cb_target_url": "seccash_new",
      "cb_done_clickbtn":"secCashResearchBtn"
    },
    {
      "id": "tableConnList",
      "type": "table",
      "df_func": "secCashDetailList",
      "parent_id": ["secCashResearchBtn"],
      "tablecols": [
        {
          "colname": "seccash_id",
          "label": "编号",
          "width":"300"
        },
        {
          "colname": "seccash_bank1",
          "label": "银行",
          "width":"300"
        },
        {
          "colname": "seccash_bankAccount1",
          "label": "银行账户",
          "width":"350"
        },
        {
          "colname": "seccash_type1",
          "label": "账户类型",
          "width":"350"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "secCashRemove",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        }
      ]
    }
  ]
}
