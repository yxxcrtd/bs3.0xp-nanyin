{
"jsonoptions": {
    "title": "新建"
  },
  "基本信息": [
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "fxAssets",
      "df_val": "F12"
    },
    {
      "type": "input",
      "id": "secid",
      "label": "合约编号",
      "verify":"required"
    },
    {
      "type": "input",
      "id": "contract",
      "label": "合约名称",
      "verify":"required"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "407"
    },
    {
      "type": "input",
      "id": "counterparty",
      "label": "交易对手方",
      "verify":"required"
    },
    {
      "type": "select",
      "id": "broker",
      "label": "券商",
      "parent_id": ["port"],
      "opt_func": "brokerList"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort"
    },
    {
      "type": "select",
      "label": "估值方法",
      "id": "valuationMethod",
      "opt_func": "valuationMethods"
    },
    {
      "type": "select",
      "label": "估值方向",
      "id": "valuationSide",
      "opt_func": "valuationSides",
      "df_val": "1"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "date",
      "label": "合约到期日",
      "id": "settleDate",
      "df_func":"returnDateControl",
      "verify":"required|date"
    },
    {
      "type": "select",
      "label": "交易目的",
      "id": "purpose",
      "opt_func": "",
      "df_val": "0",
      "opt_val": {
        "0": "投机",
        "1": "套期保值"
      }
    }
  ],
  "多空头信息": [
    {
      "type": "select",
      "id": "bankAcct",
      "label": "多头现金账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList"
    },
    {
      "type": "select",
      "id": "longCurrency",
      "label": "多头货币",
      "parent_id": ["bankAcct"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash",
      "label": "多头金额",
      "df_func": "round(tradeCash,2)",
      "verify":"required|number"
    },
    {
      "type": "input",
      "id": "longFX",
      "label": "多头合约汇率",
      "parent_id": ["tradeCash2", "tradeCash"],
      "tips":"多头货币/空头货币",
      "df_func": "longCalcFxRate..longFX"
    },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "空头现金账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList"
    },
    {
      "type": "select",
      "id": "shortCurrency",
      "label": "空头货币",
      "parent_id": ["bankAcct2"],
      "disabled": "yes",
      "df_func": "bankAccountCurrency2",
      "opt_func": "currencyList"
    },
    {
      "type": "input",
      "id": "tradeCash2",
      "label": "空头金额",
      "df_func": "round(tradeCash2,2)",
      "verify":"required|number"
      
    },
    {
      "type": "input",
      "id": "shortFX",
      "label": "空头合约汇率",
      "parent_id": ["tradeCash", "tradeCash2"],
      "tips":"空头货币/多头货币",
      "df_func": "shortCalcFxRate..longFX"
    }
  ],
  "其他信息": [
    {
      "type": "hidden",
      "label": "总账组",
      "id": "glgroup",
      "opt_func": "glListInCOA",
      "parent_id": ["bankAcct2"],
      "disabled": "yes",
      "df_func": "getForwardGlGroup"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses",
      "parent_id": ["totalExpense"]
    },
    {
      "type": "input",
      "id": "totalExpense2",
      "label": "不随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses2",
      "parent_id": ["totalExpense2"]
    }
  ],
  "费用详情": [
    {
   "type": "formoption",
   "backcolor": "#f5f5f5",
   "hide_func": "",
   "formjson":"trade_fee"
  },
  {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "expense",
          "label": "交易费用",
          "col_func":"tradeExpenseType"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户",
          "col_func":"bankAcctNameByActID"
        },
        {
          "colname": "feeTradeCurrency",
          "label": "交易货币",
          "col_func":"tradeCurrencyCode"
        },
        {
          "colname": "tableFeeCurrency",
          "label": "费用货币",
          "col_func":"feeCurrencyCode"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "cashAmount",
          "label": "应收应付金额",
          "total": "yes"
        },
        {
          "colname": "expenseSettleDate",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["incurrency"],
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":"totalExpense",
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "hidden",
              "label": "应收应付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "0"
            },
            {
		      "type": "select",
		      "id": "bankAccount",
		      "label": "费用现金账户",
		      "parent_id": ["port"],
		      "opt_func": "portfolioAccountShortList"
		    },
            {
              "type": "select",
              "label": "交易货币",
              "id": "feeTradeCurrency",
              "opt_func": "currencyList"
            },
            {
		      "type": "select",
		      "id": "tableFeeCurrency",
		      "label": "费用货币",
		      "disabled": "yes",
		      "parent_id": ["bankAccount"],
		      "df_func": "bankAccountFeeCurrency",
		      "opt_func": "currencyList"
		    },
		    {
		      "type": "input",
		      "id": "fxRate",
		      "label": "交易汇率",
		      "parent_id": ["bankAccount","feeTradeCurrency"],
		      "df_func": "DefaultFeeFxRateTrade",
		      "tips":"费用货币/记账货币",
              "verify":"required|number"
		    },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "label": "费用化金额"
            },
            {
              "type": "input",
              "id": "cashAmount",
              "label": "应收应付金额"
            },
            {
              "type": "date",
              "label": "结转时间",
              "id": "expenseSettleDate"
            }
          ]
        }
      ]
    }
    ],
"操作": [
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
	{
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "forward_open_Create",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
