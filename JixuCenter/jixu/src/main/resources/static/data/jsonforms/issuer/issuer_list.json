					"cb_export_source":"tableConnList"
				},
				{
				  "label": "<i class='layui-icon layui-icon-add-circle'></i>新建",
				  "cb_func": "",
				  "cb_target": "modal",
				  "cb_target_url": "issuer_new",
				  "cb_done_clickbtn":"issuerSearchBtn"
				}
			]
		}
	],
	"发行商": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#f5f5f5",
			"hide_func": ""
		},
		{
		  "id": "issuer_filter",
		  "type": "hidden",
		  "label": "发行商名称",
		  "df_val":""
		},
		{
		  "type": "blank",
		  "colwidth": "11"
		},
		{
		  "type": "button",
		  "label": "<i class='layui-icon layui-icon-search'></i>查询",
		  "id": "issuerSearchBtn"
		}
	],
	"tabledata": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#fff",
			"hide_func": ""
		},
		{
			"id": "tableConnList",
			"type": "table",
			"pagedown": "true",
			"page": 200,
			"df_func": "newIssuers",
			"parent_id": ["issuer_filter", "issuerSearchBtn"],
			"tablecols": [
				{
					"type": "checkbox"
				},
				{
				  "colname": "issuer_id",
				  "label": "发行商代码",
				  "width":"300"
				},
				{
				  "colname": "name",
				  "label": "发行商名称",
				  "width":"400"
				},
				{
				  "colname": "lname",
				  "label": "发行商长名",
				  "width":"400"
				},
				{
				  "colname": "country",
				  "label": "国家",
				  "col_func":"countryCode",
				  "width":"300"
				},
				{
				  "id": "daeditbtn",
