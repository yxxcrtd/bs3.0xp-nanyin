				  "label": "<i class='layui-icon layui-icon-edit'></i>",
				  "cb_func": "",
				  "cb_target": "modal",
				  "cb_target_url": "issuer_edit",
				  "cb_done_clickbtn":"issuerSearchBtn"
				},
				{
				  "type": "button",
				  "label": "<i class='layui-icon layui-icon-delete'></i>",
				  "cb_func": "issuerRemove",
				  "cb_target": "message",
				  "cb_done_action": "_delrow",
				  "cb_done_clickbtn":"issuerSearchBtn"
				}
			]
		}
