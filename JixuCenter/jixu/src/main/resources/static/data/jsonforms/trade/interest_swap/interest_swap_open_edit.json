{
  "jsonoptions": {
    "title": "编辑",
    "formgroup": {
      "合约信息": "12",
      "收入端信息": "6",
      "支出端信息": "6",
      "费用详情": "12",
      "操作": "12"
    }
  },
  "合约信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "F14",
      "colwidth": "4"
    },
    { "type": "input", "id": "secid", "label": "合同编号","disabled": "yes","verify": "required","colwidth": "4"},
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "750",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "基金经理",
      "id": "manager",
      "opt_func": "managersInPort",
      "colwidth": "4"
    },
    {
      "type": "hidden",
      "id": "broker",
      "label": "交易对手方",
      "parent_id": ["port"],
      "opt_func": "brokerList",
      "colwidth": "4"
    },
    {
      "type": "select",
      "id": "valuationMethod",
      "label": "核算方法",
      "opt_func": "valuationMethods",
      "colwidth": "4"
    },
    {
      "type": "select",
      "id": "purpose",
      "label": "交易目的",
      "opt_val": {
        "0": "投机",
        "1": "对冲风险"
      },
      "df_val": "0",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "结算日期",
      "id": "settleDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "到期时间",
      "id": "maturityDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "input",
      "id": "totalExpense",
      "label": "随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses",
      "parent_id": ["totalExpense"],
      "colwidth": "4"
    },
    {
      "type": "input",
      "id": "totalExpense2",
      "label": "不随交易支付费用合计",
      "disabled":"yes",
      "df_func": "calcTradeExpenses2",
      "parent_id": ["totalExpense2"],
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "总账组",
      "id": "glgroup",
      "opt_func": "glListInCOA",
      "df_val":"165",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "面额互换",
      "id": "swapExchangeInd",
      "opt_func": "swapSetPrincipalType",
      "colwidth": "4"
    }
  ],
  "收入端信息": [
    {
      "type": "input",
      "id": "principal",
      "label": "收入端本金",
      "df_func": "principal2",
      "parent_id": ["principal2"],
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "couponType",
      "label": "利率类型",
      "opt_func": "cfTypes",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "couponRate",
      "label": "利率",
      "disabled": "yes",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "base",
      "label": "利率基础",
      "opt_val": {},
      "disabled": "yes",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "factor",
      "label": "利差",
      "disabled": "yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "收入端银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "select",
      "label": "收入币种",
      "id": "incurrency",
      "parent_id": ["bankAcct"],
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "tradeFX",
      "label": "收入端汇率",
      "parent_id": ["port","tradeDate","bankAcct"],
      "df_func": "DefaultFxRate",
      "verify": "required|number",
      "tips":"收入币种/产品本位币",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "cashflowcfg",
      "label": "收入现金流",
      "disabled": "yes",
      "colwidth": "6"
    },
    { "type": "blank", "colwidth": "1" },
    {
      "type": "button",
      "label": "现金流配置",
      "cb_func": "couponType",
      "cb_target": "modal",
      "cb_target_func": "cfURL",
      "colwidth": "2",
      "cb_done_upelem": ["cashflowcfg","couponRate","base","factor"]
    },
    {
      "type": "button",
      "label": "更新现金流",
      "cb_func": ["couponType","cashflowcfg","couponRate","cfDetail"],
      "cb_target": "modal",
      "cb_target_func": "cfURLUPDATE",
      "colwidth": "2",
      "cb_done_upelem": ["cashflowcfg","couponRate","base","factor"]
    }
  ],

  "支出端信息": [
    {
      "type": "input",
      "id": "principal2",
      "label": "支出端本金",
      "df_func": "principal",
      "parent_id": ["principal"],
      "verify": "required|number",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "couponType2",
      "label": "利率类型",
      "opt_func": "cfTypes",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "couponRate2",
      "label": "利率",
      "disabled": "yes",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "base2",
      "label": "利率基础",
      "opt_val": {},
      "disabled": "yes",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "factor2",
      "label": "利差",
      "disabled": "yes",
      "colwidth": "6"
    },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "支出端银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "select",
      "label": "支出币种",
      "id": "incurrency2",
      "parent_id": ["bankAcct2"],
      "df_func": "bankAccountCurrency2",
      "opt_func": "currencyList",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "tradeFX2",
      "label": "支出端汇率",
      "parent_id": ["port","tradeDate","bankAcct2"],
      "df_func": "DefaultFxRate2",
      "verify": "required|number",
      "tips":"支出货币/产品本位币",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "cashflowcfg2",
      "label": "支出现金流",
      "disabled": "yes",
      "colwidth": "6"
    },
    { "type": "blank", "colwidth": "1" },
    {
      "type": "button",
      "label": "现金流配置",
      "cb_func": "couponType2",
      "cb_target": "modal",
      "cb_target_func": "cfURL2pay",
      "colwidth": "2",
      "cb_done_upelem": ["cashflowcfg2","couponRate2","base2","factor2"]
    },
    {
      "type": "button",
      "label": "更新现金流",
      "cb_func": ["couponType2","cashflowcfg2","couponRate2","cfDetail2"],
      "cb_target": "modal",
      "cb_target_func": "cfURL2payUPDATE",
      "colwidth": "2",
      "cb_done_upelem": ["cashflowcfg2","couponRate2","base2","factor2"]
    }
  ],
  "费用详情": [
    {
   "type": "formoption",
   "backcolor": "#f5f5f5",
   "hide_func": "",
   "formjson":"trade_fee1_edit"
  },
  {
      "id": "tablefee",
      "type": "table",
      "search": "yes",
      "df_func": "tradeExpenseDetail",
      "parent_id": ["Trade_FeeListBtn"],
      "tablecols": [
        {
          "colname": "expense",
          "label": "交易费用",
          "col_func":"tradeExpenseType"
        },
        {
          "colname": "bankAccount",
          "label": "现金账户",
          "col_func":"bankAcctNameByActID"
        },
        {
          "colname": "feeTradeCurrency",
          "label": "交易货币",
          "col_func":"tradeCurrencyCode"
        },
        {
          "colname": "tableFeeCurrency",
          "label": "费用货币",
          "col_func":"feeCurrencyCode"
        },
        {
          "colname": "fxRate",
          "label": "汇率"
        },
        {
          "colname": "totalAmount",
          "label": "费用|费率",
          "total": "yes"
        },
        {
          "colname": "expenseAmount",
          "label": "费用化金额",
          "total": "yes"
        },
        {
          "colname": "cashAmount",
          "label": "是否随交易支付",
          "col_func":"getPayTradeTypeValue",
          "total": "yes"
        },
        {
          "colname": "expenseSettleDate",
          "type":"hidden",
          "label": "结转时间"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-delete'></i>",
          "cb_func": "",
          "cb_target": "message",
          "cb_done_action": "_delrow",
          "cb_done_clickbtn":"totalExpense"
        },
        {
          "type": "button",
          "label": "<i class='layui-icon layui-icon-edit'></i>",
          "cb_func": ["incurrency"],
          "cb_done_action": "_updaterow",
          "cb_done_clickbtn":["totalExpense","totalExpense2"],
          "cb_target_form": [
            {
              "type": "select",
              "label": "费用选择",
              "id": "expense",
              "opt_func": "gettradeExpenses",
              "df_val": "1"
            },
            {
              "type": "hidden",
              "label": "是否随交易支付",
              "id": "rpType",
              "opt_func": "getexpenseRPType",
              "df_val": "0"
            },
            {
		      "type": "select",
		      "id": "bankAccount",
		      "label": "费用现金账户",
		      "parent_id": ["port"],
		      "opt_func": "portfolioAccountShortList"
		    },
            {
              "type": "select",
              "label": "交易货币",
              "id": "feeTradeCurrency",
              "opt_func": "currencyList"
            },
            {
		      "type": "select",
		      "id": "tableFeeCurrency",
		      "label": "费用货币",
		      "disabled": "yes",
		      "parent_id": ["bankAccount"],
		      "df_func": "bankAccountFeeCurrency",
		      "opt_func": "currencyList"
		    },
		    {
		      "type": "input",
		      "id": "fxRate",
		      "label": "交易汇率",
		      "parent_id": ["bankAccount","feeTradeCurrency"],
		      "df_func": "DefaultFeeFxRateTrade",
		      "tips":"费用货币/记账货币",
              "verify":"required|number"
		    },
            {
              "type": "input",
              "id": "totalAmount",
              "label": "费用|费率"
            },
            {
              "type": "input",
              "id": "expenseAmount",
              "parent_id": ["expense","totalAmount"],
              "df_func": "getTradeFeeDtoByIDandAmount",
              "label": "费用化金额"
            },
            {
              "type": "select",
              "id": "cashAmount",
              "df_func": "isPaywithTrade",
      		  "opt_func":"getPayTradeType",
      		  "parent_id": "expense",
      		  "disabled":"yes",
              "label": "是否随交易支付"
            },
            {
              "type": "hidden",
              "label": "结转时间",
              "id": "expenseSettleDate",
              "df_val":"2999-12-31"
            }
          ]
        }
      ]
    }
    ],
"操作": [
    { "type": "br" },
    { "type": "blank", "colwidth": "5" },
    {
      "type": "btngroup",
      "label": "<i class='layui-icon layui-icon-delete'></i>提交",
       "colwidth": "2" ,
       "buttons":[
    {
      "type": "button",
      "label": "<i class=layui-icon layui-icon-ok'></i>提交",
      "cb_func": "swap_open_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }]}
  ]
}