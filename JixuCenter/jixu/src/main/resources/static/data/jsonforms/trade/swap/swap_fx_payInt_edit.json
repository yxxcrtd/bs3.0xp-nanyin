{
  "jsonoptions": {
    "title": "编辑",
    "formgroup": {
      "合约信息": "12",
      "收入端信息": "6",
      "支出端信息": "6",
      "费用详情": "10",
      "操作": "12"
    }
  },
  "合约信息": [
    {
      "type": "input",
      "id": "trade_id",
      "label": "交易编号",
      "disabled": "yes",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "资产类型",
      "id": "assetType",
      "disabled": "yes",
      "opt_func": "allAssets",
      "df_val": "F13",
      "colwidth": "4"
    },
    {
      "type": "selecttab",
      "label": "互换合同名称",
      "id": "secid",
      "opt_func": "newSmfCurSwapShortList",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "交易类型",
      "id": "tradeType",
      "disabled": "yes",
      "opt_func": "allTradeTypes",
      "df_val": "752",
      "colwidth": "4"
    },
    {
      "type": "select",
      "label": "投资组合",
      "id": "port",
      "disabled": "yes",
      "opt_func": "portShortList",
      "df_func": "port",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "交易日期",
      "id": "tradeDate",
      "verify": "required|date",
      "df_func":"returnDateControl",
      "colwidth": "4"
    },
    {
      "type": "date",
      "label": "计息结束日",
      "id": "divBasicDate",
      "parent_id":["secid","tradeDate","tradeType"],
      "verify": "required|date",
      "df_func":"returnDivBasicDate",
      "colwidth": "4"
    },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "4"
    }
  ],
  "收入端信息": [
    {
      "type": "input",
      "id": "principal",
      "label": "收入端本金",
      "parent_id": ["secid"],
      "disabled":"yes",
      "df_func": "swapInterestTrade..principal",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "intatmat",
      "label": "收息金额",
      "verify": "required|number",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "select",
      "id": "bankAcct",
      "label": "收入端银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "收入端币种",
      "id": "incurrency",
      "parent_id": ["bankAcct"],
      "disabled":"yes",
      "df_func": "bankAccountCurrency",
      "opt_func": "currencyList",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "tradeFX",
      "label": "收入端汇率",
      "parent_id": ["port","tradeDate","bankAcct"],
      "df_func": "DefaultFxRate",
      "tips":"收入端币种/产品本位币",
      "df_val":"1",
      "colwidth": "6"
    },
    {
      "type": "checkbox",
      "id": "setAllInterest",
      "label": "是否结清",
      "opt_val":{
      "1":"是",
      "0":"否"},
      "df_val":"1",
      "verify":"required",
      "colwidth": "6"
    }
  ],

  "支出端信息": [
    {
      "type": "input",
      "id": "principal2",
      "label": "支出端本金",
      "disabled":"yes",
      "parent_id": ["secid"],
      "df_func": "swapInterestTrade..principal2",
      "colwidth": "6"
    },
    {
      "type": "input",
      "id": "intatmat2",
      "label": "付息金额",
      "verify": "required|number",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "select",
      "id": "bankAcct2",
      "label": "支出端银行账户",
      "parent_id": ["port"],
      "opt_func": "portfolioAccountShortList",
      "colwidth": "6"
    },
    {
      "type": "select",
      "label": "支出端币种",
      "id": "incurrency2",
      "parent_id": ["bankAcct2"],
      "disabled":"yes",
      "df_func": "bankAccountCurrency2",
      "opt_func": "currencyList",
      "colwidth": "6"
    },
    { "type": "br" },
    {
      "type": "input",
      "id": "tradeFX2",
      "label": "支出端汇率",
      "tips":"支出端币种/产品本位币",
      "df_val":"1",
      "parent_id": ["port","tradeDate","bankAcct2"],
      "df_func":"DefaultFxRate2",
      "colwidth": "6"
    },
    {
      "type": "checkbox",
      "id": "setAllInterest2",
      "label": "是否结清",
      "opt_val":{
      "1":"是",
      "0":"否"},
      "df_val":"1",
      "verify":"required",
      "colwidth": "6"
    }
  ],
  "操作":[
   { "type": "blank", "colwidth": "5" },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-ok'></i>提交",
      "cb_func": "swap_expire_Update",
      "cb_target": "message",
      "cb_done_message": "提交成功",
      "cb_done_action": "_closemodal",
      "colwidth": "1"
    },
    {
      "type": "button",
      "label": "<i class='layui-icon layui-icon-delete'></i>取消",
      "cb_func": "_closemodal",
       "colwidth": "1" 
    }
  ]
}
