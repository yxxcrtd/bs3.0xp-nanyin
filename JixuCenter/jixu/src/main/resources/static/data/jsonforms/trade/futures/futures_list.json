		{
			"type": "blank",
			"colwidth": "3"
		},
		{
		    "type": "button",
		    "label": "<i class='layui-icon layui-icon-search'></i>查询",
		    "id": "Trade_futuresListBtn",
		    "colwidth": "1"
	    },
	    {
			"type": "date",
			"label": "开始日期",
			"id": "start"
		},
		{
			"type": "date",
			"label": "结束日期",
			"id": "end"
		}
	],
	"tabledata": [
		{
			"type": "formoption",
			"title": "none",
			"backcolor": "#fff",
			"hide_func": ""
		},
		{
			"id": "tableConnList",
			"type": "table",
			"pagedown": "true",
			"df_func": "Trade_futuresList",
			"cb_func": ["port", "tradeDetail"],
		    "cb_target": "modal",
		    "cb_target_func": "newTradeForm",
