					"label": "交易编码"
				},
				{
					"colname": "tradeTypeName",
					"label": "交易类型"
				},
				{
					"colname": "status",
					"label": "过账状态",
					"type":"hidden"
				},
				{
					"colname": "secid",
					"label": "证券代码"
				},
				{
					"colname": "secname",
					"label": "证券名称"
				},
				{
					"colname": "tradedate",
					"label": "交易时间",
					"sort": "true"
				},
				{
					"colname": "settledate",
					"label": "结算时间",
					"sort": "true"
				},
				{
					"colname": "shares",
					"label": "数量"
				},
				{
					"colname": "principal",
					"label": "本金"
				},
				{
					"colname": "tradeexpense",
					"label": "费用"
				},
				{
					"colname": "accruedincome",
					"type": "hidden",
					"label": "利息"
				},
		        {
		          "id": "daeditbtn",
		          "type": "button",
		          "label": "<i class='layui-icon layui-icon-edit'></i>",
		          "cb_func": ["port", "tradeDetail"],
		          "cb_target": "modal",
		          "cb_target_func": "newTradeForm",
		          "cb_done_clickbtn":"Trade_futuresListBtn"
		        },
		        {
		          "type": "button",
		          "label": "<i class='layui-icon layui-icon-delete'></i>",
		          "cb_func": "tradeRemove",
		          "cb_target": "message",
		          "cb_done_action": "_delrow",
		          "cb_done_clickbtn":"Trade_futuresListBtn"
		        }
