<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "/spring-beans.dtd">

<beans>

	<import resource="database.xml" />
	
	<bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
		<property name="dataSource" ref="dataSource"></property>
		<property name="configLocation" value="classpath:mybatisConfig.xml"></property>
		<property name="mapperLocations">
			<list>
				<value>classpath*:com/jixu/dao/mapper/*.xml</value>
				<value>classpath*:com/joyintech/valuation/common/dao/sqlmap/*.xml</value>
			</list> 
		</property>
		<property name="typeAliasesPackage" value="com.orm.obj"/>
	</bean>
	
	<!--配置mybatis数据映射接口-->
	<bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
		<property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />  
  		<property name="basePackage" value="com.jixu.dao,com.joyintech.valuation.common.dao" />  
	</bean>  
</beans>