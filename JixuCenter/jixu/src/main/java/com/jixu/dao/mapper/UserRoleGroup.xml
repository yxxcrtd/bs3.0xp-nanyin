<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.UserRoleGroupDao">
<resultMap type="com.orm.obj.UserRoleGroup" id="BaseResultMap">
	<result property="groupID" column="GroupID" jdbcType="INTEGER"/>
	<result property="groupName" column="GroupName" jdbcType="VARCHAR"/>
	<collection property="roleTypeRoleGroupMap" javaType="java.util.Set" column="GroupID" ofType="com.orm.obj.RoleTypeRoleGroupMap" select="com.jixu.dao.intf.RoleTypeRoleGroupMapDao.getRoleTypeRoleGroupMapListByUserRoleGroupID"/>
	<collection property="verifyConfig" javaType="java.util.Set" column="GroupID" ofType="com.orm.obj.VerifyConfig" select="com.jixu.dao.intf.VerifyConfigDao.getVerifyConfigListByUserRoleGroupID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		GroupID,
		GroupName
		from userrolegroup
		where GroupID = #{groupID,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		GroupID,
		GroupName
		from userrolegroup
		where GroupID = #{id,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntityAll" resultMap="BaseResultMap">
		select * from userrolegroup
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.UserRoleGroup" >
		delete from userrolegroup where GroupID=#{groupID,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.UserRoleGroup" >
		<selectKey keyProperty="groupID" resultType="int" order="BEFORE">
			    select UserRoleGroup_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into userrolegroup (
		GroupID,
		GroupName
		)
		values(
		#{groupID},
		#{groupName,jdbcType=VARCHAR}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.UserRoleGroup" >
		update userrolegroup set
		GroupID = #{groupID,jdbcType=INTEGER},
		GroupName = #{groupName,jdbcType=VARCHAR}
		where GroupID = #{groupID,jdbcType=INTEGER}
	</update>
</mapper>
