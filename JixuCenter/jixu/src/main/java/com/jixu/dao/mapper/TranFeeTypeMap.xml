<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.TranFeeTypeMapDao">
<resultMap type="com.orm.obj.TranFeeTypeMap" id="BaseResultMap">
	<result property="id" column="id" jdbcType="INTEGER"/>
	<result property="assetType" column="assetType" jdbcType="INTEGER"/>
	<association property="tranFeeTypeCode" column="TranFeeTypeCode" javaType="com.orm.obj.TranFeeDef" select="com.jixu.dao.intf.TranFeeDefDao.get"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		id,
		TranFeeTypeCode,
		assetType
		from tran_fee_typemap
		where id = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.TranFeeTypeMap" >
		delete from tran_fee_typemap where id=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.TranFeeTypeMap" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select TranFeeTypeMap_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into tran_fee_typemap (
		id,
		TranFeeTypeCode,
		assetType
		)
		values(
		#{id},
		#{tranFeeTypeCode.id,jdbcType=INTEGER},
		#{assetType,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.TranFeeTypeMap" >
		update tran_fee_typemap set
		id = #{id,jdbcType=INTEGER},
		TranFeeTypeCode = #{tranFeeTypeCode.id,jdbcType=INTEGER},
		assetType = #{assetType,jdbcType=INTEGER}
		where id = #{id,jdbcType=INTEGER}
	</update>

	<select id="deleteTranFeeDefMapByFeeID">
		<![CDATA[
			delete from Tran_Fee_TypeMap where tranFeeTypeCode=#{feeDefID}
		]]>
	</select>

	<select id="getTranFeeTypeMapsListByTranFeeDefID" resultMap="BaseResultMap" >
		<![CDATA[
				select * from TranFeeTypeMap where TranFeeTypeCode=#{0}
		]]>
	</select>
</mapper>
