<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.UserRoleGroupMapDao">
<resultMap type="com.orm.obj.UserRoleGroupMap" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<association property="userRole" column="RoleID" javaType="com.orm.obj.UserRole" select="com.jixu.dao.intf.UserRoleDao.get"/>
	<association property="userRoleGroup" column="GroupID" javaType="com.orm.obj.UserRoleGroup" select="com.jixu.dao.intf.UserRoleGroupDao.get"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		ID,
		RoleID,
		GroupID
		from userrolegroupmap
		where ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.UserRoleGroupMap" >
		delete from userrolegroupmap where ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.UserRoleGroupMap" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select UserRoleGroupMap_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into userrolegroupmap (
		ID,
		RoleID,
		GroupID
		)
		values(
		#{id},
		#{userRole.roleID,jdbcType=INTEGER},
		#{userRoleGroup.groupID,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.UserRoleGroupMap" >
		update userrolegroupmap set
		ID = #{id,jdbcType=INTEGER},
		RoleID = #{userRole.roleID,jdbcType=INTEGER},
		GroupID = #{userRoleGroup.groupID,jdbcType=INTEGER}
		where ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="deleteUserRoleGroupMap">
		<![CDATA[
			delete from UserRoleGroupMap where roleID=#{roleID}
		]]>
	</select>

	<select id="loadUserRoleGroupMap" resultMap="BaseResultMap">
		<![CDATA[
			select * from UserRoleGroupMap where roleID=#{roleid}
		]]>
	</select>

	<select id="getUserRoleGroupMapListByUserRoleID" resultMap="BaseResultMap" >
