<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.FxCurrencyDao">
<resultMap type="com.orm.obj.FxCurrency" id="BaseResultMap">
	<result property="id" column="CURR_ID" jdbcType="INTEGER"/>
	<result property="currCode" column="CURR_CODE" jdbcType="VARCHAR"/>
	<result property="currName" column="CURR_NAME" jdbcType="VARCHAR"/>
	<result property="active" column="active" jdbcType="INTEGER"/>
	<collection property="fxRates" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.FxRate" select="com.jixu.dao.intf.FxRateDao.getFxRatesListByFxCurrencyID"/>
	<collection property="fxRates2" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.FxRate" select="com.jixu.dao.intf.FxRateDao.getFxRates2ListByFxCurrencyID"/>
	<collection property="tranFasicFee" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.TranBasicFee" select="com.jixu.dao.intf.TranBasicFeeDao.getTranFasicFeeListByFxCurrencyID"/>
	<collection property="bkCashRcpy" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.BkCashRcpy" select="com.jixu.dao.intf.BkCashRcpyDao.getBkCashRcpyListByFxCurrencyID"/>
	<collection property="bkCashFlow" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.BkCashFlow" select="com.jixu.dao.intf.BkCashFlowDao.getBkCashFlowListByFxCurrencyID"/>
	<collection property="tranTasic" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.TranBasic" select="com.jixu.dao.intf.TranBasicDao.getTranTasicListByFxCurrencyID"/>
	<collection property="tranTasic2" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.TranBasic" select="com.jixu.dao.intf.TranBasicDao.getTranTasic2ListByFxCurrencyID"/>
	<collection property="tranBasicSettle" javaType="java.util.Set" column="CURR_ID" ofType="com.orm.obj.TranBasic" select="com.jixu.dao.intf.TranBasicDao.getTranBasicSettleListByFxCurrencyID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		CURR_ID,
		CURR_CODE,
		CURR_NAME,
		active
		from fx_currency
		where CURR_ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.FxCurrency" >
		delete from fx_currency where CURR_ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.FxCurrency" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select FxCurrency_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into fx_currency (
		CURR_ID,
		CURR_CODE,
		CURR_NAME,
		active
		)
		values(
		#{id},
		#{currCode,jdbcType=VARCHAR},
		#{currName,jdbcType=VARCHAR},
		#{active,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.FxCurrency" >
		update fx_currency set
		CURR_ID = #{id,jdbcType=INTEGER},
		CURR_CODE = #{currCode,jdbcType=VARCHAR},
		CURR_NAME = #{currName,jdbcType=VARCHAR},
		active = #{active,jdbcType=INTEGER}
		where CURR_ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="loadCurrency" resultMap="BaseResultMap">
		<![CDATA[
			select * from FX_CURRENCY
		]]>
	</select>

	<select id="loadFxCurrencyByCurCode" resultMap="BaseResultMap">
		<![CDATA[
			select * from FX_CURRENCY where CURR_CODE =#{currcode} and rownum=1
		]]>
	</select>

	<select id="loadFxCurrency" resultMap="BaseResultMap">
		select * from FX_CURRENCY where CURR_ID=#{currencyCode}
	</select>

	<select id="loadCurrencyList" resultMap="BaseResultMap">
		<![CDATA[
			select * from FX_CURRENCY order by CURR_NAME asc
		]]>
	</select>

	<select id="updateCurrency">
		update fx_currency set
		CURR_ID = #{currency.id,jdbcType=INTEGER},
		CURR_CODE = #{currency.currCode,jdbcType=VARCHAR},
		CURR_NAME = #{currency.currName,jdbcType=VARCHAR},
		active = #{currency.active,jdbcType=INTEGER}
		where CURR_ID = #{currency.id,jdbcType=INTEGER}
	</select>

	<insert id="saveCurrency">
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select FxCurrency_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into fx_currency (
		CURR_ID,
		CURR_CODE,
		CURR_NAME,
		active)
		values(
		#{id},
		#{currency.currCode,jdbcType=VARCHAR},
		#{currency.currName,jdbcType=VARCHAR},
		#{currency.active,jdbcType=INTEGER})
	</insert>

	<select id="getCurrencyList" resultMap="BaseResultMap">
		<![CDATA[
			select * from FX_CURRENCY order by CURR_ID
		]]>
	</select>
</mapper>
