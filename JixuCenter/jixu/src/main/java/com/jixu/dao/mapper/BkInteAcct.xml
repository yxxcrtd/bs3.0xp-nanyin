<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.BkInteAcctDao">
<resultMap type="com.orm.obj.BkInteAcct" id="BaseResultMap">
	<result property="id" column="BK_INTE_ID" jdbcType="INTEGER"/>
	<result property="cashflowtype" column="CASHFLOWTYPE" jdbcType="VARCHAR"/>
	<result property="intperiodconv" column="INTPERIODCONV" jdbcType="INTEGER"/>
	<result property="masterrecname" column="MASTERRECNAME" jdbcType="VARCHAR"/>
	<association property="bkinfo" column="BANKID" javaType="com.orm.obj.BkInfo" select="com.jixu.dao.intf.BkInfoDao.get"/>
	<association property="cashFlowCfg" column="cashFlowCfg" javaType="com.orm.obj.CashFlowCfg" select="com.jixu.dao.intf.CashFlowCfgDao.get"/>
	<collection property="bkInteRatios" javaType="java.util.Set" column="BK_INTE_ID" ofType="com.orm.obj.BkInteRatio" select="com.jixu.dao.intf.BkInteRatioDao.getBkInteRatiosListByBkInteAcctID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		BK_INTE_ID,
		CASHFLOWTYPE,
		INTPERIODCONV,
		MASTERRECNAME,
		BANKID,
		cashFlowCfg
		from bk_inte_acct
		where BK_INTE_ID = #{id,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select * from bk_inte_acct where BK_INTE_ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.BkInteAcct" >
		delete from bk_inte_acct where BK_INTE_ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.BkInteAcct" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select BkInteAcct_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into bk_inte_acct (
		BK_INTE_ID,
		CASHFLOWTYPE,
		INTPERIODCONV,
		MASTERRECNAME,
		BANKID,
		cashFlowCfg
		)
		values(
		#{id},
		#{cashflowtype,jdbcType=VARCHAR},
		#{intperiodconv,jdbcType=INTEGER},
		#{masterrecname,jdbcType=VARCHAR},
		#{bkinfo.bankID,jdbcType=INTEGER},
		#{cashFlowCfg.cashFlowID,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.BkInteAcct" >
		update bk_inte_acct set
		BK_INTE_ID = #{id,jdbcType=INTEGER},
		CASHFLOWTYPE = #{cashflowtype,jdbcType=VARCHAR},
		INTPERIODCONV = #{intperiodconv,jdbcType=INTEGER},
		MASTERRECNAME = #{masterrecname,jdbcType=VARCHAR},
		BANKID = #{bkinfo.bankID,jdbcType=INTEGER},
		cashFlowCfg = #{cashFlowCfg.cashFlowID,jdbcType=INTEGER}
		where BK_INTE_ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="checkInteAcctNameExist" resultType="Boolean">
		<![CDATA[
			select  count(*) from Bk_Inte_Acct where masterrecname=#{inteAcct} and bankID=#{bankID}
		]]>
	</select>

	<select id="loadBankInteAcctByBank" resultMap="BaseResultMap">
		<![CDATA[
			select * from BK_INTE_ACCT where bankID=#{bankID}
		]]>
	</select>

	<select id="loadBkInteAcct" resultMap="BaseResultMap">
		<![CDATA[
			select * from BK_INTE_ACCT where BK_INTE_ID=#{bkInteAcctID}
		]]>
	</select>

	<select id="getBkInteAcctListByBkInfoID" resultMap="BaseResultMap" >
		<![CDATA[
				select * from BkInteAcct where BANKID=#{0}
		]]>
	</select>

	<select id="getBkInteAcctListByCashFlowCfgID" resultMap="BaseResultMap" >
		<![CDATA[
				select * from BkInteAcct where cashFlowCfg=#{0}
		]]>
	</select>
</mapper>
