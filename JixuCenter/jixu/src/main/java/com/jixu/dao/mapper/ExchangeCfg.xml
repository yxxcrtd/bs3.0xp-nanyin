<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.ExchangeCfgDao">
<resultMap type="com.orm.obj.ExchangeCfg" id="BaseResultMap">
	<result property="code" column="code" jdbcType="INTEGER"/>
	<result property="name" column="name" jdbcType="VARCHAR"/>
	<collection property="issueinfo" javaType="java.util.Set" column="code" ofType="com.orm.obj.IssueInfo" select="com.jixu.dao.intf.IssueInfoDao.getIssueinfoListByExchangeCfgID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		code,
		name
		from exchangecfg
		where code = #{code,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.ExchangeCfg" >
		delete from exchangecfg where code=#{code,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.ExchangeCfg" >
		<selectKey keyProperty="code" resultType="int" order="BEFORE">
			    select ExchangeCfg_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into exchangecfg (
		code,
		name
		)
		values(
		#{code},
		#{name,jdbcType=VARCHAR}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.ExchangeCfg" >
		update exchangecfg set
		code = #{code,jdbcType=INTEGER},
		name = #{name,jdbcType=VARCHAR}
		where code = #{code,jdbcType=INTEGER}
	</update>

	<select id="loadExchange" resultMap="BaseResultMap">
		<![CDATA[
			select * from ExchangeCfg  where code=#{exchangeCode}
		]]>
	</select>

	<select id="loadExchangeList" resultMap="BaseResultMap">
		<![CDATA[
			select * from ExchangeCfg order by name asc
		]]>
	</select>
</mapper>
