<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.IssueInfoDao">
<resultMap type="com.orm.obj.IssueInfo" id="BaseResultMap">
	<result property="id" column="CUSIP" jdbcType="INTEGER"/>
	<result property="coaaGroup" column="GLGROUP" jdbcType="INTEGER"/>
	<result property="securityid" column="SECURITYID" jdbcType="VARCHAR"/>
	<result property="priCur" column="PriCur" jdbcType="INTEGER"/>
	<result property="issueType" column="ISSUETYPE" jdbcType="INTEGER"/>
	<result property="cashFlowCfgID" column="CASHFLOWCFG" jdbcType="INTEGER"/>
	<result property="incomeCur" column="IncomeCur" jdbcType="INTEGER"/>
	<result property="securityname" column="securityname" jdbcType="VARCHAR"/>
	<result property="expireDate" column="ExpireDate" jdbcType="DATE"/>
	<result property="contractSize" column="ContractSize" jdbcType="DOUBLE"/>
	<result property="optionType" column="OptionType" jdbcType="DOUBLE"/>
	<result property="underCusip" column="UnderCusip" jdbcType="DOUBLE"/>
	<result property="activeDate" column="ActiveDate" jdbcType="DATE"/>
	<result property="cashFlowCfgID2" column="CASHFLOWCFG2" jdbcType="INTEGER"/>
	<result property="endPrice" column="EndPrice" jdbcType="DOUBLE"/>
	<result property="fixIncomeType" column="FixIncomeType" jdbcType="INTEGER"/>
	<result property="startPrice" column="StartPrice" jdbcType="DOUBLE"/>
	<result property="incomeCur2" column="incomeCur2" jdbcType="INTEGER"/>
	<result property="priCur2" column="priCur2" jdbcType="INTEGER"/>
	<result property="swapExchangeInd" column="swapExchangeInd" jdbcType="INTEGER"/>
	<association property="issuer" column="issuer" javaType="com.orm.obj.Issuer" select="com.jixu.dao.intf.IssuerDao.get"/>
	<association property="sourceID" column="sourceID" javaType="com.orm.obj.InterfaceSource" select="com.jixu.dao.intf.InterfaceSourceDao.get"/>
	<association property="rpSecType" column="rpSecType" javaType="com.orm.obj.RPSecType" select="com.jixu.dao.intf.RPSecTypeDao.get"/>
	<association property="exchangeCode" column="exchangeCode" javaType="com.orm.obj.ExchangeCfg" select="com.jixu.dao.intf.ExchangeCfgDao.get"/>
	<association property="country" column="CountryCode" javaType="com.orm.obj.Country" select="com.jixu.dao.intf.CountryDao.get"/>
	<collection property="tranBasic" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.TranBasic" select="com.jixu.dao.intf.TranBasicDao.getTranBasicListByIssueInfoID"/>
	<collection property="secPrices" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.SecPrice" select="com.jixu.dao.intf.SecPriceDao.getSecPricesListByIssueInfoID"/>
	<collection property="tran" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.Tran" select="com.jixu.dao.intf.TranDao.getTranListByIssueInfoID"/>
	<collection property="secPrice" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.SecPrice" select="com.jixu.dao.intf.SecPriceDao.getSecPriceListByIssueInfoID"/>
	<collection property="cashFlow" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.BkCashFlow" select="com.jixu.dao.intf.BkCashFlowDao.getCashFlowListByIssueInfoID"/>
	<collection property="cashRcpy" javaType="java.util.Set" column="CUSIP" ofType="com.orm.obj.BkCashRcpy" select="com.jixu.dao.intf.BkCashRcpyDao.getCashRcpyListByIssueInfoID"/>
</resultMap>
<resultMap type="com.jixu.mvc.control.model.MarketStockModel" id="MarketStockModel">
	<result property="cusip" column="cusip" jdbcType="INTEGER"/>
	<result property="sourcename" column="sourcename" jdbcType="VARCHAR"/>
	<result property="secType" column="secType" jdbcType="VARCHAR"/>
	<result property="secCode" column="secCode" jdbcType="VARCHAR"/>
	<result property="secName" column="secName" jdbcType="VARCHAR"/>
	<result property="industryName" column="industryName" jdbcType="VARCHAR"/>
	<result property="coaName" column="coaName" jdbcType="VARCHAR"/>
	<result property="curName" column="curName" jdbcType="VARCHAR"/>
	<result property="country" column="country" jdbcType="VARCHAR"/>
</resultMap>
	<select id="loadSecIDNameList" resultType="String">
		select concat_ws('', cusip , '|' , securityid , '|' , securityname) from Issue_Info where 1=1
		<if test="sourceid>0">
			and sourceID.sourceID=#{sourceid}
		</if>
		<if test="secType>0">
			and issueType=#{secType}
		</if>
		 order by securityid asc
	</select>
</mapper>
