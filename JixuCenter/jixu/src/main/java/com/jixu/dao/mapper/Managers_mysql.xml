<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.ManagersDao">
<resultMap type="com.orm.obj.Managers" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<result property="managerName" column="managerName" jdbcType="VARCHAR"/>
	<result property="shortCode" column="shortCode" jdbcType="VARCHAR"/>
	<result property="active" column="active" jdbcType="INTEGER"/>
	<association property="managerGroup" column="managerGroupCode" javaType="com.orm.obj.ManagerGroup" select="com.jixu.dao.intf.ManagerGroupDao.get"/>
</resultMap>


	<select id="getDefaultManagerID" resultType="int">
		<![CDATA[
			select ifnull(max(mgrs.ID),0) from managers mgrs,portfolio_hdr ph  where ph.managerGroup=mgrs.managerGroupCode and ph.portfolio=#{portnum}
		]]>
	</select>

</mapper>
