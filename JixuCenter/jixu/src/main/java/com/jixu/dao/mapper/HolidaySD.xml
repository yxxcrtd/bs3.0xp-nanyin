<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.HolidaySDDao">
<resultMap type="com.orm.obj.HolidaySD" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<result property="code" column="code" jdbcType="VARCHAR"/>
	<result property="name" column="name" jdbcType="VARCHAR"/>
	<collection property="holidayLS" javaType="java.util.Set" column="ID" ofType="com.orm.obj.HolidayLS" select="com.jixu.dao.intf.HolidayLSDao.getHolidayLSListByHolidaySDID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		ID,
		code,
		name
		from holidaysd
		where ID = #{id,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select * from holidaysd where ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.HolidaySD" >
		delete from holidaysd where ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.HolidaySD" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select HolidaySD_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into holidaysd (
		ID,
		code,
		name
		)
		values(
		#{id},
		#{code,jdbcType=VARCHAR},
		#{name,jdbcType=VARCHAR}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.HolidaySD" >
		update holidaysd set
		ID = #{id,jdbcType=INTEGER},
		code = #{code,jdbcType=VARCHAR},
		name = #{name,jdbcType=VARCHAR}
		where ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="loadHolidaySD" resultMap="BaseResultMap">
		<![CDATA[
			select * from HolidaySD where id=#{id}
		]]>
	</select>

	<select id="loadHolidaySchedule" resultMap="BaseResultMap">
		<![CDATA[
			select * from HolidaySD order by id asc
		]]>
	</select>

	<insert id="saveHolidaySD">
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select HolidaySD_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into holidaysd (
		ID,
		code,
		name)
		values(
		#{id},
		#{holidaySD.code,jdbcType=VARCHAR},
		#{holidaySD.name,jdbcType=VARCHAR}
		)
	</insert>
</mapper>
