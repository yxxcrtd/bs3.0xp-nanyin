<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.VoucherDao">
<resultMap type="com.orm.obj.Voucher" id="BaseResultMap">
	<result property="vouchernum" column="VOUCHERNUM" jdbcType="VARCHAR"/>
	<result property="affirmDate" column="AFFIRMDATE" jdbcType="TIMESTAMP"/>
	<result property="affirmUser" column="AFFIRMUSER" jdbcType="VARCHAR"/>
	<result property="auditDate" column="AUDITDATE" jdbcType="TIMESTAMP"/>
	<result property="auditMsg" column="AUDITMSG" jdbcType="VARCHAR"/>
	<result property="auditUser" column="AUDITUSER" jdbcType="VARCHAR"/>
	<result property="importedDate" column="IMPORTEDDATE" jdbcType="DATE"/>
	<result property="importedUser" column="IMPORTEDUSER" jdbcType="VARCHAR"/>
	<result property="isAudit" column="ISAUDIT" jdbcType="INTEGER"/>
	<result property="isAuditMsgValid" column="ISAUDITMSGVALID" jdbcType="INTEGER"/>
	<result property="journalSourceCode" column="JOURNALSOURCECODE" jdbcType="INTEGER"/>
	<result property="ledgerDate" column="LEDGERDATE" jdbcType="DATE"/>
	<result property="managerGroupCode" column="MANAGERGROUPCODE" jdbcType="INTEGER"/>
	<result property="settlementDate" column="SETTLEMENTDATE" jdbcType="DATE"/>
	<result property="stampDate" column="STAMPDATE" jdbcType="TIMESTAMP"/>
	<result property="stampUser" column="STAMPUSER" jdbcType="VARCHAR"/>
	<result property="taNum" column="TANUM" jdbcType="INTEGER"/>
	<result property="tradeDate" column="TRADEDATE" jdbcType="DATE"/>
	<result property="portfolio" column="PORTFOLIONUM" jdbcType="INTEGER"/>
	<collection property="voucherDetails" javaType="java.util.Set" column="VOUCHERNUM" ofType="com.orm.obj.VoucherDetails" select="com.jixu.dao.intf.VoucherDetailsDao.getVoucherDetailsListByVoucherID"/>
</resultMap>
<resultMap type="com.jixu.dataInterface.model.VouchersBean" id="BaseResultMap2">
	<result property="vouchernum" column="vouchernum" jdbcType="VARCHAR"/>
	<result property="ledgerDate" column="ledgerDate" jdbcType="DATE"/>
	<result property="acctnum" column="acctnum" jdbcType="VARCHAR"/>
	<result property="acctname" column="acctname" jdbcType="VARCHAR"/>
	<result property="journalDesc" column="journalDesc" jdbcType="VARCHAR"/>
	<result property="desciption" column="desciption" jdbcType="VARCHAR"/>
	<result property="drLocal" column="drLocal" jdbcType="DOUBLE"/>
	<result property="crLocal" column="drLocal" jdbcType="DOUBLE"/>
	<result property="drFunc" column="drFunc" jdbcType="DOUBLE"/>
	<result property="crFunc" column="crFunc" jdbcType="DOUBLE"/>
	<result property="amount" column="amount" jdbcType="DOUBLE"/>
	<result property="portname" column="portname" jdbcType="VARCHAR"/>
	<result property="secid" column="secid" jdbcType="VARCHAR"/>
	<result property="journalCode" column="journalCode" jdbcType="INTEGER"/>
</resultMap>

<resultMap type="com.jixu.data.pojo.Balance" id="Balance">
	<result property="id" column="id" jdbcType="INTEGER"/>
	<result property="asOfDate" column="asOfDate" jdbcType="DATE"/>
	<result property="portnum" column="portnum" jdbcType="VARCHAR"/>
	<result property="portCode" column="portCode" jdbcType="VARCHAR"/>
	<result property="portName" column="portName" jdbcType="VARCHAR"/>
	<result property="accntNum" column="accntNum" jdbcType="VARCHAR"/>
	<result property="accntName" column="accntName" jdbcType="VARCHAR"/>
	<result property="accntLevel" column="accntLevel" jdbcType="INTEGER"/>
	<result property="accntCategory" column="accntCategory" jdbcType="INTEGER"/>
	<result property="accntIsLeaf" column="accntIsLeaf" jdbcType="INTEGER"/>
	<result property="drFunc" column="drFunc" jdbcType="DOUBLE"/>
	<result property="crFunc" column="crFunc" jdbcType="DOUBLE"/>
	<result property="drLocal" column="drLocal" jdbcType="DOUBLE"/>
	<result property="crLocal" column="crLocal" jdbcType="DOUBLE"/>
	<result property="localCur" column="localCur" jdbcType="VARCHAR"/>
</resultMap>
	

	<select id="checkJournalRunable" resultType="Boolean">
		<![CDATA[
			select ifnull(count(v.vouchernum),0) from Voucher v where v.portfolionum=#{portNum} and v.ledgerDate=#{journalDate} and v.journalSourceCode=#{journalType}
		]]>
	</select>

	

	<select id="getVouchernumByTradeNum">
		<![CDATA[
			select ifnull(max(vr.vouchernum),0) from Voucher vr where vr.taNum=#{tanum}
		]]>
	</select>
</mapper>
