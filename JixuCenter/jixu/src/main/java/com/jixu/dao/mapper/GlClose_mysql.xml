<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.GlCloseDao">
<resultMap type="com.orm.obj.GlClose" id="BaseResultMap">
	<result property="glcloseID" column="glcloseID" jdbcType="INTEGER"/>
	<result property="acctnum" column="acctnum" jdbcType="VARCHAR"/>
	<result property="classid" column="classid" jdbcType="INTEGER"/>
	<result property="closeDate" column="closeDate" jdbcType="DATE"/>
	<result property="cr_func" column="cr_func" jdbcType="DOUBLE"/>
	<result property="cr_local" column="cr_local" jdbcType="DOUBLE"/>
	<result property="currencycode" column="currencycode" jdbcType="INTEGER"/>
	<result property="dr_func" column="dr_func" jdbcType="DOUBLE"/>
	<result property="dr_local" column="dr_local" jdbcType="DOUBLE"/>
	<association property="portfolio" column="portfolio" javaType="com.orm.obj.PortfolioHdr" select="com.jixu.dao.intf.PortfolioHdrDao.get"/>
</resultMap>
	

	<select id="getCloseBalance" resultType="Double">
		<![CDATA[
			select ifnull(max(dr_local-cr_local),0) from Gl_Close where portfolio=#{portnum} and closeDate=#{glDate} and acctnum=#{acctnum}  limit 1
		]]>
	</select>
</mapper>
