<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.CoaaGroupDao">
<resultMap type="com.orm.obj.CoaaGroup" id="BaseResultMap">
	<result property="groupNum" column="groupNum" jdbcType="INTEGER"/>
	<result property="groupName" column="groupName" jdbcType="VARCHAR"/>
	<collection property="portfolio" javaType="java.util.Set" column="groupNum" ofType="com.orm.obj.PortfolioHdr" select="com.jixu.dao.intf.PortfolioHdrDao.getPortfolioListByCoaaGroupID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		groupNum,
		groupName
		from coaagroup
		where groupNum = #{groupNum,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select * from coaagroup where groupNum = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.CoaaGroup" >
		delete from coaagroup where groupNum=#{groupNum,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.CoaaGroup" >
		<selectKey keyProperty="groupNum" resultType="int" order="BEFORE">
			    select CoaaGroup_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into coaagroup (
		groupNum,
		groupName
		)
		values(
		#{groupNum},
		#{groupName,jdbcType=VARCHAR}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.CoaaGroup" >
		update coaagroup set
		groupNum = #{groupNum,jdbcType=INTEGER},
		groupName = #{groupName,jdbcType=VARCHAR}
		where groupNum = #{groupNum,jdbcType=INTEGER}
	</update>

	<select id="loadCoaaGroup" resultMap="BaseResultMap">
		<![CDATA[
		select * from coaagroup where groupNum=#{groupCode}
		]]>
	</select>

	<select id="loadFxTranCoaaGroup" resultMap="BaseResultMap">
		<![CDATA[
			select * from CoaaGroup where instr(groupName,#{fxcur})>0 and rownum=1
		]]>
	</select>

	<select id="loadAllCoaaGroup" resultMap="BaseResultMap">
		<![CDATA[
			select * from CoaaGroup order by groupNum asc
		]]>
	</select>
</mapper>
