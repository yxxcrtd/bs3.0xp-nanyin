<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.FxRateDao">
<resultMap type="com.orm.obj.FxRate" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<result property="lstUpdate" column="LST_UPDATE" jdbcType="TIMESTAMP"/>
	<result property="rate" column="RATE" jdbcType="DOUBLE"/>
	<result property="rateDate" column="rate_Date" jdbcType="DATE"/>
	<association property="currID" column="CURR_ID" javaType="com.orm.obj.FxCurrency" select="com.jixu.dao.intf.FxCurrencyDao.get"/>
	<association property="sourceID" column="sourceID" javaType="com.orm.obj.InterfaceSource" select="com.jixu.dao.intf.InterfaceSourceDao.get"/>
	<association property="baseCurrID" column="baseCurrID" javaType="com.orm.obj.FxCurrency" select="com.jixu.dao.intf.FxCurrencyDao.get"/>
</resultMap>
<resultMap type="com.jixu.mvc.control.model.MarketFxRateModel" id="BaseResultMap2">
	<result property="fxid" column="fxid" jdbcType="INTEGER"/>
	<result property="sourceid" column="sourceid" jdbcType="INTEGER"/>
	<result property="soucename" column="soucename" jdbcType="VARCHAR"/>
	<result property="curID" column="curID" jdbcType="INTEGER"/>
	<result property="currency" column="currency" jdbcType="VARCHAR"/>
	<result property="baseCurID" column="baseCurID" jdbcType="INTEGER"/>
	<result property="baseCurrency" column="baseCurrency" jdbcType="VARCHAR"/>
	<result property="rateDate" column="rateDate" jdbcType="DATE"/>
	<result property="rate" column="rate" jdbcType="DOUBLE"/>
</resultMap>
	

	<select id="loadFxrate" resultType="Double">
		<![CDATA[
			select * from (select ifnull(max(rate),0) from fx_rate where baseCurrID=#{baseCurrency} and CURR_ID=#{localCurrency}
			and RATE_DATE<=#{date} and sourceID=#{sourceID} order by RATE_DATE desc) de limit 1
		]]>
	</select>

</mapper>
