<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.InterfaceSourceDao">
<resultMap type="com.orm.obj.InterfaceSource" id="BaseResultMap">
	<result property="sourceID" column="sourceID" jdbcType="INTEGER"/>
	<result property="sourceDesc" column="sourceDesc" jdbcType="VARCHAR"/>
	<result property="sourceType" column="sourceType" jdbcType="INTEGER"/>
	<result property="autoTime" column="autoTime" jdbcType="VARCHAR"/>
	<result property="autoType" column="autoType" jdbcType="INTEGER"/>
	<result property="backupFlag" column="backupFlag" jdbcType="BIT"/>
	<result property="backupPath" column="backupPath" jdbcType="VARCHAR"/>
	<result property="channelAccount" column="channelAccount" jdbcType="VARCHAR"/>
	<result property="channelPWD" column="channelPWD" jdbcType="VARCHAR"/>
	<result property="channelType" column="channelType" jdbcType="INTEGER"/>
	<result property="fileName" column="fileName" jdbcType="VARCHAR"/>
	<result property="fileType" column="fileType" jdbcType="INTEGER"/>
	<result property="filepath" column="filepath" jdbcType="VARCHAR"/>
	<result property="sourceName" column="sourceName" jdbcType="VARCHAR"/>
	<result property="tableStartLine" column="tableStartLine" jdbcType="INTEGER"/>
	<result property="tablename" column="tablename" jdbcType="VARCHAR"/>
	<result property="autoFlag" column="autoFlag" jdbcType="BIT"/>
	<result property="fileMultiFlag" column="fileMultiFlag" jdbcType="BIT"/>
	<result property="sourceSecType" column="sourceSecType" jdbcType="INTEGER"/>
	<result property="tableEndChar" column="tableEndChar" jdbcType="VARCHAR"/>
	<result property="tableSpilitChar" column="tableSpilitChar" jdbcType="VARCHAR"/>
	<result property="msg" column="msg" jdbcType="VARCHAR"/>
	<result property="enCodeType" column="enCodeType" jdbcType="INTEGER"/>
	<result property="expSourceClass" column="ExpSourceClass" jdbcType="VARCHAR"/>
	<result property="autoNDays" column="AutoNDays" jdbcType="INTEGER"/>
	<result property="tranType" column="tranType" jdbcType="INTEGER"/>
	<association property="holiday" column="holiday" javaType="com.orm.obj.HolidaySD" select="com.jixu.dao.intf.HolidaySDDao.get"/>
	<collection property="portfolioMap" javaType="java.util.Set" column="sourceID" ofType="com.orm.obj.PortfolioInterfaceMap" select="com.jixu.dao.intf.PortfolioInterfaceMapDao.getPortfolioMapListByInterfaceSourceID"/>
	<collection property="colconfig" javaType="java.util.Set" column="sourceID" ofType="com.orm.obj.InterfaceColConfig" select="com.jixu.dao.intf.InterfaceColConfigDao.getColconfigListByInterfaceSourceID"/>
	<collection property="msgColMap" javaType="java.util.Set" column="sourceID" ofType="com.orm.obj.InterfaceMsgColMap" select="com.jixu.dao.intf.InterfaceMsgColMapDao.getMsgColMapListByInterfaceSourceID"/>
</resultMap>
	
	<select id="getInterfaceSourceID" resultType="int">
		<![CDATA[
			select ifnull(max(iis.sourceid),0) from portfoliointerfacemap pim, interfacesource iis
			where pim.interfacesourceid=iis.sourceid and pim.rpSecType=#{rpSecType} and iis.sourceType=#{sourceType} 
			and pim.portfolio=#{portnum}
			limit 1
		]]>
	</select>
</mapper>
