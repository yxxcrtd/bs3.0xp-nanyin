<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.UserClientMapDao">
<resultMap type="com.orm.obj.UserClientMap" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<association property="client" column="ClientID" javaType="com.orm.obj.PortfolioClient" select="com.jixu.dao.intf.PortfolioClientDao.get"/>
	<association property="users" column="UserID" javaType="com.orm.obj.Users" select="com.jixu.dao.intf.UsersDao.get"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		ID,
		ClientID,
		UserID
		from userclientmap
		where ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.UserClientMap" >
		delete from userclientmap where ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.UserClientMap" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select UserClientMap_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into userclientmap (
		ID,
		ClientID,
		UserID
		)
		values(
		#{id},
		#{client.clientid,jdbcType=INTEGER},
		#{users.userid,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.UserClientMap" >
		update userclientmap set
		ID = #{id,jdbcType=INTEGER},
		ClientID = #{client.clientid,jdbcType=INTEGER},
		UserID = #{users.userid,jdbcType=INTEGER}
		where ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="loadUserClientMapListByUserID" resultMap="BaseResultMap">
		<![CDATA[
			select * from UserClientMap where userID=#{userID}
		]]>
	</select>

	<select id="deleteUserClientMap">
		<![CDATA[
			delete from UserClientMap where userID=#{userID}
		]]>
	</select>
</mapper>
