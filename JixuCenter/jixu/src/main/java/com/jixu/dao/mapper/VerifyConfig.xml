<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.VerifyConfigDao">
<resultMap type="com.orm.obj.VerifyConfig" id="BaseResultMap">
	<result property="id" column="id" jdbcType="INTEGER"/>
	<result property="msgHeader" column="msgHeader" jdbcType="VARCHAR"/>
	<result property="name" column="name" jdbcType="VARCHAR"/>
	<association property="roleGroup" column="groupID" javaType="com.orm.obj.UserRoleGroup" select="com.jixu.dao.intf.UserRoleGroupDao.get"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		id,
		msgHeader,
		name,
		groupID
		from verifyconfig
		where id = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.VerifyConfig" >
		delete from verifyconfig where id=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.VerifyConfig" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select VerifyConfig_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into verifyconfig (
		id,
		msgHeader,
		name,
		groupID
		)
		values(
		#{id},
		#{msgHeader,jdbcType=VARCHAR},
		#{name,jdbcType=VARCHAR},
		#{roleGroup.groupID,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.VerifyConfig" >
		update verifyconfig set
		id = #{id,jdbcType=INTEGER},
		msgHeader = #{msgHeader,jdbcType=VARCHAR},
		name = #{name,jdbcType=VARCHAR},
		roleGroup = #{groupID,jdbcType=INTEGER}
		where id = #{id,jdbcType=INTEGER}
	</update>

	<select id="deleteVerifyConfig">
		<![CDATA[
			delete from VerifyConfig where groupID=#{groupID}
		]]>
	</select>

	<select id="loadVerifyConfigByHeader"  resultMap="BaseResultMap">
		<![CDATA[
			select *from VerifyConfig where msgHeader=#{msgheader}and rownum=1
		]]>
	</select>

	<select id="loadVerifyConfigDetail" resultMap="BaseResultMap">
		<![CDATA[
			select * from VerifyConfig where id=#{id} and rownum=1
		]]>
	</select>

	<select id="loadVerifyConfig" resultMap="BaseResultMap">
		<![CDATA[
			select * from VerifyConfig where groupID=#{groupid}
		]]>
	</select>

	<select id="getVerifyConfigListByUserRoleGroupID" resultMap="BaseResultMap" >
		<![CDATA[
				select * from VerifyConfig where groupID=#{0}
		]]>
	</select>
</mapper>
