<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.SecPriceDao">
<resultMap type="com.orm.obj.SecPrice" id="BaseResultMap">
	<result property="id" column="id" jdbcType="INTEGER"/>
	<result property="lst_update" column="LST_UPDATE" jdbcType="TIMESTAMP"/>
	<result property="price" column="PRICE" jdbcType="DOUBLE"/>
	<result property="priceto" column="priceto" jdbcType="INTEGER"/>
	<result property="yield" column="yield" jdbcType="DOUBLE"/>
	<result property="price_date" column="PRICE_DATE" jdbcType="DATE"/>
	<association property="cusip" column="c" javaType="com.orm.obj.IssueInfo" select="com.jixu.dao.intf.IssueInfoDao.get"/>
	<association property="sourceID" column="sourceID" javaType="com.orm.obj.InterfaceSource" select="com.jixu.dao.intf.InterfaceSourceDao.get"/>
</resultMap>
<resultMap type="com.jixu.mvc.control.model.MarketPriceModel" id="BaseResultMap2">
		<result property="priceid" column="priceid" jdbcType="INTEGER"/>
		<result property="sourceid" column="sourceid" jdbcType="INTEGER"/>
		<result property="sourcename" column="sourcename" jdbcType="VARCHAR"/>
		<result property="secid" column="secid" jdbcType="VARCHAR"/>
		<result property="secname" column="secname" jdbcType="VARCHAR"/>
		<result property="curency" column="curency" jdbcType="VARCHAR"/>
		<result property="price" column="price" jdbcType="DOUBLE"/>
		<result property="priceDate" column="priceDate" jdbcType="DATE"/>
		<result property="priceto" column="priceto" jdbcType="INTEGER"/>
		<result property="yield" column="yield" jdbcType="DOUBLE"/>
</resultMap>

	<select id="loadCusipPrice" resultType="Double">
		<![CDATA[
			select * from
				(
					select ifnull(max(sp.price),0) from sec_price sp where sp.cusip=#{cusip} and sp.price_date<=#{priceDate} and sp.sourceID=#{sourceID} order by sp.price_date desc
				) de limit 1
		]]>
	</select>

	<select id="loadCusipYield" resultType="Double">
		<![CDATA[
			select * from (select ifnull(max(sp.yield),0)  from portfoliointerfacemap pim, interfacesource iis, issue_info ii, sec_price sp
				where pim.interfacesourceid=iis.sourceid and ii.rpsectype=pim.rpsectype and pim.portfolio=#{portnum}   
            		and iis.sourcetype=2 and ii.cusip=#{cusip} and sp.cusip=ii.cusip 
                    	and sp.sourceid=iis.sourceid and sp.price_date<=#{priceDate} order by sp.price_date desc) de limit 1
		]]>
	</select>

	
</mapper>
