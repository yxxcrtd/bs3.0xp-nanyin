<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.UserRoleDao">
<resultMap type="com.orm.obj.UserRole" id="BaseResultMap">
	<result property="roleID" column="RoleID" jdbcType="INTEGER"/>
	<result property="roleDesc" column="RoleDesc" jdbcType="VARCHAR"/>
	<collection property="users" javaType="java.util.Set" column="RoleID" ofType="com.orm.obj.Users" select="com.jixu.dao.intf.UsersDao.getUsersListByUserRoleID"/>
	<collection property="userRoleGroupMap" javaType="java.util.Set" column="RoleID" ofType="com.orm.obj.UserRoleGroupMap" select="com.jixu.dao.intf.UserRoleGroupMapDao.getUserRoleGroupMapListByUserRoleID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		RoleID,
		RoleDesc
		from userrole
		where RoleID = #{roleID,jdbcType=INTEGER}
	 </select>
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		RoleID,
		RoleDesc
		from userrole
		where RoleID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.UserRole" >
		delete from userrole where RoleID=#{roleID,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.UserRole" >
		<selectKey keyProperty="roleID" resultType="int" order="BEFORE">
			    select UserRole_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into userrole (
		RoleID,
		RoleDesc
		)
		values(
		#{roleID},
		#{roleDesc,jdbcType=VARCHAR}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.UserRole" >
		update userrole set
		RoleID = #{roleID,jdbcType=INTEGER},
		RoleDesc = #{roleDesc,jdbcType=VARCHAR}
		where RoleID = #{roleID,jdbcType=INTEGER}
	</update>

	<select id="loadUserRoleList" resultMap="BaseResultMap">
		<![CDATA[
			select * from UserRole	
		]]>
	</select>
</mapper>
