<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.ProvinceDao">
<resultMap type="com.orm.obj.Province" id="BaseResultMap">
	<result property="proID" column="proID" jdbcType="INTEGER"/>
	<result property="proName" column="proName" jdbcType="VARCHAR"/>
	<association property="country" column="country" javaType="com.orm.obj.Country" select="com.jixu.dao.intf.CountryDao.get"/>
	<collection property="portfolios" javaType="java.util.Set" column="proID" ofType="com.orm.obj.PortfolioHdr" select="com.jixu.dao.intf.PortfolioHdrDao.getPortfoliosListByProvinceID"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		proID,
		proName,
		country
		from province
		where proID = #{proID,jdbcType=INTEGER}
	 </select>
	 
	 <select id="loadEntity" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select* from Province where proID = #{id}
	 </select>
	 
	<delete id="deleteEntity" parameterType="com.orm.obj.Province" >
		delete from province where proID=#{proID,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.Province" >
		<selectKey keyProperty="proID" resultType="int" order="BEFORE">
			    select Province_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into province (
		proID,
		proName,
		country
		)
		values(
		#{proID},
		#{proName,jdbcType=VARCHAR},
		#{country.countryID,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.Province" >
		update province set
		proID = #{proID,jdbcType=INTEGER},
		proName = #{proName,jdbcType=VARCHAR},
		country = #{country.countryID,jdbcType=INTEGER}
		where proID = #{proID,jdbcType=INTEGER}
	</update>

	<select id="getProvinceist" resultMap="BaseResultMap">
		<![CDATA[
			select * from Province order by proID asc
		]]>
	</select>

	<select id="getProvincesListByCountryID" resultMap="BaseResultMap" >
		<![CDATA[
				select * from Province where country=#{0}
		]]>
	</select>
</mapper>
