<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.CashFlowRateDao">
<resultMap type="com.orm.obj.CashFlowRate" id="BaseResultMap">
	<result property="id" column="ID" jdbcType="INTEGER"/>
	<result property="cfDate" column="cfDate" jdbcType="TIMESTAMP"/>
	<result property="cfRate" column="cfRate" jdbcType="DOUBLE"/>
	<result property="cfid" column="cfid" jdbcType="INTEGER"/>
</resultMap>
	<select id="get" resultMap="BaseResultMap" parameterType="java.lang.Integer" >
		select
		ID,
		cfDate,
		cfid
		from cashflowrate
		where ID = #{id,jdbcType=INTEGER}
	 </select>
	<delete id="deleteEntity" parameterType="com.orm.obj.CashFlowRate" >
		delete from cashflowrate where ID=#{id,jdbcType=INTEGER}
	</delete>
	<insert id="saveEntity" parameterType="com.orm.obj.CashFlowRate" >
		<selectKey keyProperty="id" resultType="int" order="BEFORE">
			    select CashFlowRate_ID_SEQ.NEXTVAL from dual
		</selectKey>
		insert into cashflowrate (
		ID,
		cfDate,
		cfid
		)
		values(
		#{id},
		#{cfid,jdbcType=INTEGER}
		)
	</insert>
	<update id="updateEntity" parameterType="com.orm.obj.CashFlowRate" >
		update cashflowrate set
		ID = #{id,jdbcType=INTEGER},
		cfid = #{cfid,jdbcType=INTEGER}
		where ID = #{id,jdbcType=INTEGER}
	</update>

	<select id="loadCashFlowRateByCfID" resultMap="BaseResultMap">
		<![CDATA[
			select * from CashFlowRate where cfid=#{cfID}
		]]>
	</select>
</mapper>
