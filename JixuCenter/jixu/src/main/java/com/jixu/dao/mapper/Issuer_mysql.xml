<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jixu.dao.intf.IssuerDao">
<resultMap type="com.orm.obj.Issuer" id="BaseResultMap">
	<result property="issuerID" column="issuerID" jdbcType="INTEGER"/>
	<result property="issuerName" column="issuerName" jdbcType="VARCHAR"/>
	<result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
	<result property="issuerShortName" column="issuerShortName" jdbcType="VARCHAR"/>
	<result property="issuerCode" column="issuerCode" jdbcType="VARCHAR"/>
	<association property="country" column="country" javaType="com.orm.obj.Country" select="com.jixu.dao.intf.CountryDao.get"/>
	<association property="rpSecType" column="rpSecType" javaType="com.orm.obj.RPSecType" select="com.jixu.dao.intf.RPSecTypeDao.get"/>
	<collection property="cusip" javaType="java.util.Set" column="issuerID" ofType="com.orm.obj.IssueInfo" select="com.jixu.dao.intf.IssueInfoDao.getCusipListByIssuerID"/>
</resultMap>
<resultMap type="com.jixu.mvc.control.model.IssuerModel" id="IssuerModel">
	<result property="id" column="id" jdbcType="INTEGER"/>
	<result property="issuercode" column="issuercode" jdbcType="VARCHAR"/>
	<result property="issuername" column="issuername" jdbcType="VARCHAR"/>
	<result property="countryCode" column="countryCode" jdbcType="INTEGER"/>
	<result property="industryType3" column="industryType3" jdbcType="INTEGER"/>
</resultMap>

	<select id="loadPageHelperIssuerModel" resultMap="IssuerModel">
		select
	        issuer0_.issuerID as id,
	        issuer0_.issuerCode as issuercode,
	        issuer0_.issuerName as issuername,
	        issuer0_.country as countryCode,
	        issuer0_.rpSecType as industryType3 
	    from
	        ISSUER issuer0_ 
	    where
	        issuer0_.issuerName like CONCAT('%',IFNULL(#{issuername},''),'%')
	        or issuer0_.issuerShortName like CONCAT('%',IFNULL(#{issuername},''),'%')
	    order by
	        issuer0_.issuerCode asc
	</select>


</mapper>
