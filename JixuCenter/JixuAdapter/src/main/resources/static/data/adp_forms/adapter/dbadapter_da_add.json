{
  "新增数据适配器": [
    
    {
      "id": "daName",
      "type": "input",
      "label": "适配器名称"
    },
    {
      "id": "sourceDsId",
      "type": "select",
      "label": "源数据集",
      "opt_func": "dataSetAllOptList"
    },
    
    {
      "id": "targetDsId",
      "type": "select",
      "label": "目标数据集",
      "opt_func": "dataSetBasicOptList"
    },
    {
    	"type":"br"
    },
    {
    	"id":"basicDataSetId",
    	"type":"hidden",
    	"df_val":"1",
    	"readme":"测试用，正常的话应该没有这个参数"
    }, {
    	"id":"unionDataSetId",
    	"type":"hidden",
    	"df_val":"2",
    	"readme":"测试用，正常的话应该没有这个参数"
    },
    {
    	"id":"SQLstatement",
    	"type":"hidden",
    	"df_val":"",
    	"readme":"测试用，正常的话应该没有这个参数"
    },
    {
      "type": "button",
      "label": "刷新目标映射表",
      "id": "refreshMapTable"
    },
  {
      "type": "button",
      "label": "保存适配器及映射表",
      "cb_func": "adapterCreate",
      "cb_target":"message",
      "cb_done_message":"保存成功"
    },
    {
      "id": "tablejson",
      "type": "table",
      "df_func": "genMappingBySQL",
      "parent_id": ["refreshMapTable"],
      "tablecols": [
      {
          "colname": "targetCol",
          "label": "目标数据字段"
        },
        {
          "label": "源数据字段",
          "colname": "sourceCol"
        },
        {
          "colname": "editMapping",
          "label": "更改源数据字段",
          "type": "button",
          "cb_func":"dsID",
          "cb_target":"modal",
          "cb_target_url":"dbadapter_da_edit_mapping"
        }
      ]
    }
  ],
  "目标数据库更新字段": [
    {
      "type": "button",
      "label": "刷新",
      "id": "refreshMergeTable"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "setTargetMergeUpdateColumns"
    },
    {
      "id": "tableupdatejson",
      "type": "table",
      "df_func": "getTargetMergeUpdateColumns",
      "parent_id": ["refreshMergeTable"],
      "tablecols": [
        {
          "type": "check",
          "label": "合并查询主键",
          "colname": "selectFlag"
        },
        {
          "colname": "columnName",
          "label": "数据库字段"
        }
      ]
    }
  ],
  "目标数据库删除字段": [
    {
      "type": "button",
      "label": "刷新",
      "id": "refreshUpdateTable"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "setTargetMergeDeleteColumns"
    },
    {
      "id": "tabledeletejson",
      "type": "table",
      "df_func": "getTargetMergeDeleteColumns",
      "parent_id": ["refreshUpdateTable"],
      "tablecols": [
        {
          "type": "check",
          "label": "删除查询主键",
          "colname": "selectFlag"
        },
        {
          "type": "check",
          "label": "测试主键",
          "colname": "testFlag",
          "df_val": "1"
        },
        {
          "colname": "columnName",
          "label": "数据库字段"
        }
      ]
    }
  ]
}
