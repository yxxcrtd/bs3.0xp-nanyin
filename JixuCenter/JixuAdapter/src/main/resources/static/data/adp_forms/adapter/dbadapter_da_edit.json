{
  "修改数据适配器": [
    {
      "id": "id",
      "type": "input",
      "label": "适配器ID",
      "disabled": "true"
    },
    {
      "id": "daName",
      "type": "input",
      "label": "适配器名称"
    },
    {
      "id": "dsID",
      "type": "select",
      "label": "选择数据集",
      "df_func": "dataSetAllOptList"
    },
    {
    	"type":"br"
    },
    {
      "id": "daSQLStatement",
      "type": "txtarea",
      "label": "Message模版",
      "df_func": ""
    },
    {
      "id": "getDropdownBySQL",
      "type": "button",
      "label": "生成配置表"
    },
    {
      "type": "button",
      "label": "刷新映射表",
      "id": "refreshMapTable"
    },

  {
      "type": "button",
      "label": "更新适配器",
      "cb_func": "adapterUpdate",
      "cb_target":"message",
      "cb_done_message":"保存成功"
    },
    {
      "id": "tableColinDS2",
      "type": "table",
      "df_func": "genMappingBySQL",
      "parent_id": ["refreshMapTable"],
      "tablecols": [
      
        {
          "label": "源数据字段",
          "colname": "sourceCol"
        },
        {
          "colname": "targetCol",
          "label": "目标数据字段"
        },
        {
          "colname": "editMapping",
          "label": "选择源数据字段",
          "type": "button",
          
          "cb_func":"dsID",
          "cb_target":"modal",
          "cb_target_url":"dbadapter_da_edit_mapping"
        }
      ]
    }
  ],
  "目标数据库更新字段": [
    {
      "type": "button",
      "label": "刷新",
      "id": "refreshMergeTable"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "setTargetMergeUpdateColumns"
    },
    {
      "id": "tableupdatejson",
      "type": "table",
      "df_func": "getTargetMergeUpdateColumns",
      "parent_id": ["refreshMergeTable"],
      "tablecols": [
        {
          "type": "check",
          "label": "合并查询主键",
          "colname": "selectFlag"
        },
        {
          "colname": "columnName",
          "label": "数据库字段"
        }
      ]
    }
  ],
  "目标数据库删除字段": [
    {
      "type": "button",
      "label": "刷新",
      "id": "refreshUpdateTable"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "setTargetMergeDeleteColumns"
    },
    {
      "id": "tabledeletejson",
      "type": "table",
      "df_func": "getTargetMergeDeleteColumns",
      "parent_id": ["refreshUpdateTable"],
      "tablecols": [
        {
          "type": "check",
          "label": "删除查询主键",
          "colname": "selectFlag"
        },
        {
          "type": "check",
          "label": "测试主键",
          "colname": "testFlag",
          "df_val": "1"
        },
        {
          "colname": "columnName",
          "label": "数据库字段"
        }
      ]
    }
  ]
}
