{
  "修改关联数据集": [
    {
      "id": "id",
      "type": "input",
      "label": "数据集ID",
      "disabled":"true"
    },
    {
    	"id":"unionDSid",
    	"type":"hidden",
    	"df_func":"id"
    },
    {
      "id": "basicDataSetId",
      "type": "input",
      "label": "基础数据集",
      "disabled":"true"
    },
    {
      "id": "name",
      "type": "input",
      "label": "关联数据名"
          },
    {
      "type": "br"
    },
    {
      "type": "button",
      "label": "保存",
      "cb_func": "unionDataSetUpdate",
      "cb_target": "message",
      "cb_done_message": "保存成功",
      "id": "updatetable"
    }
  ],

  "关联列列表": [
    {
      "type": "button",
      "label": "刷新",
      "cb_func": "",
      "id": "updateTableRelativeCols"
    },
    {
      "type": "button",
      "label": "增加一行",
      "cb_func": "id",
      "cb_target": "modal",
      "cb_target_url": "dbadapter_ds_relative_add_row"
    },

    {
      "type": "button",
      "label": "保存关联列布局",
      "cb_func": "unionDataSetSaveColList",
      "cb_target": "message",
      "cb_done_message": "保存成功"
    },
    {
      "id": "exColListTable",
      "type": "table",
      "df_func": "unionDataSetExColsList",
      "parent_id": ["updateTableRelativeCols"],
      "tablecols": [
        {
          "type": "checkbox"
        },
        {
          "colname": "exColID",
          "label": "数据列ID"
        },
        {
          "colname": "exColName",
          "label": "字段名称"
        },
        {
          "colname": "exColfunctionID",
          "label": "函数编号"
        },
        {
          "colname": "exColFuncStr",
          "label": "函数表达式"
        },
        {
          "colname": "updatebtn",
          "id": "updatebtn",
          "type": "button",
          "label": "修改",
          "cb_func": "",
          "cb_target": "modal",
          "cb_target_url": "dbadapter_ds_relative_edit_row"
        },
        {
          "colname": "moveupbtn",
          "id": "moveupbtn",
          "type": "button",
          "label": "<i class='layui-icon layui-icon-up'></i> ",
          "cb_func": "_moverowup"
        },
        {
          "colname": "movedownbtn",
          "id": "movedownbtn",
          "type": "button",
          "label": "<i class='iconfont icon-down'></i> ",
          "cb_func": "_moverowdown"
        },
        {
          "colname": "movedownbtn",
          "id": "delbtn",
          "type": "button",
          "color": "red",
          "label": "删除",
          "cb_func": "",
          "cb_target": "modal",
          "cb_target_url": "dbadapter_ds_relative_del_row"
        },
        {
          "colname": "movedownbtn",
          "id": "check1",
          "type": "check",
          "color": "red",
          "label": "测试用"
        }
      ]
    }
  ]
}
