<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>tams-parent</artifactId>
        <version>0.0.3</version>
    </parent>
  
    <name>mobileApproval</name>
    <version>1.0.0</version>
    <artifactId>mobileApproval</artifactId>
    <description>移动审批</description>
    <build>
        <plugins>
            <!-- 打包源代码插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>

        <!-- 移动APP -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>itext-asian</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.8</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>jodconverter</artifactId>
            <version>2.2.2</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>jodconverter-core</artifactId>
            <version>3.0-beta-4</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>juh</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>ridl</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>unoil</artifactId>
            <version>3.0.1</version>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>component-business</artifactId>
            <version>0.0.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-invest</artifactId>
            <version>1.0.0</version>
            <scope>compile</scope>
        </dependency>
        
    </dependencies>

</project>