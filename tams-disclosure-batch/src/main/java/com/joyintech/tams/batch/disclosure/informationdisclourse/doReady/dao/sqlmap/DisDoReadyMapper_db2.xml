<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.tams.batch.disclosure.informationdisclourse.doReady.dao.DisDoReadyMapper_db2">
	
	 <update id="updateReadybyAdapter" parameterType="String" >
    	UPDATE DIS_DATA_READY SET 
    		DATA_DATE	=	TO_DATE(#{date,jdbcType=VARCHAR},'yyyyMMdd')
    </update>
    
    
     <insert id="insertReadyByInterf" parameterType="String" >
     
        insert into ADPT_FILEBACKUPRECORD values(adpt_fileb_id_seq.nextval,'1',current date,TO_CHAR(TO_DATE(#{date,jdbcType=VARCHAR},'yyyyMMdd'),'yyyy-MM-dd'),null)
    </insert>
    
    
    <select id="getValueId" resultType="java.lang.String">
		select adpt_fileb_id_seq.nextval from sysibm.SYSDUMMY1
	</select>
</mapper>