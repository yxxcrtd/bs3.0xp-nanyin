    <select id="getAverageMdate" resultType="int" parameterType="java.util.Map">
		SELECT SUM((case when AL_FLAG = '01' then 1 else -1 end) *POS_AMT*END_DAYS_1)
		/ SUM((case  when AL_FLAG = '01' then 1 else -1 end) *POS_AMT)
          FROM REP_ASSET_INDEX
	  	WHERE PROD_ID = #{prodid,jdbcType=VARCHAR}
	  	AND VALUE_DATE = #{valuedate,jdbcType=DATE}
	</select>

    <select id="getYeildE" resultType="java.math.BigDecimal" parameterType="java.util.Map">
		SELECT       a.RATE
		from (
		SELECT        RATE,
		             @rn := @rn + 1  AS RN
		  FROM REP_CASH_YIELD, (select @rn := 0) b
		WHERE       busi_id = #{prodid,jdbcType=VARCHAR}
		AND START_DATE &lt;= #{valuedate,jdbcType=DATE}
		AND CASH_TYPE = #{cashType,jdbcType=VARCHAR}
		ORDER BY START_DATE DESC
		) a
		limit 1
	</select>
