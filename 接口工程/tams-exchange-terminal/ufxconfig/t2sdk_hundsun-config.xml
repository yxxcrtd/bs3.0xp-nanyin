<?xml version="1.0" encoding="UTF-8"?>
<!-- for details please read  <T2SDK JAVA Developer Manual>-->
<t2sdk-configuration>
    <performance heartbeatTime="10" acquireConnWaitTime="5000"
                 registerTime="5" reconnInterval="3" localServerName="tamsExchangeParent"
                 callBackTime="5000" enmCompress="true"/>
    <parents>
        <parent parentName="ar_tree" safeLevel="NONE"> <!--Trading realated node named ar_tree-->
            <limit licenseFile="ufxconfig/(20190807)GJZQJG-HSFCJSJJ-ALL-0000_3rd.dat"
                   ufxPassword="888888"/><!--locate license -->
            <members>
                <member no="5" address="172.24.60.25" port="18904" charset="gbk"
                        poolSize="2"/> <!-- control multi thread pool size-->
            </members>
        </parent>

        <parent parentName="ar_tree_msg" safeLevel="NONE"> <!-- Message Center realated node named ar_tree_msg-->
            <limit licenseFile="ufxconfig/(20190807)GJZQJG-HSFCJSJJ-ALL-0000_3rd.dat"
                   ufxPassword="888888"/>
            <members>
                <member no="1" address="172.24.60.25" port="18904" charset="gbk"
                        poolSize="2"/>
            </members>
        </parent>

    </parents>

    <callBackMethods>
        <method id="-1" className="com.hundsun.mcapi.MCT2sdkCallback"/>
        <method id="5" className="com.joyintech.tams.exchange.terminal.trade.ufx.UfxTradeCallBack"/>
        <method id="6" className="com.joyintech.tams.exchange.terminal.test.UfxRebackTest"/>
    </callBackMethods>
    <logAdapter className="com.joyintech.tams.exchange.terminal.trade.ufx.log.UfxLogAdapter"/>
    <extCrypt class='com.hundsun.libsecurity.CryptDecorator'/> <!-- 加密库指向-->

    <mc parentName="ar_tree_msg" type="0" cachedir="./mc" inittimeout="3000">
        <subscriber subname="joyin" subcallback="com.joyintech.tams.exchange.terminal.trade.ufx.UfxMCCallBack"
                    timeout="3000"/>
        <publisher pubname="joyin" msgCount="200" isResetNo="false"/>
        <mclog dir="D:\mclog"/>
    </mc>
</t2sdk-configuration>