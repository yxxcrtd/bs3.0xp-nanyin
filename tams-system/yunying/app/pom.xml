<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.joyintech</groupId>
		<artifactId>tams-parent</artifactId>
		<version>0.0.4</version>
	</parent>
	<artifactId>tams-yunying</artifactId>
	<version>0.1.9</version>
<!-- 	<packaging>war</packaging> -->
	<packaging>jar</packaging>
	<name>tams-yunying</name>
	<description>理财资管系统画面整合启动</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
        <hibernate.version>5.3.6.Final</hibernate.version>
	</properties>



    <dependencies>
		<!-- 集成微服务端的代码 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-service-container</artifactId>
			<version>2.1.1</version>
			<exclusions>
				<exclusion>
					<artifactId>service-bankuplink</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>

				<exclusion>
					<artifactId>service-asset</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-basicdata</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-document</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-entrust</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-interf</artifactId>
					<groupId>com.joyintech.service</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-invest-interf</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-period</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-portfolio</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-product</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-report</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-risk</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-risk-redis</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-risk-redis-inf</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-settle</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-trade</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>component-base</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>tams-invest-common</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-common</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
				<exclusion>
					<artifactId>service-exchange</artifactId>
					<groupId>com.joyintech</groupId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-data</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-log</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>framework-security</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-tools</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-system</artifactId>
		</dependency>
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>joyintech-workflow</artifactId>
		</dependency>
		<!-- 中债画面端 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-svreport</artifactId>
			<version>3.0.0</version>
			<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
			            <artifactId>spring-boot-starter-tomcat</artifactId>
					</exclusion>
		    </exclusions>
		</dependency>
        <!-- 信批画面端 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-disclosure</artifactId>
            <version>3.0.0</version>
			<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
			            <artifactId>spring-boot-starter-tomcat</artifactId>
					</exclusion>
		    </exclusions>
        </dependency>
        <!-- 估值画面端 -->
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-valuation</artifactId>
            <version>1.0.0</version>
			<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
			            <artifactId>spring-boot-starter-tomcat</artifactId>
					</exclusion>
		    </exclusions>
        </dependency>

		<!-- 公共基础数据画面 -->
		<dependency>
			<groupId>com.joyintech</groupId>
			<artifactId>tams-common-basicdata</artifactId>
			<version>2.1.1.3</version>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<finalName>tams-yunying</finalName>
		<plugins>
		<!-- 打包源代码插件 -->
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-source-plugin</artifactId>
               <version>2.4</version>
               <configuration>
                  <attach>true</attach>
               </configuration>
               <executions>
                  <execution>
                     <phase>compile</phase>
                     <goals>
                        <goal>jar</goal>
                     </goals>
                  </execution>
               </executions>
            </plugin>


			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.joyintech.tams.TamsApplication</mainClass>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.xml</include>
				</includes>
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.xml</include>
					<include>**/*.txt</include>
					<include>**/*.png</include>
					<include>**/*.properties</include>
					<include>**/*.ini</include>
					<include>**/*.yml</include>
					<include>**/*.js</include>
					<include>**/*.html</include>
					<include>**/*.xls</include>
				</includes>
				<filtering>false</filtering>
			</resource>
		</resources>
	</build>

</project>
