<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="myDataSource" class="org.apache.commons.dbcp.BasicDataSource"
          destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.OracleDriver"></property>
        <property name="url" value="jdbc:oracle:thin:@//192.168.60.142:1521/orcl"></property>
        <property name="username" value="CVR303INIT_TEST1209"></property>
        <property name="password" value="CVR303INIT_TEST1209"></property>
    </bean>

    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="myDataSource"/>
        <property name="mapperLocations" value="com/joyintech/dao/*.xml"/>
    </bean>

    <bean id="SysBatchTaskMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
            <property name="mapperInterface" value="com.joyintech.framework.base.dao.SysBatchTaskMapper"/>
            <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="SysBatchGrpMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.framework.base.dao.SysBatchGrpMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="ValBatchStart001Mapper" class="org.mybatis.spring.mapper.MapperFactoryBean" scope="prototype">
        <property name="mapperInterface" value="com.joyintech.tams.valuation.system.batchstart.dao.ValBatchStart001Mapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="SysBatchPrdGrpMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.framework.base.dao.SysBatchPrdGrpMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="SysBatchgrpExecInfoMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.framework.base.dao.SysBatchgrpExecInfoMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="BooksetComMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.tams.valuation.common.dao.BooksetComMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="BaseCommonMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.tams.valuation.common.dao.BaseCommonMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>

    <bean id="BokBooksetDateMapper" class="org.mybatis.spring.mapper.MapperFactoryBean">
        <property name="mapperInterface" value="com.joyintech.tams.common.base.dao.BokBooksetDateMapper"/>
        <property name="sqlSessionFactory" ref="sqlSessionFactory"/>
    </bean>
</beans>