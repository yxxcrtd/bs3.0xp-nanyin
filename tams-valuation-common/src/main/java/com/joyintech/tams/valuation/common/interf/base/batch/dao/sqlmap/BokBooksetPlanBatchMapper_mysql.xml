<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.common.interf.base.batch.dao.BokBooksetPlanBatchMapper_mysql">
	<resultMap id="BaseResultMap"
		type="com.joyintech.tams.common.base.entity.BokBooksetPlan">
		<id column="BOOKSET_SCHEME_ID" property="booksetSchemeId" jdbcType="VARCHAR" />
		<result column="BOOKSET_ID" property="booksetId" jdbcType="VARCHAR" />
		<result column="SCHEME_ID" property="schemeId" jdbcType="VARCHAR" />
		<result column="SCHEME_TYPE" property="schemeType" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
	</resultMap>


	<insert id="insertBatch" parameterType="java.util.List">
		insert into BOK_BOOKSET_PLAN (BOOKSET_SCHEME_ID, BOOKSET_ID,
		SCHEME_ID,
		SCHEME_TYPE, CREATE_USER, CREATE_DEPT,
		CREATE_TIME, UPDATE_USER, UPDATE_TIME
		) values
		<foreach collection="list" item="item" separator=",">
			(#{item.booksetSchemeId,jdbcType=VARCHAR},
			#{item.booksetId,jdbcType=VARCHAR},
			#{item.schemeId,jdbcType=VARCHAR},
			#{item.schemeType,jdbcType=VARCHAR},
			#{item.createUser,jdbcType=VARCHAR},
			#{item.createDept,jdbcType=VARCHAR},
			#{item.createTime,jdbcType=TIMESTAMP},
			#{item.updateUser,jdbcType=VARCHAR},
			#{item.updateTime,jdbcType=TIMESTAMP})
		</foreach>
	</insert>

</mapper>
