<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.common.interf.transdata.pabhq.dao.CBondBenchmarkMapper_db2" >
    <resultMap id="BaseResultMap" type="com.joyintech.tams.valuation.common.interf.transdata.pabhq.entity.CBondBenchmark" >
        <result column="OBJECT_ID" property="objectId" jdbcType="VARCHAR" />
        <result column="TRADE_DT" property="tradeDt" jdbcType="VARCHAR" />
        <result column="B_INFO_BENCHMARK" property="bInfoBenchmark" jdbcType="VARCHAR" />
        <result column="B_INFO_RATE" property="bInfoRate" jdbcType="DECIMAL" />
        <result column="OPDATE" property="opdate" jdbcType="DATE" />
        <result column="OPMODE" property="opmode" jdbcType="VARCHAR" />
    </resultMap>
    <select id="queryData" resultMap="BaseResultMap" parameterType="java.lang.String" >
    	select
    		OBJECT_ID, TO_CHAR(TO_DATE(TRADE_DT,'yyyyMMdd'),'yyyy-MM-dd')  TRADE_DT, 
    		B_INFO_BENCHMARK, coalesce(B_INFO_RATE/100,NULL) B_INFO_RATE
    	from CBONDBENCHMARK
    	where TRADE_DT = #{cdate,jdbcType=VARCHAR}
    </select>
    <insert id="insertBatch" parameterType="java.util.List" >
    	insert into CBONDBENCHMARK (OBJECT_ID, TRADE_DT, B_INFO_BENCHMARK, 
            B_INFO_RATE,OPDATE,OPMODE)
    	<foreach collection="list" item="item" separator="from sysibm.SYSDUMMY1 union all select" open="select * from (select "
                 close=" from sysibm.SYSDUMMY1)">
            #{item.objectId,jdbcType=VARCHAR}, #{item.tradeDt,jdbcType=VARCHAR}, #{item.bInfoBenchmark,jdbcType=VARCHAR}, 
            #{item.bInfoRate,jdbcType=DECIMAL}
            ,#{item.opdate,jdbcType=DATE},#{item.opmode,jdbcType=VARCHAR}    
        </foreach>
    </insert>
    
  	<delete id="deleteFifthDay" parameterType="java.lang.String" >
        delete from CBONDBENCHMARK
        where #{cdate,jdbcType=VARCHAR} >= TRADE_DT 
    </delete>
    
    <delete id="deleteThisDayDay" parameterType="java.lang.String" >
        delete from CBONDBENCHMARK
        where TRADE_DT = #{cdate,jdbcType=VARCHAR}
    </delete>
</mapper>