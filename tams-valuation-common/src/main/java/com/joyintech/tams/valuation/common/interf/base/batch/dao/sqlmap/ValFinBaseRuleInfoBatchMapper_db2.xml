<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.common.interf.base.batch.dao.ValFinBaseRuleInfoBatchMapper_db2" >
    <delete id="deleteBatch" parameterType="java.util.List" >
        delete from FIN_BASE_RULE_INFO
        where
        <foreach collection="list" item="item" index="index" separator="or" open="(" close=")">
            (
                BASE_RULE_ID = #{item.baseRuleId,jdbcType=VARCHAR}
                and effDate = #{item.effDate,jdbcType=DATE}
            )
        </foreach>
    </delete>
</mapper>