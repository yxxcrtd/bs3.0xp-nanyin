<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.common.interf.base.batch.dao.BenchmarkCompoBatchMapper_mysql">
    <resultMap id="BaseResultMap" type="com.joyintech.tams.common.base.entity.MstBenchmarkCompo" >
        <id column="BENCHMARK_NO" property="benchmarkNo" jdbcType="CHAR" />
        <id column="INT_RATE_ID" property="intRateId" jdbcType="CHAR" />
        <result column="WEIGHTS" property="weights" jdbcType="CHAR" />
    </resultMap>
    <insert id="insertBatch" parameterType="java.util.List" >
    	insert into MST_BENCHMARK_COMPO (BENCHMARK_NO, INT_RATE_ID, WEIGHTS
            ) values
        <foreach collection="list" item="item" separator=",">
            (#{item.benchmarkNo,jdbcType=CHAR}, #{item.intRateId,jdbcType=CHAR}, #{item.weights,jdbcType=CHAR})
        </foreach>
    </insert>
</mapper>
