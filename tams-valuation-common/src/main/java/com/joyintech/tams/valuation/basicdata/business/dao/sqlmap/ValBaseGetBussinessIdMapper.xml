<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.valuation.basicdata.business.dao.ValBaseGetBussinessIdMapper" >
	<select id="selectRuleByParameter" parameterType="com.joyintech.tams.valuation.basicdata.business.dto.BussinessCodeParameter"
	resultMap="com.joyintech.tams.common.base.dao.MstBusinessIdRuleMapper.BaseResultMap">
		SELECT
		    SEQ_NO,
		    COMMON_BUSINESS_TYPE,
		    TYPE_1,
		    TYPE_2,
		    TYPE_3,
		    TYPE_4,
		    TYPE_5,
		    TYPE_6,
		    BUSINESS_ID_RULE_TYPE,
		    PREFIX_NAME,
		    PREFIX_SEQUENCE_NAME,
		    PREFIX_SEQUENCE_LEN,
		    POSTFIX_NAME,
		    POSTFIX_SEQUENCE_NAME,
		    POSTFIX_SEQUENCE_LEN,
		    DATE_RULE_TYPE,
		    BUSINESS_ID_SERVICE_NAME,
		    BUSINESS_ID_METHOD_NAME,
		    CREATE_USER,
		    CREATE_DEPT,
		    CREATE_TIME,
		    UPDATE_USER,
		    UPDATE_TIME
		FROM
		    MST_BUSINESS_ID_RULE
		<where> 
		<choose>
		    <!-- 增加seqNo的匹配模式 -->
			<when test="seqNo != null and seqNo != ''">
			SEQ_NO = #{seqNo}
			</when>
			<otherwise>
			    <!-- 支持数据字典的ext1和ext2对应 修改 by renping 2019-07-19 start-->
		        <if test="commonBusinessType != null">
			    COMMON_BUSINESS_TYPE = #{commonBusinessType.value}
		        </if>
		        <if test="commonBusinessExtType != null">
			    and COMMON_BUSINESS_TYPE = #{commonBusinessExtType.value}
		        </if>
			    <!-- 支持数据字典的ext1和ext2对应 修改 by renping 2019-07-19 end-->
		        <if test="type1 != null">
		            and TYPE_1 = #{type1.value}
		        </if>
		        <if test="type2 != null">
		            and TYPE_2 = #{type2.value}
		        </if>
		        <if test="type3 != null">
		            and TYPE_3 = #{type3.value}
		        </if>
		        <if test="type4 != null">
		            and TYPE_4 = #{type4.value}
		        </if>
		        <if test="type5 != null">
		            and TYPE_5 = #{type5.value}
		        </if>
		        <if test="type6 != null">
		            and TYPE_6 = #{type6.value}
		        </if>
			</otherwise>
		</choose>
		</where>
	</select>
	<select id="getNextValBySequenceName" resultType="java.lang.String" useCache="false" flushCache="true">
		select ${sequenceName}.nextval from dual
	</select>
</mapper>