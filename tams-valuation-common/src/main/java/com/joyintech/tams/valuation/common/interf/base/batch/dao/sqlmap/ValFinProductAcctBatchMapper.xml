    <select id="getStlCapacctInfo" resultType="com.joyintech.tams.common.base.entity.StlCapacctInfo" parameterType="java.lang.String" >
        SELECT t.ACCT_NO acctNo,
           t.ACCT_NAME acctName,
           t.BANK_DEP bankDep,
           t.CCY ccy
       FROM STL_CAPACCT_INFO t
       WHERE t.ACCT_NO = #{acctNo}
       AND t.CCY = #{ccy}
