      <delete id="deleteBatch" parameterType="java.util.List" >
         delete from STL_FIN_PRODUCT_ACCT 
         <!-- modify by dongjun on 20181024 REMARK:缺陷编号GZHSXT-991 start -->
        where (FINPROD_ID, FINPROD_TYPE) in 
	        <foreach collection="list" item="item" index="index" separator="," open="("
	                 close=")">
	            <if test="(index % 1000) == 999">
	              (null, null) ) OR (FINPROD_ID, FINPROD_TYPE) in ( 
