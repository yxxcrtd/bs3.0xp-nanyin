        insert into STL_FIN_PRODUCT_ACCT (FINPROD_ID, FINPROD_TYPE, ACCT_NO, 
            CCY, ACCT_TYPE, CREATE_USER, 
            CREATE_DEPT, CREATE_TIME, UPDATE_USER, 
